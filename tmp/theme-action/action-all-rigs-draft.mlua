@Logic
script RtsActionThemeLogic extends Logic
 property table Scenes = {}
 property number Elapsed = 0
 property number ScanClock = 0
 property number DrawClock = 0

 method string GetBossThemeKey(string mobId)
  if self._T.BossKeys == nil then self._T.BossKeys = {B01 = "forbidden_altar", B02 = "zakum_altar", B03 = "pianus_cave", B04 = "cave_of_life", B05 = "twilight_of_gods", B06 = "cygnus_garden", B07 = "black_heaven_core", B08 = "world_tree_summit", B09 = "collapsing_clocktower", B10 = "diffraction_hall", B11 = "eye_of_void", B12 = "altar_of_desire", B13 = "near_the_end", B14 = "dark_temple", B15 = "dark_temple", B16 = "dark_throne", B17 = "boundary_of_beginning_and_end", B18 = "nonexistent_space"} end
  return self._T.BossKeys[mobId] or ""
 end

 -- 화면/카메라는 고정한다. 움직임은 분리된 신체 부위와 환경 효과에만 적용.
 method table GetSceneMotion()
  return {zoom = 1, x = 0, y = 0, light = 1}
 end

 method any GetRig(string key)
  if self._T.Rigs == nil then self._T.Rigs = {["zakum_altar"]={["fx"]="lava",["parts"]={{["id"]="arm-l1",["w"]=336,["h"]=332,["size"]=168982,["x"]=778,["y"]=446,["k"]=0.68,["px"]=295.68,["py"]=275.56,["amp"]=-5,["period"]=4.8,["phase"]=0,["order"]=92,["angle"]=0,["dy"]=0,["ruid"]="5fabb556c40241ca8b7c1746252d8ac3"},{["id"]="arm-l2",["w"]=494,["h"]=236,["size"]=191807,["x"]=737,["y"]=522,["k"]=0.55,["px"]=444.6,["py"]=136.88,["amp"]=-7,["period"]=4.1,["phase"]=1,["order"]=92,["angle"]=-12,["dy"]=0,["ruid"]="a5786ead45874644bfa1e5b4e924ba6e"},{["id"]="arm-l3",["w"]=459,["h"]=185,["size"]=165816,["x"]=733,["y"]=600,["k"]=0.57,["px"]=413.1,["py"]=98.05,["amp"]=-5.5,["period"]=5.3,["phase"]=2,["order"]=92,["angle"]=0,["dy"]=0,["ruid"]="a01788f7cbcf4f55b84876d248d55be7"},{["id"]="arm-l4",["w"]=368,["h"]=236,["size"]=137510,["x"]=749,["y"]=640,["k"]=0.61,["px"]=320.16,["py"]=56.64,["amp"]=-6,["period"]=4.6,["phase"]=3,["order"]=92,["angle"]=0,["dy"]=0,["ruid"]="9e1a14df75de4a16b9183c90a069ef16"},{["id"]="arm-r1",["w"]=338,["h"]=332,["size"]=167988,["x"]=892,["y"]=446,["k"]=0.68,["px"]=40.56,["py"]=275.56,["amp"]=5,["period"]=4.8,["phase"]=1.5,["order"]=92,["angle"]=0,["dy"]=0,["ruid"]="aff573c8ed1d485cbb894ba4caeb0dbd"},{["id"]="arm-r2",["w"]=494,["h"]=236,["size"]=189283,["x"]=933,["y"]=522,["k"]=0.55,["px"]=49.4,["py"]=136.88,["amp"]=7,["period"]=4.1,["phase"]=2.8,["order"]=92,["angle"]=12,["dy"]=0,["ruid"]="1f15128780a84733af473580fd753e69"},{["id"]="arm-r3",["w"]=462,["h"]=185,["size"]=167214,["x"]=937,["y"]=600,["k"]=0.57,["px"]=46.2,["py"]=98.05,["amp"]=5.5,["period"]=5.3,["phase"]=3.4,["order"]=92,["angle"]=0,["dy"]=0,["ruid"]="39d7ab783d684352a1a24d2a005bfeb0"},{["id"]="arm-r4",["w"]=366,["h"]=236,["size"]=137753,["x"]=921,["y"]=640,["k"]=0.61,["px"]=47.58,["py"]=56.64,["amp"]=6,["period"]=4.6,["phase"]=4.2,["order"]=92,["angle"]=0,["dy"]=0,["ruid"]="a9069ad925e44502ab326a15ae082ebd"},{["id"]="body",["w"]=330,["h"]=462,["size"]=355945,["x"]=835,["y"]=740,["k"]=1.04,["px"]=165,["py"]=462,["amp"]=0,["period"]=5,["phase"]=0,["order"]=94,["angle"]=0,["dy"]=0,["ruid"]="fc7bb7ed9c654866b73f56604b59b267"}}},["cave_of_life"]={["fx"]="water",["parts"]={{["id"]="tail",["w"]=401,["h"]=367,["size"]=187970,["x"]=1010,["y"]=727,["k"]=0.65,["px"]=32.08,["py"]=209.19,["amp"]=6,["period"]=5.4,["phase"]=0.2,["order"]=91,["angle"]=0,["dy"]=0,["ruid"]="25811aa47c1d405ea0e7dbe7350e13a9"},{["id"]="wing-l",["w"]=340,["h"]=389,["size"]=169555,["x"]=710,["y"]=478,["k"]=0.9,["px"]=312.8,["py"]=89.47,["amp"]=5,["period"]=4.2,["phase"]=0.5,["order"]=92,["angle"]=0,["dy"]=0,["ruid"]="09b27be3fdd24b64b6742df5aff3d66c"},{["id"]="wing-r",["w"]=339,["h"]=389,["size"]=168722,["x"]=960,["y"]=478,["k"]=0.9,["px"]=27.12,["py"]=89.47,["amp"]=-5,["period"]=4.2,["phase"]=1.1,["order"]=92,["angle"]=0,["dy"]=0,["ruid"]="376035668c014e50be79611d3a1cddbe"},{["id"]="head-l",["w"]=358,["h"]=349,["size"]=190537,["x"]=752,["y"]=484,["k"]=0.74,["px"]=307.88,["py"]=331.55,["amp"]=3.5,["period"]=5,["phase"]=0,["order"]=93,["angle"]=0,["dy"]=0,["ruid"]="d2efc640aa424e62b5e7d36e8f8eed79"},{["id"]="head-r",["w"]=360,["h"]=331,["size"]=188043,["x"]=918,["y"]=484,["k"]=0.74,["px"]=50.4,["py"]=314.45,["amp"]=-3.8,["period"]=5.7,["phase"]=1.3,["order"]=93,["angle"]=0,["dy"]=0,["ruid"]="1a81d0ff2c984783b621102b1a28f674"},{["id"]="head-c",["w"]=240,["h"]=447,["size"]=176175,["x"]=835,["y"]=481,["k"]=0.9,["px"]=120,["py"]=433.59,["amp"]=2,["period"]=6.1,["phase"]=2,["order"]=93,["angle"]=0,["dy"]=3,["ruid"]="ef273a96578b487a8a8c1643aa95c547"},{["id"]="arm-l",["w"]=316,["h"]=285,["size"]=135247,["x"]=720,["y"]=552,["k"]=0.55,["px"]=284.4,["py"]=199.5,["amp"]=7,["period"]=4.7,["phase"]=2,["order"]=93,["angle"]=0,["dy"]=0,["ruid"]="b5c2e833b78f4e8a8102c56b6cd20cab"},{["id"]="arm-r",["w"]=309,["h"]=289,["size"]=138626,["x"]=950,["y"]=552,["k"]=0.55,["px"]=30.9,["py"]=202.3,["amp"]=-7,["period"]=5.2,["phase"]=0.8,["order"]=93,["angle"]=0,["dy"]=0,["ruid"]="11d8f064957d4d52a0b5933bc641ce8a"},{["id"]="body",["w"]=431,["h"]=361,["size"]=286818,["x"]=835,["y"]=800,["k"]=1.17,["px"]=215.5,["py"]=361,["amp"]=0,["period"]=6.1,["phase"]=0,["order"]=94,["angle"]=0,["dy"]=0,["ruid"]="3b13f218e7b649249cdf7d08f7e3a66a"}}}} end
  return self._T.Rigs[key]
 end

 method table GetEnvironmentSprites()
  if self._T.EnvironmentSprites == nil then self._T.EnvironmentSprites = {["lava-bubble"]="67de545f31bf4579810896b1c64cc2dd",["lava-burst"]="2da36751d97c409792c10f99949e5ec9",["lava-ripple"]="4bf66d0405a540b8abaa9cd99b985dc3",["water-drop"]="11860b6d4b4e43e19170cb74c4bb616d",["water-trail"]="b95fd419c9d14ae08322c8c7351b7143",["water-splash"]="a2c4816fb8664b6fbae6c20813500935"} end
  return self._T.EnvironmentSprites
 end

 method any GetPartSize(string ruid)
  if self._T.PartSizes == nil then self._T.PartSizes = {["fc7bb7ed9c654866b73f56604b59b267"]={["w"]=330,["h"]=462},["5fabb556c40241ca8b7c1746252d8ac3"]={["w"]=336,["h"]=332},["aff573c8ed1d485cbb894ba4caeb0dbd"]={["w"]=338,["h"]=332},["a5786ead45874644bfa1e5b4e924ba6e"]={["w"]=494,["h"]=236},["1f15128780a84733af473580fd753e69"]={["w"]=494,["h"]=236},["a01788f7cbcf4f55b84876d248d55be7"]={["w"]=459,["h"]=185},["39d7ab783d684352a1a24d2a005bfeb0"]={["w"]=462,["h"]=185},["9e1a14df75de4a16b9183c90a069ef16"]={["w"]=368,["h"]=236},["a9069ad925e44502ab326a15ae082ebd"]={["w"]=366,["h"]=236},["3b13f218e7b649249cdf7d08f7e3a66a"]={["w"]=431,["h"]=361},["ef273a96578b487a8a8c1643aa95c547"]={["w"]=240,["h"]=447},["d2efc640aa424e62b5e7d36e8f8eed79"]={["w"]=358,["h"]=349},["1a81d0ff2c984783b621102b1a28f674"]={["w"]=360,["h"]=331},["b5c2e833b78f4e8a8102c56b6cd20cab"]={["w"]=316,["h"]=285},["11d8f064957d4d52a0b5933bc641ce8a"]={["w"]=309,["h"]=289},["09b27be3fdd24b64b6742df5aff3d66c"]={["w"]=340,["h"]=389},["376035668c014e50be79611d3a1cddbe"]={["w"]=339,["h"]=389},["25811aa47c1d405ea0e7dbe7350e13a9"]={["w"]=401,["h"]=367},["5d5fe5f887cd42cd93a034c9295cb36a"]={["w"]=1672,["h"]=941},["3684123625a94c58b2d3219367c3cf8b"]={["w"]=1672,["h"]=941},["67de545f31bf4579810896b1c64cc2dd"]={["w"]=512,["h"]=512},["2da36751d97c409792c10f99949e5ec9"]={["w"]=512,["h"]=512},["4bf66d0405a540b8abaa9cd99b985dc3"]={["w"]=512,["h"]=512},["11860b6d4b4e43e19170cb74c4bb616d"]={["w"]=512,["h"]=512},["b95fd419c9d14ae08322c8c7351b7143"]={["w"]=512,["h"]=512},["a2c4816fb8664b6fbae6c20813500935"]={["w"]=512,["h"]=512}} end
  return self._T.PartSizes[ruid]
 end

 method any GetDefinition(string key)
  -- 기본 테마에는 액션 레이어를 만들지 않는다.
  for _, d in ipairs(self:GetDefinitions()) do if d.key == key then return d end end
  return nil
 end

 method any GetByBackground(string ruid)
  -- 서버·월드·카드가 같은 자산 크기 표를 사용한다.
  if self._T.ByBackground == nil then
   self._T.ByBackground = {}
   for _, d in ipairs(self:GetDefinitions()) do self._T.ByBackground[d.background] = d end
  end
  return self._T.ByBackground[ruid]
 end

 @ExecSpace("ClientOnly")
 method void OnBeginPlay()
  -- 세션별 장식 상태를 초기화한다.
  self.Scenes = {}
  self.Elapsed = 0
  self.ScanClock = 0
  self.DrawClock = 0
 end

 @ExecSpace("ClientOnly")
 method void OnEndPlay()
  -- 카드·관전·맵 종료 시 장식을 정리한다.
  for i = #self.Scenes, 1, -1 do self:RemoveScene(i) end
 end

 @ExecSpace("ClientOnly")
 method void OnUpdate(number delta)
  -- 관전 구역 한 곳과 열린 카드만 30fps로 갱신한다.
  self.Elapsed = self.Elapsed + delta
  self.ScanClock = self.ScanClock + delta
  self.DrawClock = self.DrawClock + delta
  if self.DrawClock < 1 / 30 then return end
  self.DrawClock = 0
  for i = #self.Scenes, 1, -1 do
   local s = self.Scenes[i]
   if not isvalid(s.host) then
    self:RemoveScene(i)
   elseif not s.ui and (s.host.SpriteRendererComponent == nil or s.host.SpriteRendererComponent.SpriteRUID ~= s.def.background or s.zone ~= _RtsHudLogic.WatchedZone) then
    self:RemoveScene(i)
   else
    self:DrawScene(s)
   end
  end
  if self.ScanClock >= 0.25 then
   self.ScanClock = 0
   self:ScanWorld()
  end
 end

 @ExecSpace("ClientOnly")
 method void ScanWorld()
  -- 테마 교체·늦은 입장·관전 전환을 RUID 관찰로 처리한다.
  local zone = _RtsHudLogic.WatchedZone
  if zone < 1 then return end
  local host = _RtsBoardViewLogic:BoardChild("ZoneBackground" .. string.format("%d", zone))
  if not isvalid(host) or host.SpriteRendererComponent == nil then return end
  local d = self:GetByBackground(host.SpriteRendererComponent.SpriteRUID)
  if d == nil then return end
  for _, s in ipairs(self.Scenes) do if s.host == host then return end end
  self:CreateScene(host, false, zone, d.w, d.h, d.key)
 end

 @ExecSpace("ClientOnly")
 method void RegisterCard(Entity photo, string key, number width)
  -- 프로필 카드에 월드와 동일한 고정 배경·부위 모션·환경 효과를 적용한다.
  if not isvalid(photo) then return end
  for i = #self.Scenes, 1, -1 do if self.Scenes[i].host == photo then self:RemoveScene(i) end end
  local d = self:GetDefinition(key)
  if d == nil then return end
  photo.SpriteGUIRendererComponent.ImageRUID = DataRef(d.background)
  local height = width * d.h / d.w
  photo.UITransformComponent.RectSize = Vector2(width, height)
  photo.UITransformComponent.anchoredPosition = Vector2(0, -26)
  self:CreateScene(photo, true, 0, width, height, key)
 end

 @ExecSpace("ClientOnly")
 method void CreateScene(Entity host, boolean ui, number zone, number width, number height, string key)
  local d = self:GetDefinition(key)
  if d == nil or not isvalid(host) then return end
  local s = {host=host, ui=ui, zone=zone, width=width, height=height, def=d, parts={}}
  local rig = self:GetRig(key)
  if rig ~= nil then
   for _, b in ipairs(rig.parts) do
    s.parts[#s.parts+1] = {rig=b, entity=self:SpawnPart(s,b.id,b.ruid,b.order)}
   end
   local fx = self:GetEnvironmentSprites()
   for i=1,8 do
    if rig.fx == "lava" then
     for _,kind in ipairs({"lava-bubble","lava-burst","lava-ripple"}) do
      s.parts[#s.parts+1] = {effect=kind, index=i, entity=self:SpawnPart(s,kind..tostring(i),fx[kind],96)}
     end
    elseif rig.fx == "water" then
     for _,kind in ipairs({"water-trail","water-splash"}) do
      s.parts[#s.parts+1] = {effect=kind, index=i, entity=self:SpawnPart(s,kind..tostring(i),fx[kind],96)}
     end
    end
   end
  end
  for i=1,18 do
   s.parts[#s.parts+1] = {particle=i, entity=self:SpawnPart(s,"Mote"..tostring(i),_RtsHudLogic.CircleMaskRUID,96)}
  end
  self.Scenes[#self.Scenes+1] = s
  self:DrawScene(s)
  _RtsConfigLogic:Log("[VRF] articulated scene "..key.." rig="..tostring(rig~=nil).." parts="..tostring(#s.parts))
 end

 @ExecSpace("ClientOnly")
 method Entity SpawnPart(table scene, string partName, string ruid, number order)
  -- 기존 네이티브 스프라이트 모델을 클라이언트 장식으로 재사용한다.
  local e = nil
  if scene.ui then
   e = _RtsHudLogic:SpawnUI("model://uisprite","RtsAction"..partName,scene.host,Vector2(0.5,0.5),Vector2(0.5,0.5),Vector2.zero,Vector2(1,1))
   if not isvalid(e) then return nil end
   local sr = e.SpriteGUIRendererComponent
   sr.ImageRUID = DataRef(ruid)
   sr.Type = ImageType.Simple
   sr.PreserveSprite = PreserveSpriteType.None
   sr.RaycastTarget = false
  else
   e = _SpawnService:SpawnByModelId("model://MapObject","RtsAction"..partName,Vector3.zero,scene.host)
   if not isvalid(e) then return nil end
   local sr = e.SpriteRendererComponent
   sr.SpriteRUID = ruid
   sr.SortingLayer = "MapLayer0"
   sr.OrderInLayer = order
  end
  return e
 end

 @ExecSpace("ClientOnly")
 method void DrawScene(table s)
  local d=s.def
  -- 배경과 카드의 크기·중심·밝기는 고정. 부위만 관절 중심으로 움직인다.
  if s.ui then
   s.host.UITransformComponent.RectSize=Vector2(s.width,s.height)
   s.host.UITransformComponent.anchoredPosition=Vector2(0,-26)
   s.host.SpriteGUIRendererComponent.Color=Color.white
  else
   _RtsBoardViewLogic:PositionBackground(s.host)
   s.host.SpriteRendererComponent.Color=Color.white
  end
  for _,p in ipairs(s.parts) do
   if not isvalid(p.entity) then continue end
   local x,y,w,h,angle,alpha=0,0,1,1,0,1
   local color=Color.white
   if p.rig~=nil then
    local b=p.rig
    local phase=self.Elapsed*math.pi*2/b.period+b.phase
    local wave=math.sin(phase)
    angle=b.angle+b.amp*wave+(b.spin or 0)*self.Elapsed
    local rad=angle*math.pi/180
    local kx=b.k*(1+(b.sx or 0)*wave)
    local ky=b.k*(1+(b.sy or 0)*wave)
    local ox=(b.w/2-b.px)*kx
    local oy=(b.py-b.h/2)*ky
    -- 신체에 붙은 부위는 같은 부유/헤엄 주기를 공유하고 관절은 따로 움직인다.
    local groupPhase=self.Elapsed*math.pi*2/(b.gperiod or 4)+(b.gphase or 0)
    local orbitPhase=self.Elapsed*math.pi*2/(b.orbitPeriod or 1)+(b.orbitPhase or 0)
    x=b.x+ox*math.cos(rad)-oy*math.sin(rad)+(b.dx or 0)*math.cos(phase)+(b.gdx or 0)*math.cos(groupPhase)+(b.orbitX or 0)*math.cos(orbitPhase)
    y=b.y-ox*math.sin(rad)-oy*math.cos(rad)-b.dy*wave-(b.gdy or 0)*math.sin(groupPhase)+(b.orbitY or 0)*math.sin(orbitPhase)
    w=b.w*kx h=b.h*ky
    alpha=math.max(0,math.min(1,(b.alpha or 1)+(b.alphaAmp or 0)*wave))
    color=Color(1,1,1,alpha)
   elseif p.effect~=nil then
    local i=p.index
    local q=(self.Elapsed/(3.1+(i%3)*0.35)+i*0.317)%1
    if string.sub(p.effect,1,4)=="lava" then
     local base=d.h*(0.875+(i%3)*0.018)
     x=d.w*(0.16+(i-1)*0.095)
     if p.effect=="lava-bubble" then
      local v=math.min(1,q/0.58)
      w=35+45*v h=w*0.75 y=base-h*0.10
      if q>=0.58 then alpha=0 else alpha=math.min(1,q/0.08)*0.9 end
     elseif p.effect=="lava-burst" then
      local v=(q-0.58)/0.24
      w=85+25*math.max(0,v) h=w*0.75 y=base-8
      if v<0 or v>1 then alpha=0 else alpha=0.9*math.sin(v*math.pi) end
     else
      local v=(q-0.55)/0.45
      w=70+100*math.max(0,v) h=w*0.55 y=base+8
      if v<0 then alpha=0 else alpha=0.65*(1-v) end
     end
    else
     local lane=i%4
     local start=0.03+lane*0.035
     local bottom=0.845+(i%2)*0.01
     local side=i<=4 and 0.10 or 0.74
     x=d.w*(side+lane*0.045)
     local v=(self.Elapsed/(2.3+(i%3)*0.2)+i*0.271)%1
     if p.effect=="water-trail" then
      y=d.h*(start+(bottom-start)*math.min(1,v/0.86))
      w=28 h=94
      if v>0.86 then alpha=0 else alpha=math.min(1,v/0.08)*0.75 end
     else
      local hit=(v-0.86)/0.14
      y=d.h*bottom w=35+40*math.max(0,hit) h=w*0.7
      if hit<0 then alpha=0 else alpha=0.8*math.sin(hit*math.pi) end
     end
    end
    color=Color(1,1,1,math.max(0,alpha))
   else
    local i=p.particle
    local phase=(self.Elapsed/(7+i%5)+i*0.618034)%1
    x=d.w*(0.08+((i*0.381966)%1)*0.84)+12*math.sin(self.Elapsed*0.7+i)
    y=d.h*(0.88-phase*0.75)
    w=2+i%4 h=w
    color=Color(d.color[1],d.color[2],d.color[3],0.38*math.sin(phase*math.pi)^2)
   end
   self:SetPartPose(s,p.entity,x,y,w,h,angle,color)
  end
 end

 @ExecSpace("ClientOnly")
 method void SetPartPose(table s, Entity e, number x, number y, number w, number h, number angle, Color tint)
  local d=s.def
  if s.ui then
   local t=e.UITransformComponent
   t.anchoredPosition=Vector2((x-d.w/2)/d.w*s.width,(d.h/2-y)/d.h*s.height)
   t.RectSize=Vector2(w/d.w*s.width,h/d.h*s.height)
   t.UIRotation=Vector3(0,0,angle)
   e.SpriteGUIRendererComponent.Color=tint
  else
   local t=e.TransformComponent
   t.Position=Vector3((x-d.w/2)/100,(d.h/2-y)/100,0)
   -- 슬롯의 원본 크기는 등록 시 보관. 새 이미지의 피벗은 중앙이다.
   local sourceW,sourceH=128,128
   local ruid=e.SpriteRendererComponent.SpriteRUID
   local size=self:GetPartSize(ruid)
   if size~=nil then sourceW=size.w sourceH=size.h end
   t.Scale=Vector3(w/sourceW,h/sourceH,1)
   t.ZRotation=angle
   e.SpriteRendererComponent.Color=tint
  end
 end

 @ExecSpace("ClientOnly")
 method void RemoveScene(number index)
  -- 교체할 때 장식과 참조를 함께 해제한다.
  local s=self.Scenes[index]
  if s==nil then return end
  table.remove(self.Scenes,index)
  for _,p in ipairs(s.parts) do if isvalid(p.entity) then p.entity:Destroy() end end
 end

