-- 유닛 간 파티 버프 — 타일 오른쪽 위 +개수 + 상세정보의 적용 중인 버프.
--   버프는 동기화된 RtsUnitComponent 값(직업·레벨·칸·BondNo)만으로 클라가 계산한다(서버 상태 없음).
--   정의 = .info/character.md의 "모든 유닛 / 주변 n타일 / 유닛 1개 지정" 스킬. 시전자 자신도 포함(홀리 유니티 제외) —
--   그래서 RtsJobTableLogic.GetStatRaw에는 파티 버프를 넣지 않는다(이중 적용 방지).
--   합산 규칙(damage.md): 최종 데미지는 서로 곱, 크리 확률·크리 데미지는 각각 합. 같은 버프(id)는 출처가 여럿이어도 1개만.
@Logic
script RtsUnitBuffLogic extends Logic

	-- 타일 안쪽 오른쪽 위에 고정하는 버프 개수. 캐릭터 프레임/방향과 무관하다.
	property number BadgeInset = 0.08

	-- 구역별 갱신 예약(동기화가 프로퍼티마다 오므로 0.2초 모아서 한 번에)
	property table Dirty = {}

	property number FlushId = 0

	-- ===== 정의 =====

	-- id 같으면 중복 적용 안 함. scope: all(구역 전체, 자신 포함) / target(BondNo 지정 유닛) / near(주변 range칸, 대각선 포함, 자신 제외 — 지금은 안 씀; 프레이는 2026-09-19부터 all)
	--   fin 최종 데미지 +% / crit 크리 확률 +% / critDmg 크리 데미지 +%. 아이콘은 메이플 원작 스킬 아이콘 RUID
	method table GetDefs()
		return {
			-- 홀리 유니티 = 프리즘 스킬(2026-09-20: 40레벨 패시브 +20% 삭제, 지정 유닛 최종 +100% → 2026-09-22 +40%). prism = 이 프리즘을 가진 유닛만 출처(RtsUnitComponent.Prisms)
			{ id = "bond", name = "홀리 유니티", job = "paladin", lv = 1, prism = "holyunity", scope = "target", icon = "53a38855164a4b64accf68785761c283", fin = 40 },
			{ id = "sharpeyes", name = "샤프아이즈", job = "bow", lv = 40, scope = "all", icon = "4cd1961bc55b47cb80e1a7f8843e225e", crit = 20, critDmg = 20 },
			{ id = "sharpeyes", name = "샤프아이즈", job = "marks", lv = 20, scope = "all", icon = "4cd1961bc55b47cb80e1a7f8843e225e", crit = 20, critDmg = 20 },
			{ id = "pray", name = "프레이", job = "bishop", lv = 30, scope = "all", icon = "39b3159efcc74334b875c94c64a74243", fin = 10 }, -- 2026-09-19: 주변 1타일·자신 미적용 → 구역 전체(자신 포함)·+10%
			{ id = "joker", name = "조커: 날카로운 검", job = "phantom", lv = 10, scope = "all", icon = "f1575f7842c740a49f9e19c2514de64e", fin = 5 }, -- 2026-09-24 사용자 "조커 최종 5% — 커트라인 낮추게"(2026-09-19 3차 5 → 3에서 되돌림)
		}
	end

	-- 효과 글자: "최종 데미지 +20%" / "크리티컬 확률 +20% · 크리티컬 데미지 +20%"
	method string EffectText(table def)
		local parts = {}
		local I = _RtsHudLogic
		if def.fin ~= nil then parts[#parts + 1] = "최종 데미지 +" .. I:Int(def.fin) .. "%" end
		if def.crit ~= nil then parts[#parts + 1] = "크리티컬 확률 +" .. I:Int(def.crit) .. "%" end
		if def.critDmg ~= nil then parts[#parts + 1] = "크리티컬 데미지 +" .. I:Int(def.critDmg) .. "%" end
		return table.concat(parts, " · ")
	end

	-- 범위 글자: "모든 유닛" / "지정 유닛 1개" / "주변 1타일"
	method string ScopeText(table def)
		if def.scope == "target" then return "지정 유닛 1개" end
		if def.scope == "near" then return "주변 " .. _RtsHudLogic:Int(def.range) .. "타일" end
		return "모든 유닛"
	end

	-- ===== 계산 =====

	-- 구역 zone의 유닛 no의 상태 컴포넌트 — 서버·클라 어디서든(엔티티 경로 조회). 2026-09-19: 전투(서버)도 버프를 써야 해서 ClientOnly인 RtsUnitLogic.GetZoneUnit 대신
	method any UnitAt(number zone, number no)
		if zone < 1 then return nil end
		local e = _EntityService:GetEntityByPath("/maps/RtsMap/" .. _RtsUnitLogic:UnitName(zone, no))
		if e == nil or not isvalid(e) then return nil end
		return e.RtsUnitComponent
	end

	-- 구역 zone의 유닛 no에 걸린 버프 목록: { def, srcNo, srcJob, srcLevel }. 출처 유닛 번호 순, id 중복 제거(출처는 화면에 안 씀)
	--   서버(RtsCombatLogic.DoAttack — 실제 크리·최종 데미지)와 클라(팝업·타일 버프 개수) 둘 다 부른다
	method table GetBuffsFor(number zone, number no)
		local out = {}
		local seen = {}
		local me = self:UnitAt(zone, no)
		if me == nil then return out end
		local defs = self:GetDefs()
		-- 2026-09-20: 1~6 고정 순회 → 구역의 실제 유닛(7·8번 불독·비숍이 출처·대상에서 빠져 있었다)
		local nos = _RtsUnitLogic:ListZoneUnits(zone)
		for i0 = 1, #nos do
			local srcNo = nos[i0]
			local src = self:UnitAt(zone, srcNo)
			if src ~= nil then
				for i = 1, #defs do
					local d = defs[i]
					if d.job == src.JobId and src.Level >= d.lv and seen[d.id] == nil and (d.prism == nil or _RtsJobTableLogic:HasPrism(src, d.prism)) and self:InScope(d, src, me) then
						seen[d.id] = true
						out[#out + 1] = { def = d, srcNo = srcNo, srcJob = src.JobId, srcLevel = src.Level }
					end
				end
			end
		end
		return out
	end

	-- 팝업 갱신 서명용: 버프 id와 수치
	method string BuffSig(number zone, number no)
		local buffs = self:GetBuffsFor(zone, no)
		local parts = {}
		for i = 1, #buffs do parts[#parts + 1] = buffs[i].def.id .. ":" .. tostring(buffs[i].def.fin or 0) end
		return table.concat(parts, ",")
	end

	method boolean InScope(table def, any src, any me)
		if def.scope == "target" then return src.BondNo == me.No end
		if def.scope == "near" then
			if src.No == me.No then return false end
			return _RtsZoneLogic:CellDistance(src.Col, src.Row, me.Col, me.Row) <= def.range
		end
		return true
	end

	-- 능력치 표(RtsJobTableLogic.GetStat 결과)에 버프 반영. 최종 데미지는 곱, 크리는 합(확률만 상한 100, 크리 데미지는 상한 없음)
	method void ApplyToStat(table st, table buffs)
		for i = 1, #buffs do
			local d = buffs[i].def
			if d.fin ~= nil then
				st.fin = st.fin * (100 + d.fin) / 100
				st.finBoss = st.finBoss * (100 + d.fin) / 100
			end
			if d.crit ~= nil then st.crit = st.crit + d.crit end
			if d.critDmg ~= nil then st.critDmg = st.critDmg + d.critDmg end
		end
		if st.crit > 100 then st.crit = 100 end
	end

	-- 이 유닛에 지정된 증강 목록 { g 등급(bronze/silver/gold/prism), t 이름, d 효과 } — RtsAugmentLogic 보유 목록 중 이 유닛에 지정된 것(2026-09-23)
	@ExecSpace("ClientOnly")
	method table GetAugmentsFor(number zone, number no)
		local u = self:UnitAt(zone, no)
		if u == nil then return {} end
		return _RtsAugmentLogic:ListForUnit(u.Owner, no)
	end

	-- ===== 타일 오른쪽 위 버프 개수 =====

	-- RtsUnitComponent 동기화마다 호출 — 구역 단위로 모아서 곧 다시 그린다
	@ExecSpace("ClientOnly")
	method void MarkDirty(number zone)
		if zone < 1 then return end
		self.Dirty[zone] = true
		if self.FlushId ~= 0 then return end
		self.FlushId = _TimerService:SetTimerOnce(function()
			self:Flush()
		end, 0.2)
	end

	@ExecSpace("ClientOnly")
	method void Flush()
		self.FlushId = 0
		local zones = self.Dirty
		self.Dirty = {}
		for zone, _ in pairs(zones) do
			self:RefreshZone(zone)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshZone(number zone)
		local nos = _RtsUnitLogic:ListZoneUnits(zone)
		for i = 1, #nos do
			local u = _RtsUnitLogic:GetZoneUnit(zone, nos[i])
			if u ~= nil then self:RefreshUnitBadge(u) end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshUnitBadge(any u)
		-- 중복 제거된 실제 버프 개수를 제자리 갱신한다. 0개일 때는 표시하지 않는다.
		local e = u.Entity
		if not isvalid(e) then return end
		local buffs = self:GetBuffsFor(u.Zone, u.No)
		local n = #buffs
		local badge = e:GetChildByName("RtsBuffCount")
		if n == 0 then
			if isvalid(badge) then badge:SetEnable(false) end
			return
		end
		if not isvalid(badge) then
			badge = _SpawnService:SpawnByModelId("model://MapObject", "RtsBuffCount", Vector3.zero, e)
			if not isvalid(badge) then return end
			if badge.SpriteRendererComponent ~= nil then badge.SpriteRendererComponent.Enable = false end
			local text = badge:AddComponent("TextRendererComponent")
			text.IsRichText = false
			text.FontSize = 2.8
			text.FontStyle = FontStyleType.Bold
			text.FontColor = Color(0.85, 1, 0.68, 1)
			text.OutlineColor = Color(0.12, 0.22, 0.12, 1)
			text.OutlineWidth = 0.2
			text.HorizontalAlignment = TextHorizontalAlignmentOption.Right
			text.VerticalAlignment = TextVerticalAlignmentOption.Top
			text.RectSize = Vector2(1.2, 0.4)
			text.RectOffset = Vector2.zero
			text.Wrapping = false
			text.SortingLayer = "Default"
			text.OrderInLayer = 210
		end
		badge:SetEnable(true)
		local label = "+" .. _RtsHudLogic:Int(n)
		if badge.TextRendererComponent.Text ~= label then badge.TextRendererComponent.Text = label end
		local cell = _RtsConfigLogic:GetGridCell()
		local center = _RtsZoneLogic:GetCellCenter(u.Zone, u.Col, u.Row)
		local pos = e.TransformComponent.WorldPosition
		local scale = e.TransformComponent.Scale
		local dx = center.x + cell / 2 - self.BadgeInset - 0.6 - pos.x
		local dy = center.y + cell / 2 - self.BadgeInset - 0.2 - pos.y
		badge.TransformComponent.Position = Vector3(dx / scale.x, dy / scale.y, 0)
		badge.TransformComponent.Scale = Vector3(1 / scale.x, 1 / scale.y, 1)
	end

end
