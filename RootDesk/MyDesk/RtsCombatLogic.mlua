-- Phase 3 #15·#16 (2026-09-17) → Phase 6·7 (2026-09-23): 유닛 자동 공격 + 데미지 계산 + 피격 연출.
--   공격 루프는 **모든 유닛이 각자** 돈다(RtsUnitLogic.SpawnUnit → StartLoop) — 사거리 안에 적이 있는 유닛만 공격하고, 메인 대상은 죽거나 사거리를 벗어나기 전까지 고정(Focus). 규칙 원문 = .info/attack.md.
--   대상 = 구역의 살아 있는 몬스터(RtsWaveLogic 웨이브 몹·RtsBossLogic 보스, 죽음·보관 제외). 보스 스테이지에선 모든 유닛·스킬 사거리 BossRange(16칸 — 그리드 어디서든 보스에 닿게, 2026-09-23. 보스 영역은 2026-09-25 가운데 2×2) — 보관된 일반 몹은 대상이 아니라 보스만 맞는다.
--   데미지 = damage.md 8단계(RtsJobTableLogic.GetStatFor/CalcStat: ① 공격력 ② 공격력% ③ 보스 공격시 데미지(보스 상대만, bossMul) ⑤ 스킬 비율 → 1회 타격, ⑥ 최종, ⑦ 무기 난수, ④ 크리 확률로 굴림)
--   + ⑧ 방어(DefenseMul: 남은 방어율 = 대상 방어율 − 방무, 0 미만 0 → × (1 − 남은 방어율). 보스 50%, 검은 마법사 4페이즈 100% — 데미지가 0이면 타격·숫자 없음).
--   파티 버프(RtsUnitBuffLogic.ApplyToStat)와 프리즘(RtsUnitComponent.Prisms → GetSkillsFor/GetStatFor)은 서버 계산에 반영.
@Logic
script RtsCombatLogic extends Logic

	-- 보스 스테이지 사거리(칸) — 지대·구체(999)는 그대로
	property number BossRange = 16

	-- 공격 반복 타이머: key = userId .. "_" .. no
	property table Loops = {}

	-- 그 루프의 주기(초) — 같으면 StartLoop가 다시 걸지 않는다
	property table Periods = {}

	-- 가드 크러쉬 캐시: 구역 → { at = ServerElapsedSeconds, v = 방어율 감소 %p } (타격마다 유닛을 훑지 않게 0.5초 유지)
	property table GuardCache = {}

	-- 테스트 모드 추가 데미지(2026-09-24 사용자 "테스트 모드로 시작할 때 추가 데미지 100만"): RtsUnitLogic.DevTools가 켜져 있으면 타격마다 이만큼 더한다(방어·난수 뒤)
	property number DevExtraDamage = 1000000

	-- 방어구 부수기 캐시(구역별 0.5초 — GuardCache와 같은 방식)
	property table ArmorCache = {}

	-- 유닛 엔티티는 칸 가운데보다 0.75 아래(발이 발판에 닿게 — RtsUnitLogic.SpawnUnit·RtsUnitComponent 이동)에 서 있다. 사거리는 칸 가운데 기준이라 이만큼 올려 잰다
	--   (2026-09-23 사용자 "위쪽 타일에 오면 안 때리고 아래쪽에 와야 때린다" — 전엔 발 기준이라 위 칸은 1.3칸, 아래 칸은 0.7칸으로 쟀다)
	property number UnitFootDy = 0.75

	-- 사거리 여유(칸): 칸 가운데 기준 range칸 + 이만큼. 0.5 = 그 칸의 경계까지(2026-09-24 사용자 "우측 상단 대각선 공격 잘 못함" —
	--   전 0.25라 눈으로는 대각선 칸 안인데 칸 바깥쪽 절반에 있는 몹은 사거리 밖이었다. 멀어지는 몹은 그 구간을 금방 지나가 거의 안 맞았다)
	property number RangeSlack = 0.5

	-- 쿨타임 스킬 준비 시각: key = userId .. "_" .. no .. "_" .. idx → 게임 시계(RtsStageLogic.GameNow — 일시정지 시간 제외)
	property table ReadyAt = {}

	-- 후딜(큰 스킬 뒤 다음 공격까지 쉬는 시각): key = userId .. "_" .. no → 게임 시계(GameNow). 사용자 2026-09-18 "생츄어리·블리자드·제네시스·드래곤 로어 후딜 1.5초"
	property table BusyUntil = {}

	-- 방향 고정(2026-09-23 사용자 "공격이 끝나기 전에 고개 돌리지 않게"): key = userId .. "_" .. no → 이 시각까지 몸 동작 중이라 FaceTo 안 함(MotionSec)
	property table FaceLockUntil = {}

	-- 메인 대상 고정(2026-09-20 사용자 "그 대상이 죽거나 거리 밖으로 나가기 전까진 쭉 때린다"): key = userId .. "_" .. no → 몬스터 엔티티. 죽거나(엔티티 소멸·HP 0) 스킬 사거리 밖이면 가장 가까운 적으로 갈아탄다
	property table Focus = {}

	-- 데미지 스킨 = 메이플스토리 기본 데미지 스킨 (유닛) — effect/damageskin/208 (기본 스킨과 같은 주황·빨강 숫자 + 만/억 글리프, 엔진이 10000000 → 1000만으로 포맷).
	--   유닛 없는 기본 스킨은 3271c3e79bf04ecba9a107d55495970d(effect/damageskin/0). MSW 기본값 6ba67548…(픽셀 숫자)은 사용자 2026-09-18 "너무 인위적" → 교체.
	--   배율은 줌 30% 화면에서 읽히는 크기(원작 숫자가 커서 2.4 → 2.0)
	property string DamageSkinId = "7e39645af9454fffb17a5451e9194dda"

	property number DamageSkinScale = 2.0

	-- 구역 zone의 공격할 수 있는 몬스터 전부(대상 고르기·구역 전체 지속 피해). 죽음(사망 연출 중)·보관(보스 스테이지의 일반 몹)은 뺀다
	@ExecSpace("ServerOnly")
	method table GetZoneMonsters(number zone)
		local out = {}
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		if mapRoot == nil then return out end
		local comps = mapRoot:GetChildComponentsByTypeName("RtsMonsterComponent", false)
		for i = 1, #comps do
			local m = comps[i]
			if m ~= nil and m.Entity ~= nil and isvalid(m.Entity) and math.floor(m.Zone + 0.5) == math.floor(zone + 0.5) and self:IsTargetable(m.Entity) then
				out[#out + 1] = m.Entity
			end
		end
		return out
	end

	-- 겨냥점 = 피격 박스 가운데(세계). 공격 판정 상자·사거리·범위 거리 계산 공용 — 3배 크기 보스는 발밑 + 0.3이 박스 밖이라 빗나간다(2026-09-23)
	@ExecSpace("ServerOnly")
	method Vector2 AimPoint(Entity t)
		local p = t.TransformComponent.WorldPosition
		local hit = t.HitComponent
		if hit == nil then return Vector2(p.x, p.y + 0.3) end
		local sc = t.TransformComponent.Scale
		return Vector2(p.x + hit.ColliderOffset.x * math.abs(sc.x), p.y + hit.ColliderOffset.y * sc.y)
	end

	-- (x, y)에서 반지름 r 안의 가장 가까운(피격 박스 가운데 기준) 공격 가능한 몬스터, 없으면 nil — 도트 퍼니셔 구체가 도착했을 때 대상이 이미 죽었으면 그 자리에서 다음 적으로(재조준)
	@ExecSpace("ServerOnly")
	method any NearestTargetableAt(number zone, number x, number y, number r)
		local list = self:GetZoneMonsters(zone)
		local best = nil
		local bestD = r * r
		for j = 1, #list do
			local a = self:AimPoint(list[j])
			local d = (a.x - x) * (a.x - x) + (a.y - y) * (a.y - y)
			if d <= bestD then
				bestD = d
				best = list[j]
			end
		end
		return best
	end

	-- 사거리·범위 거리 기준점: 일반 몹은 발(트랙 위, 기존 규칙 그대로), 보스는 몸 가운데(보스는 몸 가운데가 트랙 위 — RtsTrackWalkerComponent.YOffset)
	@ExecSpace("ServerOnly")
	method Vector2 RangePoint(Entity t)
		local m = t.RtsMonsterComponent
		if m ~= nil and m.IsBoss then return self:AimPoint(t) end
		local p = t.TransformComponent.WorldPosition
		return Vector2(p.x, p.y)
	end

	-- 판정 순간 대상 확정(2026-09-23 사용자 "공격이 한 번씩 삑난다 — 판정이 나면 적중하도록"): 대상이 살아 있으면 그대로,
	--   이미 죽었거나 보관됐으면(다른 유닛·앞 타격이 먼저 잡음) 유닛 사거리(range칸, +0.25) 안에서 원래 대상 자리와 가장 가까운 적. avoid(이름 집합 — 같은 타격의 다른 대상)는 다른 후보가 없을 때만. 없으면 nil
	@ExecSpace("ServerOnly")
	method any ResolveTarget(any t, Entity unitEntity, number zone, number range, table avoid)
		if t ~= nil and self:IsTargetable(t) then return t end
		if unitEntity == nil or not isvalid(unitEntity) then return nil end
		local up = unitEntity.TransformComponent.WorldPosition
		local ux = up.x
		local uy = up.y + self.UnitFootDy
		local ox = ux
		local oy = uy
		if t ~= nil and isvalid(t) then
			local p0 = self:RangePoint(t)
			ox = p0.x
			oy = p0.y
		end
		local cell = _RtsConfigLogic:GetGridCell()
		local list = self:GetZoneMonsters(zone)
		local best = nil
		local bestD = 1e18
		local alt = nil
		local altD = 1e18
		for i = 1, #list do
			local m = list[i]
			local p = self:RangePoint(m)
			local dc = math.abs(p.x - ux) / cell
			local dr = math.abs(p.y - uy) / cell
			if math.max(dc, dr) <= range + self.RangeSlack then
				local d = (p.x - ox) * (p.x - ox) + (p.y - oy) * (p.y - oy)
				if avoid ~= nil and avoid[m.Name] then
					if d < altD then
						altD = d
						alt = m
					end
				elseif d < bestD then
					bestD = d
					best = m
				end
			end
		end
		if best ~= nil then return best end
		return alt
	end

	-- 판정 상자 한 번: 0.6 상자가 빗나가면(충돌체가 한 프레임 늦게 따라온 빠른 몹) 큰 상자로 한 번 더. IsAttackTarget이 TargetName만 통과시켜 다른 몹은 안 맞는다
	@ExecSpace("ServerOnly")
	method void HitOnce(any atk, Entity t, string info)
		local aim = self:AimPoint(t)
		local got = atk:AttackFrom(Vector2(0.6, 0.6), aim, info, CollisionGroups.HitBox)
		if got == nil or #got == 0 then atk:AttackFrom(Vector2(3, 3), aim, info, CollisionGroups.HitBox) end
	end

	-- 지금 맞힐 수 있는 몬스터인가(판정 지연 중 죽거나 보관된 대상 거르기에도 쓴다)
	@ExecSpace("ServerOnly")
	method boolean IsTargetable(Entity t)
		if t == nil or not isvalid(t) then return false end
		local m = t.RtsMonsterComponent
		if m == nil then return false end
		return not m.Dead and not m.Stashed and m.Hp > 0
	end

	-- ⑧ 방어(damage.md, 2026-09-24 합연산 — 곱연산에서 되돌림): 데미지 × (1 − max(0, 방어율 − 가드 크러쉬 − 방어 깎기 − 방무) ÷ 100).
	--   방무 = st.ign(직업 킷·프리즘 합 — 2026-09-24 증강 방무 삭제), 보스 상대면 + st.ignBoss(발할라), 지속 피해 지대(dot)는 st.dotIgn(포이즌 리전 100).
	--   일반 몬스터는 방어율 0(2026-09-24 사용자 "방무는 이제 보스 옵션") → 1. 단 아케인리버(65라운드~) 일반 몬스터는 50(2026-09-26 — 표 def, tools/gen-stage-table.py ARCANE_MOB_DEF)
	--   가드 크러쉬(팔라딘 패시브, 2026-09-23 사용자 "사거리 제한 제거"): 같은 구역에 팔라딘이 있으면 그 구역 모든 몬스터 방어율 −10%p(10레벨)·−20%p(40레벨)
	--   2026-09-24: 방어율 감소 디버프(썬콜 블리자드 템페스트 — 방어율 −ShredPct%p, 가드 크러쉬와 같이 뺀다)와
	--   받는 데미지 증가 디버프(비숍 디바인 퍼니시먼트 — 결과에 × (1 + VulnPct%), 일반 몬스터에도)를 여기서 함께 곱한다 — 돌려주는 값 = 방어 × 받는 데미지 배율
	@ExecSpace("ServerOnly")
	method number DefenseMul(table st, Entity t, boolean isDot)
		local m = t.RtsMonsterComponent
		if m == nil then return 1 end
		local vuln = 1 + m:VulnNow() / 100
		if m.Defense <= 0 then return vuln end
		-- 2026-09-24 사용자 "합연산 + 증강 방무 삭제"(곱연산에서 되돌림): 남은 방어율 = 방어율 − 가드 크러쉬 − 방어 깎기(템페스트 ShredPct%p) − 방무(보스면 + 발할라 ignBoss)
		--   → 데미지 × (1 − 남은 방어율 ÷ 100), 0 미만 0. 지속 피해 지대는 st.dotIgn(포이즌 리전 100)
		local ign = st.ign or 0
		if isDot then
			ign = st.dotIgn or 0
		elseif m.IsBoss and st.ignBoss ~= nil and st.ignBoss > 0 then
			ign = ign + st.ignBoss
		end
		local remain = m.Defense - self:GuardCrush(m.Zone) - self:ArmorBreak(m.Zone) - m:ShredNow() - ign
		if remain < 0 then remain = 0 end
		local mul = 1 - remain / 100
		if mul < 0 then mul = 0 end
		return mul * vuln
	end

	-- 구역 zone의 방어구 부수기(%p, 2026-09-24): 그 구역 주인의 1티어 유닛 중 가장 큰 값(RtsJobTableLogic.ArmorBreakFor — 증강 개수 × 1, 최대 30)
	-- 테스트 모드면 타격마다 더할 데미지(DevExtraDamage), 아니면 0
	@ExecSpace("ServerOnly")
	method number DevExtra()
		if _RtsUnitLogic.DevTools then return self.DevExtraDamage end
		return 0
	end

	@ExecSpace("ServerOnly")
	method number ArmorBreak(number zone)
		local z = math.floor(zone + 0.5)
		local now = _UtilLogic.ServerElapsedSeconds
		local c = self.ArmorCache[z]
		if c ~= nil and now - c.at < 0.5 then return c.v end
		local v = 0
		local owner = _RtsRunResultLogic:OwnerOfZone(z)
		local list = _RtsUnitLogic.UnitsByUser[owner]
		if list ~= nil then
			for no, e in pairs(list) do
				if e ~= nil and isvalid(e) and e.RtsUnitComponent ~= nil then
					local a = _RtsJobTableLogic:ArmorBreakFor(e.RtsUnitComponent)
					if a > v then v = a end
				end
			end
		end
		self.ArmorCache[z] = { at = now, v = v }
		return v
	end

	-- 구역 zone의 가드 크러쉬 방어율 감소(%p): 그 구역 주인의 팔라딘 중 가장 높은 레벨 기준 — 40레벨 20, 10레벨 10, 없으면 0
	@ExecSpace("ServerOnly")
	method number GuardCrush(number zone)
		local z = math.floor(zone + 0.5)
		local now = _UtilLogic.ServerElapsedSeconds
		local c = self.GuardCache[z]
		if c ~= nil and now - c.at < 0.5 then return c.v end
		local v = 0
		local owner = _RtsRunResultLogic:OwnerOfZone(z)
		local list = _RtsUnitLogic.UnitsByUser[owner]
		if list ~= nil then
			for no, e in pairs(list) do
				if e ~= nil and isvalid(e) and e.RtsUnitComponent ~= nil and e.RtsUnitComponent.JobId == "paladin" then
					local L = e.RtsUnitComponent.Level
					if L >= 40 and v < 20 then v = 20 elseif L >= 10 and v < 10 then v = 10 end
				end
			end
		end
		self.GuardCache[z] = { at = now, v = v }
		return v
	end

	-- 유닛 no가 공격 주기마다 공격을 반복. 대상·능력치는 매번 DoAttack이 새로 읽으므로 루프는 주기가 바뀔 때만 다시 건다
	--   (2026-09-23 사용자 "레벨업할 때 캐릭터가 멈춤" — 레벨업마다 루프를 새로 걸어 첫 공격이 1초씩 밀렸다. 스페이스 연타면 계속 못 침)
	--   처음 거는 루프만 1초 뒤 첫 공격, 주기가 바뀌어 다시 걸 때는 곧바로 이어서
	@ExecSpace("ServerOnly")
	method void StartLoop(string userId, number no)
		local key = userId .. "_" .. string.format("%d", no)
		local e = _RtsUnitLogic:GetUnit(userId, no)
		if e == nil then
			self:StopLoop(userId, no)
			return
		end
		local u = e.RtsUnitComponent
		local st = _RtsJobTableLogic:GetStatFor(u)
		local period = _RtsJobTableLogic:GetPeriod(st)
		local firstDelay = 1.0
		if self.Loops[key] ~= nil then
			if self.Periods[key] == period then return end
			_TimerService:ClearTimer(self.Loops[key])
			self.Loops[key] = nil
			firstDelay = 0.05
		end
		self.Periods[key] = period
		self.Loops[key] = _TimerService:SetTimerRepeat(function()
			self:DoAttack(userId, no)
		end, period, firstDelay)
	end

	@ExecSpace("ServerOnly")
	method void StopLoop(string userId, number no)
		local key = userId .. "_" .. string.format("%d", no)
		if self.Loops[key] ~= nil then
			_TimerService:ClearTimer(self.Loops[key])
			self.Loops[key] = nil
		end
		self.Periods[key] = nil
	end

	-- 사거리 range칸 안의 구역 몬스터를 가까운 순으로 최대 n마리(character.md 헤더: 패드 기준 주변 n칸·대각선 포함 = 체비셰프 칸 거리, 살짝 걸쳐도 안 → +0.25칸 여유)
	@ExecSpace("ServerOnly")
	--   aoe(칸)가 있으면(2026-09-19 사용자 "메인 대상 가까운 기준 범위 1 이내로, 체인 라이트닝은 3"): 메인 대상 = 사거리 안 가장 가까운 적 1마리,
	--   나머지 = 메인 대상에서 aoe칸(+0.25) 안의 적을 가까운 것부터 이어 가는 순서(직전 대상에서 가장 가까운 미타격 적 — 빔·타격 순서가 한 줄로 이어짐). 유닛 사거리 밖이어도 메인 대상 곁이면 맞는다.
	--   aoe가 nil이면 예전 규칙(유닛 중심 사거리 안 가까운 순 n마리) — 지금은 지대(dot) 외엔 항상 aoe를 준다.
	--   randomPick(전체 광역기 k.area — 제네시스·생츄어리·블리자드·드래곤 로어, 2026-09-19 사용자 "메인 타겟 없음, 사거리 안 모든 적 중 n마리를 우선순위 없이 랜덤으로"): aoe 없이 사거리 안 후보를 섞어 n마리
	--   focus(엔티티)가 있고 살아 있으며 사거리 안이면 메인 대상으로 고정(가장 가까운 적보다 우선 — attack.md '메인 대상 고정'). 전체 광역·지대·구체엔 안 쓴다
	method table PickTargets(Entity unitEntity, number zone, number range, number n, any aoe, any randomPick, any focus)
		local out = {}
		if n <= 0 then return out end
		local up = unitEntity.TransformComponent.WorldPosition
		up = Vector3(up.x, up.y + self.UnitFootDy, 0)
		local cell = _RtsConfigLogic:GetGridCell()
		local list = self:GetZoneMonsters(zone)
		local cands = {}
		for i = 1, #list do
			local m = list[i]
			local p = self:RangePoint(m)
			local dc = math.abs(p.x - up.x) / cell
			local dr = math.abs(p.y - up.y) / cell
			if math.max(dc, dr) <= range + self.RangeSlack then cands[#cands + 1] = { e = m, d = dc * dc + dr * dr } end
		end
		table.sort(cands, function(a, b) return a.d < b.d end)
		-- 고정 대상이 후보 안에 있으면 맨 앞으로(메인 대상 유지)
		if focus ~= nil and isvalid(focus) then
			for i = 2, #cands do
				if cands[i].e == focus then
					local f = table.remove(cands, i)
					table.insert(cands, 1, f)
					break
				end
			end
		end
		if aoe == nil then
			if randomPick == true and #cands > 1 then
				-- 피셔-예이츠 섞기
				for i = #cands, 2, -1 do
					local j = _UtilLogic:RandomIntegerRange(1, i)
					cands[i], cands[j] = cands[j], cands[i]
				end
			end
			for i = 1, math.min(n, #cands) do out[#out + 1] = cands[i].e end
			return out
		end
		if #cands == 0 then return out end
		local main = cands[1].e
		out[1] = main
		local mp = self:RangePoint(main)
		-- 메인 대상 aoe칸 안의 후보(메인 제외, 유닛 사거리 무관)
		local near = {}
		for i = 1, #list do
			local m = list[i]
			if m ~= main then
				local p = self:RangePoint(m)
				local dc = math.abs(p.x - mp.x) / cell
				local dr = math.abs(p.y - mp.y) / cell
				if math.max(dc, dr) <= aoe + 0.25 then near[#near + 1] = m end
			end
		end
		-- 직전 대상에서 가장 가까운 것부터 이어 붙인다
		local last = main
		while #out < n and #near > 0 do
			local lp = self:RangePoint(last)
			local bi = 1
			local bd = nil
			for i = 1, #near do
				local p = self:RangePoint(near[i])
				local d = (p.x - lp.x) * (p.x - lp.x) + (p.y - lp.y) * (p.y - lp.y)
				if bd == nil or d < bd then bd = d; bi = i end
			end
			last = near[bi]
			out[#out + 1] = last
			table.remove(near, bi)
		end
		return out
	end

	-- 지금이 보스 라운드인가 = 방 전역 스테이지가 보스(RtsStageLogic). 보스전 잠금 스킬·보스전 사거리에 쓴다
	@ExecSpace("ServerOnly")
	method boolean IsBossRound(number zone)
		return _RtsStageLogic:IsBossStageNow()
	end

	-- 잠금 설정(RtsJobTableLogic.GetLock): 0 사용 / 1 보스전 잠금(보스 라운드엔 안 씀) / 2 잠금 / 3 영구 잠금
	@ExecSpace("ServerOnly")
	method boolean SkillUsable(any u, number i)
		local lock = _RtsJobTableLogic:GetLock(u.SkillLocks, i)
		if lock >= 2 then return false end
		if lock == 1 and self:IsBossRound(u.Zone) then return false end
		return true
	end

	-- 공격 1회: 스킬표의 액티브 중 쓸 것을 고르고(쿨타임 스킬이 준비됐고 사거리 안에 대상이 있으면 우선, 아니면 기본 공격), 대상 = 사거리 안 가까운 순 n마리.
	--   사거리 안에 1마리도 없으면 공격(모션·이펙트·사운드) 자체를 안 하고 쿨타임도 안 쓴다(character.md 헤더). 시전 연출은 즉시 전 클라에(대상 전부 전달), 판정은 fx.hitDelay 뒤 대상마다
	@ExecSpace("ServerOnly")
	method void DoAttack(string userId, number no)
		-- 일시정지 중엔 공격 루프가 돌아도 치지 않는다(RtsStageLogic.Paused — 쿨타임은 게임 시계라 그대로 남는다)
		if _RtsStageLogic.Paused then return end
		local e = _RtsUnitLogic:GetUnit(userId, no)
		if e == nil or not isvalid(e) then return end
		local bkey = userId .. "_" .. string.format("%d", no)
		if (self.BusyUntil[bkey] or 0) > _RtsStageLogic:GameNow() then return end
		local u = e.RtsUnitComponent
		-- 프리즘 반영 표(2026-09-22): 스킬 목록·능력치 모두 그 유닛의 Prisms대로
		local skills = _RtsJobTableLogic:GetSkillsFor(u)
		-- 파티 버프(샤프아이즈 크리 / 홀리 유니티·프레이·조커 최종) 반영값으로 싸운다 — 2026-09-19 사용자: "샤프아이즈로 크확 20%인데 크리가 안 뜬다"(전엔 기본값 Calc만 써서 서버 크리 0%)
		local st = _RtsJobTableLogic:GetStatFor(u)
		_RtsUnitBuffLogic:ApplyToStat(st, _RtsUnitBuffLogic:GetBuffsFor(u.Zone, u.No))
		local c = _RtsJobTableLogic:CalcStat(u.JobId, u.Level, st)
		-- 쓸 스킬: 획득한 액티브(fx 있음) 중 잠금 2·3이 아닌 것. 쿨타임 스킬(cd)은 준비됐으면 기본 공격보다 우선(뒤에 있는 = 높은 레벨 스킬 먼저 본다)
		--   사거리 = 스킬 range(기본 공격은 레벨 강화 st.range가 있으면 그것), 타겟 수 = 스킬 targets(없으면 st.targets). 지속 피해 지대(dot)·zoneWide(블리자드 템페스트)는 구역 어디든 몬스터가 있으면
		local now = _RtsStageLogic:GameNow()
		local bossRound = self:IsBossRound(u.Zone)
		local idx = 0
		local targets = {}
		-- 이번 공격의 사거리(판정 순간 대상이 죽었을 때 대신 맞을 적을 찾는 범위 — ResolveTarget)
		local useRange = 2
		-- 두 번 돈다: 1차 = 쿨타임 스킬(준비된 것, 뒤에서부터), 2차 = 쿨 없는 기본 공격. 프리즘 액티브(디바인 퍼니시먼트·애로우 레인)는 표 끝에 붙어 인덱스가 제네시스보다 커서
		--   한 번에 돌면 늘 먼저 잡혀 쿨 스킬이 영영 안 나갔다(2026-09-22 사용자 "디바인 퍼니시먼트 중에 제네시스가 잠금이 아닌데 안 쓴다")
		local order = {}
		for i = #skills, 1, -1 do if skills[i].cd ~= nil then order[#order + 1] = i end end
		for i = #skills, 1, -1 do if skills[i].cd == nil then order[#order + 1] = i end end
		for oi = 1, #order do
			local i = order[oi]
			local k = skills[i]
			if k.kind == "액티브" and k.fx ~= nil and u.Level >= k.lv and self:SkillUsable(u, i) then
				local rk = userId .. "_" .. string.format("%d", no) .. "_" .. string.format("%d", i)
				local ready = k.cd == nil or (self.ReadyAt[rk] or 0) <= now
				if ready then
					local range = k.range or 2
					if k.cd == nil and st.range ~= nil then range = st.range end
					local count = k.targets or st.targets
					-- 지대(dot)와 구체 스킬(spread = 도트 퍼니셔)은 사거리 제한 없음 — 구역의 몬스터 전부가 후보(도트 퍼니셔는 구체마다 자기 자리에서 가장 가까운 적을 따라간다, 2026-09-19 사용자 "예외")
					if k.dot ~= nil or k.spread then
						range = 999
						count = 999
					elseif k.zoneWide then
						-- 사거리 제한 없음(블리자드 템페스트 — 2026-09-26 사용자 "템페스트일 때만 사거리 제한 해제"): 구역의 몬스터 전부가 후보, 그중 targets마리를 랜덤으로
						range = 999
					elseif bossRound and range < self.BossRange then
						-- 보스 스테이지: 모든 유닛·스킬 사거리 16칸(2026-09-23 사용자 — 전원이 친다. 그리드 어디서든 닿게 10 → 16, 보스 영역은 2026-09-25 가운데 2×2)
						range = self.BossRange
					end
					-- 다수 타격 범위(2026-09-19 사용자): 모든 범위 공격은 메인 대상 1마리 곁 1칸 안(k.aoe, 기본 1)만 — 트랙이 2칸 이상 벌어진 몬스터는 사거리 안이라도 안 맞는다. 체인 라이트닝만 aoe 3. 지대·구체는 예외
					--   전체 광역기(k.area)는 메인 대상 없이 사거리 안 전부가 후보 → n마리 랜덤
					local aoe = k.aoe
					if aoe == nil and k.dot == nil and not k.spread and not k.area then aoe = 1 end
					-- 메인 대상 고정: 메인 대상이 있는 스킬(aoe 규칙)만. 전체 광역(area)·지대(dot)·구체(spread)는 매번 새로 고른다
					local focus = nil
					if aoe ~= nil then focus = self.Focus[bkey] end
					local list = self:PickTargets(e, u.Zone, range, count, aoe, k.area == true, focus)
					if #list > 0 then
						idx = i
						targets = list
						useRange = range
						if aoe ~= nil then self.Focus[bkey] = list[1] end
						if k.cd ~= nil then self.ReadyAt[rk] = now + k.cd end
						break
					end
				end
			end
		end
		if idx == 0 then return end
		local k = skills[idx]
		local fx = k.fx
		-- 보스 집중(썬콜 프리즘 블리자드 템페스트, 2026-09-22 → 2026-09-26 30회): 대상이 전부 보스면 bossHits번을 보스들에게 번갈아 반복 타격(낙하 얼음 30개 — 1체면 30회, 2체면 15회씩). attack.md §3 예외
		if k.bossHits ~= nil and #targets >= 1 then
			local allBoss = true
			for j = 1, #targets do
				local tm = targets[j].RtsMonsterComponent
				if tm == nil or not tm.IsBoss then
					allBoss = false
					break
				end
			end
			if allBoss then
				local bs = targets
				targets = {}
				for h = 1, k.bossHits do targets[h] = bs[((h - 1) % #bs) + 1] end
			end
		end
		local target = targets[1]
		-- 후딜: 이 스킬 뒤 k.after초 동안은 다음 공격을 건너뛴다(공격 주기 타이머는 그대로 돈다)
		if k.after ~= nil then self.BusyUntil[bkey] = now + k.after end
		-- 쿨타임 스킬은 자기 비율·타격 수(k.ratio / hits, 없으면 기본 공격 값)
		local ratio = k.ratio or st.ratio
		-- 실수 오차(340×2×0.7 = 475.999…)로 한 끗 깎이지 않게 아주 작은 값을 더해 내림
		local perHit = math.floor(c.atk * (st.pct / 100) * (ratio / 100) * (st.fin / 100) + 0.0001)
		if perHit < 1 then perHit = 1 end
		local hits = k.hits or st.hits
		-- 보스 상대 배율(damage.md ③ 보스 공격시 데미지 합연산 풀 × ⑥ 보스 최종 ÷ 몬스터 최종 × 프리즘 bossFinal) — 보스(IsBoss)를 칠 때만 곱한다(2026-09-22 개발모드 보스)
		--   damage.md ③ 보스 공격시 데미지 증가(st.bossAdd 합) × ⑥ 보스 최종 데미지(st.finBoss ÷ st.fin — 킷·프리즘 '보스 공격 시 최종 데미지'가 여기에 곱) ×
		--   스킬 하나에만 붙는 '보스에게 주는 최종 데미지'(k.bossFinal)
		local bossBase = (1 + (st.bossAdd or 0) / 100) * ((st.finBoss or st.fin) / st.fin) * (k.bossFinal or 1)
		-- ⑤ 스킬 데미지 '보스 공격 시 +n%'(2026-09-24 — .info/tier.md, 사용자 "보스 최종 데미지는 없어, 스킬 데미지로"): 보스를 칠 때만 스킬 비율에 n%p를 더한다(비율 × (비율 + n) ÷ 비율).
		--   스킬 k.bossRatio(블리자드 템페스트 180 − 1001 = 보스 1회 180%), 기본 공격(k.ratio 없음)은 st.bossRatio(발할라·인레이지·폭풍의 시 강화·애로우 레인·풍마수리검·레디 투 다이·블스아이·거대화·디바인 퍼니시먼트)
		local bossRatio = k.bossRatio
		if bossRatio == nil and k.ratio == nil then bossRatio = st.bossRatio end
		local bossMul = bossBase
		if bossRatio ~= nil and bossRatio ~= 0 and ratio > 0 then bossMul = bossBase * (ratio + bossRatio) / ratio end
		-- 타격마다 비율이 다른 스킬(hitRatios — 듀얼블레이더 21.7 / 28.3)은 그 타격의 비율에 n을 더한다
		local function bossMulAt(h)
			if bossRatio == nil or bossRatio == 0 or k.hitRatios == nil or h == nil or k.hitRatios[h] == nil or k.hitRatios[h] <= 0 then return bossMul end
			return bossBase * (k.hitRatios[h] + bossRatio) / k.hitRatios[h]
		end
		local atk = e.RtsUnitAttackComponent
		if atk == nil then return end
		atk.CritRate = 1 + st.critDmg / 100
		-- 메인 대상(가장 가까운 1마리) 쪽을 본다 — 규칙은 character.md 헤더
		local tp = target.TransformComponent.WorldPosition
		local up = e.TransformComponent.WorldPosition
		-- 앞 시전의 몸 동작이 아직이면 방향을 그대로 둔다(동작 도중 고개 돌리기 방지 — 이번 시전도 그 방향으로 그린다)
		if now >= (self.FaceLockUntil[bkey] or 0) then
			if tp.x < up.x - 0.05 then u:FaceTo(-1) elseif tp.x > up.x + 0.05 then u:FaceTo(1) end
		end
		self.FaceLockUntil[bkey] = now + self:MotionSec(fx)
		-- 구체 분배(도트 퍼니셔: k.spread + fx.projFrom "around" — 사용자 2026-09-18 "캐릭터 주변에 골고루 흩뿌려지듯 생성돼 가장 가까운 적에게, 보스 우선"):
		--   구체 h는 유닛 손 높이 주위 반지름 projSpread, 각도 2π(h-1)/hits + π/hits 지점에서 생성돼 그 지점에서 가장 가까운 대상으로(보스가 사거리 안에 있으면 보스만). 클라 PlayProjectile도 같은 식으로 출발점을 잡아 그림과 판정이 맞는다
		--   넘치는 딜 나누기(2026-09-23 사용자 "구체 1개만 먼저 폭발해도 모든 구체 판정이 끝나버림"): 가까운 적 하나에 구체가 몰리면 첫 구체에 죽고 나머지는 헛방이었다 →
		--   대상마다 이미 배정한 구체 딜(1타 × 보스 배율 × 방어, 크리·무기 난수 빼고)이 남은 체력에 닿으면 그 대상은 건너뛰고 다음으로 가까운 적에게. 전부 닿았으면 그냥 가장 가까운 적
		local orbTargets = nil
		local orbDelay = nil
		local orbPoint = nil
		if k.spread and fx.projFrom == "around" and hits > 0 then
			orbTargets = {}
			orbDelay = {}
			orbPoint = {}
			local hy = up.y + (fx.projDy or 0.9)
			local bossOnly = false
			local planned = {}
			local estHit = {}
			for j = 1, #targets do
				local tm = targets[j].RtsMonsterComponent
				if tm ~= nil and tm.IsBoss then bossOnly = true end
				planned[j] = 0
				local est = perHit
				if tm ~= nil and tm.IsBoss then est = est * bossMul end
				estHit[j] = est * self:DefenseMul(st, targets[j], false)
			end
			for h = 1, hits do
				local o = _RtsJobTableLogic:OrbSpawnOffset(h, hits, fx)
				local ox = up.x + o.x
				local oy = hy + o.y
				local best = nil
				local bestD = 1e18
				local bestJ = 0
				local near = nil
				local nearD = 1e18
				local nearJ = 0
				for j = 1, #targets do
					local tj = targets[j]
					if not bossOnly or (tj.RtsMonsterComponent ~= nil and tj.RtsMonsterComponent.IsBoss) then
						local p = tj.TransformComponent.WorldPosition
						local ty = p.y + (fx.hitDy or 0.6)
						local tx = p.x
						if tj.HitComponent ~= nil then
							local sc = tj.TransformComponent.Scale
							tx = p.x + tj.HitComponent.ColliderOffset.x * math.abs(sc.x)
							ty = p.y + tj.HitComponent.ColliderOffset.y * sc.y
						end
						local d = (tx - ox) * (tx - ox) + (ty - oy) * (ty - oy)
						if d < nearD then
							nearD = d
							near = tj
							nearJ = j
						end
						local hpLeft = 0
						if tj.RtsMonsterComponent ~= nil then hpLeft = tj.RtsMonsterComponent.Hp end
						if planned[j] < hpLeft and d < bestD then
							bestD = d
							best = tj
							bestJ = j
						end
					end
				end
				if best == nil then
					best = near
					bestD = nearD
					bestJ = nearJ
				end
				if bestJ > 0 then planned[bestJ] = planned[bestJ] + estHit[bestJ] end
				orbTargets[h] = best or targets[1]
				-- 폭발 지점(시전 때 대상 피격 박스 가운데 — 클라 구체가 날아가는 곳)
				local ap = self:AimPoint(orbTargets[h])
				orbPoint[h] = { x = ap.x, y = ap.y }
				-- 도착 시각 = 생성(stagger) + 떠 있기(projHover) + 거리 ÷ 속도(projSpeed) — 클라 SpawnProjectile과 같은 식. projSpeed가 없으면 hitDelay + (h-1)×hitGap
				if fx.projSpeed ~= nil and fx.projSpeed > 0 then
					orbDelay[h] = (fx.projStagger or 0) * (h - 1) + (fx.projHover or 0) + _RtsJobTableLogic:OrbTravelSec(fx, math.sqrt(bestD))
				else
					orbDelay[h] = (fx.hitDelay or 0.3) + (h - 1) * (fx.hitGap or 0.1)
				end
			end
		end
		local nameList = targets
		if orbTargets ~= nil then nameList = orbTargets end
		local names = nameList[1].Name
		for j = 2, #nameList do names = names .. "," .. nameList[j].Name end
		self:CastFxFace(u.Zone, no, idx, names, u.FaceDir)
		-- 타격 수만큼 따로 판정한다(엔진의 GetDisplayHitCount 분할은 총합을 무작위로 나눠 1회당 비율과 어긋남) — 타격마다 크리 따로, 간격 hitGap.
		--   보통은 대상마다 hits회씩, k.spread(도트 퍼니셔 구체 30개)는 hits회를 대상들에 돌아가며 1회씩 나눈다
		local delay = fx.hitDelay or 0.3
		local gap = fx.hitGap or 0.1
		-- hitStagger(초): 같은 타격 안에서 대상 j마다 (j−1)×hitStagger 늦게 판정(블리자드 템페스트 — 얼음 30개가 차례로 떨어지는 클라 markStagger와 같은 값)
		local stagger = fx.hitStagger or 0
		-- 대상 1마리에 1타 판정 (타격마다 크리 따로)
		local avoid = {}
		for j = 1, #targets do avoid[targets[j].Name] = true end
		local function strike(t0, hitBase, h)
			if not isvalid(e) then return end
			local t = self:ResolveTarget(t0, e, u.Zone, useRange, avoid)
			if t == nil then return end
			-- ⑧ 방어: 남은 방어율 100%면 데미지 0 → 타격·숫자·연출 없음
			local defMul = self:DefenseMul(st, t, false)
			if defMul <= 0 then return end
			local crit = k.forceCrit == true or (_UtilLogic:RandomDouble() * 100) < st.crit
			local dmgBase = hitBase
			if t.RtsMonsterComponent ~= nil and t.RtsMonsterComponent.IsBoss then
				dmgBase = hitBase * bossMulAt(h)
			elseif k.mobMul ~= nil then
				-- 일반 몬스터 상대 배율(스킬 mobMul — 도트 퍼니셔 0.5, 2026-09-23 사용자 "일반 몬스터 공격 시 데미지 50% 감소")
				dmgBase = hitBase * k.mobMul
			end
			-- 무기 데미지(weapon.md): 타격마다 무기별 최소~최대 비율을 굴려 곱한다(최종 데미지 뒤, 방어 전)
			atk.Dmg = math.max(1, math.floor(dmgBase * _RtsJobTableLogic:RollWeapon(u.JobId) * defMul + 0.0001)) + self:DevExtra()
			atk.Hits = 1
			atk.Crit = crit
			atk.TargetName = t.Name
			self:HitOnce(atk, t, u.JobId .. ":" .. string.format("%d", idx))
			self:HitFx(t.Name, u.Zone, no, idx, crit, h or 1)
			-- 빙결(블리자드): 맞은 몬스터를 k.freeze초 얼린다
			if k.freeze ~= nil and t.RtsMonsterComponent ~= nil then t.RtsMonsterComponent:Freeze(k.freeze) end
			-- 방어율 감소(블리자드 템페스트 k.shred = { pct, sec }) · 받는 데미지 증가(디바인 퍼니시먼트 k.vuln = { pct, sec }) — 2026-09-24
			if k.shred ~= nil and t.RtsMonsterComponent ~= nil then t.RtsMonsterComponent:ApplyShred(k.shred.pct, k.shred.sec) end
			if k.vuln ~= nil and t.RtsMonsterComponent ~= nil then t.RtsMonsterComponent:ApplyVuln(k.vuln.pct, k.vuln.sec) end
		end
		for h = 1, hits do
			local tlist = targets
			local when = delay + (h - 1) * gap
			if k.spread then
				if orbTargets ~= nil then
					tlist = { orbTargets[h] }
					when = orbDelay[h]
				else
					tlist = { targets[((h - 1) % #targets) + 1] }
				end
			end
			-- hitRatios(프리즘 블레이드 토네이도 + 카르마 퓨리): 타격마다 비율이 다르면 그 타격의 비율로 1타를 다시 계산
			local hitBase = perHit
			if k.hitRatios ~= nil and k.hitRatios[h] ~= nil then
				hitBase = math.max(1, math.floor(c.atk * (st.pct / 100) * (k.hitRatios[h] / 100) * (st.fin / 100) + 0.0001))
			end
			local hh = h
			if stagger > 0 and not k.spread then
				for j = 1, #tlist do
					local t = tlist[j]
					_RtsStageLogic:After(function() strike(t, hitBase, hh) end, when + (j - 1) * stagger)
				end
			else
				-- 구체 재조준(2026-09-24 사용자 "도트 퍼니셔 구체가 날아가는 도중 적이 죽으면 그냥 불발"): 도착했는데 대상이 이미 죽었으면(다른 구체·유닛이 먼저 잡음)
				--   그 자리(죽은 대상의 지금 겨냥점 — 사망 클립 동안 남아 있음, 없으면 시전 때 폭발 지점)에서 구역의 가장 가까운 적으로 이어 날아간다(구체는 사거리 제한 없음).
				--   전 클라에 이어지는 구체(RedirectOrbFx — 떠 있기 없이 바로 비행)를 그리고, 비행 시간(OrbTravelSec, 클라와 같은 식) 뒤 판정. 이어 간 대상도 먼저 죽으면 2번까지 다시.
				--   전엔 폭발 지점 반지름 projSpread 안의 적만 바로 맞았다 — 몹이 그새 지나가 버리면 헛방
				local op = nil
				if orbPoint ~= nil then op = orbPoint[h] end
				local zone = u.Zone
				-- 최초 구체 생성부터 5초. 재조준·일시정지로 수명이 다시 시작되지 않는다.
				local expiresAt = 0
				if op ~= nil and fx.projMaxLife ~= nil then
					expiresAt = _UtilLogic.ElapsedSeconds + math.min(fx.projDelay or 0, fx.projHover or 0) + (fx.projStagger or 0) * (h - 1) + fx.projMaxLife
				end
				local function expired()
					local gone = expiresAt > 0 and _UtilLogic.ElapsedSeconds >= expiresAt
					if gone then _RtsConfigLogic:Log("dot orb expired before hit: " .. tostring(hh)) end
					return gone
				end
				local function redirect(t0, px, py, left)
					if not isvalid(e) or expired() then return end
					local sx = px
					local sy = py
					if t0 ~= nil and isvalid(t0) then
						local a0 = self:AimPoint(t0)
						sx = a0.x
						sy = a0.y
					end
					local t2 = self:NearestTargetableAt(zone, sx, sy, 10000)
					if t2 == nil then return end
					local a2 = self:AimPoint(t2)
					local dist = math.sqrt((a2.x - sx) * (a2.x - sx) + (a2.y - sy) * (a2.y - sy))
					self:RedirectOrbFx(zone, no, idx, sx, sy, t2.Name, math.max(0, expiresAt - _UtilLogic.ElapsedSeconds))
					_RtsStageLogic:After(function()
						if not isvalid(e) or expired() then return end
						if self:IsTargetable(t2) then
							strike(t2, hitBase, hh)
						elseif left > 0 then
							redirect(t2, a2.x, a2.y, left - 1)
						end
					end, _RtsJobTableLogic:OrbTravelSec(fx, dist))
				end
				_RtsStageLogic:After(function()
					if not isvalid(e) or expired() then return end
					for j = 1, #tlist do
						local t = tlist[j]
						if op ~= nil and not self:IsTargetable(t) then
							redirect(t, op.x, op.y, 2)
						elseif t ~= nil then
							strike(t, hitBase, hh)
						end
					end
				end, when)
			end
		end
		-- 쉐도우 파트너(나이트로드 30): 기본 공격 뒤에 st.halfHits회를 데미지 ½로 이어서(같은 간격, 대상 같음). 쿨타임 스킬엔 없음
		local halfHits = 0
		if k.cd == nil and k.hits == nil then halfHits = st.halfHits or 0 end
		for h = 1, halfHits do
			local when = delay + (hits + h - 1) * gap
			_RtsStageLogic:After(function()
				if not isvalid(e) then return end
				for j = 1, #targets do
					local t = self:ResolveTarget(targets[j], e, u.Zone, useRange, avoid)
					local defMul = 0
					if t ~= nil then defMul = self:DefenseMul(st, t, false) end
					if defMul > 0 then
						local crit = (_UtilLogic:RandomDouble() * 100) < st.crit
						local dmgBase = perHit * 0.5
						if t.RtsMonsterComponent ~= nil and t.RtsMonsterComponent.IsBoss then dmgBase = dmgBase * bossMul end
						atk.Dmg = math.max(1, math.floor(dmgBase * _RtsJobTableLogic:RollWeapon(u.JobId) * defMul + 0.0001)) + self:DevExtra()
						atk.Hits = 1
						atk.Crit = crit
						atk.TargetName = t.Name
						self:HitOnce(atk, t, u.JobId .. ":" .. string.format("%d", idx))
						self:HitFx(t.Name, u.Zone, no, idx, crit, hits + h)
					end
				end
			end, when)
		end
		-- 지속 피해 지대(포이즌 리전): dot = { pct, period, dur } — period초마다 구역 안 모든 몬스터에 공격력 × pct%(강화면 st.dotPct)를 dur초 동안. 직접 타격은 없음(hits 0).
		--   "타일이 중첩돼도 디버프라 중복 없음" = 몬스터 1마리에 틱당 1회. 그림(맹독지대 타일)은 클라 CastFx가 zoneClips로 깐다
		if k.dot ~= nil then
			local dotPct = st.dotPct or k.dot.pct
			local perTick = math.floor(c.atk * (st.pct / 100) * (dotPct / 100) * (st.fin / 100) + 0.0001)
			if perTick < 1 then perTick = 1 end
			local ticks = math.floor(k.dot.dur / k.dot.period + 0.5)
			local dotEnd = _RtsStageLogic:GameNow() + k.dot.dur + 0.2
			for t = 1, ticks do
				_RtsStageLogic:After(function()
					if not isvalid(e) then return end
					local list = self:GetZoneMonsters(u.Zone)
					for j = 1, #list do
						local m = list[j]
						-- 중독 표시(몬스터 정보 창 디버프 아이콘): 이 지대가 끝날 때까지
						if m.RtsMonsterComponent ~= nil and m.RtsMonsterComponent.PoisonUntil < dotEnd then m.RtsMonsterComponent.PoisonUntil = dotEnd end
						local defMul = self:DefenseMul(st, m, true)
						if defMul > 0 then
							local crit = (_UtilLogic:RandomDouble() * 100) < st.crit
							local dmg = math.max(1, math.floor(perTick * _RtsJobTableLogic:RollWeapon(u.JobId) * defMul + 0.0001))
							-- 고정 데미지(st.dotFlat — 포이즌 리전 20 + 레벨 × 3): 일반 몬스터만, 난수·방어 없이 더한다
							if st.dotFlat ~= nil and m.RtsMonsterComponent ~= nil and not m.RtsMonsterComponent.IsBoss then dmg = dmg + st.dotFlat end
							atk.Dmg = dmg + self:DevExtra()
							atk.Hits = 1
							atk.Crit = crit
							atk.TargetName = m.Name
							atk:AttackFrom(Vector2(0.6, 0.6), self:AimPoint(m), u.JobId .. ":" .. string.format("%d", idx), CollisionGroups.HitBox)
							self:HitFx(m.Name, u.Zone, no, idx, crit, 1)
						end
					end
				end, t * k.dot.period)
			end
		end
	end

	-- 몸 동작이 끝나는 데 걸리는 초(모션 지연 + 모션 수 × 간격 ÷ 재생 속도, 최대 1.2초) — 이 동안은 방향 고정(FaceLockUntil).
	--   루프 동작(motionLoop·motionCycle — 폭풍의 시·조커·디바인 퍼니시먼트)은 0: 루프 이펙트는 방향이 바뀌면 같이 뒤집힌다(RefreshLoopFacing)
	method number MotionSec(table fx)
		if fx == nil or fx.motionLoop or fx.motionCycle then return 0 end
		local n = 0
		if fx.motions ~= nil then n = #fx.motions elseif fx.motion ~= nil then n = 1 end
		if n == 0 then return 0 end
		local rate = fx.motionRate or 1
		if rate <= 0 then rate = 1 end
		local sec = (fx.motionDelay or 0) + ((n - 1) * (fx.motionGap or 0.45) + 0.5) / rate
		if sec > 1.2 then sec = 1.2 end
		return sec
	end

	-- 전 클라: 유닛 시전 연출(모션 + 이펙트 + 시전음 + 투사체·빔·표식은 대상들 쪽으로). targetNames = 쉼표로 이은 대상 이름(첫 = 메인 대상)
	--   face = 시전 때 서버가 정한 방향(−1 왼쪽 / 1 오른쪽) — FaceDir 동기화보다 RPC가 먼저 와도 아바타·이펙트를 이 방향으로 먼저 맞춘다
	@ExecSpace("Client")
	method void CastFxFace(number zone, number no, number idx, string targetNames, number face)
		local u = _RtsUnitLogic:GetZoneUnit(zone, no)
		if u == nil then return end
		u:SetLocalFace(face)
		local skills = _RtsJobTableLogic:GetSkillsFor(u)
		local k = skills[math.floor(idx)]
		if k == nil or k.fx == nil then return end
		local targets = {}
		for nm in string.gmatch(targetNames, "[^,]+") do
			local t = _EntityService:GetEntityByPath("/maps/RtsMap/" .. nm)
			if t ~= nil then targets[#targets + 1] = t end
		end
		_RtsSkillFxLogic:Preload(k.fx)
		_RtsSkillFxLogic:PlayCast(u.Entity, _RtsSkillFxLogic:LoopKey(zone, no), k.fx, targets[1], targets)
	end

	-- 전 클라: 몬스터 피격 연출(번쩍임 + 타격 클립 + 타격음). 데미지 숫자는 엔진 데미지 스킨이 따로 그린다
	--   h = 이 시전 안에서 몇 번째 타격인지(1부터; 쉐도우 파트너 ½타는 hits+h) — hitSoundEvery(n타마다 1번 소리, 39타 블레이드 토네이도)에 쓴다
	@ExecSpace("Client")
	method void HitFx(string targetName, number zone, number no, number idx, boolean crit, number h)
		local t = _EntityService:GetEntityByPath("/maps/RtsMap/" .. targetName)
		if t == nil or t.RtsMonsterComponent == nil then return end
		local u = _RtsUnitLogic:GetZoneUnit(zone, no)
		if u == nil then return end
		local skills = _RtsJobTableLogic:GetSkillsFor(u)
		local k = skills[math.floor(idx)]
		local fx = nil
		if k ~= nil then fx = k.fx end
		t.RtsMonsterComponent:PlayHitFxAt(fx, crit, h)
	end

	-- 전 클라: 도트 퍼니셔 구체 재조준 — (x, y)(대상이 죽은 자리)에서 새 대상 targetName으로 이어 날아가는 구체(서버 구체 재조준 redirect와 짝)
	@ExecSpace("Client")
	method void RedirectOrbFx(number zone, number no, number idx, number x, number y, string targetName, number lifeLeft)
		local t = _EntityService:GetEntityByPath("/maps/RtsMap/" .. targetName)
		if t == nil or not isvalid(t) then return end
		local u = _RtsUnitLogic:GetZoneUnit(zone, no)
		if u == nil then return end
		local skills = _RtsJobTableLogic:GetSkillsFor(u)
		local k = skills[math.floor(idx)]
		if k == nil or k.fx == nil then return end
		-- 남은 수명은 기존 이펙트 표에 전달해 새 구체의 5초 타이머를 다시 시작하지 않는다.
		local redirectFx = _RtsJobTableLogic:CopyTable(k.fx)
		if redirectFx.projMaxLife ~= nil then redirectFx.projMaxLife = lifeLeft end
		_RtsSkillFxLogic:PlayOrbRedirect(redirectFx, Vector2(x, y), t)
	end

end
