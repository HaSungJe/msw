-- Phase 4 #14 / Phase 5 #19·#20 (부분, 2026-09-15): 배치된 유닛 1기의 상태. 유닛 엔티티(MapObject + 아바타)에 붙는다.
--   값은 서버가 바꾸고 Sync로 전 클라에 내려간다. 클라는 읽기만(팝업·HUD 슬롯). 조작 요청은 RtsUnitLogic의 서버 메서드로.
--   클릭은 RtsUnitSelectLogic이 화면 터치(ScreenTouchEvent) + 자체 상자로 판정한다(엔티티 TouchReceive는 2026-09-22 미발화로 폐기).
@Component
script RtsUnitComponent extends Component

	@Sync
	property string Owner = ""

	@Sync
	property number Zone = 0

	@Sync
	property number No = 0

	@Sync
	property string JobId = ""

	@Sync
	property number Level = 1

	@Sync
	property number Col = 0

	@Sync
	property number Row = 0

	-- 대상 지정 스킬(홀리 유니티)의 대상 유닛 번호. 0 = 미지정
	@Sync
	property number BondNo = 0

	-- 위치 이동 / 대상 변경이 다시 가능해지는 시각(서버 경과 초). 유닛마다 3분 고정(RtsUnitLogic.CooldownSec)
	@Sync
	property number MoveReadyAt = 0

	@Sync
	property number BondReadyAt = 0

	-- 액티브 스킬 잠금 설정: 스킬 목록 순서대로 한 글자씩 0 사용 / 1 보스전 잠금 / 2 잠금 / 3 영구 잠금(프리즘 증강, 강제·해제 불가) (RtsJobTableLogic.DefaultLocks/GetLock). 변경 쿨타임 없음
	@Sync
	property string SkillLocks = ""

	-- 이 유닛의 레벨업에 쓴 메소 누적(방출 환급 30%의 기준 — 2026-09-22 사용자). 영입가는 포함하지 않는다
	@Sync
	property number SpentMeso = 0

	-- 이 유닛에 적용된 프리즘 증강 id(쉼표 목록 — RtsJobTableLogic.GetPrisms). 서버 RtsUnitLogic.ApplyPrism이 채우고, 스킬 표는 GetSkillsFor/GetStatFor가 이 값대로 바꾼다
	@Sync
	property string Prisms = ""

	-- 이 유닛에 지정된 브론즈~골드·특수 코어 증강 id(쉼표 목록 — RtsAugmentTableLogic). 서버 RtsAugmentLogic.RequestAssign이 채우고, GetStatFor가 프리즘 다음에 능력치로 얹는다(2026-09-23)
	@Sync
	property string Augs = ""

	-- 보는 방향: -1 왼쪽(메이플 아바타 기본 = 스케일 양수), +1 오른쪽. 서버 FaceTo가 정하고 클라가 아바타 루트 스케일 x 부호로 그린다(유닛 엔티티 스케일은 안 건드려 자식 아이콘이 뒤집히지 않음).
	--   마지막 공격 방향을 유지한다(공격 끝나도 되돌리지 않음 — 사용자 2026-09-18)
	@Sync
	property number FaceDir = -1

	-- 클라: 시전 RPC가 알려 준 방향(0 = 없음). FaceDir 동기화가 늦게 와도 시전 순간 아바타·이펙트를 이 방향으로(RtsCombatLogic.CastFxFace). 동기화가 오면 0으로
	property number LocalFace = 0

	-- 클라: 그림자 분신 스타일 재시도 횟수(엔티티가 늦게 올 때)
	property number ShadowTries = 0

	-- 썬콜 전용 스프라이트 유닛. 아바타/코스튬 없이 프레임을 직접 재생한다.
	property Entity MageSkinEntity = nil
	property table MageSkinSprites = {}
	property string MageSkinAction = "stand1"
	property number MageSkinTries = 0
	property boolean MageSkinLoading = false
	property number MageActionClock = 0
	property table MageFrameDurations = {}

	method void OnBeginPlay()
		if self:IsClient() then self:SetupClient() end
	end

	@ExecSpace("ClientOnly")
	method void SetupClient()
		_RtsHudLogic:RefreshMyUnits()
		_RtsUnitBuffLogic:MarkDirty(self.Zone)
		self:ApplyFace()
		-- 아바타 루트가 아직 없을 수 있어 잠시 뒤 한 번 더
		_TimerService:SetTimerOnce(function()
			if isvalid(self.Entity) then
				self:ApplyFace()
				self:SetupMageSkin()
			end
		end, 0.3)
		-- 이 직업의 스킬 연출 클립을 프리즘 변형까지 미리 올려 첫 시전(프리즘을 켠 직후 포함) 로딩 끊김을 없앤다
		_RtsJobTableLogic:PreloadJobFx(self.JobId)
		_RtsUnitLogic:WarmLevelUpFx()
		local skills = _RtsJobTableLogic:GetSkillsFor(self)
		for i = 1, #skills do
			if skills[i].fx ~= nil then _RtsSkillFxLogic:Preload(skills[i].fx) end
		end
		self:SetupMageSkin()
	end

	-- 보는 방향을 아바타에 반영(클라). 메이플 아바타는 기본이 왼쪽 보기라 오른쪽을 볼 때 루트 스케일 x = -1
	@ExecSpace("ClientOnly")
	method void ApplyFace()
		self:DrawMageSkin()
		local ar = self.Entity.AvatarRendererComponent
		if ar == nil then return end
		local root = ar:GetAvatarRootEntity()
		if root == nil or not isvalid(root) then return end
		local sx = 1
		if self:FaceNow() > 0 then sx = -1 end
		local s = root.TransformComponent.Scale
		if s.x ~= sx then root.TransformComponent.Scale = Vector3(sx, s.y, s.z) end
		self:ApplyShadow()
		-- 공격 중 도는 루프 클립(폭풍의 시 keydown·조커 리본)은 유닛 엔티티의 자식이라 아바타 루트 스케일을 안 타므로 따로 반전 — 2026-09-20 사용자 "모든 캐릭터 애니메이션은 보는 방향 따라가야"
		_RtsSkillFxLogic:RefreshLoopFacing(_RtsSkillFxLogic:LoopKey(self.Zone, self.No))
	end

	@ExecSpace("ClientOnly")
	method void SetupMageSkin()
		if self.JobId ~= "il" or isvalid(self.MageSkinEntity) or self.MageSkinLoading then return end
		if self.MageSkinTries >= 10 then return end
		self.MageSkinTries = self.MageSkinTries + 1
		local frames = _RtsJobTableLogic:GetMageSkinFrames()
		self.MageFrameDurations = _RtsJobTableLogic:GetMageSkinFrameDurations()
		if frames.stand1 == nil or #frames.stand1 == 0 then return end
		local loaded = {}
		self.MageSkinLoading = true
		for action, sequence in pairs(frames) do
			loaded[action] = {}
			for i, ruid in ipairs(sequence) do
				local sprite = _ResourceService:LoadSpriteAndWait(ruid)
				if sprite == nil or not sprite.IsLoadComplete then
					self.MageSkinLoading = false
					_TimerService:SetTimerOnce(function()
						if isvalid(self.Entity) then self:SetupMageSkin() end
					end, 1)
					return
				end
				loaded[action][i] = sprite
			end
		end
		self.MageSkinLoading = false
		if not isvalid(self.Entity) then return end
		local skin = _SpawnService:SpawnByModelId("model://MapObject", "MageSkin", Vector3.zero, self.Entity)
		if skin == nil then return end
		skin.SpriteRendererComponent.OrderInLayer = 0
		skin.SpriteRendererComponent.SortingLayer = "Default"
		self.MageSkinSprites = loaded
		self.MageSkinEntity = skin
		self:DrawMageSkin()
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if self.JobId ~= "il" or not isvalid(self.MageSkinEntity) then return end
		if self.MageSkinAction == "stand1" then return end
		self.MageActionClock = self.MageActionClock + delta
		self:DrawMageSkin()
	end

	@ExecSpace("ClientOnly")
	method void PlayMageAction(string name)
		if name ~= "swingO1" and name ~= "swingO3" then name = "stand1" end
		self.MageActionClock = 0
		self.MageSkinAction = name
		self:DrawMageSkin()
	end

	@ExecSpace("ClientOnly")
	method void DrawMageSkin()
		local skin = self.MageSkinEntity
		if not isvalid(skin) then return end
		local sequence = self.MageSkinSprites[self.MageSkinAction]
		if sequence == nil then return end
		-- 표시와 대기 복귀가 같은 스킬별 시간표를 사용한다.
		local frame = 1
		if self.MageSkinAction ~= "stand1" then
			local elapsed = self.MageActionClock
			local durations = self.MageFrameDurations[self.MageSkinAction]
			if durations == nil then return end
			for i = 1, #sequence - 1 do
				if elapsed < durations[i] then break end
				elapsed = elapsed - durations[i]
				frame = i + 1
			end
		end
		local sprite = sequence[frame]
		if sprite == nil then return end
		local sr = skin.SpriteRendererComponent
		local flip = self:FaceNow() > 0
		local pixelScale = 0.002
		local x = (sprite.PivotPixel.x - sprite.Width / 2) * pixelScale
		if flip then x = -x end
		local feetY = sprite.Height - 64
		-- 대기 1장 고정·스킬별 3장 순서 재생. 회전·호흡 변형 없이 발을 맞춘다.
		local y = (sprite.PivotPixel.y - (sprite.Height - feetY)) * pixelScale
		skin.TransformComponent.Position = Vector3(x, y, 0)
		skin.TransformComponent.ZRotation = 0
		local scale = sprite.PixelPerUnit * pixelScale
		skin.TransformComponent.Scale = Vector3(scale, scale, 1)
		if sr.SpriteRUID ~= sprite.RUID then sr.SpriteRUID = sprite.RUID end
		sr.FlipX = flip
		skin.Visible = true
	end

	-- 쉐도우 파트너 그림자(서버가 30레벨부터 자식 "Shadow" 스프라이트로 세움 — 원작 4111002/special 검은 실루엣): 등 뒤(보는 방향 반대) 0.22(로컬, 부모 스케일 2라 세계 0.44)에 두고
	--   본체와 같은 쪽을 보게 뒤집는다(원작 그림은 왼쪽 보기 → 오른쪽 볼 땐 스케일 x −1). 동작은 RtsSkillFxLogic.SendAction이 같은 이름의 그림자 클립으로 따라 보낸다.
	--   엔티티가 늦게 올 수 있어 없으면 잠시 뒤 다시(최대 8회)
	@ExecSpace("ClientOnly")
	method void ApplyShadow()
		local sh = self.Entity:GetChildByName("Shadow")
		if sh == nil or not isvalid(sh) then
			if self.ShadowTries < 8 and (_RtsJobTableLogic:GetStatFor(self).halfHits or 0) > 0 then
				self.ShadowTries = self.ShadowTries + 1
				_TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self:ApplyShadow() end end, 0.5)
			end
			return
		end
		local back = 0.22
		local sx = 1
		if self:FaceNow() > 0 then
			back = -0.22
			sx = -1
		end
		sh.TransformComponent.Position = Vector3(back, 0, 0)
		local sc = sh.TransformComponent.Scale
		if sc.x ~= sx then sh.TransformComponent.Scale = Vector3(sx, 1, 1) end
		local sr = sh.SpriteRendererComponent
		if sr ~= nil then
			sr.Color = Color(1, 1, 1, 0.9)
			if sr.SpriteRUID == "" then sr.SpriteRUID = _RtsSkillFxLogic:ShadowClip("stand1") end
		end
	end

	method boolean IsFacingRight()
		return self:FaceNow() > 0
	end

	-- 지금 그릴 방향: 클라에 시전 방향(LocalFace)이 있으면 그것, 아니면 동기화된 FaceDir
	method number FaceNow()
		if self.LocalFace ~= 0 then return self.LocalFace end
		return self.FaceDir
	end

	-- 클라: 시전 RPC의 방향을 먼저 적용(RtsCombatLogic.CastFxFace)
	@ExecSpace("ClientOnly")
	method void SetLocalFace(number d)
		local f = -1
		if d > 0 then f = 1 end
		if self.LocalFace == f then return end
		self.LocalFace = f
		self:ApplyFace()
	end


	-- 서버가 바꾼 값이 도착하면 열려 있는 팝업·슬롯을 다시 그린다. 버프 아이콘은 남의 유닛도(구역 단위로 모아서)
	method void OnSyncProperty(string name, any value)
		if not self:IsClient() then return end
		if name == "JobId" then self:SetupMageSkin() end
		if name == "FaceDir" then
			self.LocalFace = 0
			self:ApplyFace()
			return
		end
		if name == "Prisms" then
			-- 프리즘 적용(2026-09-22) → 새 스킬 연출 미리 올리고 팝업·슬롯·버프 아이콘 갱신
			local skills = _RtsJobTableLogic:GetSkillsFor(self)
			for i = 1, #skills do
				if skills[i].fx ~= nil then _RtsSkillFxLogic:Preload(skills[i].fx) end
			end
			_RtsHudLogic:RefreshMyUnits()
			_RtsUnitBuffLogic:MarkDirty(self.Zone)
			_RtsUnitPopupLogic:OnUnitSynced(self.No)
			return
		end
		if name == "Level" then
			-- 30레벨 도달 → 서버가 그림자 분신을 세우므로 스타일 적용(엔티티 동기화가 늦을 수 있어 재시도)
			self.ShadowTries = 0
			_TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self:ApplyShadow() end end, 0.3)
		end
		_RtsUnitBuffLogic:MarkDirty(self.Zone)
		if not _RtsUnitLogic:IsMine(self.Owner) then return end
		_RtsHudLogic:RefreshMyUnits()
		_RtsUnitPopupLogic:OnUnitSynced(self.No)
	end

	-- ===== 서버 =====

	-- 남은 쿨타임(초). 양쪽 공간에서 서버 시계 기준
	method number MoveCoolLeft()
		local left = self.MoveReadyAt - _RtsStageLogic:GameNow()
		if left < 0 then left = 0 end
		return math.ceil(left)
	end

	method number BondCoolLeft()
		local left = self.BondReadyAt - _RtsStageLogic:GameNow()
		if left < 0 then left = 0 end
		return math.ceil(left)
	end

	-- 외형 적용: 직업 기본 세트만(UseCustomEquipOnly — 월드 아바타 스킨은 2026-09-25 삭제)
	@ExecSpace("ServerOnly")
	method void ApplyLook()
		local cm = self.Entity.CostumeManagerComponent
		if cm == nil then return end
		local set = _RtsJobTableLogic:GetCostume(self.JobId)
		if set == nil then return end
		cm.UseCustomEquipOnly = true
		cm.DefaultEquipUserId = ""
		cm.CustomLongcoatEquip = set.longcoat
		cm.CustomTwoHandedWeaponEquip = set.weapon2h or ""
		cm.CustomOneHandedWeaponEquip = set.weapon1h or ""
		cm.CustomShoesEquip = set.shoes
		cm.CustomHairEquip = set.hair
		cm.CustomCapEquip = set.cap or ""
		cm.CustomFaceAccessoryEquip = set.faceAcc or ""
		cm.CustomFaceEquip = set.face or ""
	end

	-- 메인 대상 쪽을 본다: dirX > 0 오른쪽, < 0 왼쪽. FaceDir 동기화 → 클라 ApplyFace. 이후 되돌리지 않는다
	@ExecSpace("ServerOnly")
	method void FaceTo(number dirX)
		local d = -1
		if dirX > 0 then d = 1 end
		if self.FaceDir ~= d then self.FaceDir = d end
	end

	-- 발판 칸에 세운다 (아바타 발 위치 = 칸 중앙 −0.75)
	@ExecSpace("ServerOnly")
	method void PlaceAt(number col, number row)
		self.Col = col
		self.Row = row
		local at = _RtsZoneLogic:GetCellCenter(self.Zone, col, row)
		self.Entity.TransformComponent.WorldPosition = Vector3(at.x, at.y - 0.75, 0)
	end

end
