-- 2026-09-23 사용자 "몬스터 클릭 시 현재 체력/최대 체력/방어율/어느 라운드의 몬스터인지, 보스도 포함": 화면 하단 가운데 정보 패널(클라 전용).
--   열기 = RtsUnitSelectLogic.HandleScreenTouchEvent(유닛이 아닌 곳 클릭 → MonsterAtScreen). 0.2초마다 체력 갱신, 몬스터가 죽거나 사라지면 닫힘.
--   빈 곳 클릭·ESC로도 닫힌다. 값은 RtsMonsterComponent 동기화(Hp·MaxHp·Defense·StageNo·IsBoss) + RtsStageTableLogic 표(이름·라운드 맵).
@Logic
script RtsMonsterInfoLogic extends Logic

	property Entity Panel = nil

	-- 정보 창 안쪽(디버프 줄을 여기에 붙인다)
	property Entity PanelIn = nil

	-- 정보 창 높이(2026-09-24 사용자 "네모 박스 높이를 키워서 아래에 디버프" — 118 → 160, 아래 40px = 디버프 줄)
	property number PanelH = 160

	property Entity Target = nil

	property Entity NameText = nil

	property Entity HpFill = nil

	property Entity HpText = nil

	-- 체력 %(체력바 오른쪽, 2026-09-23 사용자)
	property Entity HpPctText = nil

	property Entity InfoText = nil

	property number TickId = 0

	-- 체력바 폭(오른쪽 PctW 칸에 체력 %)
	property number BarW = 366

	property number PctW = 70

	-- 왼쪽 몬스터 아이콘(2026-09-23 사용자 "상태창 좌측에 몬스터 아이콘") — 이동 애니메이션을 칸 정중앙에 맞춰 반복. IconW 칸 + 여백 뒤에 이름·체력바·정보
	property number IconW = 94

	property number LeftX = 118

	-- 디버프(2026-09-24 사용자 "이동속도 감소 같은 디버프도 아이콘으로 — 마우스를 올리면 설명과 남은 시간" → 같은 날 "몬스터 우측에 디버프 정보 칸" → 같은 날 "네모 박스 높이를 키워서 아래에 디버프, 마우스 오버하면 박스 우측에"): 정보 창 안 아래 줄(DebuffRow = 그 줄, 칩 = 아이콘(또는 색 띠) + 디버프 이름).
	--   목록 = DebuffList(동기화된 FrozenUntil·ShredUntil/Pct·VulnUntil/Pct·PoisonUntil + 구역 팔라딘 가드 크러쉬·방어구 부수기). 아이콘 RUID가 없으면 색 띠(ruid만 채우면 그림으로)
	property Entity DebuffRow = nil

	property string DebuffSig = ""

	property table DebuffTimes = {}

	property Entity Tip = nil

	property Entity TipText = nil

	property string TipId = ""

	property number IconSize = 36

	-- 디버프 설명 창 폭(칩에 마우스를 올리면 정보 창 바로 오른쪽에 뜬다)
	property number DebuffBoxW = 340

	method boolean IsOpen()
		return self.Target ~= nil
	end

	-- 화면 좌표의 몬스터(지금 보고 있는 구역, 살아 있는 것). 피격 박스(표 boxW·boxH·boxX·boxY × 스케일)에 약간 여유를 두고, 여럿이면 박스 가운데가 가장 가까운 것
	@ExecSpace("ClientOnly")
	method any MonsterAtScreen(Vector2 screen)
		local w = _UILogic:ScreenToWorldPosition(screen)
		local zone = math.floor(_RtsHudLogic.WatchedZone + 0.5)
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		if mapRoot == nil then return nil end
		local comps = mapRoot:GetChildComponentsByTypeName("RtsMonsterComponent", false)
		local best = nil
		local bestD = 1e18
		for i = 1, #comps do
			local m = comps[i]
			if m ~= nil and isvalid(m.Entity) and m.Entity.Enable and not m.Dead and math.floor(m.Zone + 0.5) == zone then
				local mon = _RtsStageTableLogic:GetMonster(m.MonsterId)
				if mon ~= nil then
					local p = m.Entity.TransformComponent.WorldPosition
					local sc = math.abs(m.Entity.TransformComponent.Scale.x)
					local cx = p.x + (mon.boxX or 0) * sc
					local cy = p.y + (mon.boxY or 0) * sc
					local hw = (mon.boxW or 0.5) * sc / 2 + 0.2
					local hh = (mon.boxH or 0.5) * sc / 2 + 0.2
					if math.abs(w.x - cx) <= hw and math.abs(w.y - cy) <= hh then
						local d = (w.x - cx) * (w.x - cx) + (w.y - cy) * (w.y - cy)
						if d < bestD then
							bestD = d
							best = m.Entity
						end
					end
				end
			end
		end
		return best
	end

	@ExecSpace("ClientOnly")
	method void Open(Entity target)
		local H = _RtsHudLogic
		if H.HudGroup == nil or target == nil or not isvalid(target) then return end
		local same = self.Target == target
		self:Close()
		if not same then H:PlayUi(H.OpenSound) end -- 창 여는 소리(2026-09-24 사용자) — 같은 몬스터 다시 그리기는 빼고
		self.Target = target
		local x0 = self.LeftX
		local panel = H:SpawnPanel("RtsMonInfo", H.HudGroup, Vector2(0.5, 0), Vector2(0.5, 0), Vector2(0, 16), Vector2(x0 + self.BarW + 4 + self.PctW + 18, self.PanelH),
			Color(0.11, 0.094, 0.075, 0.95), H:ColGold(), 1.5)
		self.Panel = panel.Parent
		self.PanelIn = panel
		-- 아이콘: 어두운 칸 + 몬스터 이동 애니메이션(표 walk 클립, 여러 부위 보스는 몸통)
		local slot = H:SpawnUI("model://uisprite", "RtsMonInfoIconBack", panel, Vector2(0, 1), Vector2(0, 1), Vector2(12, -10), Vector2(self.IconW, self.IconW))
		slot.SpriteGUIRendererComponent.ImageRUID = DataRef(H.WhiteRUID)
		slot.SpriteGUIRendererComponent.Color = Color(0.2, 0.17, 0.15, 1)
		-- 칸 밖으로 삐져나오는 걷기 클립(초록버섯 등 — 프레임이 크거나 기준점이 치우친 것)을 칸 안으로 자른다(2026-09-24 사용자 "칸 밖으로 빠져나옴")
		if slot.MaskComponent == nil then slot:AddComponent("MaskComponent") end
		-- 칸 정중앙에 걷기 클립 반복(공용 초상 RtsHudLogic.SpawnMonsterPortrait — 아이콘·유저 카드와 같은 맞춤 식, 2026-09-25 공용화)
		H:SpawnMonsterPortrait(slot, target.RtsMonsterComponent.MonsterId, self.IconW - 8, true)
		self.NameText = H:SpawnLabel("RtsMonInfoName", panel, Vector2(0, 1), Vector2(0, 1), Vector2(x0, -8), Vector2(self.BarW + 4 + self.PctW, 28),
			"", H:ColInk(), 19, TextAlignmentType.MiddleLeft, true)
		self.NameText.TextComponent.IsRichText = true
		-- 체력바(배경·채움) + 가운데 글자
		local back = H:SpawnUI("model://uisprite", "RtsMonInfoHpBack", panel, Vector2(0, 1), Vector2(0, 1), Vector2(x0, -42), Vector2(self.BarW, 26))
		back.SpriteGUIRendererComponent.Color = Color(0.2, 0.17, 0.15, 1)
		self.HpFill = H:SpawnUI("model://uisprite", "RtsMonInfoHpFill", panel, Vector2(0, 1), Vector2(0, 1), Vector2(x0, -42), Vector2(self.BarW, 26))
		self.HpFill.SpriteGUIRendererComponent.Color = Color(0.85, 0.2, 0.2, 1)
		self.HpText = H:SpawnLabel("RtsMonInfoHpText", panel, Vector2(0, 1), Vector2(0, 1), Vector2(x0, -42), Vector2(self.BarW, 26),
			"", Color(1, 1, 1, 1), 15, TextAlignmentType.MiddleCenter, true)
		self.HpPctText = H:SpawnLabel("RtsMonInfoHpPct", panel, Vector2(0, 1), Vector2(0, 1), Vector2(x0 + self.BarW + 4, -42), Vector2(self.PctW, 26),
			"", H:ColInk(), 16, TextAlignmentType.MiddleRight, true)
		self.InfoText = H:SpawnLabel("RtsMonInfoText", panel, Vector2(0, 1), Vector2(0, 1), Vector2(x0, -76), Vector2(self.BarW + 4 + self.PctW, 28),
			"", H:ColMuted(), 15, TextAlignmentType.MiddleLeft, false)
		self:Refresh()
		self.TickId = _TimerService:SetTimerRepeat(function() self:Refresh() end, 0.2, 0.2)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		if self.TickId ~= 0 then
			_TimerService:ClearTimer(self.TickId)
			self.TickId = 0
		end
		self.Target = nil
		if self.Panel ~= nil and isvalid(self.Panel) then self.Panel:Destroy() end
		self.Panel = nil
		self.NameText = nil
		self.HpFill = nil
		self.HpText = nil
		self.HpPctText = nil
		self.InfoText = nil
		self.DebuffRow = nil
		self.PanelIn = nil
		self.DebuffSig = ""
		self.DebuffTimes = {}
		self.Tip = nil
		self.TipText = nil
		self.TipId = ""
	end

	-- 이름 · (보스) / 체력바 + "현재 / 최대" / "방어율 50%  ·  25라운드 · 폐광"
	@ExecSpace("ClientOnly")
	method void Refresh()
		local t = self.Target
		if t == nil or not isvalid(t) or t.RtsMonsterComponent == nil or t.RtsMonsterComponent.Dead then
			self:Close()
			return
		end
		if self.NameText == nil or not isvalid(self.NameText) then return end
		local H = _RtsHudLogic
		local m = t.RtsMonsterComponent
		local mon = _RtsStageTableLogic:GetMonster(m.MonsterId)
		local name = m.MonsterId
		if mon ~= nil then name = mon.name end
		if m.IsBoss then name = name .. "  <color=#e0b95a>보스</color>" end
		if self.NameText.TextComponent.Text ~= name then self.NameText.TextComponent.Text = name end
		local r = 0
		if m.MaxHp > 0 then r = m.Hp / m.MaxHp end
		if r < 0 then r = 0 elseif r > 1 then r = 1 end
		self.HpFill.UITransformComponent.RectSize = Vector2(math.max(1, self.BarW * r), 26)
		self.HpText.TextComponent.Text = H:FormatNumber(math.max(0, m.Hp)) .. " / " .. H:FormatNumber(m.MaxHp)
		if self.HpPctText ~= nil and isvalid(self.HpPctText) then self.HpPctText.TextComponent.Text = string.format("%.1f%%", r * 100) end
		-- 방어율은 보스만(2026-09-24 사용자 "일반 몬스터 방어율 0 — 방무는 보스 옵션")
		local info = ""
		if m.IsBoss then info = "방어율 " .. H:Int(m.Defense) .. "%" end
		local s = nil
		if m.StageNo > 0 then s = _RtsStageTableLogic:GetStage(m.StageNo) end
		if s ~= nil then
			if info ~= "" then info = info .. "   ·   " end
			info = info .. H:Int(m.StageNo) .. "라운드 · " .. _RtsStageTableLogic:FullName(s)
		end
		if self.InfoText.TextComponent.Text ~= info then self.InfoText.TextComponent.Text = info end
		self:RefreshDebuffs(m)
	end

	-- 지금 걸린 디버프: { id, name, desc, left(남은 초, −1 = 조건이 있는 동안), ruid(아이콘 — 없으면 ""), color(칩 왼쪽 색 띠 — 아이콘이 없을 때) }
	@ExecSpace("ClientOnly")
	method table DebuffList(any m)
		local H = _RtsHudLogic
		local now = _RtsStageLogic:GameNow()
		local out = {}
		if not m.IsBoss and m.FrozenUntil > now then
			out[#out + 1] = { id = "freeze", name = "빙결", desc = "블리자드에 얼어 이동속도가 50% 감소한다.", short = "이속 −50%", left = m.FrozenUntil - now, ruid = "", color = Color(0.45, 0.78, 1, 1) }
		end
		if m.ShredUntil > now and m.ShredPct > 0 then
			out[#out + 1] = { id = "shred", name = "방어율 감소", desc = "블리자드 템페스트: 방어율이 " .. H:Int(m.ShredPct) .. "%p 감소한다.", short = "방어 −" .. H:Int(m.ShredPct) .. "%p", left = m.ShredUntil - now, ruid = "", color = Color(0.3, 0.55, 0.95, 1) }
		end
		if m.VulnUntil > now and m.VulnPct > 0 then
			out[#out + 1] = { id = "vuln", name = "받는 데미지 증가", desc = "디바인 퍼니시먼트: 받는 데미지가 " .. H:Int(m.VulnPct) .. "% 증가한다.", short = "피해 +" .. H:Int(m.VulnPct) .. "%", left = m.VulnUntil - now, ruid = "", color = Color(0.95, 0.8, 0.35, 1) }
		end
		if m.PoisonUntil > now then
			out[#out + 1] = { id = "poison", name = "중독", desc = "포이즌 리전: 맹독 지대 안에서 2초마다 지속 피해를 입는다.", short = "지속 피해", left = m.PoisonUntil - now, ruid = "", color = Color(0.45, 0.8, 0.35, 1) }
		end
		if m.Defense > 0 then
			local g = self:GuardCrushOf(m.Zone)
			if g > 0 then
				out[#out + 1] = { id = "guard", name = "가드 크러쉬", desc = "팔라딘이 구역에 있는 동안 방어율이 " .. H:Int(g) .. "%p 감소한다.", short = "방어 −" .. H:Int(g) .. "%p", left = -1, ruid = "b28058e366624ed0beb099fb67831526", color = Color(1, 1, 1, 1) }
			end
			-- 방어구 부수기(2026-09-24 사용자 — 1티어 증강 개수만큼 보스 약화, 아이콘 1f4eea78…)
			local a = self:ArmorBreakOf(m.Zone)
			if a > 0 then
				-- 설명엔 '1티어' 대신 효과를 주는 유닛의 직업 이름(2026-09-24 사용자 "1티어/2티어는 개발 관점 — 유저는 몰라야 해")
				out[#out + 1] = { id = "armorbreak", name = "방어구 부수기", desc = self:ArmorBreakJobOf(m.Zone) .. "의 증강 1개마다 보스 방어율이 1%p 감소한다(최대 " .. H:Int(_RtsJobTableLogic.ArmorBreakCap) .. "%p). 지금 " .. H:Int(a) .. "%p 감소.", short = "방어 −" .. H:Int(a) .. "%p", left = -1, ruid = "1f4eea783bbe4785b3ba82334f211aaa", color = Color(1, 1, 1, 1) }
			end
		end
		return out
	end

	-- 구역 zone의 방어구 부수기 %p(클라 — 서버 RtsCombatLogic.ArmorBreak와 같은 규칙: 1티어 유닛 중 가장 큰 RtsJobTableLogic.ArmorBreakFor)
	@ExecSpace("ClientOnly")
	method number ArmorBreakOf(number zone)
		local z = math.floor(zone + 0.5)
		local nos = _RtsUnitLogic:ListZoneUnits(z)
		local v = 0
		for i = 1, #nos do
			local a = _RtsJobTableLogic:ArmorBreakFor(_RtsUnitLogic:GetZoneUnit(z, nos[i]))
			if a > v then v = a end
		end
		return v
	end

	-- 구역 zone에서 방어구 부수기를 주는 유닛(ArmorBreakOf와 같은 기준 — 가장 큰 값)의 직업 이름
	@ExecSpace("ClientOnly")
	method string ArmorBreakJobOf(number zone)
		local z = math.floor(zone + 0.5)
		local nos = _RtsUnitLogic:ListZoneUnits(z)
		local v = 0
		local name = ""
		for i = 1, #nos do
			local u = _RtsUnitLogic:GetZoneUnit(z, nos[i])
			local a = _RtsJobTableLogic:ArmorBreakFor(u)
			if a > v then
				v = a
				name = _RtsJobTableLogic:GetJobNameFor(u)
			end
		end
		return name
	end

	-- 구역 zone의 가드 크러쉬 %p(클라 — 서버 RtsCombatLogic.GuardCrush와 같은 규칙: 팔라딘 40레벨 20, 10레벨 10)
	@ExecSpace("ClientOnly")
	method number GuardCrushOf(number zone)
		local z = math.floor(zone + 0.5)
		local nos = _RtsUnitLogic:ListZoneUnits(z)
		local v = 0
		for i = 1, #nos do
			local u = _RtsUnitLogic:GetZoneUnit(z, nos[i])
			if u ~= nil and u.JobId == "paladin" then
				if u.Level >= 40 and v < 20 then v = 20 elseif u.Level >= 10 and v < 10 then v = 10 end
			end
		end
		return v
	end

	-- 디버프 줄: 정보 창 안 아래쪽(이름·체력·정보 줄 밑). 디버프마다 칩 = 아이콘 + 효과 요약(방어 −2%p). 목록(id 순서)이 바뀌면 다시 만들고, 매 갱신마다 요약·설명 글자만 바꾼다.
	--   칩에 마우스를 올리면 정보 창 바로 오른쪽에 이름 · 설명 · 남은 시간(설명 창은 마우스를 받지 않는다 — 깜빡임 방지)
	@ExecSpace("ClientOnly")
	method void RefreshDebuffs(any m)
		if self.Panel == nil or not isvalid(self.Panel) or self.PanelIn == nil or not isvalid(self.PanelIn) then return end
		local H = _RtsHudLogic
		local list = self:DebuffList(m)
		local sig = ""
		for i = 1, #list do sig = sig .. list[i].id .. ";" end
		if sig ~= self.DebuffSig or self.DebuffRow == nil then
			self.DebuffSig = sig
			self:HideTip()
			if self.DebuffRow ~= nil and isvalid(self.DebuffRow) then self.DebuffRow:Destroy() end
			self.DebuffTimes = {}
			-- 줄 = 창 폭 전체(초상 아래까지), 위에 가는 구분선
			local avail = self.LeftX + self.BarW + 4 + self.PctW + 18 - 24
			local row = H:SpawnUI("model://uisprite", "RtsMonInfoDebuffs", self.PanelIn, Vector2(0, 0), Vector2(0, 0), Vector2(12, 8), Vector2(avail, 34))
			row.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
			row.SpriteGUIRendererComponent.RaycastTarget = false
			self.DebuffRow = row
			local line = H:SpawnUI("model://uisprite", "RtsMonInfoDebuffLine", row, Vector2(0, 1), Vector2(0, 0), Vector2(0, 5), Vector2(avail, 1.5))
			line.SpriteGUIRendererComponent.ImageRUID = DataRef(H.WhiteRUID)
			line.SpriteGUIRendererComponent.Color = H:ColBorderSoft()
			line.SpriteGUIRendererComponent.RaycastTarget = false
			local n = #list
			if n == 0 then
				local none = H:SpawnLabel("RtsMonInfoDebuffNone", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(4, 0), Vector2(avail - 8, 26), "걸린 디버프 없음", H:ColMuted(), 14, TextAlignmentType.MiddleLeft, false)
				none.SpriteGUIRendererComponent.RaycastTarget = false
			end
			-- 칩 = 디버프 이름 그대로(2026-09-24 사용자 "빙/파/약/독 뭐냐 — 빙결이면 빙결, 중독이면 중독"). 아이콘 그림이 있으면 그림 + 이름, 없으면 왼쪽 색 띠 + 이름.
			--   효과 수치·남은 시간은 설명 창(마우스 오버). 칩 폭 = 이름 길이(글자 × 15px), 합이 줄보다 길면 같은 비율로 줄인다(라벨 BestFit이 글자를 맞춘다)
			local ws = {}
			local sum = 0
			for i = 1, n do
				local d = list[i]
				local _, cont = string.gsub(d.name, "[\128-\191]", "")
				local chars = string.len(d.name) - cont
				local lead = 14
				if d.ruid ~= "" then lead = 34 end
				ws[i] = lead + chars * 15 + 12
				sum = sum + ws[i] + 6
			end
			local k = 1
			if sum > avail then k = avail / sum end
			local x = 0
			for i = 1, n do
				local d = list[i]
				local w = math.floor(ws[i] * k)
				local lead = 14
				if d.ruid ~= "" then lead = 34 end
				local chip = H:SpawnPanel("RtsMonInfoDebuff" .. d.id, row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(x, 0), Vector2(w, 32),
					Color(0.16, 0.135, 0.11, 1), H:ColBorderSoft(), 1)
				x = x + w + math.floor(6 * k)
				local outer = chip.Parent
				chip.SpriteGUIRendererComponent.RaycastTarget = false
				if d.ruid ~= "" then
					local icon = H:SpawnUI("model://uisprite", "RtsMonInfoDebuffIcon", chip, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(4, 0), Vector2(24, 24))
					local r = icon.SpriteGUIRendererComponent
					r.RaycastTarget = false
					-- 칸 크기에 맞춰 늘려 그린다(AspectOnly는 그림의 기준점을 따라 한쪽으로 치우쳤다)
					r.PreserveSprite = PreserveSpriteType.None
					r.ImageRUID = DataRef(d.ruid)
					r.Color = Color(1, 1, 1, 1)
				else
					local bar = H:SpawnUI("model://uisprite", "RtsMonInfoDebuffBar", chip, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(4, 0), Vector2(4, 20))
					bar.SpriteGUIRendererComponent.ImageRUID = DataRef(H.WhiteRUID)
					bar.SpriteGUIRendererComponent.Color = d.color
					bar.SpriteGUIRendererComponent.RaycastTarget = false
				end
				local sh = H:SpawnLabel("RtsMonInfoDebuffName", chip, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(math.floor(lead * k), 0), Vector2(math.max(10, w - math.floor(lead * k) - 6), 26), d.name, H:ColInk(), 14, TextAlignmentType.MiddleLeft, true)
				sh.SpriteGUIRendererComponent.RaycastTarget = false
				self.DebuffTimes[d.id] = { short = sh }
				-- 칩 전체(바깥 테두리)가 마우스를 받는다
				local tr = outer.UITouchReceiveComponent
				if tr == nil then tr = outer:AddComponent("UITouchReceiveComponent") end
				local id = d.id
				outer:ConnectEvent(UITouchEnterEvent, function(ev) self:ShowTip(id, 0) end)
				outer:ConnectEvent(UITouchExitEvent, function(ev) if self.TipId == id then self:HideTip() end end)
			end
		end
		for i = 1, #list do
			local d = list[i]
			if self.TipId == d.id and self.TipText ~= nil and isvalid(self.TipText) then
				local txt = self:TipBody(d)
				if self.TipText.TextComponent.Text ~= txt then self.TipText.TextComponent.Text = txt end
			end
		end
		if self.TipId ~= "" and string.find(sig, self.TipId .. ";", 1, true) == nil then self:HideTip() end
	end

	@ExecSpace("ClientOnly")
	method string TipBody(table d)
		local left = "조건이 유지되는 동안"
		if d.left >= 0 then left = "남은 시간 " .. string.format("%.1f", d.left) .. "초" end
		return "<b>" .. d.name .. "</b>\n" .. d.desc .. "\n<color=#e0b95a>" .. left .. "</color>"
	end

	-- 긴 설명 창: 정보 창 바로 오른쪽(아래 맞춤, 폭 DebuffBoxW), 높이 = 설명 길이에 맞춤. 마우스를 받지 않는다
	@ExecSpace("ClientOnly")
	method void ShowTip(string id, number x)
		self:HideTip()
		if self.Panel == nil or not isvalid(self.Panel) or self.Target == nil or not isvalid(self.Target) then return end
		local list = self:DebuffList(self.Target.RtsMonsterComponent)
		local d = nil
		for i = 1, #list do
			if list[i].id == id then d = list[i] end
		end
		if d == nil then return end
		local H = _RtsHudLogic
		local W = self.DebuffBoxW
		-- 한 줄 약 18자(16pt, 폭 W−24) — 한글 3바이트 기준 어림, 넉넉히(글이 넘치면 라벨 BestFit이 줄인다)
		local chars = math.ceil(string.len(d.desc) / 2.6)
		local lines = math.max(1, math.ceil(chars / 18))
		local h = math.max(self.PanelH, 16 + 26 + lines * 23 + 26)
		local tip = H:SpawnPanel("RtsMonInfoTip", self.Panel, Vector2(1, 0), Vector2(0, 0), Vector2(8, 0), Vector2(W, h), Color(0.11, 0.094, 0.075, 0.97), H:ColGold(), 1.5)
		self.Tip = tip.Parent
		self.Tip.SpriteGUIRendererComponent.RaycastTarget = false
		tip.SpriteGUIRendererComponent.RaycastTarget = false
		self.TipId = id
		self.TipText = H:SpawnLabel("RtsMonInfoTipText", tip, Vector2(0, 1), Vector2(0, 1), Vector2(12, -10), Vector2(W - 24, h - 20), self:TipBody(d), H:ColInk(), 16, TextAlignmentType.UpperLeft, false)
		self.TipText.TextComponent.IsRichText = true
		self.TipText.SpriteGUIRendererComponent.RaycastTarget = false
	end

	@ExecSpace("ClientOnly")
	method void HideTip()
		if self.Tip ~= nil and isvalid(self.Tip) then self.Tip:Destroy() end
		self.Tip = nil
		self.TipText = nil
		self.TipId = ""
	end

end
