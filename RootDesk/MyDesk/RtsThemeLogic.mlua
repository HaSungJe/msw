-- rts-base: 트랙/타일 테마 프리셋 (2026-09-14 사용자 지시 — "트랙/타일은 프리셋 가능하도록")
--   프리셋 = 바닥 타일 이름(+변형 타일·비율) + 그리드 트랙 텍스처 RUID(+틴트) + 배경 사물 목록(공식 스프라이트, 칸 좌표) + 썸네일 묶음. 타일은 CaveFloorTileSet 안의 Name.
--   2026-09-25 사용자 "맵 테마 여러 개 — 헤네시스/엘리니아/페리온/커닝시티/리스항구, 기본은 헤네시스, 선택하면 내 맵/트랙이 바뀜(보이는 것만)":
--   테마는 **유저마다(= 그 유저 구역만)** 적용한다(ApplyToZone). 고르기·저장·보유는 RtsProfileLogic, 창은 RtsPopupLogic('profile' [테마] 탭).
--   2026-09-25 기본 마을 5종 디자인 적용(docs/design/theme-presets.md): 엘리니아·페리온·커닝·리스는 새 바닥 타일·테마 트랙 판·여백 장식, 5종 모두 400×240 썸네일. 헤네시스 바닥·트랙은 그대로, 여백 장식은 없음.
--   적용은 서버가 한다(타일·프롭이 서버 소유). 클라는 GetPreset·GetPresets로 읽기만.
@Logic
script RtsThemeLogic extends Logic

	-- 기본 테마 키(빈 구역·처음 입장·모르는 키)
	property string DefaultKey = "henesys"

	-- 서버: 구역 → 지금 적용된 테마 키(없으면 DefaultKey — EnsureZoneVisuals·EnsureGroundTiles가 기본으로 세운 상태)
	property table ZoneTheme = {}

	-- 장식물 자리(칸 좌표, col 1 = 첫 열 중앙이 0.5 → col 0.5 = 그리드 왼쪽 가장자리, col 16.5 = 오른쪽 가장자리; row도 같은 식, 13행 아래 가장자리 = 13.5).
	--   그리드는 16×13, 좌우 여백 4칸씩·위아래 0.25칸이라 **전부 좌우 여백에만** 둔다(2026-09-20 사용자 "타일에 오브젝트 안 겹치게"). 칸 1.78유닛, PPU 100.
	--   헤네시스는 공식 탑뷰 오브젝트 23개(GetHenesysDecor)를 두었다가 2026-09-25 사용자 "헤네시스 테마에 좌/우 설치된 오브젝트들 제거"로 뺐다(장식 없음 — 마을 풍경 배경만)
	-- 마을 장식(2026-09-25 테마 디자인): 큰 투명 컷아웃 하나~둘을 좌우 여백에. 원본(1024~1203px)을 반으로 줄여 올려서 scale은 가이드라인 값 × 2
	--   {ruid, col, row, scale, flip} — flip = 좌우 뒤집기(SpriteRenderer FlipX). 전투판(col 1~16)·오른쪽 row<8(영입 HUD 밑)에는 닿지 않게
	method table GetElliniaDecor()
		return {
			{ ruid = "487afe0def6249baad65871d93a81cb7", col = -1.8, row = 5.6, scale = 0.86 },  -- 거목(4.4×6.6). 가이드 row 4.0은 윗부분이 좌상단 HUD(프로필 상자·유저 카드)에 가려 5.6으로
			{ ruid = "487afe0def6249baad65871d93a81cb7", col = 18.2, row = 10.5, scale = 0.6, flip = true },  -- 작은 거목, 뒤집어 복제처럼 안 보이게
		}
	end

	method table GetPerionDecor()
		return {
			{ ruid = "d5ea7c706994465d93b72b44bc5b4241", col = -1.8, row = 8.5, scale = 0.8 },  -- 절벽 마을(4.5×5.5)
		}
	end

	method table GetKerningDecor()
		return {
			{ ruid = "0dff7e125801459099ca68b008841616", col = 18.1, row = 10.0, scale = 0.76, flip = true },  -- 공사장(3.9×5.8) — 추락주의 면이 전투판 쪽
		}
	end

	method table GetLithDecor()
		return {
			{ ruid = "4801d34b001d49dabda05a25d265ac42", col = -1.7, row = 9.8, scale = 0.7 },  -- 범선(4.2×4.6)
		}
	end

	-- 배경 사물 공통: 그리드 위·불투명 (유닛·몹은 200~)
	method number GetDecorOrder()
		return 110
	end

	method number GetDecorAlpha()
		return 1
	end

	-- 프리셋 표(표 순서 = 테마 창 순서). 새 테마 = 여기 한 줄 + 타일셋에 타일 1개 + 그리드 텍스처 1장(assets/textures/README.md 절차) + 장식물 목록 + 썸네일 — docs/theme-presets.md
	--   key       저장 값(유저 DataStorage "theme")·RPC 인자 — 한 번 정하면 바꾸지 않는다
	--   tab       테마 창 탭 이름(같은 이름끼리 한 탭). 지금은 '기본'만
	--   gridTint  트랙 판 색 입히기. 테마별 트랙 판이 있어 지금은 모두 흰색
	--   backgroundRUID  마을 풍경 스프라이트 RUID(1920×1080). 트랙 판 아래, 바닥 타일 위에 배치
	--   backgroundAlpha 풍경 투명도. 트랙·발판과 전투 UI가 읽히도록 약간 낮춘다
	--   thumb     같은 풍경을 줄인 썸네일 RUID(400×240, "" = 없음 → color로 칠함) — 프로필 창 테마 카드·프로필 상자·유저 카드 배경
	--   free      true = 누구나 보유(기본 지급). false면 유저 보유 목록(DataStorage "themes")에 있어야 고를 수 있다(2026-09-25 사용자 "테마·비석·아이콘 모두 영구 소유")
	--   바닥 타일·트랙 판·장식·썸네일 RUID와 원본 PNG 경로는 assets/textures/README.md
	method table GetPresets()
		return {
			{ key = "henesys", name = "헤네시스", tab = "기본", floorTile = "HenesysGrass1", floorVariants = { "HenesysGrass2", "HenesysGrass3" }, variantRatio = 0.12,
				gridRUID = "a752d95ae8f84f9291047ae34b00416f", gridTint = Color(1, 1, 1, 1), decor = {}, backgroundRUID = "e1886576584e4e3f99c9912abf75c489", backgroundAlpha = 0.78, thumb = "bf5c2956120046aab843eb14f562b925", color = Color(0.42, 0.66, 0.3, 1), free = true }, -- 2026-09-25 M2 경로(ZoneTrackGridM2 — 보스 가운데 2×2, S 화살표·E 되돌리기)
			{ key = "ellinia", name = "엘리니아", tab = "기본", floorTile = "ElliniaMoss", floorVariants = {}, variantRatio = 0,
				gridRUID = "7831f90d580d4c1e92629f326c82eaa9", gridTint = Color(1, 1, 1, 1), decor = self:GetElliniaDecor(), backgroundRUID = "83bbe809e077494094ebdaa6dfd1a720", backgroundAlpha = 0.78, thumb = "f307b6caed814747aec03e3483777254", color = Color(0.25, 0.55, 0.47, 1), free = true },
			{ key = "perion", name = "페리온", tab = "기본", floorTile = "PerionEarth", floorVariants = {}, variantRatio = 0,
				gridRUID = "9ed4e22a587c4e068b7b832b890aa019", gridTint = Color(1, 1, 1, 1), decor = self:GetPerionDecor(), backgroundRUID = "cf6f24aaecac4f5e88464b8e02a21c2a", backgroundAlpha = 0.78, thumb = "fd0451c462a14c91ab45582a08484353", color = Color(0.66, 0.44, 0.26, 1), free = true },
			{ key = "kerning", name = "커닝시티", tab = "기본", floorTile = "KerningPavement", floorVariants = {}, variantRatio = 0,
				gridRUID = "e0721799e39d4ecebf723b842c013b74", gridTint = Color(1, 1, 1, 1), decor = self:GetKerningDecor(), backgroundRUID = "e2f7cda163294b3b8d8ab956f2966bda", backgroundAlpha = 0.78, thumb = "457ec944d357431ba1642520d7d4eb16", color = Color(0.4, 0.4, 0.54, 1), free = true },
			{ key = "lith", name = "리스항구", tab = "기본", floorTile = "LithSand", floorVariants = {}, variantRatio = 0,
				gridRUID = "7b1ad42ce59245eea17e52ab201b4dde", gridTint = Color(1, 1, 1, 1), decor = self:GetLithDecor(), backgroundRUID = "89b81c540feb454796ba78a0025b7223", backgroundAlpha = 0.78, thumb = "7653fa3a53314b43a2aa4b16ccae3adc", color = Color(0.33, 0.56, 0.8, 1), free = true },
		}
	end

	-- 탭 이름(표 순서대로, 중복 없이)
	method table GetTabs()
		local out = {}
		local seen = {}
		local list = self:GetPresets()
		for i = 1, #list do
			local t = list[i].tab or "기본"
			if not seen[t] then
				seen[t] = true
				out[#out + 1] = t
			end
		end
		return out
	end

	method boolean HasKey(string key)
		local list = self:GetPresets()
		for i = 1, #list do
			if list[i].key == key then return true end
		end
		return false
	end

	-- 없는 키면 기본(헤네시스)
	method table GetPreset(string key)
		local list = self:GetPresets()
		for i = 1, #list do
			if list[i].key == key then return list[i] end
		end
		return list[1]
	end

	method string GetZoneTheme(number zone)
		local k = self.ZoneTheme[math.floor(zone + 0.5)]
		if k == nil or k == "" then return self.DefaultKey end
		return k
	end

	-- 구역 하나에 테마 적용(서버): 그 구역 사각형 바닥 타일 · 구역 트랙 판(텍스처 + 틴트) · 구역 여백 장식. 같은 테마면 아무것도 안 한다
	--   2026-09-25 — 전엔 ApplyPreset(key)가 8구역·바닥 전체를 한꺼번에 바꿨다(한 사람이 바꾸면 모두 바뀜)
	@ExecSpace("ServerOnly")
	method boolean ApplyToZone(number zone, string key)
		local z = math.floor(zone + 0.5)
		if z < 1 or z > _RtsZoneLogic:GetZoneCount() then return false end
		if not self:HasKey(key) then
			_RtsConfigLogic:Log("RtsTheme: unknown preset " .. key)
			return false
		end
		if self:GetZoneTheme(z) == key then return true end
		local preset = self:GetPreset(key)
		_RtsBootstrapLogic:FillZoneTiles(z, preset.floorTile, preset.floorVariants, preset.variantRatio)
		_RtsZoneLogic:SetZoneBackground(z, preset.backgroundRUID, preset.backgroundAlpha)
		_RtsZoneLogic:SetZoneGrid(z, preset.gridRUID, preset.gridTint)
		_RtsZoneLogic:SetZoneDecor(z, preset.decor)
		self.ZoneTheme[z] = key
		_RtsConfigLogic:Log("RtsTheme: zone " .. string.format("%d", z) .. " → " .. key)
		return true
	end

end
