-- rts-base: 트랙/타일 테마 프리셋 (2026-09-14 사용자 지시 — "트랙/타일은 프리셋 가능하도록")
--   프리셋 = 바닥 타일 이름(+변형 타일·비율) + 그리드 트랙 텍스처 RUID(+틴트) + 배경 사물 목록(공식 스프라이트, 칸 좌표) + 썸네일 묶음. 타일은 CaveFloorTileSet 안의 Name.
--   2026-09-25 사용자 "맵 테마 여러 개 — 헤네시스/엘리니아/페리온/커닝시티/리스항구, 기본은 헤네시스, 선택하면 내 맵/트랙이 바뀜(보이는 것만)":
--   테마는 **유저마다(= 그 유저 구역만)** 적용한다(ApplyToZone). 고르기·저장은 RtsProfileLogic, 창은 RtsPopupLogic('theme').
--   헤네시스 외 4종은 기능 뼈대용 임시 모양(기존 타일 + 트랙 판 틴트, 장식·썸네일 없음) — 실제 디자인은 ChatGPT가 docs/theme-presets.md를 보고 이 표만 바꾼다.
--   적용은 서버가 한다(타일·프롭이 서버 소유). 클라는 GetPreset·GetPresets로 읽기만.
@Logic
script RtsThemeLogic extends Logic

	-- 기본 테마 키(빈 구역·처음 입장·모르는 키)
	property string DefaultKey = "henesys"

	-- 서버: 구역 → 지금 적용된 테마 키(없으면 DefaultKey — EnsureZoneVisuals·EnsureGroundTiles가 기본으로 세운 상태)
	property table ZoneTheme = {}

	-- 배경 사물: 공식 MSW 탑뷰 헤네시스 오브젝트(maplestory/map/obj/msw/topview_henesys/*)를 **트랙·발판 영역 바깥**에만
	--   (2026-09-14 사용자: 안쪽은 유닛 자리라 배경과 겹치면 안 됨). 왼쪽 여백·오른쪽 16~18열·위쪽 띠. 불투명, 그리드 위(OrderInLayer 110).
	--   {ruid, col, row} — 그리드 칸 좌표(1-기반, 소수 허용). 화면은 열 -2.75~20.25 / 행 0~12.5
	-- 장식물 자리(칸 좌표, col 1 = 첫 열 중앙이 0.5 → col 0.5 = 그리드 왼쪽 가장자리, col 16.5 = 오른쪽 가장자리; row도 같은 식, 13행 아래 가장자리 = 13.5).
	--   2026-09-20 사용자 "타일에 오브젝트 안 겹치게": 그리드는 16×13, 좌우 여백 4칸씩·위아래 0.25칸이라 **전부 좌우 여백에만** 둔다(윗줄 덤불·건초는 뺌).
	--   스프라이트 크기(PPU 100, 칸 1.78유닛): 건물 1.2~2.4칸, 나무 ≈1칸, 덤불 0.6~0.75칸, 건초 0.5~0.95칸, 깃발 0.4칸. 오른쪽은 x 18칸 이후가 영입 HUD 밑이라 큰 건물은 아래쪽(8행~)에
	method table GetHenesysDecor()
		return {
			-- 왼쪽 여백(x −3.5 ~ −0.6)
			{ ruid = "6776ca0ef83c4e64b94e1a1818295bbe", col = -1.5, row = 3.0 },  -- building/2 (1.9×1.5)
			{ ruid = "f333071fcb09429fb8b5615fcf90a957", col = -1.5, row = 7.0 },  -- building/4 (1.8×1.4)
			{ ruid = "a9144c7f9fb04f9281c0f1df560db3e1", col = -1.5, row = 11.0 },  -- building/7 (1.7×1.3)
			{ ruid = "b71bcab7f8a74573ad8c85c81c64036a", col = -2.9, row = 1.3 },  -- tree/0
			{ ruid = "5cd0f21502dd41bc8db9bc933d7b609c", col = -2.9, row = 5.0 },  -- tree/1
			{ ruid = "3a2c81b1fd684b0d82482d9677572285", col = -2.9, row = 9.0 },  -- tree/3
			{ ruid = "c7f0b7d9751e4c07bc14315983232dbe", col = -2.9, row = 12.6 },  -- tree/2
			{ ruid = "5b2061db8fa24cfdbcd7742a6128690a", col = -0.8, row = 1.2 },  -- hay
			{ ruid = "2d93a94442c747b7a53bd849ad757f61", col = -0.7, row = 5.0 },  -- bush
			{ ruid = "3e79cbf6ae7643bc91d2a527a6b35ff3", col = -0.7, row = 9.0 },  -- bush
			{ ruid = "b7f991fecbe04454bc8d97df629aca55", col = -0.6, row = 12.8 },  -- flag
			-- 오른쪽 여백(x 16.6 ~ 19.4; HUD 밑 피해 큰 건물은 8행 아래)
			{ ruid = "27104f25e3784ba6be376ee17b200451", col = 17.3, row = 2.0 },  -- building/6 (1.3×1.3)
			{ ruid = "a8165f6fa7a8458190fff745e9d4ebbd", col = 17.3, row = 4.9 },  -- building/9 (1.2×1.7)
			{ ruid = "3cf6b9e903e645c295fadfa6bb0548b0", col = 17.8, row = 8.0 },  -- building/3 (2.0×1.4)
			{ ruid = "44dbaa45a1b34854a581ec90253aefef", col = 18.0, row = 11.2 },  -- building/1 (2.4×1.9)
			{ ruid = "5cd0f21502dd41bc8db9bc933d7b609c", col = 17.2, row = 6.5 },  -- tree/1
			{ ruid = "b71bcab7f8a74573ad8c85c81c64036a", col = 17.0, row = 9.7 },  -- tree/0
			{ ruid = "3a2c81b1fd684b0d82482d9677572285", col = 19.0, row = 6.6 },  -- tree/3
			{ ruid = "c7f0b7d9751e4c07bc14315983232dbe", col = 17.0, row = 12.6 },  -- tree/2
			{ ruid = "3e79cbf6ae7643bc91d2a527a6b35ff3", col = 16.9, row = 1.0 },  -- bush
			{ ruid = "2d93a94442c747b7a53bd849ad757f61", col = 16.9, row = 3.5 },  -- bush
			{ ruid = "ebcdd844b63043d1a755c2fd1511e986", col = 19.0, row = 9.9 },  -- hay
			{ ruid = "d1a0f546529540dca4f00bc2c8a3cf7f", col = 16.9, row = 8.1 },  -- flag
			{ ruid = "2e2fdcacb22d4d59877d4a7ca1469ef2", col = 19.2, row = 12.9 },  -- bench
		}
	end

	-- 배경 사물 공통: 그리드 위·불투명 (유닛·몹은 200~)
	method number GetDecorOrder()
		return 110
	end

	method number GetDecorAlpha()
		return 1
	end

	-- 프리셋 표(표 순서 = 테마 창 순서). 새 테마 = 여기 한 줄 + 타일셋에 타일 1개 + 그리드 텍스처 1장(assets/textures/README.md 절차) + 장식물 목록 + 썸네일 — docs/theme-presets.md
	--   key       저장 값(유저 DataStorage "theme")·RPC 인자 — 한 번 정하면 바꾸지 않는다
	--   tab       테마 창 탭 이름(같은 이름끼리 한 탭). 지금은 '기본'만
	--   gridTint  트랙 판 색 입히기(임시 모양용). 디자인 텍스처가 오면 흰색으로
	--   thumb     썸네일 스프라이트 RUID("" = 없음 → color로 칠함) — 테마 창 카드·테마 상자·유저 카드 배경
	method table GetPresets()
		return {
			{ key = "henesys", name = "헤네시스", tab = "기본", floorTile = "HenesysGrass1", floorVariants = { "HenesysGrass2", "HenesysGrass3" }, variantRatio = 0.12,
				gridRUID = "95b3ec9d377e46ecb9d394467d27dada", gridTint = Color(1, 1, 1, 1), decor = self:GetHenesysDecor(), thumb = "", color = Color(0.42, 0.66, 0.3, 1) }, -- 2026-09-20 16×13(ZoneTrackGridHenesys16)
			-- ↓ 임시 모양(2026-09-25 뼈대) — 기존 타일 + 트랙 판 틴트. ChatGPT가 floorTile·gridRUID·decor·thumb를 바꾼다
			{ key = "ellinia", name = "엘리니아", tab = "기본", floorTile = "HenesysGrassFloor", floorVariants = {}, variantRatio = 0,
				gridRUID = "95b3ec9d377e46ecb9d394467d27dada", gridTint = Color(0.7, 0.95, 0.86, 1), decor = {}, thumb = "", color = Color(0.25, 0.55, 0.47, 1) },
			{ key = "perion", name = "페리온", tab = "기본", floorTile = "HenesysSoil", floorVariants = {}, variantRatio = 0,
				gridRUID = "95b3ec9d377e46ecb9d394467d27dada", gridTint = Color(1, 0.82, 0.64, 1), decor = {}, thumb = "", color = Color(0.66, 0.44, 0.26, 1) },
			{ key = "kerning", name = "커닝시티", tab = "기본", floorTile = "HenesysStone1", floorVariants = {}, variantRatio = 0,
				gridRUID = "95b3ec9d377e46ecb9d394467d27dada", gridTint = Color(0.8, 0.78, 0.95, 1), decor = {}, thumb = "", color = Color(0.4, 0.4, 0.54, 1) },
			{ key = "lith", name = "리스항구", tab = "기본", floorTile = "ElnathSnowFloor", floorVariants = {}, variantRatio = 0,
				gridRUID = "95b3ec9d377e46ecb9d394467d27dada", gridTint = Color(0.72, 0.88, 1, 1), decor = {}, thumb = "", color = Color(0.33, 0.56, 0.8, 1) },
		}
	end

	-- 탭 이름(표 순서대로, 중복 없이)
	method table GetTabs()
		local out = {}
		local seen = {}
		local list = self:GetPresets()
		for i = 1, #list do
			local t = list[i].tab or "기본"
			if not seen[t] then
				seen[t] = true
				out[#out + 1] = t
			end
		end
		return out
	end

	method boolean HasKey(string key)
		local list = self:GetPresets()
		for i = 1, #list do
			if list[i].key == key then return true end
		end
		return false
	end

	-- 없는 키면 기본(헤네시스)
	method table GetPreset(string key)
		local list = self:GetPresets()
		for i = 1, #list do
			if list[i].key == key then return list[i] end
		end
		return list[1]
	end

	method string GetZoneTheme(number zone)
		local k = self.ZoneTheme[math.floor(zone + 0.5)]
		if k == nil or k == "" then return self.DefaultKey end
		return k
	end

	-- 구역 하나에 테마 적용(서버): 그 구역 사각형 바닥 타일 · 구역 트랙 판(텍스처 + 틴트) · 구역 여백 장식. 같은 테마면 아무것도 안 한다
	--   2026-09-25 — 전엔 ApplyPreset(key)가 8구역·바닥 전체를 한꺼번에 바꿨다(한 사람이 바꾸면 모두 바뀜)
	@ExecSpace("ServerOnly")
	method boolean ApplyToZone(number zone, string key)
		local z = math.floor(zone + 0.5)
		if z < 1 or z > _RtsZoneLogic:GetZoneCount() then return false end
		if not self:HasKey(key) then
			_RtsConfigLogic:Log("RtsTheme: unknown preset " .. key)
			return false
		end
		if self:GetZoneTheme(z) == key then return true end
		local preset = self:GetPreset(key)
		_RtsBootstrapLogic:FillZoneTiles(z, preset.floorTile, preset.floorVariants, preset.variantRatio)
		_RtsZoneLogic:SetZoneGrid(z, preset.gridRUID, preset.gridTint)
		_RtsZoneLogic:SetZoneDecor(z, preset.decor)
		self.ZoneTheme[z] = key
		_RtsConfigLogic:Log("RtsTheme: zone " .. string.format("%d", z) .. " → " .. key)
		return true
	end

end
