-- rts-base: 트랙/타일 테마 프리셋 (2026-09-14 사용자 지시 — "트랙/타일은 프리셋 가능하도록")
--   프리셋 = 바닥 타일 이름(+변형 타일·비율) + 그리드 트랙 텍스처 RUID + 배경 사물 목록(공식 스프라이트, 칸 좌표) 묶음. 타일은 CaveFloorTileSet 안의 Name.
--   기본은 헤네시스. 프리셋 선택 UI·과금은 나중(로드맵 Phase 10 이후) — 여기는 단일 소스와 적용 함수만.
--   적용은 서버가 한다(타일·프롭이 서버 소유). 클라는 GetActiveKey/GetPreset로 읽기만.
@Logic
script RtsThemeLogic extends Logic

	property string ActiveKey = "henesys"

	-- 배경 사물: 공식 MSW 탑뷰 헤네시스 오브젝트(maplestory/map/obj/msw/topview_henesys/*)를 **트랙·발판 영역 바깥**에만
	--   (2026-09-14 사용자: 안쪽은 유닛 자리라 배경과 겹치면 안 됨). 왼쪽 여백·오른쪽 16~18열·위쪽 띠. 불투명, 그리드 위(OrderInLayer 110).
	--   {ruid, col, row} — 그리드 칸 좌표(1-기반, 소수 허용). 화면은 열 -2.75~20.25 / 행 0~12.5
	-- 장식물 자리(칸 좌표, col 1 = 첫 열 중앙이 0.5 → col 0.5 = 그리드 왼쪽 가장자리, col 16.5 = 오른쪽 가장자리; row도 같은 식, 13행 아래 가장자리 = 13.5).
	--   2026-09-20 사용자 "타일에 오브젝트 안 겹치게": 그리드는 16×13, 좌우 여백 4칸씩·위아래 0.25칸이라 **전부 좌우 여백에만** 둔다(윗줄 덤불·건초는 뺌).
	--   스프라이트 크기(PPU 100, 칸 1.78유닛): 건물 1.2~2.4칸, 나무 ≈1칸, 덤불 0.6~0.75칸, 건초 0.5~0.95칸, 깃발 0.4칸. 오른쪽은 x 18칸 이후가 영입 HUD 밑이라 큰 건물은 아래쪽(8행~)에
	method table GetHenesysDecor()
		return {
			-- 왼쪽 여백(x −3.5 ~ −0.6)
			{ ruid = "6776ca0ef83c4e64b94e1a1818295bbe", col = -1.5, row = 3.0 },  -- building/2 (1.9×1.5)
			{ ruid = "f333071fcb09429fb8b5615fcf90a957", col = -1.5, row = 7.0 },  -- building/4 (1.8×1.4)
			{ ruid = "a9144c7f9fb04f9281c0f1df560db3e1", col = -1.5, row = 11.0 },  -- building/7 (1.7×1.3)
			{ ruid = "b71bcab7f8a74573ad8c85c81c64036a", col = -2.9, row = 1.3 },  -- tree/0
			{ ruid = "5cd0f21502dd41bc8db9bc933d7b609c", col = -2.9, row = 5.0 },  -- tree/1
			{ ruid = "3a2c81b1fd684b0d82482d9677572285", col = -2.9, row = 9.0 },  -- tree/3
			{ ruid = "c7f0b7d9751e4c07bc14315983232dbe", col = -2.9, row = 12.6 },  -- tree/2
			{ ruid = "5b2061db8fa24cfdbcd7742a6128690a", col = -0.8, row = 1.2 },  -- hay
			{ ruid = "2d93a94442c747b7a53bd849ad757f61", col = -0.7, row = 5.0 },  -- bush
			{ ruid = "3e79cbf6ae7643bc91d2a527a6b35ff3", col = -0.7, row = 9.0 },  -- bush
			{ ruid = "b7f991fecbe04454bc8d97df629aca55", col = -0.6, row = 12.8 },  -- flag
			-- 오른쪽 여백(x 16.6 ~ 19.4; HUD 밑 피해 큰 건물은 8행 아래)
			{ ruid = "27104f25e3784ba6be376ee17b200451", col = 17.3, row = 2.0 },  -- building/6 (1.3×1.3)
			{ ruid = "a8165f6fa7a8458190fff745e9d4ebbd", col = 17.3, row = 4.9 },  -- building/9 (1.2×1.7)
			{ ruid = "3cf6b9e903e645c295fadfa6bb0548b0", col = 17.8, row = 8.0 },  -- building/3 (2.0×1.4)
			{ ruid = "44dbaa45a1b34854a581ec90253aefef", col = 18.0, row = 11.2 },  -- building/1 (2.4×1.9)
			{ ruid = "5cd0f21502dd41bc8db9bc933d7b609c", col = 17.2, row = 6.5 },  -- tree/1
			{ ruid = "b71bcab7f8a74573ad8c85c81c64036a", col = 17.0, row = 9.7 },  -- tree/0
			{ ruid = "3a2c81b1fd684b0d82482d9677572285", col = 19.0, row = 6.6 },  -- tree/3
			{ ruid = "c7f0b7d9751e4c07bc14315983232dbe", col = 17.0, row = 12.6 },  -- tree/2
			{ ruid = "3e79cbf6ae7643bc91d2a527a6b35ff3", col = 16.9, row = 1.0 },  -- bush
			{ ruid = "2d93a94442c747b7a53bd849ad757f61", col = 16.9, row = 3.5 },  -- bush
			{ ruid = "ebcdd844b63043d1a755c2fd1511e986", col = 19.0, row = 9.9 },  -- hay
			{ ruid = "d1a0f546529540dca4f00bc2c8a3cf7f", col = 16.9, row = 8.1 },  -- flag
			{ ruid = "2e2fdcacb22d4d59877d4a7ca1469ef2", col = 19.2, row = 12.9 },  -- bench
		}
	end

	-- 배경 사물 공통: 그리드 위·불투명 (유닛·몹은 200~)
	method number GetDecorOrder()
		return 110
	end

	method number GetDecorAlpha()
		return 1
	end

	-- 프리셋 표. 새 테마 = 여기 한 줄 + 타일셋에 타일 1개 + 그리드 텍스처 1장(assets/textures/README.md 절차) + 장식물 목록
	method table GetPresets()
		return {
			{ key = "henesys", name = "헤네시스", floorTile = "HenesysGrass1", floorVariants = { "HenesysGrass2", "HenesysGrass3" }, variantRatio = 0.12,
				gridRUID = "95b3ec9d377e46ecb9d394467d27dada", decor = self:GetHenesysDecor() }, -- 2026-09-20 16×13(ZoneTrackGridHenesys16). 이전 18×12 f8bf4274602c4d22b2e6643e114fbc5f
			{ key = "elnath", name = "엘나스", floorTile = "ElnathSnowFloor", floorVariants = {}, variantRatio = 0,
				gridRUID = "651583e1c1ee44cdb6d2a891755ab528", decor = {} }, -- 아직 18×12 텍스처 — 엘나스를 다시 쓰려면 gen-track-grid.js 회청 변형으로 16×13 재생성 필요
		}
	end

	method table GetPresetKeys()
		local keys = {}
		local list = self:GetPresets()
		for i = 1, #list do keys[i] = list[i].key end
		return keys
	end

	-- 없는 키면 첫 번째(기본) 프리셋
	method table GetPreset(string key)
		local list = self:GetPresets()
		for i = 1, #list do
			if list[i].key == key then return list[i] end
		end
		return list[1]
	end

	method string GetActiveKey()
		return self.ActiveKey
	end

	method string GetFloorTileName()
		return self:GetPreset(self.ActiveKey).floorTile
	end

	-- 바닥 변형 타일(꽃 등)과 비율 — FillGroundTiles가 무작위 칸에 섞는다
	method table GetFloorVariants()
		local v = self:GetPreset(self.ActiveKey).floorVariants
		if v == nil then return {} end
		return v
	end

	method number GetFloorVariantRatio()
		local r = self:GetPreset(self.ActiveKey).variantRatio
		if r == nil then return 0 end
		return r
	end

	method string GetGridRUID()
		return self:GetPreset(self.ActiveKey).gridRUID
	end

	method table GetDecor()
		return self:GetPreset(self.ActiveKey).decor
	end

	-- 프리셋 전환: 바닥 타일 다시 채우고 8구역 그리드 스프라이트·장식물 교체. 입장 전(시각화 전)에 불러도 안전
	@ExecSpace("ServerOnly")
	method boolean ApplyPreset(string key)
		local preset = self:GetPreset(key)
		if preset.key ~= key then
			_RtsConfigLogic:Log("RtsTheme: unknown preset " .. key)
			return false
		end
		self.ActiveKey = preset.key
		_RtsBootstrapLogic:FillGroundTiles(preset.floorTile, preset.floorVariants, preset.variantRatio)
		_RtsZoneLogic:SetGridRUID(preset.gridRUID)
		_RtsZoneLogic:SetDecor(preset.decor)
		_RtsConfigLogic:Log("RtsTheme: applied " .. preset.key)
		return true
	end

end
