-- Phase 6·7 (2026-09-23): 한 판 132 스테이지 + 몬스터 247종 표. 서버·클라 공용 읽기 전용.
--   데이터(BEGIN GENERATED ~ END GENERATED)는 tools/gen-stage-table.py가 로컬 .info(monster-wave·monster·level·balance-detail)에서 만든다 — 손으로 고치지 않는다.
--   스테이지 행: no(1~132) · tag(.info 태그 "1"~"115" / "보스") · name · kind("mob"/"boss"/"rest") · theme · bgm(배경음 RUID — monster-wave.md 'sound-N' 이름을 생성기가 변환) · sec · hp(몹 1마리 / 보스 1체) · meso(라운드 총액, 40마리 몫 = /40)
--               · special(메소 2배 라운드) · def(보스 방어율 %) · mobs(몬스터 id 목록)
--   몬스터 행: name · walk(이동 클립, 없으면 stand) · die(사망 클립) · dieSound · dieSec(사망 클립 길이) · scale · boxW·boxH·boxX·boxY(피격 박스, 로컬) · barY(체력바 높이, 세계)
--   · size(일반 몬스터 크기 배율, 없으면 1 — 엔티티 스케일 = scale × size, 체력바·데미지 숫자 높이도 × size. 2026-09-25 사용자: 리프레 켄타우로스부터 2 · 시간의 신전 3 · 미래의 헤네시스 2 · 황혼의 페리온 맵(인적이 끊긴 남쪽 길~원혼의 땅) 2)
@Logic
script RtsStageTableLogic extends Logic

	property boolean Loaded = false

	property table Stages = {}

	property table Monsters = {}

	-- 영입 칸이 열리는 순번(1 · 5 · 자쿰 26 · 혼테일 43 · 핑크빈 47 · 시그너스 56 — 2026-09-23 사용자)
	property table RecruitAt = {}

	property number SpawnPerStage = 40

	method void Ensure()
		if self.Loaded then return end
		self.Loaded = true
		self:LoadGenerated()
	end

	method number GetStageCount()
		self:Ensure()
		return #self.Stages
	end

	method table GetStage(number no)
		self:Ensure()
		return self.Stages[math.floor(no + 0.5)]
	end

	method table GetMonster(string id)
		self:Ensure()
		return self.Monsters[id]
	end

	-- 스테이지 no의 몬스터 1마리 메소(라운드 총액 ÷ 40 — 생성기가 400 단위로 맞춰 10메소 단위)
	method number GetMobMeso(number no)
		local s = self:GetStage(no)
		if s == nil or s.kind ~= "mob" then return 0 end
		return math.floor(s.meso / self.SpawnPerStage + 0.5)
	end

	method boolean IsBossStage(number no)
		local s = self:GetStage(no)
		return s ~= nil and s.kind == "boss"
	end

	-- 지금 순번에서 보유할 수 있는 유닛 수(카운트다운·1라운드 = 1, 5·26·43·47·56에서 1명씩, 최대 6)
	method number RecruitLimit(number stageNo)
		self:Ensure()
		local n = 0
		for i = 1, #self.RecruitAt do
			if self.RecruitAt[i] <= math.max(1, stageNo) then n = n + 1 end
		end
		return n
	end

	-- 다음 영입 칸이 열리는 순번(0 = 더 없음)
	method number NextRecruitStage(number stageNo)
		self:Ensure()
		for i = 1, #self.RecruitAt do
			if self.RecruitAt[i] > math.max(1, stageNo) then return self.RecruitAt[i] end
		end
		return 0
	end

	-- 화면용 맵 이름 "지역 - 맵"(2026-09-24 사용자 "맵 이름에 어느 대륙 — 엘나스 - 빙판조심, 레헬른 - 닭이 뛰노는 곳"). 지역 = 표의 theme.
	--   맵 이름이 이미 지역 이름으로 시작하면(고통의 미궁 중심부(1)) 반복하지 않고 맵 이름만
	method string FullName(any s)
		if s == nil then return "" end
		local t = s.theme or ""
		if t == "" or string.sub(s.name, 1, string.len(t)) == t then return s.name end
		return t .. " - " .. s.name
	end

