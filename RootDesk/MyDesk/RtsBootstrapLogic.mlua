-- rts-base bootstrap (화면 v2 — 구역 배정/그리드 시각화/플레이어 목록 통지)
@Logic
script RtsBootstrapLogic extends Logic

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		local userId = event.UserId
		local userEntity = _UserService:GetUserEntityByUserId(userId)
		if userEntity == nil then return end
		if userEntity.RtsCameraAnchorComponent == nil then
			userEntity:AddComponent("RtsCameraAnchorComponent")
		end
		self:EnsureGroundTiles()
		_RtsZoneLogic:EnsureZoneVisuals()
		_RtsDemoLogic:EnsureWalkers()

		-- 구역 배정 후 해당 클라에만 통지, 플레이어 목록은 전 클라에 통지
		local zone = _RtsZoneLogic:AssignZone(userId)
		if zone > 0 then
			userEntity.RtsCameraAnchorComponent:ApplyAssignedZone(zone, userId)
			-- 영입(Phase 5 #18) 전까지 시범 편성 3기 + 시범 메소
			_RtsUnitLogic:EnsureDemoUnits(userId, zone)
		end
		self:BroadcastPlayerList()
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		_RtsUnitLogic:RemoveUnits(event.UserId)
		_RtsZoneLogic:ReleaseZone(event.UserId)
		self:BroadcastPlayerList()
	end

	-- 배정 현황 → "userId(탭)닉네임(탭)구역(탭)생존" 줄바꿈 구분(구역순) → 모든 클라의 HUD 플레이어 목록 갱신
	--   생존은 탈락 판정(Phase 3 #13)이 생기기 전까지 항상 1
	@ExecSpace("ServerOnly")
	method void BroadcastPlayerList()
		local rows = {}
		for userId, zone in pairs(_RtsZoneLogic.ZoneByUser) do
			local nick = userId
			local e = _UserService:GetUserEntityByUserId(userId)
			if e ~= nil and e.PlayerComponent ~= nil and e.PlayerComponent.Nickname ~= "" then
				nick = e.PlayerComponent.Nickname
			end
			rows[#rows + 1] = { zone = zone, line = userId .. "\t" .. nick .. "\t" .. tostring(zone) .. "\t1" }
		end
		table.sort(rows, function(a, b) return a.zone < b.zone end)
		local packed = ""
		for i = 1, #rows do
			if i > 1 then packed = packed .. "\n" end
			packed = packed .. rows[i].line
		end
		_RtsHudLogic:RefreshPlayerList(packed)
	end

	-- 바닥 채우기 (멱등). 타일 크기는 RtsConfigLogic.FloorTileUnit, 사방 16유닛 여유
	--   어떤 타일로 채울지는 테마 프리셋(RtsThemeLogic)이 정한다
	@ExecSpace("ServerOnly")
	method void EnsureGroundTiles()
		local tm = _EntityService:GetEntityByPath("/maps/RtsMap/RectTileMap")
		if tm == nil then return end
		local tilemap = tm.RectTileMapComponent
		if tilemap == nil then return end
		local tileUnit = _RtsConfigLogic:GetFloorTileUnit()
		local tilesX = _RtsConfigLogic:GetMapCellsX() / tileUnit
		local tilesY = _RtsConfigLogic:GetMapCellsY() / tileUnit
		local pad = 16 / tileUnit
		local need = (tilesX + pad * 2) * (tilesY + pad * 2)
		if tilemap.TileCount >= need then return end
		self:FillGroundTiles(_RtsThemeLogic:GetFloorTileName(), _RtsThemeLogic:GetFloorVariants(), _RtsThemeLogic:GetFloorVariantRatio())
	end

	-- 바닥 전체를 주어진 타일(타일셋의 Name)로 다시 채운다 — 테마 전환도 이걸 쓴다
	--   variants가 있으면 ratio 비율만큼 무작위 칸을 변형 타일(꽃 등)로 바꿔 반복감을 줄인다(결정적 해시 → 매번 같은 자리)
	@ExecSpace("ServerOnly")
	method void FillGroundTiles(string tileName, table variants, number ratio)
		local tm = _EntityService:GetEntityByPath("/maps/RtsMap/RectTileMap")
		if tm == nil then return end
		local tilemap = tm.RectTileMapComponent
		if tilemap == nil then return end
		local tileUnit = _RtsConfigLogic:GetFloorTileUnit()
		tilemap.GridSize = Vector2(tileUnit, tileUnit)
		local tilesX = _RtsConfigLogic:GetMapCellsX() / tileUnit
		local tilesY = _RtsConfigLogic:GetMapCellsY() / tileUnit
		local pad = 16 / tileUnit
		tilemap:Clear()
		tilemap:BoxFill(tileName, Vector2Int(0 - pad, 0 - pad), Vector2Int(tilesX - 1 + pad, tilesY - 1 + pad))
		if variants == nil or #variants == 0 or ratio <= 0 then return end
		for y = 0 - pad, tilesY - 1 + pad do
			for x = 0 - pad, tilesX - 1 + pad do
				local h = ((x + 97) * 374761393 + (y + 89) * 668265263) % 1000003
				if (h % 1000) / 1000 < ratio then
					local v = variants[(h % #variants) + 1]
					tilemap:SetTile(v, x, y)
				end
			end
		end
	end

end
