-- rts-base bootstrap (화면 v2 — 구역 배정/그리드 시각화/플레이어 목록 통지)
@Logic
script RtsBootstrapLogic extends Logic

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		local userId = event.UserId
		-- 로비(정적 룸 · LobbyMap — Phase 8): 게임 로직 없이 로비만(RtsLobbyLogic). 게임은 방마다 인스턴스 룸(RtsMap)에서
		if not _RoomService:IsInstanceRoom() then
			_RtsLobbyLogic:OnUserEnter(userId)
			return
		end
		-- 게임 방: 키로 방 게임 / 혼자 하기를 가른다(첫 입장 때 한 번)
		_RtsStageLogic:ApplyRoomKey(_RoomService.RoomKey)
		local userEntity = _UserService:GetUserEntityByUserId(userId)
		if userEntity == nil then return end
		if userEntity.RtsCameraAnchorComponent == nil then
			userEntity:AddComponent("RtsCameraAnchorComponent")
		end
		self:EnsureGroundTiles()
		_RtsZoneLogic:EnsureZoneVisuals()

		-- 구역 배정 후 해당 클라에만 통지 → 한 판 진행에 합류(Phase 6: 입장 5초 뒤 시작, 판이 끝난 방이면 초기화 후 새 판). 플레이어 목록은 전 클라에 통지
		local zone = _RtsZoneLogic:AssignZone(userId)
		if zone > 0 then
			userEntity.RtsCameraAnchorComponent:ApplyAssignedZone(zone, userId)
			_RtsStageLogic:OnUserEnter(userId)
			-- 계정 꾸미기(테마·아이콘, 2026-09-25): 저장소에서 불러와 내 구역에 테마 적용 + 그 유저에게 전체 전달(목록은 아래 BroadcastPlayerList)
			_RtsProfileLogic:OnUserEnter(userId, zone)
			-- 방 게임이면 방 채팅 기록(RtsGameChatLogic — 혼자 하기엔 없음)
			_RtsGameChatLogic:OnUserEnter(userId)
		end
		self:BroadcastPlayerList()
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		if not _RoomService:IsInstanceRoom() then
			_RtsLobbyLogic:OnUserLeave(event.UserId)
			return
		end
		-- 게임 방: 우리가 로비로 보낸 게 아니면(접속 종료) 로비의 방에 알린다
		_RtsLobbyLogic:OnGameUserLeave(event.UserId)
		local zone = _RtsZoneLogic:GetZoneOfUser(event.UserId)
		_RtsUnitLogic:RemoveUnits(event.UserId)
		_RtsZoneLogic:ReleaseZone(event.UserId)
		_RtsStageLogic:OnUserLeave(event.UserId, zone)
		-- 빈 구역은 기본 테마로 되돌리고 프로필 메모리 정리
		_RtsProfileLogic:OnUserLeave(event.UserId, zone)
		self:BroadcastPlayerList()
	end

	-- 연결 끊김·재접속(2026-09-28 사용자 제보: 모바일에서 화면을 내렸다 올리면 몬스터가 멈추고, 죽거나 판이 끝나도(필드 0) 화면에 남음).
	--   재접속은 퇴장·입장이 아니라 같은 세션이 이어진다(메소·유닛·판 상태 유지). 화면의 몬스터가 서버와 끊긴 '유령'으로 남는 것으로 보여,
	--   재접속 뒤 서버가 지금 살아 있는 몬스터·보스·유닛 이름 목록을 두 번(ReconnectSyncDelays) 그 화면에 보내고, 화면은 목록에 없는 것만 숨긴다(ClearGhosts).
	--   원인 확인용으로 숨긴 수 · 서버 수 · 화면 수를 잠깐 안내한다
	property table ReconnectSyncDelays = { 1.5, 5 }

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserDisconnectEvent(UserDisconnectEvent event)
		_RtsConfigLogic:Log("RtsBootstrap: disconnect " .. event.UserId .. " map " .. tostring(event.DisconnectMapName))
		if not _RoomService:IsInstanceRoom() then return end
		-- 솔로 판은 자동 일시정지(RtsStageLogic.OnUserDisconnect)
		_RtsStageLogic:OnUserDisconnect(event.UserId)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserReconnectEvent(UserReconnectEvent event)
		local userId = event.UserId
		_RtsConfigLogic:Log("RtsBootstrap: reconnect " .. userId .. " map " .. tostring(event.ReconnectMapName))
		if not _RoomService:IsInstanceRoom() then return end
		for i = 1, #self.ReconnectSyncDelays do
			local first = i == 1
			_TimerService:SetTimerOnce(function() self:SendLiveList(userId, first) end, self.ReconnectSyncDelays[i])
		end
		self:BroadcastPlayerList()
		_RtsStageLogic:OnUserReconnect(userId)
	end

	-- 서버: 지금 판(보드 루트)에 살아 있는 몬스터·보스·유닛 엔티티 이름(몬스터 "Mob구역_번호" · 보스 "Boss구역_번호"는 판마다 겹치지 않는다)을 그 유저 화면으로
	@ExecSpace("ServerOnly")
	method void SendLiveList(string userId, boolean first)
		if _UserService:GetUserEntityByUserId(userId) == nil then return end
		local root = _RtsBoardViewLogic:GetRoot()
		if root == nil then return end
		local names = {}
		for _, typeName in ipairs({ "RtsMonsterComponent", "RtsUnitComponent" }) do
			local comps = root:GetChildComponentsByTypeName(typeName, false)
			for i = 1, #comps do
				local c = comps[i]
				if c ~= nil and c.Entity ~= nil and isvalid(c.Entity) then names[#names + 1] = c.Entity.Name end
			end
		end
		self:ClearGhosts(table.concat(names, ","), #names, first, userId)
	end

	-- 클라(그 유저에게만): 서버 목록에 없는 몬스터·유닛 = 재접속 전에 받은 채 서버와 끊긴 유령 → 숨긴다(지우지 않고 SetEnable(false) — 이 화면에만 적용)
	@ExecSpace("Client")
	method void ClearGhosts(string packed, number serverCount, boolean first, string userId)
		local live = {}
		for name in string.gmatch(packed, "[^,]+") do live[name] = true end
		-- 보드 루트("RtsBoard")가 재접속 뒤 새로 붙었을 수도 있어 맵 아래 같은 이름을 모두 훑고, 캐시한 루트도 비운다(다음 GetRoot가 다시 찾게)
		local roots = {}
		local map = _EntityService:GetEntityByPath("/maps/RtsMap")
		if map ~= nil then
			for _, child in ipairs(map.Children:ToTable()) do
				if child ~= nil and isvalid(child) and child.Name == "RtsBoard" then roots[#roots + 1] = child end
			end
		end
		_RtsBoardViewLogic._T.Root = nil
		local seen = 0
		local hidden = 0
		for r = 1, #roots do
			for _, typeName in ipairs({ "RtsMonsterComponent", "RtsUnitComponent" }) do
				local comps = roots[r]:GetChildComponentsByTypeName(typeName, false)
				for i = 1, #comps do
					local e = comps[i].Entity
					if e ~= nil and isvalid(e) and e.Enable then
						seen = seen + 1
						if not live[e.Name] then
							e:SetEnable(false)
							hidden = hidden + 1
						end
					end
				end
			end
		end
		log("RtsBootstrap: reconnect sync roots " .. string.format("%d", #roots) .. " server " .. string.format("%d", serverCount) .. " screen " .. string.format("%d", seen) .. " hidden " .. string.format("%d", hidden))
		-- 원인 확인용: 첫 번째는 늘, 두 번째는 정리한 게 있을 때만(재접속은 드물다 — 확인이 끝나면 정리가 있을 때만 띄우게 줄인다)
		if not first and hidden == 0 then return end
		local msg = "다시 연결됐어요 · 정리 " .. string.format("%d", hidden) .. " (서버 " .. string.format("%d", serverCount) .. " · 화면 " .. string.format("%d", seen) .. " · 판 " .. string.format("%d", #roots) .. ")"
		-- 솔로 판은 연결이 끊긴 동안 멈춰 둔다(RtsStageLogic.OnUserDisconnect) — [계속하기]로 이어서
		if _RtsStageLogic.Paused then msg = msg .. " · 멈춰 뒀어요, [계속하기]로 이어서" end
		_RtsHudLogic:ShowHintFor(msg, 6)
	end

	-- 배정 현황 → "userId(탭)닉네임(탭)구역(탭)생존(탭)테마(탭)아이콘" 줄바꿈 구분(구역순) → 모든 클라의 HUD 플레이어 목록(유저 카드) 갱신
	--   생존 = RtsRunResultLogic 상태(진행 중·클리어 1 / 탈락 0). 테마·아이콘 = RtsProfileLogic(2026-09-25 — 카드 배경 썸네일·동그란 아이콘)
	@ExecSpace("ServerOnly")
	method void BroadcastPlayerList()
		local rows = {}
		for userId, zone in pairs(_RtsZoneLogic.ZoneByUser) do
			local nick = userId
			local e = _UserService:GetUserEntityByUserId(userId)
			if e ~= nil and e.PlayerComponent ~= nil and e.PlayerComponent.Nickname ~= "" then
				nick = e.PlayerComponent.Nickname
			end
			local alive = "1"
			if _RtsRunResultLogic:GetState(userId) == 1 then alive = "0" end
			rows[#rows + 1] = { zone = zone, line = userId .. "\t" .. nick .. "\t" .. tostring(zone) .. "\t" .. alive .. "\t" .. _RtsProfileLogic:ThemeOf(userId) .. "\t" .. _RtsProfileLogic:IconOf(userId) }
		end
		table.sort(rows, function(a, b) return a.zone < b.zone end)
		local packed = ""
		for i = 1, #rows do
			if i > 1 then packed = packed .. "\n" end
			packed = packed .. rows[i].line
		end
		_RtsHudLogic:RefreshPlayerList(packed)
	end

	-- 바닥 사방 여유(유닛) — 맵 밖으로 카메라가 조금 나가도 빈 곳이 안 보이게
	property number GroundPad = 16

	-- 바닥 타일맵(RectTileMapComponent) — 없으면 nil
	@ExecSpace("ServerOnly")
	method any GroundTilemap()
		local tm = _EntityService:GetEntityByPath("/maps/RtsMap/RectTileMap")
		if tm == nil then return nil end
		return tm.RectTileMapComponent
	end

	-- 바닥 전체 칸 범위(맵 + 사방 GroundPad, 타일 칸 좌표) { x0, y0, x1, y1 }
	method table GroundBounds()
		local tileUnit = _RtsConfigLogic:GetFloorTileUnit()
		local tilesX = _RtsConfigLogic:GetMapCellsX() / tileUnit
		local tilesY = _RtsConfigLogic:GetMapCellsY() / tileUnit
		local pad = self.GroundPad / tileUnit
		return { x0 = 0 - pad, y0 = 0 - pad, x1 = tilesX - 1 + pad, y1 = tilesY - 1 + pad }
	end

	-- 바닥 채우기 (멱등). 타일 크기는 RtsConfigLogic.FloorTileUnit, 사방 GroundPad 여유
	--   어떤 타일로 채울지는 테마 프리셋(RtsThemeLogic)이 정한다
	@ExecSpace("ServerOnly")
	method void EnsureGroundTiles()
		local tilemap = self:GroundTilemap()
		if tilemap == nil then return end
		local b = self:GroundBounds()
		local need = (b.x1 - b.x0 + 1) * (b.y1 - b.y0 + 1)
		if tilemap.TileCount >= need then return end
		local preset = _RtsThemeLogic:GetPreset(_RtsThemeLogic.DefaultKey)
		self:FillGroundTiles(preset.floorTile, preset.floorVariants, preset.variantRatio)
	end

	-- 바닥 전체를 주어진 타일(타일셋의 Name)로 다시 채운다 — 처음 한 번(기본 테마). 유저 테마는 구역만(FillZoneTiles)
	--   variants가 있으면 ratio 비율만큼 무작위 칸을 변형 타일(꽃 등)로 바꿔 반복감을 줄인다(결정적 해시 → 매번 같은 자리)
	@ExecSpace("ServerOnly")
	method void FillGroundTiles(string tileName, table variants, number ratio)
		local tilemap = self:GroundTilemap()
		if tilemap == nil then return end
		local tileUnit = _RtsConfigLogic:GetFloorTileUnit()
		tilemap.GridSize = Vector2(tileUnit, tileUnit)
		local b = self:GroundBounds()
		tilemap:Clear()
		tilemap:BoxFill(tileName, Vector2Int(b.x0, b.y0), Vector2Int(b.x1, b.y1))
		self:ScatterVariants(tilemap, variants, ratio, b.x0, b.y0, b.x1, b.y1)
	end

	-- 구역 하나의 바닥만 다시 칠한다(테마 = 유저별, RtsThemeLogic.ApplyToZone — 2026-09-25).
	--   맵은 (0,0)부터 구역 2열 × 4행, 구역 한 칸 = 구역 간격(48×32유닛) = 타일 12×8칸(FloorTileUnit 4)이라 경계가 타일에 딱 맞는다.
	--   맨 바깥 구역은 EnsureGroundTiles의 사방 여유(GroundPad)까지 같이 칠한다
	@ExecSpace("ServerOnly")
	method void FillZoneTiles(number zone, string tileName, table variants, number ratio)
		local tilemap = self:GroundTilemap()
		if tilemap == nil then return end
		local C = _RtsConfigLogic
		local tileUnit = C:GetFloorTileUnit()
		local cols = C:GetZoneCols()
		local rows = C:GetZoneRows()
		local cr = C:ZoneColRow(zone)
		local col = cr.col
		local rowB = rows - 1 - cr.row
		local perX = math.floor(C:GetZonePitchX() / tileUnit + 0.5)
		local perY = math.floor(C:GetZonePitchY() / tileUnit + 0.5)
		local pad = math.floor(self.GroundPad / tileUnit + 0.5)
		local x0 = col * perX
		local x1 = x0 + perX - 1
		local y0 = rowB * perY
		local y1 = y0 + perY - 1
		if col == 0 then x0 = x0 - pad end
		if col == cols - 1 then x1 = x1 + pad end
		if rowB == 0 then y0 = y0 - pad end
		if rowB == rows - 1 then y1 = y1 + pad end
		tilemap:BoxFill(tileName, Vector2Int(x0, y0), Vector2Int(x1, y1))
		self:ScatterVariants(tilemap, variants, ratio, x0, y0, x1, y1)
	end

	-- 변형 타일(꽃 등)을 ratio 비율로 섞는다 — 칸 좌표 해시라 매번 같은 자리(FillGroundTiles·FillZoneTiles 공용)
	@ExecSpace("ServerOnly")
	method void ScatterVariants(any tilemap, table variants, number ratio, number x0, number y0, number x1, number y1)
		if variants == nil or #variants == 0 or ratio <= 0 then return end
		for y = y0, y1 do
			for x = x0, x1 do
				local h = ((x + 97) * 374761393 + (y + 89) * 668265263) % 1000003
				if (h % 1000) / 1000 < ratio then
					local v = variants[(h % #variants) + 1]
					tilemap:SetTile(v, x, y)
				end
			end
		end
	end

end
