-- Phase 4 합류(2026-09-23, revision-1 §2): 증강 표 — 정의·프리즘 지급·굴림·능력치 오버레이. 서버·클라 공용 읽기 전용.
--   원본 = .info/augmentation.md(사용자 확정 — 이름·효과).
--   2026-10-14 개편(사용자): 증강은 15,000메소 뽑기로 얻는다(2026-10-17 — 전 3,000 · 6,000)(라운드 지급·단계 I/II/III·유닛당 한도·특수 코어·거인 학살자 삭제).
--     같은 날 사용자 "브론즈/골드/실버를 다 없애자 — 일반 증강 95% · 프리즘 5%, 전체 중에 랜덤": 등급은 일반(normal)·프리즘 둘뿐.
--     일반 증강 = 공통 3종(어설픈·능숙한·완벽한 단련 — 수치 그대로) + 직업 증강 24종(사용자 '증강 목록 (2026.10.14)'). 뽑으면 27종 전체(내 직업이 아닌 것 포함)에서 서로 다른 3장(Roll — 가중치 같음) 중 하나.
--     증강끼리는 모두 합연산 — '최종 데미지 +n%'도 같은 종류(유닛 전체 fin · 스킬 하나 skillFin)끼리 더한 뒤 능력치에 한 번 곱한다(2026-10-14 사용자 "합연산").
--   프리즘 = 팬텀 잠금 해제 + 직업 전용 10(RtsJobTableLogic.GetPrisms의 id와 같다). 자쿰·시그너스·루시드 처치 직후 지급, 자쿰 보상만 전체에서 선택(PrismChoices), 나머지·뽑기 프리즘은 가중치 무작위 3장(Roll).
@Logic
script RtsAugmentTableLogic extends Logic

	property boolean Loaded = false

	-- id → 정의 { id, grade(normal 일반 / prism 프리즘), name, w(무작위 3장 가중치 — 일반은 모두 1), atk/pct/crit/critDmg(공통), job(직업 전용 프리즘), unlock(팬텀),
	--   직업 증강: forJob(대상 직업 — 공용이면 forJobs 목록) · needPrism(이 프리즘이 있는 유닛만) · kind/val/skills(효과 — AddJobAug 주석) }
	property table Defs = {}

	-- 등급(normal · prism) → id 목록(표 순서 — 일반은 공통이 먼저, 그다음 직업 증강)
	property table ByGrade = {}

	-- 한 판에 받을 수 있는 장수(2026-10-15 사용자 "프레이 최대 100%" · "쉐도우 파트너도 100%까지 — 유닛당 5개까지만" ·
	--   "동일 유닛 여러 개 영입 불가니까 프레이 7개, 쉐도우 파트너 5개, 가드 크러쉬 6개(상한 50%)만 등장"):
	--   프레이 강화 = 기본 30% + 10% × 7 = 100% / 쉐도우 파트너 강화 = 기본 50% + 10% × 5 = 100% / 가드 크러쉬 = 40레벨 20% + 5% × 6 = 50%.
	--   다 찬 유닛엔 지정 불가(RtsAugmentLogic.CanAssignTo), 이번 판에 받은 장수(지정 + 미지정)가 다 차면 일반 증강 선택지에 안 나온다(RtsAugmentLogic.NormalExclude)
	--   섀도어 레디 투 다이 강화 = 5장(최종 +8% × 5 = +40% — 2026-10-16 사용자 "섀도어가 너무 쌔다 · 레디 투 다이 증강은 5번까지만")
	--   샤프아이즈 강화 = 5장(2026-10-17 사용자 "샤프아이즈 강화는 5번까지만" — 보우마스터·신궁 공용이라 두 유닛 합쳐 5장, 같은 날 샤프아이즈 기본 50 → 30%: 30 + 4 × 5 = 50%)
	property table MaxStack = { bishop_pray = 7, nl_sp = 5, pal_gc = 6, shad_rtd = 5, archer_se = 5 }

	-- 가드 크러쉬 방어율 감소 상한(%) — 팔라딘 레벨 기준 + 증강 합이 넘지 않게(RtsCombatLogic.GuardCrush · RtsMonsterInfoLogic.GuardCrushOf)
	property number GuardCap = 50

	-- 대상 스킬 목록이 없는 직업 증강의 그림 스킬(SkillIconFor — 그 증강이 강화하는 스킬·버프 이름, RtsJobTableLogic.SkillIcon 표의 이름)
	property table IconSkill = { hero_combo = "콤보 어택", pal_gc = "가드 크러쉬", dk_beholder = "비홀더", dk_berserk = "버서크", archer_se = "샤프아이즈",
		bishop_pray = "프레이", nl_sp = "쉐도우 파트너", shad_rtd = "레디 투 다이", ph_aria = "프레이 오브 아리아", ph_bulls = "블스아이" }

	-- 프리즘 지급 = 이 순번의 보스를 잡았을 때(자쿰·시그너스·루시드 — 2026-09-23 3개로)
	property table PrismStages = {}

	method void Ensure()
		if self.Loaded then return end
		self.Loaded = true
		self.Defs = {}
		self.ByGrade = { normal = {}, prism = {} }
		-- 공통 증강(2026-10-14 사용자 "공격력%/크리티컬확률/크리티컬데미지 3%/4%/5% 모두 증가 + 공격력 30/40/50" — 같은 날 등급 삭제 뒤에도 "3종 그대로 섞기")
		self:AddStat({ id = "all_1", grade = "normal", w = 1, name = "어설픈 단련", atk = 30, pct = 3, crit = 3, critDmg = 3 })
		self:AddStat({ id = "all_2", grade = "normal", w = 1, name = "능숙한 단련", atk = 40, pct = 4, crit = 4, critDmg = 4 })
		self:AddStat({ id = "all_3", grade = "normal", w = 1, name = "완벽한 단련", atk = 50, pct = 5, crit = 5, critDmg = 5 })
		-- 직업 증강(2026-10-14 사용자 '증강 목록 (2026.10.14)' — "이거 기준으로 밸런스 다시 맞추자", 수치는 그대로). 같은 날 등급(브론즈·실버·골드) 삭제 — 모두 일반.
		--   { id, 직업(공용이면 목록), 이름, 종류, 값, 대상 스킬(목록), 필요 프리즘 } — 종류는 AddJobAug 주석
		local jobAugs = {
			{ "hero_rb", "hero", "레이징 블로우 강화", "skill", 30, { "레이징 블로우" } },
			{ "hero_combo", "hero", "콤보 어택 강화", "fin", 5 },
			{ "pal_dc", "paladin", "디바인 차지 강화", "skill", 100, { "디바인 차지" } },
			{ "pal_gc", "paladin", "가드 크러쉬", "guard", 5 },
			{ "dk_beholder", "dk", "비홀더 강화", "pct", 10 },
			{ "dk_berserk", "dk", "버서크 강화", "fin", 14 },
			{ "bow_storm", "bow", "폭풍의 시/애로우 레인 강화", "skillFin", 9, { "폭풍의 시", "애로우 레인" } },
			{ "archer_se", { "bow", "marks" }, "샤프아이즈 강화", "se", 4 },
			{ "marks_pierce", "marks", "피어싱 강화", "skill", 120, { "피어싱" } },
			{ "il_chain", "il", "체인 라이트닝 강화", "skill", 160, { "체인 라이트닝" } },
			{ "il_bliz1", "il", "블리자드 강화(1)", "proj", 1, { "블리자드" } },
			{ "il_bliz2", "il", "블리자드 강화(2)", "skillFin", 10, { "블리자드" } },
			{ "fp_poison", "fp", "포이즌 리전 강화", "skill", 50, { "포이즌 리전" } },
			{ "fp_dot1", "fp", "도트 퍼니셔 강화(1)", "proj", 1, { "도트 퍼니셔" } },
			{ "fp_dot2", "fp", "도트 퍼니셔 강화(2)", "skillFin", 12, { "도트 퍼니셔" } },
			{ "bishop_angel", "bishop", "엔젤레이/디바인 퍼니시먼트 강화", "skillFin", 30, { "엔젤레이", "디바인 퍼니시먼트" } },
			{ "bishop_pray", "bishop", "프레이 강화", "pray", 10 },
			{ "nl_quad", "nl", "쿼드러플 스로우/풍마수리검 강화", "skillFin", 15, { "쿼드러플 스로우", "풍마수리검" } },
			{ "nl_sp", "nl", "쉐도우 파트너 강화", "sp", 10 },
			{ "shad_blade", "shad", "블레이드 토네이도/카르마 퓨리 강화", "skillFin", 15, { "블레이드 토네이도 + 카르마 퓨리" }, "dualblade" },
			{ "shad_rtd", "shad", "레디 투 다이 강화", "fin", 8 },
			{ "ph_aria", "phantom", "프레이 오브 아리아 강화", "pct", 10 },
			{ "ph_bulls", "phantom", "블스아이 강화", "fin", 12 },
			{ "ph_joker", "phantom", "조커 강화", "skill", 50, { "조커" } },
		}
		for i = 1, #jobAugs do self:AddJobAug(jobAugs[i]) end
		-- 프리즘 — 직업(팬텀 잠금 해제·섀도어 전직) + 스킬(직업 전용) = RtsJobTableLogic.GetPrisms 정의를 그대로 쓴다. 특수 코어(일격필살·보스 슬레이어)는 2026-10-14 삭제
		local jobW = { phantom = 5, dualblade = 5 }
		local ps = _RtsJobTableLogic:GetPrisms()
		for i = 1, #ps do
			local p = ps[i]
			local w = jobW[p.id] or 7.5
			if p.id == "phantom" then
				self:AddPrism({ id = "phantom", name = "팬텀", w = w, unlock = "phantom", desc = "영웅 팬텀을 영입할 수 있게 된다." })
			else
				self:AddPrism({ id = p.id, name = p.name, w = w, job = p.job, desc = "[" .. _RtsJobTableLogic:GetJobName(p.job) .. " 전용 · 50레벨부터] " .. p.desc })
			end
		end
		-- 2026-09-23 사용자 "프리즘 개수 3개로 — 자쿰·시그너스·루시드 처치 후"(전 스우·진 힐라 포함 5개)
		self.PrismStages = { 26, 56, 89 }
	end

	method void AddStat(table d)
		self.Defs[d.id] = d
		local g = self.ByGrade[d.grade]
		g[#g + 1] = d.id
	end

	-- 직업 증강 한 줄 → 정의. 종류(kind) · 값(val):
	--   skill = 대상 스킬 데미지 +val%p(합연산 — 기본 공격이면 st.ratio, 지속 피해면 st.dotPct, 쿨 스킬이면 그 이름에 — RtsJobTableLogic.GetStatFor)
	--   skillFin = 대상 스킬의 최종 데미지 +val%(여러 장은 합 → ×(1 + 합)) / fin = 그 유닛 최종 데미지 +val%(여러 장은 합 → ×(1 + 합)) / pct = 공격력 +val%(합) / ign = 방어율 무시 +val%(합)
	--   proj = 대상 스킬 투사체 +val개(블리자드: 최대 대상 수 · 보스 타격 횟수, 도트 퍼니셔: 구체 수) / pray·se = 그 유닛이 거는 프레이·샤프아이즈 증가량 +val%p
	--   guard = 그 팔라딘의 가드 크러쉬(같은 구역 모든 적 방어율 감소) +val%(2026-10-15 사용자 "가드 크러쉬 증강으로 %를 올려도 몬스터 디버프에 20p" — 전엔 팔라딘 자신의 방무 ign이라 디버프에 안 보였다.
	--     RtsCombatLogic.GuardCrush · RtsMonsterInfoLogic.GuardCrushOf)
	--   sp = 쉐도우 파트너 데미지 +val%p(기본 50% · 최대 100% — RtsJobTableLogic.GetStatFor spRate)
	method void AddJobAug(table r)
		local d = { id = r[1], grade = "normal", w = 1, name = r[3], kind = r[4], val = r[5], skills = r[6], needPrism = r[7] }
		if type(r[2]) == "table" then
			d.forJobs = r[2]
			d.forJob = r[2][1]
		else
			d.forJob = r[2]
			d.forJobs = { r[2] }
		end
		self:AddStat(d)
	end

	-- 직업 증강을 받을 수 있는 직업인가(공용 forJobs 포함)
	method boolean IsForJob(table d, string jobId)
		if d == nil or d.forJobs == nil then return false end
		for i = 1, #d.forJobs do
			if d.forJobs[i] == jobId then return true end
		end
		return false
	end

	-- 직업 증강의 대상 표시("히어로" · "보우마스터·신궁" · 프리즘 조건이면 그 직업 이름 — 듀얼블레이더)
	method string JobLabel(table d)
		if d == nil or d.forJobs == nil then return "" end
		if d.needPrism == "dualblade" then return "듀얼블레이더" end
		local names = {}
		for i = 1, #d.forJobs do names[#names + 1] = _RtsJobTableLogic:GetJobName(d.forJobs[i]) end
		return table.concat(names, "·")
	end

	-- 지정 목록(쉼표 — RtsUnitComponent.Augs)에 증강 id가 몇 장 있는가
	method number CountIn(string augs, string id)
		local n = 0
		if augs == nil or augs == "" then return 0 end
		for a in string.gmatch(augs, "[^,]+") do
			if a == id then n = n + 1 end
		end
		return n
	end

	-- 대상 스킬 이름 표시("폭풍의 시·애로우 레인")
	method string SkillLabel(table d)
		if d == nil or d.skills == nil then return "" end
		return table.concat(d.skills, "·")
	end

	-- 직업 증강 그림 = 그 증강이 강화하는 스킬의 아이콘(2026-10-15 사용자 "증강이 각 스킬에 대한 정보 — 증강에 스킬 아이콘"):
	--   대상 스킬 첫째(skills) 또는 IconSkill → RtsJobTableLogic.SkillIcon(유닛 상세 스킬 탭과 같은 그림). 그 표에 없으면 필요 프리즘 그림(듀얼블레이더).
	--   공통 증강은 ""(능력치 그림 그대로 — RtsPopupLogic.SpawnAugIcon)
	method string SkillIconFor(table d)
		if d == nil or d.forJob == nil then return "" end
		local name = self.IconSkill[d.id]
		if name == nil and d.skills ~= nil then name = d.skills[1] end
		local ruid = ""
		if name ~= nil then ruid = _RtsJobTableLogic:SkillIcon(d.forJob, { name = name }) end
		if ruid == "" and d.needPrism ~= nil then
			local pz = _RtsJobTableLogic:GetPrism(d.needPrism)
			if pz ~= nil and pz.icon ~= nil then ruid = pz.icon end
		end
		return ruid
	end

	method void AddPrism(table d)
		d.grade = "prism"
		self.Defs[d.id] = d
		local g = self.ByGrade.prism
		g[#g + 1] = d.id
	end

	method any GetDef(string id)
		self:Ensure()
		return self.Defs[id]
	end

	-- 이 순번 보스를 잡으면 프리즘을 주는가
	method boolean IsPrismStage(number no)
		self:Ensure()
		local n = math.floor(no + 0.5)
		for i = 1, #self.PrismStages do
			if self.PrismStages[i] == n then return true end
		end
		return false
	end

	-- 이 순번 보스가 준 프리즘은 전체에서 고르는가 — 첫 프리즘 보스(자쿰)만(2026-09-27 사용자 "자쿰 한정으로 자쿰이 준 프리즘만 선택 가능")
	method boolean IsPrismPickStage(number no)
		self:Ensure()
		return #self.PrismStages > 0 and self.PrismStages[1] == math.floor(no + 0.5)
	end

	-- 효과 한 줄: 공통 "공격력 +30 · 공격력 +3% · …" / 직업 증강 "[히어로 전용] …" / 프리즘은 설명
	method string EffectText(string id)
		local d = self:GetDef(id)
		if d == nil then return "" end
		if d.desc ~= nil then return d.desc end
		local I = _RtsHudLogic
		if d.forJobs ~= nil then
			local tag = "[" .. self:JobLabel(d) .. " 전용] "
			local sk = self:SkillLabel(d)
			local v = I:Num(d.val or 0)
			if d.kind == "skill" then return tag .. sk .. "의 데미지가 " .. v .. "% 증가한다." end
			if d.kind == "skillFin" then return tag .. sk .. "의 최종 데미지가 " .. v .. "% 증가한다." end
			if d.kind == "fin" then
				local cap = ""
				if self.MaxStack[d.id] ~= nil then cap = " (" .. I:Int(self.MaxStack[d.id]) .. "개까지)" end
				return tag .. "최종 데미지가 " .. v .. "% 증가한다." .. cap
			end
			if d.kind == "pct" then return tag .. "공격력이 " .. v .. "% 증가한다." end
			if d.kind == "ign" then return tag .. "몬스터의 방어율을 " .. v .. "% 무시한다." end
			if d.kind == "guard" then return tag .. "가드 크러쉬의 방어율 감소가 " .. v .. "% 늘어난다. (같은 구역의 모든 적, 최대 50% — 6개까지)" end
			if d.kind == "proj" and sk == "블리자드" then return tag .. "블리자드의 투사체가 " .. I:Int(d.val) .. "개 늘어난다. 보스를 공격할 때 타격 횟수도 " .. I:Int(d.val) .. "회 늘어난다." end
			if d.kind == "proj" then return tag .. sk .. "의 구체가 " .. I:Int(d.val) .. "개 늘어난다." end
			if d.kind == "pray" then return tag .. "프레이의 최종 데미지 증가량이 " .. v .. "% 늘어난다. (기본 30%, 최대 100% — 7개까지)" end
			if d.kind == "se" then return tag .. "샤프아이즈의 크리티컬 확률·크리티컬 데미지 증가량이 " .. v .. "%씩 늘어난다. (기본 30% — 5개까지)" end
			if d.kind == "sp" then return tag .. "쉐도우 파트너의 데미지가 " .. v .. "% 증가한다. (기본 50%, 최대 100% — 5개까지)" end
			return tag
		end
		return table.concat(self:StatLines(self:Totals(id)), " · ")
	end

	-- 프리즘 전체 선택지(자쿰 처치 보상 — 2026-09-27 사용자 "자쿰 한정으로 자쿰이 준 프리즘만 선택 가능"): 아직 없는 프리즘 전부를
	--   내 유닛 직업의 프리즘 → 다른 직업 프리즘 → 팬텀 잠금 해제 순서로(같은 묶음 안은 GetPrisms 순서). exclude[id] = true는 뺀다. preferJobs[jobId] = true = 내가 가진 유닛 직업
	method table PrismChoices(table exclude, table preferJobs)
		self:Ensure()
		local mine = {}
		local other = {}
		local unlock = {}
		local ids = self.ByGrade.prism or {}
		for i = 1, #ids do
			local id = ids[i]
			if exclude == nil or not exclude[id] then
				local d = self.Defs[id]
				if d.unlock ~= nil then
					unlock[#unlock + 1] = id
				elseif preferJobs ~= nil and d.job ~= nil and preferJobs[d.job] then
					mine[#mine + 1] = id
				else
					other[#other + 1] = id
				end
			end
		end
		local out = {}
		for _, group in ipairs({ mine, other, unlock }) do
			for _, id in ipairs(group) do out[#out + 1] = id end
		end
		return out
	end

	-- 서로 다른 3개를 가중치(w)대로(exclude[id] = true인 것 제외). 후보가 모자라면 있는 만큼 — 일반 증강 3택1(가중치 모두 1 = 27종 균등) · 프리즘 3택1(뽑기·시그너스·루시드)
	method table Roll(string grade, table exclude)
		self:Ensure()
		local pool = {}
		local ids = self.ByGrade[grade] or {}
		for i = 1, #ids do
			if exclude == nil or not exclude[ids[i]] then pool[#pool + 1] = ids[i] end
		end
		local out = {}
		while #out < 3 and #pool > 0 do
			local total = 0
			for i = 1, #pool do total = total + self.Defs[pool[i]].w end
			local r = _UtilLogic:RandomDouble() * total
			local pick = #pool
			for i = 1, #pool do
				r = r - self.Defs[pool[i]].w
				if r <= 0 then
					pick = i
					break
				end
			end
			out[#out + 1] = pool[pick]
			table.remove(pool, pick)
		end
		return out
	end

	-- 이 등급에 exclude 말고 남은 증강이 있는가(난수를 쓰지 않는다)
	method boolean HasAny(string grade, table exclude)
		self:Ensure()
		for _, id in ipairs(self.ByGrade[grade] or {}) do
			if exclude == nil or not exclude[id] then return true end
		end
		return false
	end

	-- 증강 합계(쉼표로 이은 id — RtsUnitComponent.Augs): 공통 atk·pct·crit·critDmg 합, fin = 100 + 최종 데미지 증강 합(%), ign·pray·se·sp 합, n = 개수.
	--   스킬 지정(이름 → 값): skill = 데미지 %p 합 / skillFin = 1 + 최종 데미지 증강 합(배율) / proj = 투사체 수 합. skillOrder = 표시 순서
	method table Totals(string augs)
		local t = { atk = 0, pct = 0, crit = 0, critDmg = 0, fin = 100, ign = 0, guard = 0, pray = 0, se = 0, sp = 0, n = 0, skill = {}, skillFin = {}, proj = {}, skillOrder = {} }
		if augs == nil or augs == "" then return t end
		self:Ensure()
		for id in string.gmatch(augs, "[^,]+") do
			local d = self.Defs[id]
			if d ~= nil and d.grade ~= "prism" then
				t.n = t.n + 1
				for _, key in ipairs({ "atk", "pct", "crit", "critDmg" }) do
					if d[key] ~= nil then t[key] = t[key] + d[key] end
				end
				local kind = d.kind
				local v = d.val or 0
				if kind == "fin" then
					t.fin = t.fin + v
				elseif kind == "pct" then
					t.pct = t.pct + v
				elseif kind == "ign" or kind == "guard" or kind == "pray" or kind == "se" or kind == "sp" then
					t[kind] = t[kind] + v
				elseif (kind == "skill" or kind == "skillFin" or kind == "proj") and d.skills ~= nil then
					for _, name in ipairs(d.skills) do
						local m = t[kind]
						if kind == "skillFin" then m[name] = (m[name] or 1) + v / 100 else m[name] = (m[name] or 0) + v end
						local seen = false
						for _, o in ipairs(t.skillOrder) do
							if o == name then seen = true end
						end
						if not seen then t.skillOrder[#t.skillOrder + 1] = name end
					end
				end
			end
		end
		return t
	end

	-- 합계(Totals 형식)를 능력치마다 한 줄 "공격력 +40" · "크리티컬 확률 +10%"… — 상세창 증강 합계·증강으로 오른 수치 공용. 0.05 미만은 뺀다(소수 한 자리 — RtsHudLogic.Num), 최종은 곱을 %로
	method table StatLines(table t)
		local I = _RtsHudLogic
		local out = {}
		local function add(label, v, unit)
			if v ~= nil and v >= 0.05 then out[#out + 1] = label .. " +" .. I:Num(v) .. unit end
		end
		add("공격력", t.atk, "")
		add("공격력", t.pct, "%")
		add("크리티컬 확률", t.crit, "%")
		add("크리티컬 데미지", t.critDmg, "%")
		if t.fin ~= nil and t.fin > 100.01 then out[#out + 1] = "최종 데미지 +" .. I:Num(t.fin - 100) .. "%" end
		add("방어율 무시", t.ign, "%")
		add("가드 크러쉬 방어율 감소", t.guard, "%")
		for _, name in ipairs(t.skillOrder or {}) do
			if t.skill ~= nil then add(name .. " 데미지", t.skill[name], "%") end
			if t.skillFin ~= nil and t.skillFin[name] ~= nil and t.skillFin[name] > 1.0001 then out[#out + 1] = name .. " 최종 데미지 +" .. I:Num((t.skillFin[name] - 1) * 100) .. "%" end
			if t.proj ~= nil and (t.proj[name] or 0) >= 1 then out[#out + 1] = name .. " 투사체 +" .. I:Int(t.proj[name]) .. "개" end
		end
		add("프레이 최종 데미지", t.pray, "%")
		add("샤프아이즈 크리티컬", t.se, "%")
		add("쉐도우 파트너 데미지", t.sp, "%")
		return out
	end

	-- 능력치 오버레이(RtsJobTableLogic.GetStatFor — 프리즘 다음): 공통·공격력%·방무는 합연산, 최종 데미지 증강 합은 능력치 최종에 한 번 곱,
	--   스킬 지정 효과는 st.skillAdd(이름 → %p) · st.skillFin(이름 → 배율) · st.projAdd(이름 → 개수)에, 프레이·샤프아이즈·쉐도우 파트너는 st.prayUp·seUp·spUp에 모아 둔다
	--   (쓰는 곳 = GetStatFor·SkillRatioAdd·SkillFinMul·SkillHits·SkillTargets·SkillBossHits·RtsUnitBuffLogic)
	method void ApplyToStat(table st, string augs)
		if augs == nil or augs == "" then return end
		local t = self:Totals(augs)
		st.crit = (st.crit or 0) + t.crit
		st.critDmg = (st.critDmg or 0) + t.critDmg
		st.flat = (st.flat or 0) + t.atk
		st.pct = (st.pct or 100) + t.pct
		st.fin = st.fin * t.fin / 100
		st.ign = (st.ign or 0) + t.ign
		st.skillAdd = t.skill
		st.skillFin = t.skillFin
		st.projAdd = t.proj
		st.prayUp = (st.prayUp or 0) + t.pray
		st.seUp = (st.seUp or 0) + t.se
		st.spUp = (st.spUp or 0) + t.sp
		if st.crit > 100 then st.crit = 100 end
	end

end
