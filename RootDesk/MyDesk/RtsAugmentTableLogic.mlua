-- Phase 4 합류(2026-09-23, revision-1 §2): 증강 표 — 정의·지급 라운드·굴림·능력치 오버레이. 서버·클라 공용 읽기 전용.
--   원본 = .info/augmentation.md(사용자 확정 — 이름·효과·가중치 [n/100]). 브론즈~골드 = 능력치만(크리 확률·크리 데미지·공격력 +n·공격력 %·보스 공격시 데미지·방어율 무시(2026-09-23 추가), 전부 합연산).
--   프리즘 = 특수 코어 3(모든 직업, 중복 등장 가능·같은 유닛 중복 적용 불가 — 방어구 부수기만 중복 적용 가능) + 팬텀 잠금 해제 + 직업 전용 11(RtsJobTableLogic.GetPrisms의 id와 같다).
--   지급: 브~골 = 몬스터 스테이지 태그 표(라운드 시작 때), 프리즘 = 보스 순번(처치 직후). 한 판 30개(브 10·실 10·골 7·프리즘 3 — 자쿰·시그너스·루시드).
@Logic
script RtsAugmentTableLogic extends Logic

	property boolean Loaded = false

	-- id → 정의 { id, grade(bronze/silver/gold/prism), name, w(가중치), crit/critDmg/atk/pct/boss/fin/ign(효과), job(직업 전용 프리즘), core(특수 코어), unlock(팬텀) }
	property table Defs = {}

	-- 등급 → id 목록(표 순서)
	property table ByGrade = {}

	-- 몬스터 스테이지 태그 → 등급(augmentation.md 지급 라운드표)
	property table GradeByTag = {}

	-- 프리즘 지급 = 이 순번의 보스를 잡았을 때(자쿰·시그너스·루시드 — 2026-09-23 3개로)
	property table PrismStages = {}

	method void Ensure()
		if self.Loaded then return end
		self.Loaded = true
		local list = {
			-- 브론즈 [n/100]
			{ "b_crit3", "bronze", "어설픈 약점 찾기 III", 5, "crit", 4 },
			{ "b_cdmg3", "bronze", "어설픈 급소 찌르기 III", 5, "critDmg", 4 },
			{ "b_atk3", "bronze", "어설픈 무기 연마 III", 5, "atk", 25 },
			{ "b_pct3", "bronze", "어설픈 전투 감각 III", 5, "pct", 4 },
			{ "b_crit2", "bronze", "어설픈 약점 찾기 II", 8, "crit", 3 },
			{ "b_cdmg2", "bronze", "어설픈 급소 찌르기 II", 8, "critDmg", 3 },
			{ "b_atk2", "bronze", "어설픈 무기 연마 II", 8, "atk", 20 },
			{ "b_pct2", "bronze", "어설픈 전투 감각 II", 8, "pct", 3 },
			{ "b_crit1", "bronze", "어설픈 약점 찾기 I", 12, "crit", 2 },
			{ "b_cdmg1", "bronze", "어설픈 급소 찌르기 I", 12, "critDmg", 2 },
			{ "b_atk1", "bronze", "어설픈 무기 연마 I", 12, "atk", 15 },
			{ "b_pct1", "bronze", "어설픈 전투 감각 I", 12, "pct", 2 },
			-- 실버
			{ "s_crit3", "silver", "능숙한 약점 찾기 III", 4.5, "crit", 7 },
			{ "s_cdmg3", "silver", "능숙한 급소 찌르기 III", 4.5, "critDmg", 7 },
			{ "s_atk3", "silver", "능숙한 무기 연마 III", 4.5, "atk", 60 },
			{ "s_pct3", "silver", "능숙한 전투 감각 III", 4.5, "pct", 7 },
			{ "s_boss3", "silver", "보스 사냥꾼 III", 2, "boss", 7 },
			{ "s_crit2", "silver", "능숙한 약점 찾기 II", 9, "crit", 6 },
			{ "s_cdmg2", "silver", "능숙한 급소 찌르기 II", 9, "critDmg", 6 },
			{ "s_atk2", "silver", "능숙한 무기 연마 II", 9, "atk", 50 },
			{ "s_pct2", "silver", "능숙한 전투 감각 II", 9, "pct", 6 },
			{ "s_boss2", "silver", "보스 사냥꾼 II", 4, "boss", 6 },
			{ "s_crit1", "silver", "능숙한 약점 찾기 I", 13.5, "crit", 5 },
			{ "s_cdmg1", "silver", "능숙한 급소 찌르기 I", 13.5, "critDmg", 5 },
			{ "s_atk1", "silver", "능숙한 무기 연마 I", 13.5, "atk", 40 },
			{ "s_pct1", "silver", "능숙한 전투 감각 I", 13.5, "pct", 5 },
			{ "s_boss1", "silver", "보스 사냥꾼 I", 6, "boss", 5 },
			-- 골드
			{ "g_crit3", "gold", "완벽한 약점 찾기 III", 4, "crit", 15 },
			{ "g_cdmg3", "gold", "완벽한 급소 찌르기 III", 4.5, "critDmg", 15 },
			{ "g_atk3", "gold", "완벽한 무기 연마 III", 4.5, "atk", 90 },
			{ "g_pct3", "gold", "완벽한 전투 감각 III", 4.5, "pct", 15 },
			{ "g_boss3", "gold", "거인 학살자 III", 2, "boss", 15 },
			{ "g_crit2", "gold", "완벽한 약점 찾기 II", 9, "crit", 12 },
			{ "g_cdmg2", "gold", "완벽한 급소 찌르기 II", 9, "critDmg", 12 },
			{ "g_atk2", "gold", "완벽한 무기 연마 II", 9, "atk", 80 },
			{ "g_pct2", "gold", "완벽한 전투 감각 II", 9, "pct", 12 },
			{ "g_boss2", "gold", "거인 학살자 II", 4, "boss", 12 },
			{ "g_crit1", "gold", "완벽한 약점 찾기 I", 13.5, "crit", 10 },
			{ "g_cdmg1", "gold", "완벽한 급소 찌르기 I", 13.5, "critDmg", 10 },
			{ "g_atk1", "gold", "완벽한 무기 연마 I", 13.5, "atk", 70 },
			{ "g_pct1", "gold", "완벽한 전투 감각 I", 13.5, "pct", 10 },
			{ "g_boss1", "gold", "거인 학살자 I", 6, "boss", 10 },
		}
		self.Defs = {}
		self.ByGrade = { bronze = {}, silver = {}, gold = {}, prism = {} }
		for i = 1, #list do
			local r = list[i]
			local d = { id = r[1], grade = r[2], name = r[3], w = r[4] }
			d[r[5]] = r[6]
			self.Defs[d.id] = d
			local g = self.ByGrade[d.grade]
			g[#g + 1] = d.id
		end
		-- 프리즘 — 특수 코어(모든 직업, 중복 등장 가능, 같은 유닛 중복 적용 불가)
		self:AddPrism({ id = "core_final", name = "일격필살", w = 5, core = true, fin = 15, desc = "[모든 직업] 최종 데미지가 15% 증가한다. 같은 유닛에 중복 적용 불가" })
		self:AddPrism({ id = "core_boss", name = "보스 슬레이어", w = 5, core = true, boss = 60, desc = "[모든 직업] 보스 공격 시 데미지가 60% 증가한다. 같은 유닛에 중복 적용 불가" }) -- 2026-09-23 사용자 "보공 60%로 너프"(전 100)
		-- 방어구 부수기(core_ign)·갑옷 꿰뚫기(방무 증강) 삭제(2026-09-24 사용자 "합연산 + 증강 방무 삭제" — 방무는 직업 킷·프리즘만)
		-- 프리즘 — 직업(팬텀 잠금 해제·섀도어 전직) + 스킬(직업 전용) = RtsJobTableLogic.GetPrisms 정의를 그대로 쓴다
		local jobW = { phantom = 5, dualblade = 5 }
		local ps = _RtsJobTableLogic:GetPrisms()
		for i = 1, #ps do
			local p = ps[i]
			local w = jobW[p.id] or 7.5
			if p.id == "phantom" then
				self:AddPrism({ id = "phantom", name = "팬텀", w = w, unlock = "phantom", desc = "영웅 팬텀을 영입할 수 있게 된다. 팬텀은 모든 능력치 증강 효과가 75% 증가한다." })
			else
				self:AddPrism({ id = p.id, name = p.name, w = w, job = p.job, desc = "[" .. _RtsJobTableLogic:GetJobName(p.job) .. " 전용] " .. p.desc })
			end
		end
		-- 지급 라운드표(augmentation.md — 몬스터 스테이지 태그)
		local br = { 4, 17, 30, 38, 51, 63, 76, 84, 97, 110 }
		local sv = { 8, 21, 34, 42, 55, 68, 80, 89, 101, 114 }
		local gd = { 13, 25, 46, 59, 72, 93, 106 }
		self.GradeByTag = {}
		for i = 1, #br do self.GradeByTag[br[i]] = "bronze" end
		for i = 1, #sv do self.GradeByTag[sv[i]] = "silver" end
		for i = 1, #gd do self.GradeByTag[gd[i]] = "gold" end
		-- 2026-09-23 사용자 "프리즘 개수 3개로 — 자쿰·시그너스·루시드 처치 후"(전 스우·진 힐라 포함 5개)
		self.PrismStages = { 26, 56, 89 }
	end

	method void AddPrism(table d)
		d.grade = "prism"
		self.Defs[d.id] = d
		local g = self.ByGrade.prism
		g[#g + 1] = d.id
	end

	method any GetDef(string id)
		self:Ensure()
		return self.Defs[id]
	end

	-- 스테이지 순번 → 그 스테이지 시작 때 주는 등급(브~골), 없으면 ""
	method string GradeForStage(number no)
		self:Ensure()
		local s = _RtsStageTableLogic:GetStage(no)
		if s == nil or s.kind ~= "mob" then return "" end
		local tag = tonumber(s.tag)
		if tag == nil then return "" end
		return self.GradeByTag[math.floor(tag + 0.5)] or ""
	end

	-- 이 순번 보스를 잡으면 프리즘을 주는가
	method boolean IsPrismStage(number no)
		self:Ensure()
		local n = math.floor(no + 0.5)
		for i = 1, #self.PrismStages do
			if self.PrismStages[i] == n then return true end
		end
		return false
	end

	-- 효과 한 줄: "크리티컬 확률 +4%" / 프리즘은 설명
	method string EffectText(string id)
		local d = self:GetDef(id)
		if d == nil then return "" end
		if d.desc ~= nil then return d.desc end
		local I = _RtsHudLogic
		if d.crit ~= nil then return "크리티컬 확률 +" .. I:Int(d.crit) .. "%" end
		if d.critDmg ~= nil then return "크리티컬 데미지 +" .. I:Int(d.critDmg) .. "%" end
		if d.atk ~= nil then return "공격력 +" .. I:Int(d.atk) end
		if d.pct ~= nil then return "공격력 +" .. I:Int(d.pct) .. "%" end
		if d.boss ~= nil then return "보스 공격 시 데미지 +" .. I:Int(d.boss) .. "%" end
		return ""
	end

	-- 서로 다른 3개를 가중치대로(exclude[id] = true인 것 제외). 후보가 모자라면 있는 만큼
	method table Roll(string grade, table exclude)
		return self:RollShared(grade, exclude, nil)
	end

	-- Roll + 고정 몫: shareOf[id] = 0~1이면 그 증강은 뽑을 때마다 후보 전체 중 그 몫의 확률로 나온다(나머지 후보는 남은 몫을 원래 가중치 비율로 나눔)
	--   (엘릭서·템페스트 짝 확률에 쓰던 것 — 2026-09-23 둘을 통합해 지금은 넘기는 곳 없음)
	method table RollShared(string grade, table exclude, table shareOf)
		self:Ensure()
		local pool = {}
		local ids = self.ByGrade[grade] or {}
		for i = 1, #ids do
			if exclude == nil or not exclude[ids[i]] then pool[#pool + 1] = ids[i] end
		end
		local out = {}
		while #out < 3 and #pool > 0 do
			-- 이번 뽑기의 가중치: 몫이 없는 후보는 원래 w, 몫이 있는 후보는 (몫 ÷ 남은 몫) × 몫 없는 후보 w 합
			local plain = 0
			local shareSum = 0
			for i = 1, #pool do
				local sh = nil
				if shareOf ~= nil then sh = shareOf[pool[i]] end
				if sh ~= nil then shareSum = shareSum + sh else plain = plain + self.Defs[pool[i]].w end
			end
			local ws = {}
			local total = 0
			for i = 1, #pool do
				local sh = nil
				if shareOf ~= nil then sh = shareOf[pool[i]] end
				local w = self.Defs[pool[i]].w
				if sh ~= nil then
					if plain > 0 and shareSum < 1 then w = sh / (1 - shareSum) * plain else w = 1 end
				end
				ws[i] = w
				total = total + w
			end
			local r = _UtilLogic:RandomDouble() * total
			local pick = #pool
			for i = 1, #pool do
				r = r - ws[i]
				if r <= 0 then
					pick = i
					break
				end
			end
			out[#out + 1] = pool[pick]
			table.remove(pool, pick)
		end
		return out
	end

	-- 증강 합계(2026-09-24 사용자 "상세보기 증강 탭에서 증강으로 오른 공격력·공격력%·보스·크리 등을 합산"): 수치는 그대로(사냥 기준), 최종은 곱을 % 로
	method table Totals(string augs)
		return self:TotalsMul(augs, nil)
	end

	-- 증강 합계에 효과 배율까지 곱한 값(팝업 증강 탭 — 실제 능력치에 들어가는 수치)
	method table TotalsMul(string augs, table mul)
		local t = { atk = 0, pct = 0, boss = 0, crit = 0, critDmg = 0, fin = 100, n = 0 }
		if augs == nil or augs == "" then return t end
		self:Ensure()
		for id in string.gmatch(augs, "[^,]+") do
			local d = self.Defs[id]
			if d ~= nil then
				t.n = t.n + 1
				if d.crit ~= nil then t.crit = t.crit + d.crit * self:MulOf(mul, d, "crit") end
				if d.critDmg ~= nil then t.critDmg = t.critDmg + d.critDmg * self:MulOf(mul, d, "critDmg") end
				if d.atk ~= nil then t.atk = t.atk + d.atk * self:MulOf(mul, d, "atk") end
				if d.pct ~= nil then t.pct = t.pct + d.pct * self:MulOf(mul, d, "pct") end
				if d.boss ~= nil then t.boss = t.boss + d.boss * self:MulOf(mul, d, "boss") end
				if d.fin ~= nil then t.fin = t.fin * (100 + d.fin) / 100 end
			end
		end
		return t
	end

	-- 능력치 오버레이(RtsJobTableLogic.GetStatFor — 프리즘 다음): augs = 유닛에 지정된 id를 쉼표로 이은 문자열(RtsUnitComponent.Augs). 전부 합연산, 일격필살만 최종 곱(방무 증강은 2026-09-24 삭제)
	method void ApplyToStat(table st, string augs)
		self:ApplyToStatMul(st, augs, nil)
	end

	-- 증강 효과 배율 mul = { crit, critDmg, atk, pct, boss }(RtsJobTableLogic.AugMulFor — 1티어 ×3 · 팬텀 ×1.5 · 2티어 약점 ×2, 2026-09-24 티어 재설계(.info/tier.md · tools/balance-calc.py TUNE)).
	--   브론즈~골드만 곱한다(특수 코어 = 프리즘 등급은 그대로). nil이면 전부 1
	method number MulOf(table mul, any d, string key)
		if mul == nil or d.grade == "prism" or mul[key] == nil then return 1 end
		return mul[key]
	end

	method void ApplyToStatMul(table st, string augs, table mul)
		if augs == nil or augs == "" then return end
		self:Ensure()
		for id in string.gmatch(augs, "[^,]+") do
			local d = self.Defs[id]
			if d ~= nil then
				if d.crit ~= nil then st.crit = (st.crit or 0) + d.crit * self:MulOf(mul, d, "crit") end
				if d.critDmg ~= nil then st.critDmg = (st.critDmg or 0) + d.critDmg * self:MulOf(mul, d, "critDmg") end
				if d.atk ~= nil then st.flat = (st.flat or 0) + d.atk * self:MulOf(mul, d, "atk") end
				if d.pct ~= nil then st.pct = (st.pct or 100) + d.pct * self:MulOf(mul, d, "pct") end
				if d.boss ~= nil then st.bossAdd = (st.bossAdd or 0) + d.boss * self:MulOf(mul, d, "boss") end
				if d.ign ~= nil then _RtsJobTableLogic:AddIgn(st, d.ign) end -- 방무는 곱연산(2026-09-24)
				if d.fin ~= nil then
					st.fin = st.fin * (100 + d.fin) / 100
					st.finBoss = st.finBoss * (100 + d.fin) / 100
				end
			end
		end
		if st.crit ~= nil and st.crit > 100 then st.crit = 100 end
	end

end
