-- rts-base: 프로토타입 시연용 (2026-09-14) — 트랙 위에 초록달팽이를 돌린다.
--   Phase 3 #10 몹 스폰·순환(RtsWaveLogic)이 생기면 이 파일은 삭제한다.
--   클립 RUID는 사용자가 준 것: 이동 e7d919d7…, 사망 a25ed762…(여기선 이동만)
@Logic
script RtsDemoLogic extends Logic

	property boolean WalkersBuilt = false

	property string WalkRUID = "e7d919d7b4724c65b2f53164c2873ae0"

	-- 구역마다 3마리, t 간격 1/3. 스케일 2.5는 줌 30%에서 적당(2026-09-14 실측)
	property number PerZone = 3

	property number WalkerScale = 2.5

	@ExecSpace("ServerOnly")
	method void EnsureWalkers()
		if self.WalkersBuilt then return end
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		if mapRoot == nil then return end
		if _EntityService:GetEntityByPath("/maps/RtsMap/DemoWalker1_1") ~= nil then
			self.WalkersBuilt = true
			return
		end
		for n = 1, _RtsZoneLogic:GetZoneCount() do
			for i = 1, self.PerZone do
				local t0 = (i - 1) / self.PerZone
				local at = _RtsZoneLogic:GetTrackPoint(n, t0)
				-- 몹은 그리드(100)·배경 사물(110) 위, 유닛보다 아래: 200
				local e = _RtsZoneLogic:SpawnProp("DemoWalker" .. tostring(n) .. "_" .. tostring(i), mapRoot, at, self.WalkRUID, 200)
				if e ~= nil then
					e.TransformComponent.Scale = Vector3(self.WalkerScale, self.WalkerScale, 1)
					local w = e:AddComponent("RtsTrackWalkerComponent")
					if w ~= nil then
						w.Zone = n
						w.T = t0
					end
				end
			end
		end
		self.WalkersBuilt = true
		log("RtsDemo: walkers x" .. tostring(self.PerZone) .. " per zone")
	end

	-- 시험대(RtsCombatLogic.TestBench): 순회 몬스터를 전부 지우고 다시 만들지 않는다
	@ExecSpace("ServerOnly")
	method void StopWalkers()
		for n = 1, _RtsZoneLogic:GetZoneCount() do
			for i = 1, self.PerZone do
				local e = _EntityService:GetEntityByPath("/maps/RtsMap/DemoWalker" .. tostring(n) .. "_" .. tostring(i))
				if e ~= nil then e:Destroy() end
			end
		end
		self.WalkersBuilt = true
	end

end
