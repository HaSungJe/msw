-- Phase 4 합류(2026-09-23, revision-1 §2): 증강 지급·선택·지정(서버 권위) + 클라 조회.
--   지급: 브론즈~골드 = 지급 라운드 시작 때(RtsStageLogic.OnStageStarted), 프리즘 = 자쿰·시그너스·루시드 처치 직후(2026-09-23 5개 → 3개)(RtsBossLogic.OnBossKilled).
--   서버가 후보 3개(서로 다름, 가중치 — RtsAugmentTableLogic.Roll)를 굴려 OfferByUser에 올리면 클라가 3택1 팝업(닫기 없음)을 연다. 여러 개가 밀리면 줄을 세워 하나씩.
--   고른 증강은 '대상 미지정'으로 보유(OwnedByUser) → 증강 창에서 유닛 1명에 1회 지정(RequestAssign). 지정 후 변경 불가.
--     브~골·특수 코어 → 그 유닛 Augs(능력치 오버레이) / 직업 프리즘 → 그 직업 유닛에만, RtsUnitLogic.ApplyPrism / 팬텀 → 받는 즉시 영입 해금(지정 없음).
--   방출된 유닛에 지정된 증강은 소멸, 탈락·새 판이면 보유 초기화.
--   동기화 문자열: OwnedByUser[userId] = "id:유닛번호,…"(0 = 미지정, -1 = 지정 필요 없음) / OfferByUser[userId] = "등급|id,id,id|개별식별자" (없으면 "")
@Logic
script RtsAugmentLogic extends Logic

	@Sync
	property SyncTable<string, string> OwnedByUser

	@Sync
	property SyncTable<string, string> OfferByUser

	-- 서버: userId → { token, grade, packed } 수령하지 않은 선택지 전체. 발급 순서를 유지한다.
	property table Queue = {}

	@Sync
	property SyncTable<string, string> PendingItemsByUser

	property table NextPendingToken = {}

	property number AwaitingPendingToken = 0

	-- 클라: 뽑기 버튼을 누른 뒤 기다리는 뽑기 횟수(BuyCountByUser가 이 값이 되면 획득음 + 보유 증강 탭 반짝임) · 누른 시각(3초 지나면 포기 — 서버 거절)
	property number AwaitBuy = 0

	property number AwaitBuyAt = 0

	-- 고르지 않은 선택지 수(지금 선택지 1 + 줄) — 클라 '펼치기 (n)' 표시용. 최대 MaxPending(10), 넘치면 먼저 받은 것부터 삭제(2026-09-23 사용자)
	@Sync
	property SyncTable<string, number> PendingByUser

	-- 2026-09-23 사용자 "증강 누적은 10개까지"(전 3)
	property number MaxPending = 10

	-- 증강 뽑기(2026-09-23 사용자): 가격 = BuyBase + BuyStep × 이번 판에 뽑은 횟수. 등급 확률(%) 브론즈 75.5 / 실버 15 / 골드 4.5 / 프리즘 5(+ 천장 BuyPrismPity — 아래)
	--   (2026-09-24 사용자: 0.5 → 2 → "프리즘 확률은 5%로" — 브론즈 75.5 / 실버 15 / 골드 4.5 / 프리즘 5. .info/tier.md)
	@Sync
	property SyncTable<string, number> BuyCountByUser

	-- 2026-09-24 사용자 "비숍 30·팔라딘 40 가성비 + 딜러 4명 50레벨 뒤 남는 돈으로 50~60회": 여유 226,740 → 3,000 + 40씩 = 55회 224,400(.info/tier.md)
	--   (전: 2026-09-23 3,000 + 800씩, 그 전 5,000 + 1,000)
	property number BuyBase = 3000

	property number BuyStep = 40

	-- 뽑기에서 나오는 프리즘은 판마다 최대 BuyPrismMax개(2026-09-24 사용자 "증강 뽑기에서 최대 2개") — 넘으면 골드. HUD 뽑기 버튼에 '프리즘 남은/최대'
	property number BuyPrismMax = 2

	@Sync
	property SyncTable<string, number> BuyPrismByUser

	-- 프리즘 천장(2026-09-24 사용자 "뽑기에서 프리즘이 안 나오면 다음 뽑기 프리즘 확률 +2%, 나오면 0%에서 다시, 2개 다 뽑으면 끝"):
	--   이번 판 뽑기 프리즘 확률 = BuyPrismBase + 추가분(BuyPrismPity — 프리즘 없이 뽑을 때마다 +BuyPrismPityStep, 프리즘이 나오면 0). 늘어난 만큼 브·실·골은 비율대로 줄어든다
	@Sync
	property SyncTable<string, number> BuyPrismPity

	property number BuyPrismBase = 5

	property number BuyPrismPityStep = 2

	-- 클라: 3택1 창을 접어 둠 — 자동으로 다시 열지 않고 HUD '펼치기'로 연다(선택지가 모두 없어지면 풀림)
	property boolean PickFolded = false

	-- 클라: 3택1 팝업을 이미 띄운 제안(같은 제안 반복 열기 방지)
	property string ShownOffer = ""

	-- 클라: 방금 '받기'를 누른 제안과 그 시각 — 서버가 다음 제안으로 바꾸기 전(잠깐) 같은 제안을 다시 열지 않는다
	property string ChosenOffer = ""

	property number ChosenAt = 0

	method void OnBeginPlay()
		if self:IsClient() then
			_TimerService:SetTimerRepeat(function() self:ClientTick() end, 0.3, 1)
		end
	end

	-- ===== 공용: 문자열 풀기 =====

	-- "id:no,id:no" → { { id, no }, … }
	method table ParseOwned(string packed)
		local out = {}
		if packed == nil or packed == "" then return out end
		for item in string.gmatch(packed, "[^,]+") do
			local c = string.find(item, ":", 1, true)
			if c ~= nil then
				local no = tonumber(string.sub(item, c + 1))
				if no ~= nil then out[#out + 1] = { id = string.sub(item, 1, c - 1), no = no } end
			end
		end
		return out
	end

	method string PackOwned(table list)
		local parts = {}
		for i = 1, #list do parts[#parts + 1] = list[i].id .. ":" .. string.format("%d", math.floor(list[i].no + 0.5)) end
		return table.concat(parts, ",")
	end

	-- "grade|a,b,c|token" → grade, { a, b, c }, token
	method table ParseOffer(string packed)
		local out = { grade = "", ids = {}, token = 0 }
		if packed == nil or packed == "" then return out end
		local bar = string.find(packed, "|", 1, true)
		if bar == nil then return out end
		out.grade = string.sub(packed, 1, bar - 1)
		local tail = string.sub(packed, bar + 1)
		local tokenAt = string.find(tail, "|", 1, true)
		if tokenAt ~= nil then
			out.token = tonumber(string.sub(tail, tokenAt + 1)) or 0
			tail = string.sub(tail, 1, tokenAt - 1)
		end
		for id in string.gmatch(tail, "[^,]+") do out.ids[#out.ids + 1] = id end
		return out
	end

	method table GetOwned(string userId)
		return self:ParseOwned(self.OwnedByUser[userId] or "")
	end

	-- 이 유저가 팬텀 잠금 해제를 받았는가
	method boolean HasUnlock(string userId, string key)
		local list = self:GetOwned(userId)
		for i = 1, #list do
			local d = _RtsAugmentTableLogic:GetDef(list[i].id)
			if d ~= nil and d.unlock == key then return true end
		end
		return false
	end

	-- 구역 zone 유닛 no에 지정된 증강(유닛 팝업 증강 탭): { g, t, d }
	method table ListForUnit(string userId, number no)
		local out = {}
		local list = self:GetOwned(userId)
		local n = math.floor(no + 0.5)
		for i = 1, #list do
			if math.floor(list[i].no + 0.5) == n then
				local d = _RtsAugmentTableLogic:GetDef(list[i].id)
				if d ~= nil then out[#out + 1] = { id = d.id, g = d.grade, t = d.name, d = _RtsAugmentTableLogic:EffectText(d.id) } end
			end
		end
		return out
	end

	-- 증강을 이 유닛에 지정할 수 있는가(서버 검사·클라 칩 표시 공용): 직업 프리즘 = 같은 직업·아직 없는 프리즘, 특수 코어 = 같은 코어 없음(stack 코어 = 방어구 부수기는 겹쳐도 됨)
	method boolean CanAssignTo(string id, any u)
		if u == nil then return false end
		local d = _RtsAugmentTableLogic:GetDef(id)
		if d == nil or d.unlock ~= nil then return false end
		if d.job ~= nil and d.job ~= "" then
			return u.JobId == d.job and not _RtsJobTableLogic:HasPrism(u, id)
		end
		if d.core and not d.stack then
			for q in string.gmatch(u.Augs or "", "[^,]+") do
				if q == id then return false end
			end
		end
		return true
	end

	-- ===== 서버: 지급 =====

	-- 스테이지 시작(RtsStageLogic.OnStageStarted): 브~골 지급 라운드면 살아 있는 유저 전원에게
	@ExecSpace("ServerOnly")
	method void OnStageStarted(number n)
		local grade = _RtsAugmentTableLogic:GradeForStage(n)
		if grade == "" then return end
		for userId, zone in pairs(_RtsZoneLogic.ZoneByUser) do
			if _RtsRunResultLogic:IsAlive(userId) then self:Offer(userId, grade) end
		end
	end

	-- 보스 처치(RtsBossLogic — 그 구역 보스를 다 잡았을 때): 프리즘 라운드면 그 구역 주인에게
	@ExecSpace("ServerOnly")
	method void OnBossDown(string userId, number stageNo)
		if userId == "" or not _RtsAugmentTableLogic:IsPrismStage(stageNo) then return end
		self:Offer(userId, "prism")
	end

	@ExecSpace("ServerOnly")
	method void Offer(string userId, string grade)
		if self.Queue[userId] == nil then self.Queue[userId] = {} end
		local q = self.Queue[userId]
		local token = (self.NextPendingToken[userId] or 0) + 1
		self.NextPendingToken[userId] = token
		q[#q + 1] = { token = token, grade = grade, packed = "" }
		local active = self:ParseOffer(self.OfferByUser[userId] or "").token
		while #q > self.MaxPending do
			local dropped = table.remove(q, 1)
			if dropped.token == active then self.OfferByUser[userId] = "" end
		end
		if (self.OfferByUser[userId] or "") == "" then self:PopNext(userId) end
		self:SyncPending(userId)
	end

	@ExecSpace("ServerOnly")
	method void SyncPending(string userId)
		local q = self.Queue[userId] or {}
		local rows = {}
		for _, item in ipairs(q) do rows[#rows + 1] = string.format("%d", item.token) .. ":" .. item.grade end
		self.PendingByUser[userId] = #q
		self.PendingItemsByUser[userId] = table.concat(rows, ",")
	end

	@ExecSpace("ServerOnly")
	method void ActivatePending(string userId, table item)
		local exclude = {}
		if item.grade == "prism" then
			for _, owned in ipairs(self:GetOwned(userId)) do
				local d = _RtsAugmentTableLogic:GetDef(owned.id)
				if d ~= nil and not d.core then exclude[d.id] = true end
			end
		end
		local ids = {}
		for _, id in ipairs(self:ParseOffer(item.packed).ids) do
			if not exclude[id] then ids[#ids + 1] = id exclude[id] = true end
		end
		if #ids < 3 then
			for _, id in ipairs(_RtsAugmentTableLogic:RollShared(item.grade, exclude, nil)) do
				if #ids < 3 then ids[#ids + 1] = id end
			end
		end
		item.packed = item.grade .. "|" .. table.concat(ids, ",") .. "|" .. string.format("%d", item.token)
		self.OfferByUser[userId] = item.packed
	end

	@ExecSpace("ServerOnly")
	method void PopNext(string userId)
		local q = self.Queue[userId] or {}
		if #q == 0 then self.OfferByUser[userId] = "" return end
		self:ActivatePending(userId, q[1])
	end

	@ExecSpace("Server")
	method void RequestBrowsePending(number token)
		local uid = senderUserId
		if uid == nil or uid == "" or not _RtsRunResultLogic:IsAlive(uid) then return end
		if token ~= math.floor(token) or token < 1 then return end
		for _, item in ipairs(self.Queue[uid] or {}) do
			if item.token == token then self:ActivatePending(uid, item) return end
		end
	end

	@ExecSpace("ClientOnly")
	method table MyPendingItems()
		local list = {}
		local packed = self.PendingItemsByUser[_RtsUnitLogic:MyUserId()] or ""
		for part in string.gmatch(packed, "[^,]+") do
			local split = string.find(part, ":", 1, true)
			if split ~= nil then list[#list + 1] = { token = tonumber(string.sub(part, 1, split - 1)), grade = string.sub(part, split + 1) } end
		end
		return list
	end

	@ExecSpace("ClientOnly")
	method void BrowsePending(number token)
		self.AwaitingPendingToken = token
		self.PickFolded = true
		self:RequestBrowsePending(token)
	end

	-- 클라: '받기' 누름 — 지금 보이는 제안을 '방금 고름'으로 적고 서버에 수령 요청
	@ExecSpace("ClientOnly")
	method void ChooseFromPopup(number idx)
		if _RtsStageLogic.Paused then
			_RtsHudLogic:ShowHintFor("일시정지를 해제한 뒤 증강을 받을 수 있어요", 3)
			return
		end
		self.ChosenOffer = self.ShownOffer
		self.ChosenAt = _UtilLogic.ElapsedSeconds
		self:RequestChoose(idx, self.ShownOffer)
	end

	-- 3택1 수령(idx = 1~3). 팬텀은 바로 해금(-1), 나머지는 미지정(0)
	@ExecSpace("Server")
	method void RequestChoose(number idx, string expectedOffer)
		if _RtsStageLogic.Paused then return end  -- 일시정지 중 게임 조작 막기(2026-09-25 사용자 "전부 막기")
		local userId = senderUserId
		if userId == nil or userId == "" or not _RtsRunResultLogic:IsAlive(userId) then return end
		if expectedOffer ~= (self.OfferByUser[userId] or "") then return end
		local offer = self:ParseOffer(self.OfferByUser[userId] or "")
		if idx ~= math.floor(idx) or idx < 1 or idx > 3 then return end
		local i = idx
		local id = offer.ids[i]
		if id == nil then return end
		local d = _RtsAugmentTableLogic:GetDef(id)
		if d == nil then return end
		local list = self:GetOwned(userId)
		local no = 0
		if d.unlock ~= nil then no = -1 end
		list[#list + 1] = { id = id, no = no }
		self.OwnedByUser[userId] = self:PackOwned(list)
		_RtsConfigLogic:Log("RtsAugment: " .. userId .. " took " .. id)
		local q = self.Queue[userId] or {}
		for qi, item in ipairs(q) do
			if item.token == offer.token then table.remove(q, qi) break end
		end
		self:PopNext(userId)
		self:SyncPending(userId)
	end

	-- 보유 증강 k번째를 유닛 no에 지정(1회, 변경 불가)
	@ExecSpace("Server")
	method void RequestAssign(number k, number no)
		if _RtsStageLogic.Paused then return end  -- 일시정지 중 게임 조작 막기(2026-09-25 사용자 "전부 막기")
		local userId = senderUserId
		if userId == nil or userId == "" or not _RtsRunResultLogic:IsAlive(userId) then return end
		local list = self:GetOwned(userId)
		local i = math.floor(k + 0.5)
		local item = list[i]
		if item == nil or item.no ~= 0 then return end
		local e = _RtsUnitLogic:GetUnit(userId, no)
		if e == nil or not isvalid(e) then return end
		local u = e.RtsUnitComponent
		if not self:CanAssignTo(item.id, u) then return end
		local d = _RtsAugmentTableLogic:GetDef(item.id)
		if d.job ~= nil and d.job ~= "" then
			_RtsUnitLogic:ApplyPrism(userId, no, item.id)
		else
			if u.Augs == "" then u.Augs = item.id else u.Augs = u.Augs .. "," .. item.id end
			_RtsUnitLogic:OnChanged(no, _RtsUnitLogic:GetMeso(userId), userId)
		end
		item.no = no
		self.OwnedByUser[userId] = self:PackOwned(list)
		_RtsConfigLogic:Log("RtsAugment: " .. userId .. " assigned " .. item.id .. " -> unit " .. string.format("%d", math.floor(no + 0.5)))
	end

	-- 유닛 방출(RtsUnitLogic.RequestDismiss): 그 유닛에 지정된 증강 소멸
	@ExecSpace("ServerOnly")
	method void OnUnitDismissed(string userId, number no)
		local list = self:GetOwned(userId)
		local keep = {}
		local n = math.floor(no + 0.5)
		for i = 1, #list do
			if math.floor(list[i].no + 0.5) ~= n then keep[#keep + 1] = list[i] end
		end
		self.OwnedByUser[userId] = self:PackOwned(keep)
	end

	-- 탈락·새 판·퇴장: 보유·제안·줄 초기화
	@ExecSpace("ServerOnly")
	method void ResetUser(string userId)
		self.OwnedByUser[userId] = ""
		self.OfferByUser[userId] = ""
		self.Queue[userId] = {}
		self.PendingItemsByUser[userId] = ""
		self.NextPendingToken[userId] = 0
		self.PendingByUser[userId] = 0
		self.BuyCountByUser[userId] = 0
		self.BuyPrismByUser[userId] = 0
		self.BuyPrismPity[userId] = 0
	end

	-- 다음 뽑기의 프리즘 확률(%) — 더 얻을 프리즘이 없으면 0
	method number BuyPrismRate(string userId)
		if self:BuyPrismLeft(userId) <= 0 then return 0 end
		local p = self.BuyPrismBase + (self.BuyPrismPity[userId] or 0)
		if p > 100 then p = 100 end
		return p
	end

	-- 이번 판에 뽑기로 더 얻을 수 있는 프리즘 수(서버·클라 공용)
	method number BuyPrismLeft(string userId)
		local left = self.BuyPrismMax - (self.BuyPrismByUser[userId] or 0)
		if left < 0 then left = 0 end
		return left
	end

	-- 다음 뽑기 가격(서버·클라 공용)
	method number BuyPrice(string userId)
		local n = self.BuyCountByUser[userId] or 0
		return self.BuyBase + self.BuyStep * n
	end

	-- 서버: 증강 뽑기 — 살아 있고 판 진행 중(카운트다운·진행), 고르지 않은 선택지 < MaxPending, 메소 ≥ 가격이면 메소 차감 → 등급 굴림 → 그 등급 3택1(Offer)
	@ExecSpace("Server")
	method void RequestBuy()
		if _RtsStageLogic.Paused then return end  -- 일시정지 중 게임 조작 막기(2026-09-25 사용자 "전부 막기")
		local userId = senderUserId
		if userId == nil or userId == "" or not _RtsRunResultLogic:IsAlive(userId) then return end
		local st = _RtsStageLogic.RunState
		if st ~= "countdown" and st ~= "running" then return end
		if (self.PendingByUser[userId] or 0) >= self.MaxPending then return end
		local price = self:BuyPrice(userId)
		local meso = _RtsUnitLogic:GetMeso(userId)
		if meso < price then return end
		_RtsUnitLogic.MesoByUser[userId] = meso - price
		self.BuyCountByUser[userId] = (self.BuyCountByUser[userId] or 0) + 1
		-- 등급: 먼저 프리즘(기본 5% + 천장 추가분), 아니면 나머지를 브론즈 75.5 · 실버 15 · 골드 4.5 비율로(합 95)
		local prismRate = self:BuyPrismRate(userId)
		local r = _UtilLogic:RandomDouble() * 100
		local grade = "bronze"
		if r < prismRate then
			grade = "prism"
		else
			local rr = (r - prismRate) / (100 - prismRate) * 95
			if rr >= 90.5 then grade = "gold" elseif rr >= 75.5 then grade = "silver" end
		end
		-- 뽑기 프리즘 상한(BuyPrismMax)을 다 채웠으면 골드(BuyPrismRate가 0이라 사실상 안 옴)
		if grade == "prism" and self:BuyPrismLeft(userId) <= 0 then grade = "gold" end
		-- 프리즘인데 더 나올 게 없으면(직업 프리즘·팬텀을 다 가짐 — 특수 코어는 늘 남음) 골드로
		if grade == "prism" then
			local ex = {}
			local owned = self:GetOwned(userId)
			for i = 1, #owned do
				local d = _RtsAugmentTableLogic:GetDef(owned[i].id)
				if d ~= nil and not d.core then ex[d.id] = true end
			end
			if #_RtsAugmentTableLogic:Roll("prism", ex) == 0 then grade = "gold" end
		end
		if grade == "prism" then
			self.BuyPrismByUser[userId] = (self.BuyPrismByUser[userId] or 0) + 1
			self.BuyPrismPity[userId] = 0
		elseif self:BuyPrismLeft(userId) > 0 then
			self.BuyPrismPity[userId] = (self.BuyPrismPity[userId] or 0) + self.BuyPrismPityStep
		end
		_RtsConfigLogic:Log("RtsAugment: " .. userId .. " bought " .. grade .. " for " .. string.format("%d", price))
		self:Offer(userId, grade)
	end

	-- 클라: '증강 뽑기' 버튼 — 안 되는 이유는 안내만 하고 서버에 보내지 않는다
	@ExecSpace("ClientOnly")
	method void BuyFromHud()
		local me = _RtsUnitLogic:MyUserId()
		if not _RtsRunResultLogic:IsMeAlive() then return end
		local st = _RtsStageLogic.RunState
		if st ~= "countdown" and st ~= "running" then return end
		if (self.PendingByUser[me] or 0) >= self.MaxPending then
			_RtsHudLogic:ShowHintFor("고르지 않은 증강 선택지가 " .. _RtsHudLogic:Int(self.MaxPending) .. "개예요 — 먼저 고르고 뽑을 수 있어요", 3)
			return
		end
		local price = self:BuyPrice(me)
		if _RtsUnitLogic:GetMyMeso() < price then
			_RtsHudLogic:ShowHintFor("메소가 부족해요 — 증강 뽑기 " .. _RtsHudLogic:FormatNumber(price) .. " 메소", 3)
			return
		end
		-- 뽑기 페이지는 구매 화면으로 유지한다. 선택은 보유 탭에서 한다.
		self.PickFolded = _RtsPopupLogic.Kind == "draw"
		-- 뽑기가 서버에서 처리되면(뽑기 횟수 증가) 획득음 + 보유 증강 탭 반짝임(2026-09-26 사용자 "뽑았다는 사운드, 보유 증강 탭에 이펙트 살짝") — ClientTick(AwaitBuy)
		self.AwaitBuy = (self.BuyCountByUser[me] or 0) + 1
		self.AwaitBuyAt = _UtilLogic.ElapsedSeconds
		self:RequestBuy()
	end

	-- 클라: 3택1 창 '접기' — 창을 닫고 자동으로 다시 열지 않는다(HUD '펼치기'로)
	@ExecSpace("ClientOnly")
	method void FoldPick()
		self.PickFolded = true
		if _RtsPopupLogic.Kind == "pick" then _RtsPopupLogic:Close() end
	end

	-- 클라: HUD '펼치기' — 고르지 않은 선택지 창을 다시 연다
	@ExecSpace("ClientOnly")
	method void ExpandPick()
		self.PickFolded = false
		local packed = self.OfferByUser[_RtsUnitLogic:MyUserId()] or ""
		if packed == "" then return end
		self.ShownOffer = packed
		_RtsUnitSelectLogic:CloseMenu()
		_RtsPopupLogic:Open("pick")
	end

	-- ===== 클라 =====

	@ExecSpace("ClientOnly")
	method table MyOffer()
		return self:ParseOffer(self.OfferByUser[_RtsUnitLogic:MyUserId()] or "")
	end

	@ExecSpace("ClientOnly")
	method table MyOwned()
		return self:GetOwned(_RtsUnitLogic:MyUserId())
	end

	-- 미지정 개수(좌하단 버튼 '증강(n)')
	@ExecSpace("ClientOnly")
	method number MyUnassigned()
		local list = self:MyOwned()
		local n = 0
		for i = 1, #list do
			if list[i].no == 0 then n = n + 1 end
		end
		return n
	end

	-- 0.3초마다: 새 제안이 오면 3택1 팝업(닫기 없음 — 다른 팝업보다 우선), 증강 버튼 라벨
	@ExecSpace("ClientOnly")
	method void ClientTick()
		if not _RtsHudLogic.Built or not _RtsPopupLogic.Built then return end
		local packed = self.OfferByUser[_RtsUnitLogic:MyUserId()] or ""
		-- 뽑기 직후: 뽑기 횟수가 올라가면(서버가 받아 처리함) 획득음 + 보유 증강 탭 반짝임. 3초 안에 안 오르면(서버 거절) 기다림을 푼다
		if self.AwaitBuy > 0 then
			if (self.BuyCountByUser[_RtsUnitLogic:MyUserId()] or 0) >= self.AwaitBuy then
				self.AwaitBuy = 0
				_SoundService:PlaySound(_RtsPopupLogic.PickSound, 1)
				_RtsPopupLogic:FlashHubTab("augment")
				_RtsConfigLogic:Log("RtsAugment: bought -> sound + flash")
			elseif _UtilLogic.ElapsedSeconds - self.AwaitBuyAt > 3 then
				self.AwaitBuy = 0
			end
		end
		if self.AwaitingPendingToken > 0 then
			if self:ParseOffer(packed).token == self.AwaitingPendingToken then
				self.AwaitingPendingToken = 0
				self.PickFolded = false
				self.ChosenOffer = ""
				self.ShownOffer = packed
				_RtsPopupLogic:Open("pick")
			else
				local found = false
				for _, item in ipairs(self:MyPendingItems()) do if item.token == self.AwaitingPendingToken then found = true end end
				if not found then self.AwaitingPendingToken = 0 end
			end
		end
		-- 제안이 겹칠 때(보스 처치 프리즘 + 라운드 시작 증강, 2026-09-23 사용자 "일반 증강 선택지에 프리즘 설명만 보였다"):
		--   전엔 '받기' 직후 서버 갱신 전의 옛 제안(프리즘)으로 팝업이 다시 열리고, 서버가 다음 제안으로 바꿔도 열린 팝업은 그대로라
		--   카드는 프리즘인데 실제 선택은 일반 증강이었다 → 방금 고른 제안은 잠깐(3초) 다시 열지 않고, 제안이 바뀌면 열려 있어도 새로 그린다
		local justChosen = packed ~= "" and packed == self.ChosenOffer and _UtilLogic.ElapsedSeconds - self.ChosenAt < 3
		if packed ~= self.ChosenOffer then self.ChosenOffer = "" end
		if packed == "" then self.PickFolded = false end
		if justChosen then
			if _RtsPopupLogic.Kind == "pick" then _RtsPopupLogic:Close() end
		elseif packed ~= "" and (self.PickFolded or _RtsPopupLogic.Kind == "draw") then
			-- 접어 둠: 자동으로 열지 않는다(HUD '펼치기')
		elseif packed ~= "" and (packed ~= self.ShownOffer or _RtsPopupLogic.Kind ~= "pick") then
			self.ShownOffer = packed
			_RtsUnitSelectLogic:CloseMenu()
			_RtsPopupLogic:Open("pick")
		elseif packed == "" then
			self.ShownOffer = ""
			if _RtsPopupLogic.Kind == "pick" then _RtsPopupLogic:Close() end
		end
		_RtsHudLogic:SetAugmentCount(self:MyUnassigned())
		local pending = self.PendingByUser[_RtsUnitLogic:MyUserId()] or 0
		_RtsHudLogic:SetPendingOffers(pending, packed ~= "" and _RtsPopupLogic.Kind ~= "pick" and not justChosen)
		local price = self:BuyPrice(_RtsUnitLogic:MyUserId())
		local st = _RtsStageLogic.RunState
		local can = _RtsRunResultLogic:IsMeAlive() and (st == "countdown" or st == "running") and pending < self.MaxPending and _RtsUnitLogic:GetMyMeso() >= price
		_RtsHudLogic:SetBuyButton(price, can)
	end

	method void OnSyncProperty(string name, any value)
		if not self:IsClient() then return end
		if name == "OwnedByUser" then
			if _RtsPopupLogic.Kind == "augment" then _RtsPopupLogic:RefreshAugment() end
			_RtsUnitPopupLogic:OnUnitSynced(0)
		elseif name == "PendingByUser" or name == "PendingItemsByUser" or name == "OfferByUser" then
			if _RtsPopupLogic.Kind == "augment" then _RtsPopupLogic:RefreshAugment() end
		end
	end

end
