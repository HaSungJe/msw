-- Phase 4 #14 / Phase 5 #19 (2026-09-15) → Phase 6 (2026-09-23): 유닛 보유·조작의 서버 권위.
--   유저별 유닛 6기(번호 1~6 = HUD 슬롯), 메소, 영입·레벨업·대상 지정·스킨·위치 이동·방출 요청 처리.
--   판 시작 = 유닛 없음·메소 0(InitUser). 영입은 Lv1·무료, 보유 수 < 영입 한도(1·5·자쿰·혼테일·핑크빈·시그너스에서 1칸씩, RtsStageTableLogic.RecruitLimit)일 때만. 메소는 몹 처치 드랍(AddMeso).
--   위치 이동과 대상 변경은 유닛마다 3분 쿨타임(고정). 탈락하면 유닛 전멸(WipeUnits), 새 판이면 초기화(ResetUser).
--   유닛 엔티티 이름 = "Unit<구역>_<번호>" (/maps/RtsMap 아래) — 클라는 이 이름으로 내 유닛을 찾는다.
@Logic
script RtsUnitLogic extends Logic

	-- 유저별 보유 메소(판 시작 0, 몹 처치 드랍으로 쌓임)
	@Sync
	property SyncTable<string, number> MesoByUser

	-- 개발 도구(테스트 프리즘 버튼·프리즘 켜고 끄기 요청). 2026-09-23 사용자 "테스트 프리즘 버튼 숨기고 시작" → false(다시 쓸 땐 true)
	property boolean DevTools = false

	-- 위치 이동·대상 변경 쿨타임(초) — 유닛마다 3분 고정
	property number CooldownSec = 180

	property number MaxUnits = 6

	-- 서버: userId → { [no] = entity }
	property table UnitsByUser = {}

	-- 월드 아바타 영구 이용권(2026-09-24 사용자 "영구로 바꿔" — 전엔 30일·재구매 연장): 월드 상점 아이템 QK03ZI15E(1,600 월드코인). 한 번 사면 영구 해금.
	--   2026-09-15 비공개 등록, 출시 때 공개
	property string AvatarProductId = "QK03ZI15E"

	-- 영구 해금 값(해금 만료 자리에 넣는 아주 먼 미래 — DateTime.UtcNow.Elapsed보다 늘 크다, 2^53 아래)
	property number AvatarForever = 9000000000000000

	-- 유저별 해금 만료(UTC ms, DateTime.UtcNow.Elapsed 기준). 0 = 잠김, AvatarForever = 영구. 원본은 유저 DataStorage "avatarUntil"
	@Sync
	property SyncTable<string, number> AvatarUntilByUser

	property string AvatarKey = "avatarUntil"

	method void OnBeginPlay()
		if self:IsServer() then
			_WorldShopService:SetProcessPurchaseCallback(self.ProcessPurchase)
			-- 해금이 만료된 유닛은 기본 세트로 되돌린다(1분마다)
			_TimerService:SetTimerRepeat(function()
				self:ExpireAvatars()
			end, 60)
		end
	end

	-- ===== 공통 =====

	method string UnitName(number zone, number no)
		return "Unit" .. string.format("%d", math.floor(zone + 0.5)) .. "_" .. string.format("%d", math.floor(no + 0.5))
	end

	method number GetCooldownSec()
		return self.CooldownSec
	end

	-- 영입 상한(HUD 슬롯 수). 열거에는 쓰지 않는다 — 2026-09-20 사용자: 초과 영입이 생길 수 있으니 유닛 순회는 실제 엔티티 기준(ListZoneUnits)
	method number GetMaxUnits()
		return self.MaxUnits
	end

	-- 구역 zone에 실제로 있는 유닛 번호 목록(오름차순). 서버·클라 모두 맵 루트 자식 이름 "Unit<구역>_<번호>"를 스캔한다 — 6기 상한 없음
	method table ListZoneUnits(number zone)
		local out = {}
		if zone < 1 then return out end
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		if mapRoot == nil then return out end
		local prefix = "Unit" .. string.format("%d", math.floor(zone + 0.5)) .. "_"
		local kids = mapRoot.Children:ToTable()
		for i = 1, #kids do
			local k = kids[i]
			if k ~= nil and isvalid(k) and string.sub(k.Name, 1, #prefix) == prefix then
				local n = tonumber(string.sub(k.Name, #prefix + 1))
				if n ~= nil and k.RtsUnitComponent ~= nil then out[#out + 1] = n end
			end
		end
		table.sort(out)
		return out
	end

	-- ===== 월드 아바타 해금 (양쪽) =====

	method number GetAvatarUntil(string userId)
		local v = self.AvatarUntilByUser[userId]
		if v == nil then return 0 end
		return v
	end

	method boolean IsAvatarUnlocked(string userId)
		return self:GetAvatarUntil(userId) > DateTime.UtcNow.Elapsed
	end

	-- ===== 클라 =====

	@ExecSpace("ClientOnly")
	method string MyUserId()
		local lp = _UserService.LocalPlayer
		if lp == nil or lp.PlayerComponent == nil then return "" end
		return lp.PlayerComponent.UserId
	end

	@ExecSpace("ClientOnly")
	method boolean IsMine(string userId)
		return userId ~= "" and userId == self:MyUserId()
	end

	@ExecSpace("ClientOnly")
	method number MyZone()
		local lp = _UserService.LocalPlayer
		if lp == nil or lp.RtsCameraAnchorComponent == nil then return 0 end
		return lp.RtsCameraAnchorComponent.MyZone
	end

	-- 구역 zone의 유닛 no 상태 컴포넌트 (없으면 nil). 남의 구역도 읽을 수 있다(버프 아이콘)
	@ExecSpace("ClientOnly")
	method any GetZoneUnit(number zone, number no)
		if zone < 1 then return nil end
		local e = _EntityService:GetEntityByPath("/maps/RtsMap/" .. self:UnitName(zone, no))
		if e == nil then return nil end
		return e.RtsUnitComponent
	end

	-- 내 유닛 no의 상태 컴포넌트 (없으면 nil)
	@ExecSpace("ClientOnly")
	method any GetMyUnit(number no)
		return self:GetZoneUnit(self:MyZone(), no)
	end

	@ExecSpace("ClientOnly")
	method number GetMyMeso()
		local v = self.MesoByUser[self:MyUserId()]
		if v == nil then return 0 end
		return v
	end

	-- 내 유닛 중 (col,row)에 서 있는 유닛 번호. 없으면 0
	@ExecSpace("ClientOnly")
	method number MyUnitAt(number col, number row)
		local nos = self:ListZoneUnits(self:MyZone())
		for i = 1, #nos do
			local no = nos[i]
			local u = self:GetMyUnit(no)
			if u ~= nil and u.Col == col and u.Row == row then return no end
		end
		return 0
	end

	method void OnSyncProperty(string name, any value)
		if not self:IsClient() then return end
		_RtsHudLogic:SetMeso(self:GetMyMeso())
		_RtsUnitPopupLogic:OnUnitSynced(0)
	end

	-- 월드 상점 구매창 (Maker에선 코인 차감 없이 테스트 구매)
	@ExecSpace("ClientOnly")
	method void RequestBuyAvatar()
		if self.AvatarProductId == "" then return end
		_WorldShopService:PromptPurchase(self.AvatarProductId)
	end

	-- 서버 처리 결과 통지 (마지막 파라미터 = 그 클라에만)
	@ExecSpace("Client")
	method void OnChanged(number no, number meso, string userId)
		_RtsHudLogic:SetMeso(meso)
		_RtsHudLogic:RefreshMyUnits()
		_RtsUnitPopupLogic:OnUnitSynced(no)
	end

	-- ===== 서버: 지급·스폰 =====

	@ExecSpace("ServerOnly")
	method Entity GetUnit(string userId, number no)
		local list = self.UnitsByUser[userId]
		if list == nil then return nil end
		return list[no]
	end

	@ExecSpace("ServerOnly")
	method number GetMeso(string userId)
		local v = self.MesoByUser[userId]
		if v == nil then return 0 end
		return v
	end

	-- 입장(RtsStageLogic.OnUserEnter): 유닛 없음·메소 0으로 시작(이미 있으면 그대로 — 판 초기화는 ResetUser)
	@ExecSpace("ServerOnly")
	method void InitUser(string userId)
		if self.UnitsByUser[userId] == nil then self.UnitsByUser[userId] = {} end
		if self.MesoByUser[userId] == nil then
			self.MesoByUser[userId] = 0
			self:LoadAvatarPass(userId)
		end
		self:OnChanged(0, self:GetMeso(userId), userId)
	end

	-- 몹 처치 드랍(RtsRunResultLogic.OnMobKilled — 구역 주인). 처치마다 RPC를 보내지 않는다 — MesoByUser 동기화(OnSyncProperty)가 HUD 메소·레벨업 버튼을 갱신
	@ExecSpace("ServerOnly")
	method void AddMeso(string userId, number n)
		if n <= 0 or self.UnitsByUser[userId] == nil then return end
		self.MesoByUser[userId] = self:GetMeso(userId) + n
	end

	-- 탈락: 유닛 전멸(공격 루프 정지·엔티티 제거). 메소는 남겨 둔다(결과 표시용 아님 — 새 판에서 ResetUser)
	@ExecSpace("ServerOnly")
	method void WipeUnits(string userId)
		self:ClearUnits(userId)
		self:OnChanged(0, self:GetMeso(userId), userId)
	end

	-- 새 판(RtsStageLogic.ResetRun): 유닛 제거 + 메소 0
	@ExecSpace("ServerOnly")
	method void ResetUser(string userId)
		self:ClearUnits(userId)
		self.MesoByUser[userId] = 0
		self:OnChanged(0, 0, userId)
	end

	-- 이 유저가 지금 더 영입할 수 있는 수(한도 − 보유, 0 미만 0)
	@ExecSpace("ServerOnly")
	method number RecruitRoom(string userId)
		local owned = 0
		local list = self.UnitsByUser[userId]
		if list ~= nil then
			for no, e in pairs(list) do
				if e ~= nil and isvalid(e) then owned = owned + 1 end
			end
		end
		local room = _RtsStageTableLogic:RecruitLimit(_RtsStageLogic.StageNo) - owned
		if room < 0 then room = 0 end
		return room
	end

	-- 유닛 엔티티 = MapObject + AvatarRenderer + CostumeManager(직업 세트) + RtsUnitComponent. 스케일 2 = 칸 80px. 클릭 판정은 RtsUnitSelectLogic(화면 터치 상자) — TouchReceive 없음
	@ExecSpace("ServerOnly")
	method Entity SpawnUnit(string userId, number zone, number no, string jobId, number level, number col, number row)
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		if mapRoot == nil then return nil end
		-- 같은 슬롯에 이미 유닛이 있으면 먼저 지운다(2026-09-22: 개발 스크립트 스폰과 영입이 같은 순간 겹쳐 슬롯 1에 엔티티가 둘 → 방출 뒤 유령 유닛이 남아 계속 공격). 루프도 정지
		local old = nil
		if self.UnitsByUser[userId] ~= nil then old = self.UnitsByUser[userId][no] end
		if old ~= nil and isvalid(old) then
			_RtsCombatLogic:StopLoop(userId, no)
			old:Destroy()
		end
		local at = _RtsZoneLogic:GetCellCenter(zone, col, row)
		local e = _SpawnService:SpawnByModelId("model://MapObject", self:UnitName(zone, no), Vector3(at.x, at.y - 0.75, 0), mapRoot)
		if e == nil then return nil end
		e:RemoveComponent("SpriteRendererComponent")
		local ar = e:AddComponent("AvatarRendererComponent")
		if ar ~= nil then ar.OrderInLayer = 200 end
		e:AddComponent("CostumeManagerComponent")
		-- 공격(Phase 3): 확장 AttackComponent + 데미지 스킨 형식(숫자는 몬스터의 DamageSkinSpawner가 그림)
		e:AddComponent("RtsUnitAttackComponent")
		local skin = e:AddComponent("DamageSkinSettingComponent")
		if skin ~= nil then
			-- 스킨 = 메이플 기본 데미지 스킨(RtsCombatLogic.DamageSkinId). 카메라 줌 30%라 기본 크기는 안 보인다(사용자 2026-09-17 "너무 작음") → 배율 RtsCombatLogic.DamageSkinScale. Default 트윈은 흔들려 보여 Blade(같은 자리에서 위로)
			skin.DamageSkinId = DataRef(_RtsCombatLogic.DamageSkinId)
			skin.DamageSkinScale = Vector2(_RtsCombatLogic.DamageSkinScale, _RtsCombatLogic.DamageSkinScale)
			skin.TweenType = DamageSkinTweenType.Blade
			skin.DelayPerAttack = 0.08
		end
		e.TransformComponent.Scale = Vector3(2, 2, 1)
		local u = e:AddComponent("RtsUnitComponent")
		u.Owner = userId
		u.Zone = zone
		u.No = no
		u.JobId = jobId
		u.Level = level
		u.Skin = 0
		u.Col = col
		u.Row = row
		u.SkillLocks = _RtsJobTableLogic:DefaultLocks(jobId)
		u:ApplyLook()
		self:EnsureShadow(e)
		self.UnitsByUser[userId][no] = e
		-- 모든 유닛은 스폰 즉시 자기 공격 루프를 돈다(2026-09-20 사용자 "모든 유닛이 개별적으로 동작하고 공격도 자율적으로" — 전엔 시험대 유닛 1기만). 사거리 안에 적이 없으면 DoAttack이 그냥 넘어간다
		_RtsCombatLogic:StartLoop(userId, no)
		return e
	end

	-- 쉐도우 파트너 그림자(2026-09-20 사용자 "쉐도우 파트너 배우면 등 뒤에 나타나야 해" / "그림자가 캐릭터랑 똑같은 실루엣이면 안 될 것 같은데" → 원작 skill/4111002/special 검은 실루엣 클립):
	--   능력치에 halfHits(그림자 표창)가 있으면 유닛 자식 "Shadow" 스프라이트(stand1 클립)를 세운다. 위치·방향은 클라 RtsUnitComponent.ApplyShadow, 동작 따라가기는 RtsSkillFxLogic.SendAction(같은 이름의 special 클립).
	--   그리기 순서 −5(아바타 부품은 order 0 — 항상 캐릭터 뒤). 부모 스케일 2를 그대로 받아 캐릭터 크기
	@ExecSpace("ServerOnly")
	method void EnsureShadow(Entity e)
		if e == nil or not isvalid(e) then return end
		local u = e.RtsUnitComponent
		if u == nil then return end
		local want = (_RtsJobTableLogic:GetStatFor(u).halfHits or 0) > 0
		local sh = e:GetChildByName("Shadow")
		if not want then
			if sh ~= nil and isvalid(sh) then sh:Destroy() end
			return
		end
		if sh ~= nil and isvalid(sh) then return end
		local wp = e.TransformComponent.WorldPosition
		sh = _SpawnService:SpawnByModelId("model://MapObject", "Shadow", Vector3(wp.x, wp.y, 0), e)
		if sh == nil then return end
		local sr = sh.SpriteRendererComponent
		if sr ~= nil then
			sr.SpriteRUID = _RtsSkillFxLogic:ShadowClip("stand1")
			sr.OrderInLayer = -5 -- 아바타 부품은 order 0에 그려지므로 그 뒤(사용자 2026-09-20 "그림자보다 캐릭터가 항상 우선")
		end
		sh.TransformComponent.Scale = Vector3(1, 1, 1)
		sh.TransformComponent.Position = Vector3(0.22, 0, 0)
	end

	-- 대상 지정 스킬(홀리 유니티 — 프리즘)의 획득 레벨. 프리즘이 스킬 표에 얹은 target 항목까지 본다
	method number TargetSkillLevelFor(any u)
		local list = _RtsJobTableLogic:GetSkillsFor(u)
		for i = 1, #list do
			if list[i].target then return list[i].lv end
		end
		return 0
	end

	-- ===== 프리즘 증강 적용(서버, 2026-09-22) =====
	--   Prisms에 id 추가 → 그 프리즘의 영구 잠금(3) → 그림자·공격 루프 재설정(주기가 바뀔 수 있음) → 알림. 같은 id 두 번은 무시, 직업이 다르면 무시
	@ExecSpace("ServerOnly")
	method void ApplyPrism(string userId, number no, string id)
		local e = self:GetUnit(userId, no)
		if e == nil then return end
		local u = e.RtsUnitComponent
		local T = _RtsJobTableLogic
		if T:HasPrism(u, id) then return end
		local p = T:GetPrism(id)
		if p == nil or p.job ~= u.JobId then return end
		if u.Prisms == "" then u.Prisms = id else u.Prisms = u.Prisms .. "," .. id end
		self:SyncPrismLocks(e)
		self:EnsureShadow(e)
		_RtsCombatLogic:StartLoop(userId, no)
		self:OnChanged(no, self:GetMeso(userId), userId)
		log("RtsUnit: prism " .. id .. " -> unit " .. string.format("%d", no) .. " (" .. u.JobId .. ")")
	end

	-- 프리즘 영구 잠금(3)은 그 프리즘 스킬을 쓸 수 있는 레벨(대개 50)이 된 뒤에만 건다 — 2026-09-23 사용자 "레벨 제한을 못 채우면 다른 스킬은 잠기지 않게,
	--   트루 스나이핑(50)을 받았더니 스킬이 다 잠겼다". 프리즘 지정·레벨업 때 부른다(이미 3이면 그대로)
	@ExecSpace("ServerOnly")
	method void SyncPrismLocks(Entity e)
		if e == nil or not isvalid(e) then return end
		local u = e.RtsUnitComponent
		if u == nil or u.Prisms == nil or u.Prisms == "" then return end
		local T = _RtsJobTableLogic
		for id in string.gmatch(u.Prisms, "[^,]+") do
			local p = T:GetPrism(id)
			if p ~= nil and p.locks ~= nil and u.Level >= T:PrismLockLevel(id, u.JobId) then
				local skills = T:GetSkillsFor(u)
				for i = 1, #p.locks do
					local idx = T:FindSkill(skills, p.locks[i])
					if idx > 0 and T:GetLock(u.SkillLocks, idx) ~= 3 then u.SkillLocks = T:SetLock(u.SkillLocks, idx, 3) end
				end
			end
		end
	end

	-- ===== 영입 =====
	--   영입 팝업의 직업 카드 → 클라 배치 모드(RtsUnitSelectLogic.BeginPlace)에서 고른 빈 발판 (col,row)에 빈 번호(1~MaxUnits)로 세운다(2026-09-22 사용자 "중앙에 생성하지 말고 위치 선택, 취소하면 영입도 취소").
	--   본편(2026-09-23 사용자 "항상 Lv1 + 메소 레벨업", "5라운드당 1명"): 무료·Lv1, 보유 수 < 영입 한도일 때만(방출로 빈 칸은 다시 영입 가능).
	--   거부: 판 진행 중(카운트다운·진행)이 아님 / 탈락·클리어한 유저 / 한도 초과 / 발판 아님 / 내 유닛이 서 있음 / 같은 직업 보유
	@ExecSpace("Server")
	method void RequestRecruitAt(string jobId, number col, number row)
		local userId = senderUserId
		if not _RtsJobTableLogic:HasJob(jobId) then return end
		local state = _RtsStageLogic.RunState
		-- 영입은 진행 중에만(2026-09-24 사용자 "시작도 안 했는데 영입 가능" — 전엔 카운트다운도)
		if state ~= "running" then return end
		if not _RtsRunResultLogic:IsAlive(userId) then return end
		if not self:IsJobUnlocked(userId, jobId) then return end
		if self:RecruitRoom(userId) <= 0 then
			log("RtsUnit: recruit " .. jobId .. " refused — limit")
			return
		end
		local zone = _RtsZoneLogic:GetZoneOfUser(userId)
		if zone < 1 then return end
		if not _RtsZoneLogic:IsPadCell(col, row) then return end
		if self.UnitsByUser[userId] == nil then self.UnitsByUser[userId] = {} end
		local list = self.UnitsByUser[userId]
		-- 동일 직업 중복 영입 불가(character.md 헤더 규칙; 2026-09-22 사용자 "듀얼블레이더로 전직했어도 섀도어 영입 추가 안 되어야 하는 건 당연" — 프리즘으로 이름이 바뀌어도 JobId는 그대로라 막힌다). 개발모드도 같음
		if self:HasJobUnit(userId, jobId) then
			log("RtsUnit: recruit " .. jobId .. " refused — already owned")
			return
		end
		local no = 0
		for i = 1, self.MaxUnits do
			local e = list[i]
			if e == nil or not isvalid(e) then
				no = i
				break
			end
		end
		if no == 0 then return end
		for _, oe in pairs(list) do
			if oe ~= nil and isvalid(oe) and oe.RtsUnitComponent ~= nil and oe.RtsUnitComponent.Col == col and oe.RtsUnitComponent.Row == row then
				log("RtsUnit: recruit " .. jobId .. " refused — pad (" .. string.format("%d,%d", col, row) .. ") occupied")
				return
			end
		end
		self:SpawnUnit(userId, zone, no, jobId, 1, col, row)
		self:OnChanged(no, self:GetMeso(userId), userId)
		log("RtsUnit: recruit " .. jobId .. " -> unit " .. string.format("%d", no) .. " at (" .. string.format("%d,%d", col, row) .. ")")
	end

	-- 영입할 수 있게 열린 직업인가(서버·클라 공용). 모험가 10직업은 항상, 영웅 팬텀은 프리즘 '팬텀 잠금 해제'(augmentation.md)를 받은 유저만.
	--   2026-09-23 사용자 "팬텀 프리즘 없는데도 팬텀 영입 가능 — 선택조차 못 하게": 전엔 개발 도구(DevTools)가 켜져 있으면 열려 있었다(증강 시스템 전 임시) → 제거.
	--   클라 영입 카드(RtsPopupLogic 영입 창 — '잠김', 클릭 없음)와 서버 RequestRecruitAt가 같이 쓴다
	method boolean IsJobUnlocked(string userId, string jobId)
		if jobId ~= "phantom" then return true end
		return _RtsAugmentLogic:HasUnlock(userId, "phantom")
	end

	-- 이 유저가 그 직업 유닛을 이미 보유했는가(서버)
	@ExecSpace("ServerOnly")
	method boolean HasJobUnit(string userId, string jobId)
		local list = self.UnitsByUser[userId]
		if list == nil then return false end
		for _, e in pairs(list) do
			if e ~= nil and isvalid(e) and e.RtsUnitComponent ~= nil and e.RtsUnitComponent.JobId == jobId then return true end
		end
		return false
	end

	-- 방출 환급률: 그 유닛의 레벨업에 쓴 메소(SpentMeso)의 30%(2026-09-22 사용자 "증강 소멸 / 메소 사용한 것의 30% 회수(레벨업에 사용한)")
	property number DismissRefundRate = 0.3

	-- 유닛 1기 방출(본편 기능, 2026-09-22): 캐릭터 메뉴 '방출' → 두 번째 클릭으로 확정. 효과 — 그 유닛의 증강(프리즘 포함)은 소멸, 레벨업에 쓴 메소의 30% 환급(영입가는 환급 없음),
	--   이 유닛을 대상으로 지정한 홀리 유니티는 미지정으로, 번호는 비워 두어 다음 영입이 채운다. 증강 시스템(Phase 4 나머지)이 생기면 RtsAugmentLogic에 '유닛 방출' 훅으로 지정 증강을 지운다
	@ExecSpace("Server")
	method void RequestDismiss(number no)
		local userId = senderUserId
		local list = self.UnitsByUser[userId]
		if list == nil then return end
		local e = list[no]
		if e == nil or not isvalid(e) then return end
		local u = e.RtsUnitComponent
		local refund = self:DismissRefund(u)
		_RtsCombatLogic:StopLoop(userId, no)
		for otherNo, oe in pairs(list) do
			if oe ~= nil and isvalid(oe) and oe.RtsUnitComponent ~= nil and oe.RtsUnitComponent.BondNo == no then oe.RtsUnitComponent.BondNo = 0 end
		end
		list[no] = nil
		e:Destroy()
		-- 그 유닛에 지정된 증강 소멸(2026-09-22 규칙)
		_RtsAugmentLogic:OnUnitDismissed(userId, no)
		self.MesoByUser[userId] = self:GetMeso(userId) + refund
		self:OnChanged(0, self:GetMeso(userId), userId)
		log("RtsUnit: dismiss unit " .. string.format("%d", no) .. " refund " .. string.format("%d", refund))
	end

	-- 방출 시 환급액(서버 지급·클라 확인 문구 공용) — 10메소 단위로 내림
	method number DismissRefund(any u)
		if u == nil then return 0 end
		return math.floor((u.SpentMeso or 0) * self.DismissRefundRate / 10 + 0.0001) * 10
	end

	-- 개발 도구: 내 유닛 전부 삭제(테스트 프리즘 팝업의 '유닛 전부 삭제')
	@ExecSpace("Server")
	method void RequestDevClear()
		local userId = senderUserId
		if not self.DevTools then return end
		self:ClearUnits(userId)
		self:OnChanged(0, self:GetMeso(userId), userId)
		log("RtsUnit: dev clear")
	end

	-- 프리즘 id를 그 직업인 내 유닛에 적용(팬텀 영입 프리즘은 직업 목록에서 팬텀을 고르면 되니 여기선 무시)
	@ExecSpace("Server")
	method void RequestDevPrism(string id)
		local userId = senderUserId
		if not self.DevTools then return end
		local p = _RtsJobTableLogic:GetPrism(id)
		if p == nil or p.job == "" then return end
		local list = self.UnitsByUser[userId]
		if list == nil then return end
		for no, e in pairs(list) do
			if e ~= nil and isvalid(e) and e.RtsUnitComponent ~= nil and e.RtsUnitComponent.JobId == p.job then
				if _RtsJobTableLogic:HasPrism(e.RtsUnitComponent, id) then
					self:RemovePrism(userId, no, id)
				else
					self:ApplyPrism(userId, no, id)
				end
			end
		end
	end

	-- 프리즘 해제(개발모드 토글용): Prisms에서 id 제거 → 그 프리즘이 잠근 스킬을 기본 잠금값으로 되돌림 → 그림자·루프·알림
	@ExecSpace("ServerOnly")
	method void RemovePrism(string userId, number no, string id)
		local e = self:GetUnit(userId, no)
		if e == nil then return end
		local u = e.RtsUnitComponent
		local T = _RtsJobTableLogic
		if not T:HasPrism(u, id) then return end
		local p = T:GetPrism(id)
		-- 잠금 복구는 제거 전 표(프리즘이 얹은 항목 순서)로 인덱스를 찾는다
		if p ~= nil and p.locks ~= nil then
			local skills = T:GetSkillsFor(u)
			for i = 1, #p.locks do
				local idx = T:FindSkill(skills, p.locks[i])
				if idx > 0 then
					local def = 0
					if skills[idx].lock ~= nil then def = skills[idx].lock end
					u.SkillLocks = T:SetLock(u.SkillLocks, idx, def)
				end
			end
		end
		local keep = {}
		for q in string.gmatch(u.Prisms, "[^,]+") do
			if q ~= id then keep[#keep + 1] = q end
		end
		u.Prisms = table.concat(keep, ",")
		self:EnsureShadow(e)
		_RtsCombatLogic:StartLoop(userId, no)
		self:OnChanged(no, self:GetMeso(userId), userId)
		log("RtsUnit: prism " .. id .. " removed from unit " .. string.format("%d", no))
	end

	-- 내 유닛 전부 제거(루프 정지·엔티티 삭제) — 개발모드 직업 교체용. 메소·아바타 패스는 유지
	@ExecSpace("ServerOnly")
	method void ClearUnits(string userId)
		local list = self.UnitsByUser[userId]
		if list == nil then return end
		for no, e in pairs(list) do
			_RtsCombatLogic:StopLoop(userId, no)
			if e ~= nil and isvalid(e) then e:Destroy() end
		end
		self.UnitsByUser[userId] = {}
	end

	-- 퇴장: 유닛(루프 정지 포함)·메소·아바타 패스 상태를 지운다
	@ExecSpace("ServerOnly")
	method void RemoveUnits(string userId)
		local list = self.UnitsByUser[userId]
		if list == nil then return end
		for no, e in pairs(list) do
			_RtsCombatLogic:StopLoop(userId, no)
			if e ~= nil and isvalid(e) then e:Destroy() end
		end
		self.UnitsByUser[userId] = nil
		self.MesoByUser[userId] = nil
		self.AvatarUntilByUser[userId] = nil
	end

	-- 유저 DataStorage에서 해금 만료 시각을 읽는다(없으면 0)
	@ExecSpace("ServerOnly")
	method void LoadAvatarPass(string userId)
		local ds = _DataStorageService:GetUserDataStorage(userId)
		if ds == nil then return end
		local code, value = ds:GetAndWait(self.AvatarKey)
		local untilMs = 0
		if code == 0 and value ~= nil and value ~= "" then untilMs = tonumber(value) or 0 end
		self.AvatarUntilByUser[userId] = untilMs
	end

	-- 월드 상점 지급 콜백: 구매 = 영구 해금(이미 영구면 그대로 — 값만 다시 쓴다). true를 돌려줘야 구매 완료
	@ExecSpace("ServerOnly")
	method boolean ProcessPurchase(any info)
		if info == nil or info.ProductId ~= self.AvatarProductId then
			log("RtsUnit: unknown product " .. tostring(info ~= nil and info.ProductId or "nil"))
			return false
		end
		local userId = info.UserId
		local untilMs = self.AvatarForever
		local ds = _DataStorageService:GetUserDataStorage(userId)
		if ds ~= nil then
			local code = ds:SetAndWait(self.AvatarKey, string.format("%d", untilMs))
			if code ~= 0 then
				log("RtsUnit: avatar pass save failed code=" .. tostring(code))
				return false
			end
		end
		self.AvatarUntilByUser[userId] = untilMs
		log("RtsUnit: avatar pass permanent for " .. userId .. " (order " .. tostring(info.OrderNumber) .. ")")
		self:OnChanged(0, self:GetMeso(userId), userId)
		return true
	end

	-- 해금이 없는 유저의 월드 아바타 스킨을 기본 세트로(영구 이용권 전 30일권이 끝난 경우 등)
	@ExecSpace("ServerOnly")
	method void ExpireAvatars()
		for userId, list in pairs(self.UnitsByUser) do
			if not self:IsAvatarUnlocked(userId) then
				local changed = false
				for no, e in pairs(list) do
					local u = e.RtsUnitComponent
					if u ~= nil and u.Skin == 1 then
						u.Skin = 0
						u:ApplyLook()
						changed = true
					end
				end
				if changed then self:OnChanged(0, self:GetMeso(userId), userId) end
			end
		end
	end

	-- ===== 서버: 요청 처리 (클라에서 호출, senderUserId로 소유 검증) =====

	@ExecSpace("Server")
	method void RequestLevelUp(number no)
		local userId = senderUserId
		local e = self:GetUnit(userId, no)
		if e == nil then return end
		local u = e.RtsUnitComponent
		if u.Level >= _RtsJobTableLogic:GetMaxLevel() then return end
		local cost = _RtsJobTableLogic:GetLevelCost(u.Level + 1)
		local meso = self:GetMeso(userId)
		if meso < cost then return end
		self.MesoByUser[userId] = meso - cost
		u.Level = u.Level + 1
		u.SpentMeso = u.SpentMeso + cost
		self:SyncPrismLocks(e)
		self:EnsureShadow(e)
		-- 레벨로 공격 주기가 바뀔 수 있어(공격속도 강화·period) 루프를 새 주기로 다시 건다
		_RtsCombatLogic:StartLoop(userId, no)
		self:OnChanged(no, meso - cost, userId)
		-- 소리·이펙트는 누른 사람 클라가 누르는 순간 바로 낸다(LevelUpNow) — 여기선 그 구역을 보는 다른 사람용 이펙트만
		self:ShowLevelUpEffect(u.Zone, no)
	end

	-- 클라: 레벨업 버튼·스페이스·메뉴 — 누르는 순간 소리 + 이펙트를 바로 내고(서버 왕복을 기다리면 늦다 — 2026-09-23 사용자 "레벨업 이펙트가 너무 느려,
	--   누르는 순간 이펙트랑 소리가 같이"), 서버에 레벨업 요청. 메소·최대 레벨은 부르는 쪽(CanLevelUp)이 먼저 거른다
	@ExecSpace("ClientOnly")
	method void LevelUpNow(number no)
		local u = self:GetMyUnit(no)
		if u == nil then return end
		_SoundService:PlaySound(self.LevelUpSound, 1)
		_RtsSkillFxLogic:PlaySfx(self.LevelUpSound, 1 / _RtsSkillFxLogic.SfxMaster, 1)
		self:PlayLevelUpClip(u)
		self:RequestLevelUp(no)
	end

	-- 클라: 레벨업 이펙트 클립·소리를 미리 올려 둔다(첫 레벨업 때 로딩으로 늦게 뜨지 않게) — 유닛이 생길 때(RtsUnitComponent.SetupClient)
	@ExecSpace("ClientOnly")
	method void WarmLevelUpFx()
		_RtsSkillFxLogic:Preload({ clip = self.LevelUpClip })
		_SoundService:LoadSound(self.LevelUpSound)
	end

	-- 레벨업 효과음(원작 sound/game/levelup — 2026-09-23 사용자 "레벨업 사운드도") — 누른 사람에게만(LevelUpNow).
	--   "레벨업 소리 좀 커야" — 볼륨 상한이 1.0이라 효과음 배율(SfxMaster) 없이 최대로, 같은 소리를 두 겹(SoundService + 효과음 풀) 동시에 틀어 더 크게
	property string LevelUpSound = "c198d87b06b24707864b1ac73345cca8"

	-- 레벨업 이펙트(원작 effect/basiceff/levelup_fast — 2026-09-23 사용자 "레벨업하는 캐릭터 주위에 레벨업 이펙트") — 유닛 발밑에 붙여 한 번(유닛 스케일을 그대로 받음),
	--   그 구역을 보고 있는 클라만
	property string LevelUpClip = "d92f2ec742d94285af771d33086773d3"

	@ExecSpace("Client")
	method void ShowLevelUpEffect(number zone, number no)
		if math.floor(zone + 0.5) ~= math.floor(_RtsHudLogic.WatchedZone + 0.5) then return end
		-- 내 구역(= 내가 누른 레벨업)은 LevelUpNow가 이미 냈다
		if math.floor(zone + 0.5) == math.floor(self:MyZone() + 0.5) then return end
		self:PlayLevelUpClip(self:GetZoneUnit(zone, no))
	end

	@ExecSpace("ClientOnly")
	method void PlayLevelUpClip(any u)
		if u == nil or u.Entity == nil or not isvalid(u.Entity) then return end
		_EffectService:PlayEffectAttached(self.LevelUpClip, u.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { SortingLayer = "Default", OrderInLayer = 305 })
	end

	-- 대상 지정(홀리 유니티): 대상 지정 스킬을 가진 직업·레벨이어야 하고, 대상은 내 다른 유닛 또는 0(미지정). 바꾸면 3분 쿨
	@ExecSpace("Server")
	method void RequestBond(number no, number targetNo)
		local userId = senderUserId
		local e = self:GetUnit(userId, no)
		if e == nil then return end
		local u = e.RtsUnitComponent
		local need = self:TargetSkillLevelFor(u)
		if need <= 0 or u.Level < need then return end
		if targetNo == no then return end
		if targetNo ~= 0 and self:GetUnit(userId, targetNo) == nil then return end
		if u.BondNo == targetNo then return end
		if u:BondCoolLeft() > 0 then return end
		u.BondNo = targetNo
		u.BondReadyAt = _UtilLogic.ServerElapsedSeconds + self.CooldownSec
		self:OnChanged(no, self:GetMeso(userId), userId)
	end

	-- 액티브 스킬 잠금 설정(2026-09-16): 획득한 액티브 스킬만, mode 0 사용 / 1 보스전 잠금 / 2 잠금. 쿨타임 없음. 영구 잠금(3)인 스킬은 못 바꾸고, 3으로 바꿀 수도 없다
	@ExecSpace("Server")
	method void RequestSkillLock(number no, number idx, number mode)
		local userId = senderUserId
		local e = self:GetUnit(userId, no)
		if e == nil then return end
		if mode ~= 0 and mode ~= 1 and mode ~= 2 then return end
		local u = e.RtsUnitComponent
		local skills = _RtsJobTableLogic:GetSkillsFor(u)
		local k = skills[idx]
		if k == nil or k.kind ~= "액티브" or u.Level < k.lv then return end
		local cur = _RtsJobTableLogic:GetLock(u.SkillLocks, idx)
		if cur == 3 or cur == mode then return end
		u.SkillLocks = _RtsJobTableLogic:SetLock(u.SkillLocks, idx, mode)
		self:OnChanged(no, self:GetMeso(userId), userId)
	end

	-- 영구 잠금(프리즘 증강 "영구적 잠금" — 광전사의 드래곤 로어, 일격필살의 피어싱, 나도 던진다!의 새비지 블로우·메소 익스플로전).
	--   증강 시스템(Phase 6)이 부른다. 획득 전 스킬도 잠근다(획득해도 잠긴 채). 풀 수 없음
	@ExecSpace("ServerOnly")
	method void SetPermaLock(string userId, number no, number idx)
		local e = self:GetUnit(userId, no)
		if e == nil then return end
		local u = e.RtsUnitComponent
		local skills = _RtsJobTableLogic:GetSkillsFor(u)
		local k = skills[idx]
		if k == nil or k.kind ~= "액티브" then return end
		if _RtsJobTableLogic:GetLock(u.SkillLocks, idx) == 3 then return end
		u.SkillLocks = _RtsJobTableLogic:SetLock(u.SkillLocks, idx, 3)
		self:OnChanged(no, self:GetMeso(userId), userId)
	end

	-- 스킨: 0 기본 세트 / 1 월드 아바타(해금 중일 때만)
	@ExecSpace("Server")
	method void RequestSkin(number no, number skin)
		local userId = senderUserId
		local e = self:GetUnit(userId, no)
		if e == nil then return end
		if skin ~= 0 and skin ~= 1 then return end
		if skin == 1 and not self:IsAvatarUnlocked(userId) then return end
		local u = e.RtsUnitComponent
		if u.Skin == skin then return end
		u.Skin = skin
		u:ApplyLook()
		self:OnChanged(no, self:GetMeso(userId), userId)
	end

	-- 위치 이동: 발판 칸이어야 하고, 내 다른 유닛이 있으면 자리를 맞바꾼다(둘 다 3분 쿨)
	@ExecSpace("Server")
	method void RequestMove(number no, number col, number row)
		local userId = senderUserId
		local e = self:GetUnit(userId, no)
		if e == nil then return end
		local u = e.RtsUnitComponent
		if u:MoveCoolLeft() > 0 then return end
		if not _RtsZoneLogic:IsPadCell(col, row) then return end
		if u.Col == col and u.Row == row then return end
		local now = _UtilLogic.ServerElapsedSeconds
		local cool = self.CooldownSec
		local list = self.UnitsByUser[userId]
		for otherNo, oe in pairs(list) do
			local o = oe.RtsUnitComponent
			if otherNo ~= no and o.Col == col and o.Row == row then
				if o:MoveCoolLeft() > 0 then return end
				o:PlaceAt(u.Col, u.Row)
				o.MoveReadyAt = now + cool
			end
		end
		u:PlaceAt(col, row)
		u.MoveReadyAt = now + cool
		log("RtsUnit: move " .. string.format("%d", no) .. " -> (" .. string.format("%d,%d", col, row) .. ")")
		self:OnChanged(no, self:GetMeso(userId), userId)
	end

end
