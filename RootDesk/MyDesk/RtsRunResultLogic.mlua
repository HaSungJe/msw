-- Phase 6·7 (2026-09-23): 유저별 한 판 결과 — 진행 중 / 탈락 / 클리어, 처치 수, 마지막으로 버틴 스테이지, 보스 HP 깎은 비율.
--   탈락(필드 110 또는 보스 시간 초과) → 그 구역 몹·보스 정리, 유닛 전멸, 구역 가운데 비석, 플레이어 목록 탈락, 개인 최고 기록 저장, 결과 팝업.
--   클리어(검은 마법사 4페이즈 처치) → 결과 팝업. 솔로(방 인원 1)면 '다시 하기', 여럿이면 '나가기' = 대기방으로(RequestExit — 인스턴스 방이면 정적 방으로, 지금은 안내).
--   점수 = 마지막으로 버틴 스테이지 순번 × 100,000 + 탈락한 보스전의 보스 HP 깎은 비율(0~10,000) — 전광판 등록은 Phase 8 #42.
--   클리어 = 난이도별(어려움·매우어려움·극악) 검은 마법사 4페이즈 클리어 횟수 순위 저장(SaveClear, 2026-09-24 사용자 — 옛 최종 메소 순위 폐기).
@Logic
script RtsRunResultLogic extends Logic

	-- 유저별 상태: 0 진행 중 / 1 탈락 / 2 클리어 (클라 HUD·영입 판단용)
	@Sync
	property SyncTable<string, number> StateByUser

	-- 서버: userId → { last = 마지막으로 버틴 순번, kills, pct = 보스 HP 깎은 비율(0~1), reason = "field"/"boss"/"" }
	property table Info = {}

	-- 구역 비석 엔티티(새 판에서 지운다)
	property table Tombs = {}

	-- 비석 그림·크기 = 그 구역 주인의 비석 프리셋(RtsTombLogic — 2026-09-25 사용자 "비석도 프리셋". 기본 비석 = 원작 묘비 map/obj/jpsengoku2014/east_out/gravestone, 스케일 5)

	-- 비석 사운드 = 원작 sound/game/tombstone(캐릭터 사망 때 비석 떨어지는 소리, 2026-09-23 사용자 "사망 시 비석 사운드")
	property string TombSound = "8727e134756141c58bf2f525a1598eee"

	property string BestKey = "BestRun"

	property number ScorePerStage = 100000

	-- 순위(2026-09-24 사용자 "어려움/매우어려움/극악을 따로따로 분리해서 클리어 횟수 순위로" — 옛 최종 메소 순위 폐기):
	--   난이도별 SortableDataStorage RankStorage .. "_D" .. 난이도(4 어려움 · 5 매우어려움 · 6 극악), userId → 값.
	--   값 = 검은 마법사 4페이즈 클리어 횟수 × RankScale + (RankScale − 1 − 2026-01-01부터 흐른 초) → 횟수가 같으면 그 횟수에 먼저 도달한 사람이 위.
	--   닉네임 = GlobalDataStorage RankNickStorage(userId → 닉네임, 클리어할 때 갱신). 보통 이하·테스트 모드 판은 기록하지 않는다
	property string RankStorage = "RtsBm4Clear"

	property string RankNickStorage = "RtsRankNick"

	property number RankMinDiff = 4

	property number RankScale = 10000000000

	property number RankMax = 999999999999999

	-- 순위 창 한 탭에 보이는 인원
	property number RankShowTop = 50

	-- 서버: 순위 조회 연타 방지(userId .. 난이도 → 마지막 조회 시각)
	property table RankAskAt = {}

	-- ===== 상태 조회(서버·클라 공용) =====

	method boolean IsAlive(string userId)
		local v = self.StateByUser[userId]
		return v == nil or v == 0
	end

	method number GetState(string userId)
		local v = self.StateByUser[userId]
		if v == nil then return 0 end
		return v
	end

	@ExecSpace("ClientOnly")
	method boolean IsMeAlive()
		return self:IsAlive(_RtsUnitLogic:MyUserId())
	end

	-- ===== 서버 =====

	@ExecSpace("ServerOnly")
	method void InitUser(string userId)
		if self.Info[userId] == nil then
			self.Info[userId] = { last = 0, kills = 0, pct = 0, reason = "" }
		end
		self.StateByUser[userId] = 0
	end

	@ExecSpace("ServerOnly")
	method void OnLeave(string userId)
		self.Info[userId] = nil
		self.StateByUser[userId] = nil
	end

	-- 새 판: 비석 지우고 지금 있는 유저를 다시 진행 중으로
	@ExecSpace("ServerOnly")
	method void ResetAll()
		for i = 1, #self.Tombs do
			local t = self.Tombs[i]
			if t ~= nil and isvalid(t) then t:Destroy() end
		end
		self.Tombs = {}
		self.Info = {}
		for userId, zone in pairs(_RtsZoneLogic.ZoneByUser) do
			self:InitUser(userId)
		end
	end

	@ExecSpace("ServerOnly")
	method string OwnerOfZone(number zone)
		local z = math.floor(zone + 0.5)
		for userId, uz in pairs(_RtsZoneLogic.ZoneByUser) do
			if math.floor(uz + 0.5) == z then return userId end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method boolean IsZoneAlive(number zone)
		local owner = self:OwnerOfZone(zone)
		return owner ~= "" and self:IsAlive(owner)
	end

	-- 살아 있는(진행 중) 유저들의 구역 번호(오름차순)
	@ExecSpace("ServerOnly")
	method table AliveZones()
		local out = {}
		for userId, zone in pairs(_RtsZoneLogic.ZoneByUser) do
			if zone > 0 and self:IsAlive(userId) then out[#out + 1] = math.floor(zone + 0.5) end
		end
		table.sort(out)
		return out
	end

	@ExecSpace("ServerOnly")
	method number AliveCount()
		return #self:AliveZones()
	end

	-- 몹 처치: 처치 수 +1, 메소는 구역 주인에게(막타가 누구든)
	@ExecSpace("ServerOnly")
	method void OnMobKilled(number zone, number meso)
		local owner = self:OwnerOfZone(zone)
		if owner == "" then return end
		local inf = self.Info[owner]
		if inf ~= nil then inf.kills = inf.kills + 1 end
		if meso > 0 and self:IsAlive(owner) then _RtsUnitLogic:AddMeso(owner, meso) end
	end

	-- 스테이지를 끝까지 버틴 유저의 '마지막으로 버틴 순번' 갱신
	@ExecSpace("ServerOnly")
	method void OnStageSurvived(number n)
		for userId, inf in pairs(self.Info) do
			if self:IsAlive(userId) then inf.last = n end
		end
	end

	@ExecSpace("ServerOnly")
	method void Eliminate(string userId, string reason, number pct)
		if userId == "" or not self:IsAlive(userId) then return end
		if self.Info[userId] == nil then self:InitUser(userId) end
		self.StateByUser[userId] = 1
		local inf = self.Info[userId]
		inf.reason = reason
		inf.pct = pct
		local zone = _RtsZoneLogic:GetZoneOfUser(userId)
		_RtsWaveLogic:ClearZone(zone)
		_RtsBossLogic:ClearZone(zone)
		_RtsUnitLogic:WipeUnits(userId)
		_RtsAugmentLogic:ResetUser(userId)
		self:SpawnTomb(zone)
		_RtsBootstrapLogic:BroadcastPlayerList()
		_RtsConfigLogic:Log("RtsResult: eliminated " .. userId .. " (" .. reason .. ") at stage " .. string.format("%d", _RtsStageLogic.StageNo))
		self:Finish(userId, false)
		if self:AliveCount() == 0 then _RtsStageLogic:EndRun() end
	end

	@ExecSpace("ServerOnly")
	method void Clear(string userId)
		if userId == "" or not self:IsAlive(userId) then return end
		self.StateByUser[userId] = 2
		local inf = self.Info[userId]
		if inf == nil then return end
		inf.last = _RtsStageTableLogic:GetStageCount()
		inf.reason = ""
		inf.pct = 0
		_RtsBootstrapLogic:BroadcastPlayerList()
		_RtsConfigLogic:Log("RtsResult: CLEAR " .. userId)
		self:SaveClear(userId)
		self:Finish(userId, true)
		if self:AliveCount() == 0 then _RtsStageLogic:EndRun() end
	end

	-- 개인 최고 기록 갱신(UserDataStorage "BestRun" = "점수|순번|클리어 0/1") 후 결과 팝업
	@ExecSpace("ServerOnly")
	method void Finish(string userId, boolean cleared)
		local inf = self.Info[userId]
		if inf == nil then return end
		local stageNo = _RtsStageLogic.StageNo
		local score = inf.last * self.ScorePerStage + math.floor(inf.pct * 10000 + 0.5)
		local kills = inf.kills
		local last = inf.last
		local pct = inf.pct
		local reason = inf.reason
		local ds = _DataStorageService:GetUserDataStorage(userId)
		if ds == nil then
			self:ShowResult(cleared, reason, stageNo, last, kills, pct, last, cleared, userId)
			return
		end
		ds:GetAsync(self.BestKey, function(code, key, value)
			local oldScore = -1
			local bestNo = last
			local bestClear = cleared
			if code == 0 and value ~= nil and value ~= "" then
				local parts = {}
				for w in string.gmatch(value, "[^|]+") do parts[#parts + 1] = w end
				oldScore = tonumber(parts[1]) or -1
				if oldScore >= score then
					bestNo = tonumber(parts[2]) or last
					bestClear = parts[3] == "1"
				end
			end
			if score > oldScore then
				local clearFlag = "0"
				if cleared then clearFlag = "1" end
				ds:SetAsync(self.BestKey, string.format("%d|%d|%s", score, last, clearFlag), function(c2, k2) end)
			end
			self:ShowResult(cleared, reason, stageNo, last, kills, pct, bestNo, bestClear, userId)
		end)
	end

	-- 조합 문자열: 번호순 "직업:레벨:프리즘+…:증강+…"를 ;로
	@ExecSpace("ServerOnly")
	method string ComboText(string userId)
		local list = _RtsUnitLogic.UnitsByUser[userId]
		if list == nil then return "" end
		local nos = {}
		for no, e in pairs(list) do
			if e ~= nil and isvalid(e) and e.RtsUnitComponent ~= nil then nos[#nos + 1] = no end
		end
		table.sort(nos)
		local parts = {}
		for i = 1, #nos do
			local u = list[nos[i]].RtsUnitComponent
			local pr = string.gsub(u.Prisms or "", ",", "+")
			local au = string.gsub(u.Augs or "", ",", "+")
			parts[#parts + 1] = u.JobId .. ":" .. string.format("%d", math.floor(u.Level + 0.5)) .. ":" .. pr .. ":" .. au
		end
		return table.concat(parts, ";")
	end

	-- 순위 값(RankStorage 주석): 횟수 × RankScale + (RankScale − 1 − 2026-01-01부터 흐른 초)
	@ExecSpace("ServerOnly")
	method number RankValue(number count)
		local sec = math.floor((DateTime.UtcNow.Elapsed - DateTime(2026, 1, 1).Elapsed) / 1000)
		if sec < 0 then sec = 0 end
		if sec > self.RankScale - 1 then sec = self.RankScale - 1 end
		return count * self.RankScale + (self.RankScale - 1 - sec)
	end

	@ExecSpace("ServerOnly")
	method string NickOf(string userId)
		local ue = _UserService:GetUserEntityByUserId(userId)
		if ue ~= nil and ue.PlayerComponent ~= nil and ue.PlayerComponent.Nickname ~= "" then return ue.PlayerComponent.Nickname end
		return userId
	end

	-- 클리어 기록: 그 난이도 클리어 횟수 +1 → 이번 순위(나보다 값이 큰 다른 유저 수 + 1 — 정렬 조회 첫 페이지까지만 센다) → 결과 창(ShowClearRank).
	--   보통 이하·테스트 모드(DevTools — 타격마다 +DevExtraDamage)는 저장하지 않고 횟수 0으로 알린다
	@ExecSpace("ServerOnly")
	method void SaveClear(string userId)
		local diff = math.floor(_RtsDifficultyLogic:Of(userId) + 0.5)
		_RtsConfigLogic:Log("RtsResult: clear " .. userId .. " [" .. _RtsDifficultyLogic:NameOf(userId) .. "] " .. self:ComboText(userId))
		if _RtsUnitLogic.DevTools or diff < self.RankMinDiff then
			self:ShowClearRank(diff, 0, 0, false, userId)
			return
		end
		local rank = _DataStorageService:GetSortableDataStorage(self.RankStorage .. "_D" .. string.format("%d", diff))
		if rank == nil then
			self:ShowClearRank(diff, 0, 0, false, userId)
			return
		end
		local names = _DataStorageService:GetGlobalDataStorage(self.RankNickStorage)
		if names ~= nil then names:SetAsync(userId, self:NickOf(userId), function(c0, k0) end) end
		rank:GetAsync(userId, function(code, key, value)
			local count = 0
			if code == 0 and value ~= nil then count = math.floor(value / self.RankScale) end
			count = count + 1
			local v = self:RankValue(count)
			rank:SetAsync(userId, v, function(c2, k2)
				rank:GetSortedAsync(SortDirection.Descending, v + 1, self.RankMax, function(c3, pages)
					local above = 0
					local more = false
					if c3 == 0 and pages ~= nil then
						local datas = pages:GetCurrentPageDatas()
						for _, it in pairs(datas) do
							if it.KeyInfo.Key ~= userId then above = above + 1 end
						end
						more = not pages.IsLastPage
					end
					_RtsConfigLogic:Log("RtsResult: rank D" .. string.format("%d", diff) .. " " .. userId .. " clears " .. string.format("%d", count) .. " rank " .. string.format("%d", above + 1))
					self:ShowClearRank(diff, count, above + 1, more, userId)
				end)
			end)
		end)
	end

	-- 결과 창에 클리어 순위(그 유저에게만 — 마지막 인자 userId): 난이도 · 그 난이도 클리어 횟수(0 = 기록 안 함) · 순위(more = 첫 페이지보다 뒤)
	@ExecSpace("Client")
	method void ShowClearRank(number diff, number count, number rank, boolean more, string userId)
		_RtsPopupLogic:SetClearRank(diff, count, rank, more)
	end

	-- 순위 창(탭 = 어려움·매우어려움·극악): 그 난이도 상위 RankShowTop명(닉네임·클리어 횟수) + 내 횟수·순위 → 요청한 유저에게만(ShowRanking).
	--   같은 탭 조회는 3초에 한 번
	@ExecSpace("Server")
	method void RequestRanking(number diff)
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		local d = math.floor(diff + 0.5)
		if d < self.RankMinDiff or d > 6 then return end
		local askKey = userId .. "_" .. string.format("%d", d)
		local now = _UtilLogic.ElapsedSeconds
		if self.RankAskAt[askKey] ~= nil and now - self.RankAskAt[askKey] < 3 then return end
		self.RankAskAt[askKey] = now
		local rank = _DataStorageService:GetSortableDataStorage(self.RankStorage .. "_D" .. string.format("%d", d))
		if rank == nil then return end
		-- 상위 목록(값 큰 순)
		local list = {}
		local code, pages = rank:GetSortedAndWait(SortDirection.Descending, 1, self.RankMax)
		while code == 0 and pages ~= nil do
			for _, it in pairs(pages:GetCurrentPageDatas()) do
				list[#list + 1] = { key = it.KeyInfo.Key, v = it.Value }
			end
			if pages.IsLastPage or #list >= self.RankShowTop then break end
			if pages:LoadNextPageAndWait() ~= 0 then break end
			pages:MoveToNextPageAndWait()
		end
		table.sort(list, function(x, y) return x.v > y.v end)
		local keys = {}
		for i = 1, math.min(#list, self.RankShowTop) do keys[#keys + 1] = list[i].key end
		-- 닉네임
		local names = {}
		local ns = _DataStorageService:GetGlobalDataStorage(self.RankNickStorage)
		if ns ~= nil and #keys > 0 then
			local c2, items = ns:BatchGetAndWait(keys)
			while c2 == 0 and items ~= nil do
				for _, it in pairs(items:GetCurrentPageDatas()) do names[it.KeyInfo.Key] = it.Value end
				if items.IsLastPage then break end
				if items:LoadNextPageAndWait() ~= 0 then break end
				items:MoveToNextPageAndWait()
			end
		end
		-- 내 횟수·순위
		local myCount = 0
		local myRank = 0
		local myMore = false
		local c3, mine = rank:GetAndWait(userId)
		if c3 == 0 and mine ~= nil and mine > 0 then
			myCount = math.floor(mine / self.RankScale)
			local n = 0
			local c4, above = rank:GetSortedAndWait(SortDirection.Descending, mine + 1, self.RankMax)
			if c4 == 0 and above ~= nil then
				for _, it in pairs(above:GetCurrentPageDatas()) do
					if it.KeyInfo.Key ~= userId then n = n + 1 end
				end
				myMore = not above.IsLastPage
			end
			myRank = n + 1
		end
		-- 행 = "닉네임(탭)횟수" 줄바꿈 구분
		local rows = {}
		for i = 1, #keys do
			local nick = names[keys[i]] or "?"
			nick = string.gsub(nick, "[\t\n]", " ")
			rows[#rows + 1] = nick .. "\t" .. string.format("%d", math.floor(list[i].v / self.RankScale))
		end
		self:ShowRanking(d, table.concat(rows, "\n"), myCount, myRank, myMore, userId)
	end

	@ExecSpace("Client")
	method void ShowRanking(number diff, string rows, number myCount, number myRank, boolean myMore, string userId)
		_RtsPopupLogic:SetRanking(diff, rows, myCount, myRank, myMore)
	end

	-- 구역 가운데 비석 — 그 구역 주인이 고른 비석(주인이 없으면 기본)
	@ExecSpace("ServerOnly")
	method void SpawnTomb(number zone)
		if zone < 1 then return end
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		if mapRoot == nil then return end
		local at = _RtsZoneLogic:GetBossPoint(zone)
		local owner = self:OwnerOfZone(zone)
		local key = _RtsTombLogic.DefaultKey
		if owner ~= "" then key = _RtsProfileLogic:TombOf(owner) end
		local pr = _RtsTombLogic:GetPreset(key)
		local t = _RtsZoneLogic:SpawnProp("RtsTomb" .. string.format("%d", math.floor(zone + 0.5)), mapRoot, at, pr.ruid, 210)
		if t == nil then return end
		t.TransformComponent.Scale = Vector3(pr.scale, pr.scale, 1)
		self.Tombs[#self.Tombs + 1] = t
		self:PlayTombSound(zone)
	end

	-- 전 클라: 비석 소리 — 그 구역 주인이거나 그 구역을 보고 있는 사람만
	@ExecSpace("Client")
	method void PlayTombSound(number zone)
		local z = math.floor(zone + 0.5)
		if z ~= math.floor(_RtsUnitLogic:MyZone() + 0.5) and z ~= math.floor(_RtsHudLogic.WatchedZone + 0.5) then return end
		_SoundService:PlaySound(self.TombSound, 1)
	end

	-- 결과 팝업(그 유저에게만 — 마지막 인자 userId)
	@ExecSpace("Client")
	method void ShowResult(boolean cleared, string reason, number stageNo, number lastNo, number kills, number pct, number bestNo, boolean bestClear, string userId)
		_RtsPopupLogic:OpenResult(cleared, reason, stageNo, lastNo, kills, pct, bestNo, bestClear)
	end

	-- '나가기'(여럿일 때 결과 팝업·탈락 뒤 우측 버튼) = 대기방으로(2026-09-23 사용자). 게임이 인스턴스 방에서 돌면 정적 방(대기방)으로 옮기고,
	--   대기방이 없는 지금(멀티 업데이트 Phase 8 전)은 안내만. 솔로(방 인원 1)면 버튼이 '다시 하기'라 여기 오지 않는다.
	--   KickUser는 사유와 상관없이 '추방됐습니다' 창이 떠서 쓰지 않는다
	@ExecSpace("Server")
	method void RequestExit()
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		if _RoomService:IsInstanceRoom() then
			_RoomService:MoveUserToStaticRoom(userId)
			return
		end
		self:NotifyNoMatching(userId)
	end

	@ExecSpace("Client")
	method void NotifyNoMatching(string userId)
		_RtsHudLogic:ShowHintFor("대기방(매칭 · 방 목록)은 멀티 업데이트 때 열려요 — 지금은 관전하거나 오른쪽 아래 '다시하기'로 투표해요", 4)
	end

end
