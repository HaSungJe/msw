-- rts-base 화면 v2: 팝업 공통 셸 + 영입/증강/보스 3택1 껍데기 (아티팩트 v16) + 유닛 정보(v27, 내용은 RtsUnitPopupLogic)
--   셸: 딤(클릭=닫기) + 중앙 패널(금색 테두리·제목·닫기 X). ESC로 닫힘. 한 번에 하나.
--   내용은 보이는 것만 — 영입·증강 로직은 Phase 5·6. 3택1은 트리거가 없어 B 키 미리보기(Phase 6에서 제거).
--   UI 헬퍼는 RtsHudLogic 것을 쓴다. 좌표는 1920×1080 기준(목업 1cqw = 19.2px).
@Logic
script RtsPopupLogic extends Logic

	property boolean Built = false

	property Entity Group = nil

	property Entity Dim = nil

	property Entity Panel = nil

	property Entity PanelOuter = nil

	property Entity Title = nil

	property Entity CloseBtn = nil

	property Entity Body = nil

	property string Kind = ""
	property table HubBar = nil
	property Entity HubPage = nil
	property table DrawRefs = nil

	property number PanelW = 1114

	property number RecruitPanelW = 1014

	-- 증강 탭 상태
	property table AugTabs = {}

	-- 방출 확인 팝업이 가리키는 내 유닛 번호 (OpenDismiss)
	property number DismissNo = 0

	-- 결과 팝업 내용(OpenResult): { cleared, reason, stageNo, lastNo, kills, pct, bestNo, bestClear }
	property table Result = {}

	-- 같은 창 다시 그리기(탭·체크 등) 때 옛 body — 새 body가 그려질 때까지 남겼다가 지운다(2026-09-24 사용자 "적용된 증강 숨기기 클릭 시 화면 번쩍임")
	property Entity OldBody = nil

	property boolean KeepOldBody = false

	-- 클리어 순위(RtsRunResultLogic.ShowClearRank → SetClearRank): { diff, count, rank, more, at } — count 0 = 기록 안 함(보통 이하·테스트 모드)
	property any ClearRank = nil

	-- 순위 창 탭(난이도 4 어려움 · 5 매우어려움 · 6 극악)과 받아 둔 목록(난이도 → { rows, myCount, myRank, myMore, at })
	property number RankDiff = 4

	property table RankCache = {}

	-- 테마·아이콘 창 탭(2026-09-25 사용자 "테마·아이콘도 종류를 탭으로 — 지금은 기본 탭만")
	property string ThemeTab = "기본"

	-- 영입 상세 스킬 탭(2026-09-25 사용자 "액티브/패시브/프리즘 증강 탭으로") — "active" | "passive" | "prism" · 스킬 영역 엔티티(탭 바꿀 때 이것만 다시)
	property string RiSkillTab = "active"

	property Entity RiSkillBox = nil

	-- 부분 다시 그리기용 참조(2026-09-25 — 탭·선택이 바뀌면 이 칸만 다시): 탭 막대(SpawnTabBar 표) · 바뀌는 칸 컨테이너
	property table RiBar = nil

	property table AugBar = nil

	property Entity AugBody = nil

	property Entity AugContent = nil

	property Entity AugDetail = nil

	property table AugRowRefs = {}

	property table CodexBar = nil

	property Entity CodexBody = nil

	property Entity CodexInfo = nil

	property Entity CodexList = nil

	property table RecruitBar = nil

	property Entity RecruitBody = nil

	property Entity RecruitContent = nil

	property table ProfileBar = nil

	property Entity ProfileBody = nil

	property Entity ProfileContent = nil

	property number ProfileW = 900

	property table PresetCards = {}

	property table IconCells = {}

	property Entity IconHead = nil

	-- 영입 상세(2026-09-25 사용자 "영입창에서 유닛 선택하면 팝업 — 외형 + 설명 + 오각형 + 50레벨 능력치 + 영입/취소"): 고른 직업 · 오각형 그림 2장(tools/gen-radar-assets.py)
	property string PendingJob = ""

	property string RadarWebRUID = "de902441f2e74e89a7fefa81ef29da0e"

	property string RightTriRUID = "c62bf5fb88994fe48ca88e725fa458aa"

	-- 프로필 창 위 탭(2026-09-25 사용자 "탭을 테마/비석 두 개로" → 가운데 아이콘 추가) — "theme" | "icon" | "tomb", 마지막 탭 기억
	property string ProfileTab = "theme"

	property string TombTab = "기본"

	property string IconTab = "기본"

	-- [아이콘] 탭 칸을 한 번에 만드는 수(247칸을 한 프레임에 만들면 탭이 늦게 뜬다 — 탭은 바로 보이고 위에서부터 나눠 채운다)
	property number IconBatch = 40

	-- 영입 팝업 탭: "adv" 모험가 / "hero" 영웅(팬텀)
	property string RecruitTab = "adv"

	-- 증강 창 상태: 등급 탭(all/bronze/silver/gold/prism) · 선택한 보유 증강 번호(MyOwned 순번) · 지정하려고 고른 유닛 번호

	-- 증강 도감 탭(2026-09-24 사용자 "좌측 아래 증강 도감 — 등급별 목록")
	property string CodexGrade = "bronze"

	-- 같은 창을 다시 그리느라 닫았다 여는 중(닫기 소리 생략)
	property boolean Reopening = false

	property number AugSel = 0

	property number AugPickNo = 0

	-- 이미 적용된(유닛에 지정된·해금된) 증강 숨기기(2026-09-24 사용자 "증강 팝업 우측 하단에 체크박스, 기본 체크")
	property boolean AugHideAssigned = true

	-- 3택1 등장음은 유지하고 카드의 지속 반짝임은 사용하지 않는다.
	property string PickSound = "dbb38b4f04044499906bd7a2ca9c4d7c"



	-- ===== 셸 =====

	@ExecSpace("ClientOnly")
	method void Build(Entity ui)
		if self.Built then return end
		local H = _RtsHudLogic
		local grp = _SpawnService:SpawnByModelId("model://uigroup", "RtsPopupGroup", Vector3.zero, ui)
		if grp == nil then
			_RtsConfigLogic:Log("RtsPopup: group spawn failed")
			return
		end
		if grp.UIGroupComponent ~= nil then grp.UIGroupComponent.DefaultShow = true end
		-- 화면 전체로(RtsHudLogic.StretchFull — 안 하면 실제 클라이언트에서 가운데 작은 사각형이 된다)
		H:StretchFull(grp)
		self.Group = grp

		local dim = H:SpawnStretch("model://uibutton", "RtsPopupDim", grp, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		H:Tint(dim, 0.039, 0.047, 0.063, 0.45)
		dim:ConnectEvent(ButtonClickEvent, function(event)
			if self.Kind ~= "pick" then self:Close() end
		end)
		self.Dim = dim

		local panel = H:SpawnPanel("RtsPopupPanel", grp, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(self.PanelW, 500),
			Color(0.11, 0.094, 0.075, 0.96), Color(0.788, 0.635, 0.29, 1), 2.3)
		self.Panel = panel
		self.PanelOuter = panel.Parent

		self.Title = H:SpawnLabel("RtsPopupTitle", panel, Vector2(0, 1), Vector2(0, 1), Vector2(27, -20), Vector2(600, 36),
			"", H:ColInk(), 27, TextAlignmentType.MiddleLeft, true)
		local x = H:SpawnPanel("RtsPopupClose", panel, Vector2(1, 1), Vector2(1, 1), Vector2(-27, -20), Vector2(38, 38),
			self:Base(), self:Mix(H:ColGold(), 0.5), 1.5)
		H:SpawnLabel("RtsPopupCloseX", x, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(36, 36),
			"×", self:Ink(), 26, TextAlignmentType.MiddleCenter, true)
		local xc = H:SpawnClick("RtsPopupCloseClick", x)
		xc:ConnectEvent(ButtonClickEvent, function(event)
			self:Close()
		end)
		self.CloseBtn = x.Parent

		grp:SetEnable(false)
		self.Built = true
	end

	method boolean IsOpen()
		return self.Kind ~= ""
	end

	@ExecSpace("ClientOnly")
	method void Open(string kind)
		if not self.Built then return end
		if self.Kind == "profile" then
			if kind == "themeconfirm" or kind == "tombconfirm" or kind == "iconinfo" or kind == "iconconfirm" then
				self:OpenProfileDialog(kind)
				return
			end
			if kind == "profile" and isvalid(self._T.ProfileDialog) then
				self:CloseProfileDialog()
				return
			end
		end
		self:CloseProfileDialog()
		if self:IsHubKind(self.Kind) and self:IsHubKind(kind) then
			self:SwitchHub(kind)
			return
		end
		local wasOpen = self.Kind ~= ""
		if wasOpen then
			-- 다시 그리기: 팝업 그룹은 끄지 않고(어두운 배경이 한 프레임 사라져 번쩍였다), 같은 창이면 옛 body를 새 body 밑에 잠깐 남긴다
			self.Reopening = true
			self.KeepOldBody = self.Kind == kind
			self:Close()
			self.Reopening = false
			self.KeepOldBody = false
		end
		-- 창 여는 소리(2026-09-24 사용자) — 탭 바꾸기 등 다시 그리기는 빼고, 보스 3택1은 자기 소리(PickSound)가 있어 뺀다
		if not wasOpen and kind ~= "pick" then _RtsHudLogic:PlayUi(_RtsHudLogic.OpenSound) end
		-- 팝업이 열리면 영입 배치 모드는 취소(= 영입 취소)
		_RtsUnitSelectLogic:EndPlace()
		if kind ~= "recruit" and kind ~= "recruitinfo" and kind ~= "augment" and kind ~= "pick" and kind ~= "unit" and kind ~= "devprism" and kind ~= "dismiss" and kind ~= "result" and kind ~= "codex" and kind ~= "draw" and kind ~= "rank" and kind ~= "restart"
			and kind ~= "profile" and kind ~= "themeconfirm" and kind ~= "tombconfirm" and kind ~= "iconinfo" and kind ~= "iconconfirm" and kind ~= "iconget" then
			_RtsConfigLogic:Log("RtsPopup: unknown kind " .. kind)
			return
		end
		self.Kind = kind
		local H = _RtsHudLogic
		local width = self.PanelW
		local height = 500
		local title = ""
		if kind == "recruit" then
			width = self.RecruitPanelW
			height = 660
			title = "캐릭터 영입"
		elseif kind == "augment" then
			height = 880
			title = "증강"
		elseif kind == "devprism" then
			height = 760
			title = "테스트 프리즘 증강 (개발용)"
		elseif kind == "unit" then
			width = _RtsUnitPopupLogic.PanelW
			height = _RtsUnitPopupLogic.PanelH
			title = "유닛"
		elseif kind == "dismiss" then
			width = 640
			height = 290
			title = "방출"
		elseif kind == "codex" then
			width = 1000
			height = 840
			title = "증강 도감"
		elseif kind == "rank" then
			width = 720
			height = 820
			title = "순위"
		elseif kind == "restart" then
			width = 640
			height = 280
			title = "다시하기"
		elseif kind == "recruitinfo" then
			-- 2026-09-25 사용자 "가로 넓이 줄이고 캐릭터 모습 창 줄이고 설명 제거 — 스킬만" → "가로가 너무 넓어, 불필요하게 넓음" 760 → 600
			width = 600
			height = 640
			title = _RtsJobTableLogic:GetJobName(self.PendingJob)
		elseif kind == "profile" then
			-- 높이 730 = 머리 70 + 탭·안내 86 + 카드 2줄 554 + 아래 20(카드 270 × 2 + 간격 10 — 한 화면에 2줄)
			width = 900
			height = 730
			title = "프로필 설정"
		elseif kind == "themeconfirm" then
			width = 640
			height = 300
			title = "맵 테마"
		elseif kind == "tombconfirm" then
			width = 640
			height = 300
			title = "비석"
		elseif kind == "iconinfo" then
			width = 640
			height = 370
			title = "아이콘"
		elseif kind == "iconconfirm" then
			width = 640
			height = 280
			title = "아이콘"
		elseif kind == "iconget" then
			width = 640
			height = 430
			title = "새 아이콘 획득!"
		elseif kind == "result" then
			width = 640
			height = 360
			title = "결과"
		else
			height = 660
			title = "보스 처치 — 증강 선택"
		end
		if self:IsHubKind(kind) then width = self.PanelW; height = 950; title = "증강" end
		self.PanelOuter.UITransformComponent.RectSize = Vector2(width, height)
		H:RoundPanel(self.Panel)
		self.Panel.SpriteGUIRendererComponent.Color = self:Base()
		-- 프로필과 연결된 설정/확인 화면은 맵이 비치지 않는 불투명 바탕이다.
		if kind == "profile" or kind == "themeconfirm" or kind == "tombconfirm" or kind == "iconinfo" or kind == "iconconfirm" or kind == "iconget" then
			self.Panel.SpriteGUIRendererComponent.Color = Color(0.98, 0.985, 1, 1)
		end
		self.PanelOuter.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0.9)
		self.Title.TextComponent.FontColor = self:Ink()
		self.Title.TextComponent.IsRichText = false
		self.Title.TextComponent.Text = title
		-- 제목 자리: 직업 상세만 가운데(2026-09-25 사용자 "직업명은 가운데로"), 나머지는 왼쪽
		local tt = self.Title.UITransformComponent
		if kind == "recruitinfo" or kind == "unit" then
			tt.AnchorsMin = Vector2(0.5, 1)
			tt.AnchorsMax = Vector2(0.5, 1)
			tt.Pivot = Vector2(0.5, 1)
			tt.anchoredPosition = Vector2(0, -20)
			self.Title.TextComponent.Alignment = TextAlignmentType.MiddleCenter
		else
			tt.AnchorsMin = Vector2(0, 1)
			tt.AnchorsMax = Vector2(0, 1)
			tt.Pivot = Vector2(0, 1)
			tt.anchoredPosition = Vector2(27, -20)
			self.Title.TextComponent.Alignment = TextAlignmentType.MiddleLeft
		end
		self.CloseBtn:SetEnable(true)

		-- body는 열 때마다 새로 만든다 (닫을 때 통째로 제거)
		local body = H:SpawnStretch("model://uisprite", "RtsPopupBody", self.Panel, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, -70))
		H:Tint(body, 0, 0, 0, 0)
		body.SpriteGUIRendererComponent.ImageRUID = DataRef(H.RoundedPanelRUID)
		body.SpriteGUIRendererComponent.Type = ImageType.Sliced
		body.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		H:SpawnWater(body)
		self.Body = body

		if self:IsHubKind(kind) then
			self:BuildHub(body, kind)
		elseif kind == "recruit" then
			self:BuildRecruit(body)
		elseif kind == "augment" then
			self:BuildAugment(body)
		elseif kind == "devprism" then
			self:BuildDevPrism(body)
		elseif kind == "unit" then
			_RtsUnitPopupLogic:BuildBody(body)
		elseif kind == "dismiss" then
			self:BuildDismiss(body)
		elseif kind == "result" then
			self:BuildResult(body)
		elseif kind == "codex" then
			self:BuildCodex(body, width)
		elseif kind == "rank" then
			self:BuildRank(body, width)
		elseif kind == "restart" then
			self:BuildRestart(body)
		elseif kind == "recruitinfo" then
			self:BuildRecruitInfo(body, width)
		elseif kind == "profile" then
			self:BuildProfile(body, width)
		elseif kind == "themeconfirm" then
			self:BuildThemeConfirm(body)
		elseif kind == "tombconfirm" then
			self:BuildTombConfirm(body)
		elseif kind == "iconinfo" then
			self:BuildIconInfo(body, width)
		elseif kind == "iconconfirm" then
			self:BuildIconConfirm(body)
		elseif kind == "iconget" then
			self:BuildIconGot(body, width)
		else
			self:BuildPick(body)
		end
		self.Group:SetEnable(true)
		-- 옛 body(같은 창 다시 그리기)는 새 body가 여러 프레임에 걸쳐 그려진 뒤 지운다 — 새 body가 위에 그려진다
		if self.OldBody ~= nil then
			local old = self.OldBody
			self.OldBody = nil
			_TimerService:SetTimerOnce(function()
				if old ~= nil and isvalid(old) then old:Destroy() end
			end, 0.12)
		end
	end

	-- 유닛 메뉴 '방출' → 이 팝업. 확인해야만 RtsUnitLogic.RequestDismiss (2026-09-22 사용자: 메뉴는 닫히고 새 팝업에서 묻는다)
	@ExecSpace("ClientOnly")
	method void OpenDismiss(number no)
		if _RtsUnitLogic:GetMyUnit(no) == nil then return end
		self.DismissNo = no
		self:Open("dismiss")
	end

	-- 판 결과(RtsRunResultLogic.ShowResult — 탈락·클리어한 그 유저에게만)
	@ExecSpace("ClientOnly")
	method void OpenResult(boolean cleared, string reason, number stageNo, number lastNo, number kills, number pct, number bestNo, boolean bestClear)
		self.Result = { cleared = cleared, reason = reason, stageNo = stageNo, lastNo = lastNo, kills = kills, pct = pct, bestNo = bestNo, bestClear = bestClear }
		-- 클리어 순위(SetClearRank)는 이 결과와 거의 같이 오므로 10초 안에 온 것만 쓴다(지난 판 값이 남지 않게)
		if not cleared or (self.ClearRank ~= nil and _UtilLogic.ElapsedSeconds - self.ClearRank.at > 10) then self.ClearRank = nil end
		self:Open("result")
	end

	-- 클리어 순위 도착(RtsRunResultLogic.ShowClearRank): 결과 창이 열려 있으면 다시 그린다. 그 난이도 순위 창 목록은 새로 받게 비운다
	@ExecSpace("ClientOnly")
	method void SetClearRank(number diff, number count, number rank, boolean more)
		local d = math.floor(diff + 0.5)
		self.ClearRank = { diff = d, count = count, rank = rank, more = more, at = _UtilLogic.ElapsedSeconds }
		self.RankCache[d] = nil
		-- (결과 창에 순위 줄을 그리지 않으니 다시 그리지 않는다 — 2026-09-25 사용자 "인게임 순위표 제거". 값은 대기방 순위표 때 다시 쓴다)
	end

	-- 순위 목록 도착(RtsRunResultLogic.ShowRanking): 순위 창이 그 탭이면 다시 그린다
	@ExecSpace("ClientOnly")
	method void SetRanking(number diff, string rows, number myCount, number myRank, boolean myMore)
		local d = math.floor(diff + 0.5)
		self.RankCache[d] = { rows = rows, myCount = myCount, myRank = myRank, myMore = myMore, at = _UtilLogic.ElapsedSeconds }
		if self.Kind == "rank" and self.RankDiff == d then self:Open("rank") end
	end

	@ExecSpace("ClientOnly")
	method void Close()
		if self.Kind == "" then return end
		if isvalid(self._T.ProfileDialog) and not self.Reopening then
			self:CloseProfileDialog()
			return
		end
		if not self.Reopening and self.Kind ~= "pick" then _RtsHudLogic:PlayUi(_RtsHudLogic.CloseSound) end
		if self.Kind == "pick" then _RtsAugmentLogic.PickFolded = true end
		self.HubBar = nil
		self.HubPage = nil
		self.DrawRefs = nil
		if self.Kind == "unit" then _RtsUnitPopupLogic:OnClosed() end
		self.Kind = ""
		self.AugTabs = {}
		self.DismissNo = 0
		if self.Body ~= nil then
			if self.KeepOldBody then
				if self.OldBody ~= nil and isvalid(self.OldBody) then self.OldBody:Destroy() end
				self.OldBody = self.Body
			else
				self.Body:Destroy()
			end
			self.Body = nil
		end
		if self.Group ~= nil and not self.Reopening then self.Group:SetEnable(false) end
		-- 기다리던 아이콘 획득 팝업(보스 3택1 등이 떠 있어 미뤘던 것)을 이어서(RtsProfileLogic.FlushGot)
		if not self.Reopening then
			_TimerService:SetTimerOnce(function() _RtsProfileLogic:FlushGot() end, 0.15)
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyDownEvent(KeyDownEvent event)
		if not self.Built then return end
		if event.key == KeyboardKey.Escape then
			if self.Kind ~= "" and self.Kind ~= "pick" then self:Close() end
		end
	end

	method boolean IsHubKind(string kind)
		-- 기존 보유·선택·도감 진입점은 증강 창 한 곳을 공유한다.
		return kind == "augment" or kind == "draw" or kind == "pick" or kind == "codex"
	end

	@ExecSpace("ClientOnly")
	method void OpenHubTab(string key)
		-- 대기 선택지가 있으면 뽑기 탭에서 이어서 고른다.
		local kind = key
		if key == "draw" and #_RtsAugmentLogic:MyOffer().ids > 0 then
			kind = "pick"
			_RtsAugmentLogic.PickFolded = false
			_RtsAugmentLogic.ShownOffer = _RtsAugmentLogic.OfferByUser[_RtsUnitLogic:MyUserId()] or ""
		elseif key ~= "pick" then
			_RtsAugmentLogic.PickFolded = true
		end
		self:Open(kind)
	end

	@ExecSpace("ClientOnly")
	method void BuildHub(Entity body, string kind)
		-- 창·메뉴 탭은 고정하고 그 아래 내용만 교체한다.
		self.HubBar = self:SpawnTabBar(body, "RtsHubTab", { {"augment", "보유 증강", 240}, {"draw", "증강 뽑기", 240}, {"codex", "증강 도감", 240} }, "", 27, -12, 240, 48, 12, 21, function(key)
			self:OpenHubTab(key)
		end)
		self.HubPage = nil
		self:SwitchHub(kind)
	end

	@ExecSpace("ClientOnly")
	method void SwitchHub(string kind)
		-- 탭 전환은 팝업을 닫지 않는다. 현재 페이지 참조만 새로 연결한다.
		local H = _RtsHudLogic
		local old = self.HubPage
		if self.Kind == "pick" and kind ~= "pick" then _RtsAugmentLogic.PickFolded = true end
		self.Kind = kind
		self.DrawRefs = nil
		local key = kind
		if key == "pick" then key = "draw" end
		self:BarSelect(self.HubBar, key)
		local page = H:SpawnStretch("model://uisprite", "RtsHubPage", self.Body, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, -70))
		page.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		self.HubPage = page
		if kind == "augment" then self:BuildAugment(page)
		elseif kind == "codex" then self:BuildCodex(page, self.PanelW)
		elseif kind == "pick" then self:BuildPick(page)
		else self:BuildDraw(page) end
		self:SwapContent(old, self.HubPage)
	end

	@ExecSpace("ClientOnly")
	method void BuildDraw(Entity body)
		-- 실제 가격과 확률은 서버와 같은 계산 함수를 사용한다.
		local H = _RtsHudLogic
		local A = _RtsAugmentLogic
		local panel = H:SpawnRoundedPanel("RtsDrawIntro", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -12), Vector2(self.PanelW - 54, 250), self:Card(), self:Edge(), 2)
		H:SpawnLabel("RtsDrawTitle", panel, Vector2(0, 1), Vector2(0, 1), Vector2(28, -26), Vector2(960, 44), "새로운 증강으로 더 강하게", self:Ink(), 30, TextAlignmentType.MiddleLeft, true)
		H:SpawnLabel("RtsDrawDesc", panel, Vector2(0, 1), Vector2(0, 1), Vector2(28, -82), Vector2(960, 64), "메소로 증강 선택지 세 장을 뽑고, 마음에 드는 한 장을 골라 주세요.\n받은 증강은 보유 증강 탭에서 캐릭터에게 지정할 수 있어요.", self:Muted(), 20, TextAlignmentType.MiddleLeft, false)
		local wallet = H:SpawnLabel("RtsDrawWallet", panel, Vector2(0, 0), Vector2(0, 0), Vector2(28, 28), Vector2(940, 34), "", self:AccentInk(), 21, TextAlignmentType.MiddleLeft, true)
		self.DrawRefs = { wallet = wallet, rates = {}, key = "" }
		local grades = {"bronze", "silver", "gold", "prism"}
		for i = 1, #grades do
			local g = grades[i]
			local card = H:SpawnRoundedPanel("RtsDrawGrade" .. tostring(i), body, Vector2(0, 1), Vector2(0, 1), Vector2(27 + (i - 1) * 268, -286), Vector2(254, 174), self:Mix(self:GradeColor(g), 0.12), self:GradeColor(g), 2)
			self:SpawnBadge("RtsDrawBadge", card, Vector2(18, -18), g)
			self.DrawRefs.rates[i] = H:SpawnLabel("RtsDrawRate", card, Vector2(0, 1), Vector2(0, 1), Vector2(18, -60), Vector2(218, 52), "", self:Ink(), 32, TextAlignmentType.MiddleLeft, true)
			H:SpawnLabel("RtsDrawRateHint", card, Vector2(0, 0), Vector2(0, 0), Vector2(18, 18), Vector2(218, 28), "다음 뽑기 확률", self:Muted(), 16, TextAlignmentType.MiddleLeft, false)
		end
		self.DrawRefs.info = H:SpawnLabel("RtsDrawInfo", body, Vector2(0, 1), Vector2(0, 1), Vector2(30, -486), Vector2(self.PanelW - 60, 92), "", self:Muted(), 18, TextAlignmentType.UpperLeft, false)
		local buy = H:SpawnRoundedPanel("RtsDrawBuy", body, Vector2(0.5, 0), Vector2(0.5, 0), Vector2(0, 74), Vector2(470, 76), H:ColGold(), self:Edge(), 2)
		self.DrawRefs.buy = buy
		self.DrawRefs.label = H:SpawnLabel("RtsDrawBuyText", buy, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(444, 68), "", self:Ink(), 23, TextAlignmentType.MiddleCenter, true)
		local click = H:SpawnClick("RtsDrawBuyClick", buy)
		click:ConnectEvent(ButtonClickEvent, function(event) A:BuyFromHud() end)
		self.DrawRefs.reason = H:SpawnLabel("RtsDrawReason", body, Vector2(0.5, 0), Vector2(0.5, 0), Vector2(0, 28), Vector2(1000, 32), "", self:Muted(), 17, TextAlignmentType.MiddleCenter, false)
		A:ClientTick()
	end

	@ExecSpace("ClientOnly")
	method void RefreshDraw(number price, boolean can)
		-- 값 변화에만 반응하고 설명·카드·탭은 재생성하지 않는다.
		if self.Kind ~= "draw" or self.DrawRefs == nil then return end
		local H = _RtsHudLogic
		local A = _RtsAugmentLogic
		local me = _RtsUnitLogic:MyUserId()
		local money = _RtsUnitLogic:GetMyMeso()
		local pending = A.PendingByUser[me] or 0
		local left = A:BuyPrismLeft(me)
		local rate = A:BuyPrismRate(me)
		local paused = _RtsStageLogic.Paused
		local key = tostring(price) .. ":" .. tostring(can) .. ":" .. tostring(money) .. ":" .. tostring(pending) .. ":" .. tostring(left) .. ":" .. tostring(rate) .. ":" .. tostring(paused)
		local r = self.DrawRefs
		if r.key == key then return end
		r.key = key
		r.wallet.TextComponent.Text = "보유 메소  " .. H:FormatNumber(money)
		local rates = {(100 - rate) * 75.5 / 95, (100 - rate) * 15 / 95, (100 - rate) * 4.5 / 95, rate}
		for i = 1, 4 do r.rates[i].TextComponent.Text = string.format("%.1f%%", rates[i]) end
		r.info.TextComponent.Text = "뽑기로 획득 가능한 프리즘  " .. H:Int(left) .. " / " .. H:Int(A.BuyPrismMax) .. "\n프리즘을 얻지 못하면 다음 뽑기의 프리즘 확률이 " .. H:Int(A.BuyPrismPityStep) .. "%p 올라요.\n선택 대기  " .. H:Int(pending) .. " / " .. H:Int(A.MaxPending)
		r.label.TextComponent.Text = "증강 뽑기  ·  " .. H:FormatNumber(price) .. " 메소"
		local reason = "세 장 중 한 장을 선택합니다"
		if paused then reason = "일시정지를 해제한 뒤 뽑을 수 있어요"
		elseif not _RtsRunResultLogic:IsMeAlive() then reason = "이번 판에서는 더 뽑을 수 없어요"
		elseif pending >= A.MaxPending then reason = "대기 중인 선택지를 먼저 골라 주세요"
		elseif money < price then reason = "메소가 " .. H:FormatNumber(price - money) .. " 더 필요해요"
		elseif not can then reason = "게임 진행 중에 뽑을 수 있어요" end
		r.reason.TextComponent.Text = reason
		if can and not paused then r.buy.SpriteGUIRendererComponent.Color = H:ColGold() else r.buy.SpriteGUIRendererComponent.Color = self:Mix(self:Edge(), 0.5) end
	end


	-- ===== 공용 조각 =====

	-- 작은 탭/버튼 (테두리 + 배경 + 글자). on이면 금색
	@ExecSpace("ClientOnly")
	method Entity SpawnTab(string name, Entity parent, Vector2 pos, Vector2 size, string text, boolean on, number fontSize)
		local H = _RtsHudLogic
		local bg = self:Card()
		local border = self:Mix(Color(0.48, 0.36, 0.25, 1), 0.35)
		local ink = self:Ink()
		if on then
			bg = self:Mix(H:ColGold(), 0.18)
			border = H:ColGold()
			ink = self:Ink()
		end
		local t = H:SpawnRoundedPanel(name, parent, Vector2(0, 1), Vector2(0, 1), pos, size, bg, border, 1.5)
		H:SpawnLabel(name .. "Text", t, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(size.x - 6, size.y - 4),
			text, ink, fontSize, TextAlignmentType.MiddleCenter, true)
		return t
	end

	-- 탭 켜짐/꺼짐 모양만 제자리에서(SpawnTab과 같은 색) — 창을 다시 그리지 않고 탭만 바꿀 때
	@ExecSpace("ClientOnly")
	method void SetTabOn(Entity t, boolean on)
		if t == nil or not isvalid(t) then return end
		local H = _RtsHudLogic
		local bg = self:Card()
		local border = self:Mix(Color(0.48, 0.36, 0.25, 1), 0.35)
		local ink = self:Ink()
		if on then
			bg = self:Mix(H:ColGold(), 0.18)
			border = H:ColGold()
			ink = self:Ink()
		end
		t.SpriteGUIRendererComponent.Color = bg
		local outer = t.Parent
		if outer ~= nil and outer.SpriteGUIRendererComponent ~= nil then outer.SpriteGUIRendererComponent.Color = border end
		if outer ~= nil then
			local lb = t:GetChildByName(outer.Name .. "Text")
			if lb ~= nil and lb.TextComponent ~= nil then lb.TextComponent.FontColor = ink end
		end
	end

	-- 탭 글자만 제자리에서(개수가 바뀐 증강 탭 등)
	@ExecSpace("ClientOnly")
	method void SetTabText(Entity t, string text)
		if t == nil or not isvalid(t) or t.Parent == nil then return end
		local lb = t:GetChildByName(t.Parent.Name .. "Text")
		if lb ~= nil and lb.TextComponent ~= nil and lb.TextComponent.Text ~= text then lb.TextComponent.Text = text end
	end

	-- 탭 막대: items = { { key, 글자, 폭(없으면 w) } … }, 가로로 gap 간격. 누르면 제자리에서 켜짐만 바꾸고 onPick(key) — 창은 그대로.
	--   돌려주는 표 { cur, tabs = { key → 탭 }, keys } 로 Tab 키 순환(BarSelect)·글자 갱신(SetTabText)
	@ExecSpace("ClientOnly")
	method table SpawnTabBar(Entity parent, string prefix, table items, string cur, number x0, number y, number w, number h, number gap, number fontSize, any onPick)
		local H = _RtsHudLogic
		local bar = { cur = cur, tabs = {}, keys = {} }
		local x = x0
		for i = 1, #items do
			local key = items[i][1]
			local tw = items[i][3] or w
			local t = self:SpawnTab(prefix .. H:Int(i), parent, Vector2(x, y), Vector2(tw, h), items[i][2], key == cur, fontSize)
			bar.tabs[key] = t
			bar.keys[i] = key
			local click = H:SpawnClick(prefix .. "Click", t)
			click:ConnectEvent(ButtonClickEvent, function(event)
				if bar.cur == key then return end
				self:BarSelect(bar, key)
				onPick(key)
			end)
			x = x + tw + gap
		end
		bar.right = x
		return bar
	end

	@ExecSpace("ClientOnly")
	method void BarSelect(table bar, string key)
		if bar == nil then return end
		bar.cur = key
		for k, t in pairs(bar.tabs) do self:SetTabOn(t, k == key) end
	end

	-- 막대의 다음 키(Tab 키 순환)
	method string BarNext(table bar)
		if bar == nil or #bar.keys == 0 then return "" end
		for i = 1, #bar.keys do
			if bar.keys[i] == bar.cur then return bar.keys[i % #bar.keys + 1] end
		end
		return bar.keys[1]
	end

	-- 바뀌는 칸 교체: 새 칸을 만든 뒤 옛 칸은 0.12초 뒤 지운다(엔진이 UI를 여러 프레임에 나눠 만들어 바로 지우면 빈 칸이 번쩍 — 유닛 상세와 같은 방식)
	@ExecSpace("ClientOnly")
	method void DropLater(Entity old)
		if old == nil or not isvalid(old) then return end
		_TimerService:SetTimerOnce(function()
			if old ~= nil and isvalid(old) then old:Destroy() end
		end, 0.12)
	end

	-- 투명한 전체 칸(바뀌는 내용을 담는 컨테이너 — 부모와 같은 좌표계)
	@ExecSpace("ClientOnly")
	method Entity SpawnBox(Entity parent, string name)
		local box = _RtsHudLogic:SpawnStretch("model://uisprite", name, parent, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		box.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		box.SpriteGUIRendererComponent.RaycastTarget = false
		return box
	end

	-- 패널 배경색 위에 반투명 색을 미리 합성한 불투명 색 (테두리 백킹이 비쳐 보이지 않게)
	method Color Base()
		return Color(0.98, 0.985, 1, 0.90)
	end


	method Color Ink()
		return Color(0.20, 0.22, 0.30, 1)
	end

	method Color Muted()
		return Color(0.42, 0.44, 0.52, 1)
	end

	method Color AccentInk()
		return Color(0.43, 0.42, 0.62, 1)
	end

	method Color Card()
		return Color(1, 1, 1, 0.56)
	end

	method Color Edge()
		return Color(0.80, 0.82, 0.89, 0.8)
	end

	method Color Mix(Color top, number a)
		local b = self:Base()
		return Color(b.r + (top.r - b.r) * a, b.g + (top.g - b.g) * a, b.b + (top.b - b.b) * a, 0.72)
	end

	method Color GradeColor(string g)
		if g == "bronze" then return Color(0.722, 0.451, 0.2, 1) end
		if g == "silver" then return Color(0.725, 0.761, 0.8, 1) end
		if g == "gold" then return Color(0.878, 0.725, 0.353, 1) end
		if g == "prism" then return Color(0.769, 0.549, 0.941, 1) end
		return Color(0.541, 0.498, 0.439, 1)
	end

	method string GradeName(string g)
		if g == "bronze" then return "브론즈" end
		if g == "silver" then return "실버" end
		if g == "gold" then return "골드" end
		if g == "prism" then return "프리즘" end
		return "전체"
	end

	-- 등급 배지
	@ExecSpace("ClientOnly")
	method Entity SpawnBadge(string name, Entity parent, Vector2 pos, string g)
		local H = _RtsHudLogic
		local c = self:GradeColor(g)
		local b = H:SpawnUI("model://uisprite", name, parent, Vector2(0, 1), Vector2(0, 1), pos, Vector2(64, 22))
		b.SpriteGUIRendererComponent.Color = Color(c.r, c.g, c.b, 0.3)
		local ink = self:Ink()
		H:SpawnLabel(name .. "Text", b, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(62, 20),
			self:GradeName(g), ink, 13, TextAlignmentType.MiddleCenter, true)
		return b
	end

	-- ===== 영입: 소속 탭 + 모든 소속 공통 계열 5열 + 보유 0/6 =====

	@ExecSpace("ClientOnly")
	method void BuildRecruit(Entity body)
		-- 직업군 탭: 모험가 / 영웅(2026-09-23 사용자 "팬텀은 영웅 탭에, 개발 아님") — 탭은 제자리, 카드·안내만 다시(RefreshRecruit)
		self.RecruitBody = body
		self.RecruitBar = self:SpawnTabBar(body, "RtsRcCat", _RtsJobTableLogic:GetRecruitFactions(), self.RecruitTab, 27, -10, 100, 36, 10, 17, function(key)
			self.RecruitTab = key
			self:RefreshRecruit()
		end)
		self.RecruitContent = nil
		self:RefreshRecruit()
	end

	-- 영입 목록의 카드·아래 안내만 다시(탭 전환·영입 칸 수 변화) — 창·탭은 그대로
	@ExecSpace("ClientOnly")
	method void RefreshRecruit()
		if self.Kind ~= "recruit" or self.RecruitBody == nil or not isvalid(self.RecruitBody) then return end
		self:BarSelect(self.RecruitBar, self.RecruitTab)
		local old = self.RecruitContent
		local box = self:SpawnBox(self.RecruitBody, "RtsRcContent")
		self.RecruitContent = box
		self:BuildRecruitCards(box)
		self:SwapContent(old, box)
	end

	@ExecSpace("ClientOnly")
	method void BuildRecruitCards(Entity body)
		local H = _RtsHudLogic

		-- 직업 id 기준(2026-09-22): 카드 클릭 → 팝업 닫고 배치 모드(RtsUnitSelectLogic.BeginPlace — 빈 발판 클릭 → 서버 RequestRecruitAt, ESC = 영입 취소).
		--   본편(2026-09-23): 무료·Lv1, 영입 한도(RtsStageTableLogic.RecruitLimit)가 남았을 때만 카드가 눌린다. 팬텀(영웅 탭)은 프리즘 '팬텀 잠금 해제'로 열린다(RtsUnitLogic.IsJobUnlocked)
		local groups = _RtsJobTableLogic:GetRecruitGroups(self.RecruitTab)
		local myId = _RtsUnitLogic:MyUserId()
		local gap = 12
		local colW = (self.RecruitPanelW - 54 - gap * (#groups - 1)) / #groups
		local cardH = 132
		local top = -66
		local nos = _RtsUnitLogic:ListZoneUnits(_RtsUnitLogic:MyZone())
		local stageNo = _RtsStageLogic.StageNo
		local state = _RtsStageLogic.RunState
		local room = _RtsStageTableLogic:RecruitLimit(stageNo) - #nos
		local canRecruit = room > 0 and (state == "countdown" or state == "running") and _RtsRunResultLogic:IsMeAlive()
		for gi = 1, #groups do
			local gx = 27 + (gi - 1) * (colW + gap)
			local g = groups[gi]
			H:SpawnLabel("RtsRcGroup" .. tostring(gi), body, Vector2(0, 1), Vector2(0, 1), Vector2(gx, top), Vector2(colW, 26),
				g[1], self:AccentInk(), 18, TextAlignmentType.MiddleCenter, true)
			local line = H:SpawnUI("model://uisprite", "RtsRcGroupLine" .. tostring(gi), body, Vector2(0, 1), Vector2(0, 1), Vector2(gx, top - 30), Vector2(colW, 1.5))
			line.SpriteGUIRendererComponent.Color = H:ColBorderSoft()
			local jobs = g[2]
			if #jobs == 0 then
				local empty = H:SpawnRoundedPanel("RtsRcEmpty" .. tostring(gi), body, Vector2(0, 1), Vector2(0, 1), Vector2(gx, top - 42), Vector2(colW, cardH),
					Color(1, 1, 1, 0.20), self:Edge(), 1)
				H:SpawnLabel("RtsRcEmptyText", empty, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2.zero, Vector2(colW - 20, 44),
					"출시 예정", self:Muted(), 16, TextAlignmentType.MiddleCenter, false)
			end
			for ji = 1, #jobs do
				local jy = top - 42 - (ji - 1) * (cardH + gap)
				local card = H:SpawnRoundedPanel("RtsRcJob" .. tostring(gi) .. "_" .. tostring(ji), body, Vector2(0, 1), Vector2(0, 1), Vector2(gx, jy), Vector2(colW, cardH),
					self:Card(), self:Edge(), 1.5)
				local jid = jobs[ji]
				-- 이미 보유한 직업은 흐리게 + '보유 중', 클릭 없음(동일 직업 중복 영입 불가 — 프리즘으로 이름이 바뀐 듀얼블레이더도 섀도어로 센다)
				local ownedJob = false
				for oi = 1, #nos do
					local ou = _RtsUnitLogic:GetMyUnit(nos[oi])
					if ou ~= nil and ou.JobId == jid then ownedJob = true end
				end
				local unlocked = _RtsUnitLogic:IsJobUnlocked(myId, jid)
				local ink = self:Ink()
				if ownedJob or not canRecruit or not unlocked then
					ink = self:Muted()
					card.SpriteGUIRendererComponent.Color = self:Card()
				end
				local status = ""
				if ownedJob then status = "보유 중" elseif not unlocked then status = "잠김" end
				local previewY = -55
				local nameY = -106
				if status ~= "" then previewY = -47; nameY = -98 end
				if _RtsJobTableLogic:HasMageSkin(jid) then
					_RtsUnitPopupLogic:SpawnPreviewAt(card, { JobId = jid }, Vector2(colW / 2, previewY), Vector2(84, 84))
				else
					_RtsUnitPopupLogic:SpawnPreviewAt(card, { JobId = jid }, Vector2(colW / 2, previewY), Vector2(68, 78))
				end
				H:SpawnLabel("RtsRcJobName", card, Vector2(0.5, 1), Vector2(0.5, 0.5), Vector2(0, nameY), Vector2(colW - 16, 22),
					_RtsJobTableLogic:GetJobName(jid), ink, 17, TextAlignmentType.MiddleCenter, false)
				if status ~= "" then
					H:SpawnLabel("RtsRcJobStatus", card, Vector2(0.5, 1), Vector2(0.5, 0.5), Vector2(0, -120), Vector2(colW - 16, 18),
						status, self:Muted(), 13, TextAlignmentType.MiddleCenter, false)
				end
				-- 카드 → 직업 상세(2026-09-25 사용자) — 보유 중·잠김·영입 불가도 보기는 된다. 영입은 상세의 [영입] → 발판 고르기
				local click = H:SpawnClick("RtsRcJobClick", card)
				click:ConnectEvent(ButtonClickEvent, function(event)
					self.PendingJob = jid
					self.RiSkillTab = "active"
					self:Open("recruitinfo")
				end)
			end
		end
		-- 하단: 보유 / 한도 · 남은 칸이면 안내, 다 썼으면 다음 영입 라운드
		local owned = #nos
		local foot = "보유 " .. H:Int(owned) .. " / " .. H:Int(_RtsUnitLogic:GetMaxUnits()) .. " · "
		if canRecruit then
			foot = foot .. "영입 가능 " .. H:Int(room) .. " — 직업을 고른 뒤 세울 발판을 클릭"
		elseif owned >= _RtsUnitLogic:GetMaxUnits() then
			foot = foot .. "영입 완료"
		elseif not _RtsRunResultLogic:IsMeAlive() or (state ~= "countdown" and state ~= "running") then
			foot = foot .. "지금은 영입할 수 없음"
		else
			local nextNo = _RtsStageTableLogic:NextRecruitStage(stageNo)
			if nextNo > 0 then foot = foot .. "다음 영입 · " .. H:Int(nextNo) .. "라운드 (방출하면 빈 칸을 다시 영입)" else foot = foot .. "영입 완료" end
		end
		H:SpawnLabel("RtsRcFoot", body, Vector2(1, 0), Vector2(1, 0), Vector2(-27, 22), Vector2(700, 26),
			foot, self:Muted(), 15, TextAlignmentType.MiddleRight, false)
	end

	-- 이 직업을 지금 영입할 수 있나: "" = 가능, 아니면 이유 한 줄(영입 목록 카드의 흐림 판정과 같은 조건 — BuildRecruit)
	@ExecSpace("ClientOnly")
	method string RecruitBlockReason(string jid)
		local myId = _RtsHudLogic.MyUserId
		local nos = _RtsUnitLogic:ListZoneUnits(_RtsUnitLogic:MyZone())
		for oi = 1, #nos do
			local ou = _RtsUnitLogic:GetMyUnit(nos[oi])
			if ou ~= nil and ou.JobId == jid then return "이미 보유 중인 직업이에요" end
		end
		if not _RtsUnitLogic:IsJobUnlocked(myId, jid) then return "잠김 — 팬텀 프리즘을 얻으면 영입할 수 있어요" end
		local state = _RtsStageLogic.RunState
		if not _RtsRunResultLogic:IsMeAlive() or (state ~= "countdown" and state ~= "running") then return "지금은 영입할 수 없어요" end
		local stageNo = _RtsStageLogic.StageNo
		if _RtsStageTableLogic:RecruitLimit(stageNo) - #nos > 0 then return "" end
		if #nos >= _RtsUnitLogic:GetMaxUnits() then return "영입 칸이 가득 찼어요" end
		local nextNo = _RtsStageTableLogic:NextRecruitStage(stageNo)
		if nextNo > 0 then return "다음 영입은 " .. _RtsHudLogic:Int(nextNo) .. "라운드부터예요" end
		return "영입 칸이 가득 찼어요"
	end

	-- 직업 상세(2026-09-25 사용자 — 폭 600, 제목 가운데): 왼쪽 위 = 기본 외형(낮은 칸) · 계열 / 오른쪽 위 = 오각형(5축, 모양으로만) /
	--   아래 = 탭 [액티브] [패시브] [프리즘 증강] + 그 탭의 목록(세로 스크롤, 줄을 누르면 그 아래로 설명 펼침) / 맨 아래 = [선택](가능할 때 → 발판 고르기) · [취소](목록으로)
	@ExecSpace("ClientOnly")
	method void BuildRecruitInfo(Entity body, number W)
		local H = _RtsHudLogic
		local T = _RtsJobTableLogic
		local jid = self.PendingJob
		if jid == nil or jid == "" or not T:HasJob(jid) then return end
		-- 왼쪽 위: 외형(기본 스킨) 150×170 — 2026-09-25 사용자 "외형 높이가 너무 높다". UI 아바타는 칸 아래쪽에 서서 칸을 캐릭터 크기에 맞게 낮춘다
		local frame = H:SpawnRoundedPanel("RtsRiAvatarBox", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -6), Vector2(150, 170),
			self:Card(), self:Edge(), 1.5)
		if T:HasMageSkin(jid) then
			_RtsUnitPopupLogic:SpawnPreviewAt(frame, { JobId = jid }, Vector2(75, -85), Vector2(140, 140))
		else
			_RtsUnitPopupLogic:SpawnPreviewAt(frame, { JobId = jid }, Vector2(80, -84), Vector2(120, 150))
		end
		H:SpawnLabel("RtsRiGroup", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -182), Vector2(150, 24),
			T:GetJobGroup(jid), self:Muted(), 15, TextAlignmentType.MiddleCenter, false)
		-- 오른쪽 위: 오각형 — 축 = 위부터 시계 방향 공격 속도 · 사거리 · 증강 효율 · 보스 · 사냥
		local rd = T:GetRadar(jid)
		self:SpawnRadar(body, 177 + (W - 204) / 2, -118, 80, { rd.speed, rd.range, rd.aug, rd.boss, rd.hunt },
			{ "공격 속도", "사거리", "증강 효율", "보스", "사냥" })
		-- 아래: 스킬 탭(제자리) + [Tab] 키캡 + 목록(탭을 바꾸면 목록만 다시 — BuildRiSkills)
		local items = { { "active", "액티브" }, { "passive", "패시브" }, { "prism", "프리즘 증강" } }
		if self.RiSkillTab ~= "passive" and self.RiSkillTab ~= "prism" then self.RiSkillTab = "active" end
		self.RiBar = self:SpawnTabBar(body, "RtsRiSkillTab", items, self.RiSkillTab, 27, -222, 120, 30, 8, 15, function(key)
			self.RiSkillTab = key
			self:BuildRiSkills(body, W)
		end)
		local tkey = H:SpawnRoundedPanel("RtsRiTabKey", body, Vector2(0, 1), Vector2(0, 1), Vector2(self.RiBar.right + 4, -224), Vector2(56, 26),
			Color(0.92, 0.93, 0.98, 0.9), Color(0.72, 0.74, 0.84, 0.9), 1.2)
		H:SpawnLabel("RtsRiTabKeyText", tkey, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(54, 24),
			"Tab", Color(0.38, 0.39, 0.50, 1), 13, TextAlignmentType.MiddleCenter, true)
		self.RiSkillBox = nil
		self:BuildRiSkills(body, W)
		-- 맨 아래: [선택](가능할 때 — 2026-09-25 사용자 "영입 → 선택") / 이유 · [취소]
		local bw = 180
		local bh = 44
		local reason = self:RecruitBlockReason(jid)
		if reason == "" then
			local yes = H:SpawnRoundedPanel("RtsRiRecruit", body, Vector2(0.5, 0), Vector2(1, 0), Vector2(-10, 22), Vector2(bw, bh),
				self:Mix(H:ColGold(), 0.25), H:ColGold(), 1.5)
			H:SpawnLabel("RtsRiRecruitText", yes, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(bw - 8, bh - 6),
				"선택", self:Ink(), 17, TextAlignmentType.MiddleCenter, true)
			local yc = H:SpawnClick("RtsRiRecruitClick", yes)
			yc:ConnectEvent(ButtonClickEvent, function(event)
				self:Close()
				_RtsUnitSelectLogic:BeginPlace(jid)
			end)
		else
			H:SpawnLabel("RtsRiReason", body, Vector2(0.5, 0), Vector2(1, 0), Vector2(-10, 22), Vector2(250, bh),
				reason, self:Muted(), 15, TextAlignmentType.MiddleRight, false)
		end
		local no = self:SpawnTab("RtsRiCancel", body, Vector2(0, 0), Vector2(bw, bh), "취소", false, 17)
		local nt = no.Parent.UITransformComponent
		nt.AnchorsMin = Vector2(0.5, 0)
		nt.AnchorsMax = Vector2(0.5, 0)
		nt.Pivot = Vector2(0, 0)
		nt.anchoredPosition = Vector2(10, 22)
		local nc = H:SpawnClick("RtsRiCancelClick", no)
		nc:ConnectEvent(ButtonClickEvent, function(event)
			self:Open("recruit")
		end)
	end

	-- 영입 상세 스킬 영역: 탭 [액티브] [패시브] [프리즘 증강] + [Tab] 키캡 + 그 탭의 목록(세로 스크롤, 줄마다 이름 + 설명이 늘 보임).
	--   탭을 바꾸면 창 전체가 아니라 이 영역(RiSkillBox)만 다시 만든다 — 2026-09-25 사용자 "탭 넘어갈 때마다 오각형이 번쩍"
	--   줄 = 테두리 칸(이름 굵게 + 설명), 간격 6 — "스킬마다 경계가 어색" → 칸 테두리·여백을 또렷하게, 설명 높이는 글자 폭(한글 14px · 영숫자 7.5px)으로 어림
	@ExecSpace("ClientOnly")
	method void BuildRiSkills(Entity body, number W)
		local H = _RtsHudLogic
		local T = _RtsJobTableLogic
		local jid = self.PendingJob
		local old = self.RiSkillBox
		local box = self:SpawnBox(body, "RtsRiSkills")
		self.RiSkillBox = box
		self:DropLater(old)
		local list = H:SpawnStretch("model://uisprite", "RtsRiSkillList", box, Vector2(0, 0), Vector2(1, 1), Vector2(27, 78), Vector2(-27, -260))
		list.SpriteGUIRendererComponent.Color = self:Mix(Color.white, 0.02)
		local sg = list:AddComponent("ScrollLayoutGroupComponent")
		if sg ~= nil then
			sg.Type = LayoutGroupType.Vertical
			sg.ChildAlignment = ChildAlignmentType.UpperLeft
			sg.Spacing = 6
			sg.UseScroll = true
			sg.ScrollBarVisible = ScrollBarVisibility.AlwaysShow
			sg.ScrollBarThickness = 8
			sg.ScrollBarHandleColor = H:ColGold()
			sg.ScrollBarBackgroundColor = Color(1, 1, 1, 0.06)
		end
		local rowW = W - 54 - 16
		local textW = rowW - 28
		local n = 0
		-- 설명 줄 수 어림: 한글(3바이트 글자) 14px · 그 밖 7.5px 폭의 합 × 1.06(줄바꿈 여유) ÷ 칸 폭
		local function descLines(text)
			local _, kor = string.gsub(text, "[\224-\239]", "")
			local _, asc = string.gsub(text, "[\1-\127]", "")
			local px = kor * 14 + asc * 7.5
			return math.max(1, math.ceil(px * 1.06 / textW))
		end
		local function addItem(title, ink, text)
			n = n + 1
			local descH = 0
			if text ~= nil and text ~= "" then descH = descLines(text) * 20 end
			local h = 36
			if descH > 0 then h = 34 + descH + 10 end
			local row = H:SpawnRoundedPanel("RtsRiSkillRow" .. H:Int(n), list, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(rowW, h),
				self:Mix(Color.white, 0.035), self:Mix(Color.white, 0.12), 1)
			row.SpriteGUIRendererComponent.RaycastTarget = false
			local head = H:SpawnLabel("RtsRiSkillName", row, Vector2(0, 1), Vector2(0, 1), Vector2(14, -6), Vector2(textW, 24),
				title, ink, 15, TextAlignmentType.MiddleLeft, true)
			if head.TextComponent ~= nil then head.TextComponent.IsRichText = false end
			if descH > 0 then
				local desc = H:SpawnLabel("RtsRiSkillDesc", row, Vector2(0, 1), Vector2(0, 1), Vector2(14, -34), Vector2(textW, descH),
					text, self:Ink(), 14, TextAlignmentType.UpperLeft, false)
				if desc.TextComponent ~= nil then desc.TextComponent.IsRichText = false end
			end
		end
		if self.RiSkillTab == "prism" then
			-- 그 직업 전용 프리즘 증강(팬텀은 영입 해금 프리즘 '영웅 팬텀'). 설명 앞 "[프리즘] "은 뺀다
			local prisms = T:GetPrisms()
			for i = 1, #prisms do
				local pz = prisms[i]
				if pz.job == jid or (jid == "phantom" and pz.id == "phantom") then
					local text = pz.desc or ""
					if string.sub(text, 1, #"[프리즘] ") == "[프리즘] " then text = string.sub(text, #"[프리즘] " + 1) end
					addItem(pz.name, Color(0.45, 0.27, 0.62, 1), text)
				end
			end
		else
			local want = "액티브"
			if self.RiSkillTab == "passive" then want = "패시브" end
			local skills = T:GetSkills(jid)
			for i = 1, #skills do
				local k = skills[i]
				if k.name ~= nil and k.name ~= "" and not k.prism and k.kind == want then
					local ink = self:Ink()
					if want == "액티브" then ink = self:AccentInk() end
					addItem("Lv " .. H:Int(k.lv or 1) .. "  " .. k.name, ink, k.desc)
				end
			end
		end
		if n == 0 then addItem("없음", self:Muted(), "") end
	end

	-- 선분 한 개(흰 사각을 늘려 회전): parent 가운데 기준 (x1, y1) → (x2, y2), 두께 t — 체크 표시 등
	@ExecSpace("ClientOnly")
	method Entity SpawnSegment(Entity parent, string name, number x1, number y1, number x2, number y2, number t, Color col)
		local H = _RtsHudLogic
		local dx = x2 - x1
		local dy = y2 - y1
		local len = math.sqrt(dx * dx + dy * dy)
		local e = H:SpawnUI("model://uisprite", name, parent, Vector2(0.5, 0.5), Vector2(0, 0.5), Vector2(x1, y1), Vector2(len + t * 0.5, t))
		if e == nil then return nil end
		e.UITransformComponent.ZRotation = math.deg(self:Atan2(dy, dx))
		e.SpriteGUIRendererComponent.Color = col
		e.SpriteGUIRendererComponent.RaycastTarget = false
		return e
	end

	-- Tab 키 = 증강 창·증강 도감의 등급 탭 순환(2026-09-25 사용자 "증강 도감/증강에서 탭으로 각 항목 넘길 수 있게") — RtsUnitSelectLogic.HandleKeyDownEvent
	@ExecSpace("ClientOnly")
	method void CycleGradeTab()
		-- 탭만 제자리에서 바꾸고 그 탭의 칸만 다시(창 전체는 그대로)
		if self.Kind == "recruitinfo" then
			local nx = self:BarNext(self.RiBar)
			if nx == "" then return end
			self.RiSkillTab = nx
			self:BarSelect(self.RiBar, nx)
			if self.Body ~= nil and isvalid(self.Body) then self:BuildRiSkills(self.Body, self.PanelOuter.UITransformComponent.RectSize.x) end
		elseif self.Kind == "codex" then
			local nx = self:BarNext(self.CodexBar)
			if nx == "" then return end
			self.CodexGrade = nx
			self:RefreshCodex()
		end
	end

	-- 탭 줄 오른쪽 [Tab] 키캡(증강·도감 — 유닛 상세의 [Tab]과 같은 모양)
	@ExecSpace("ClientOnly")
	method void SpawnTabKeyHint(Entity body, number x)
		local H = _RtsHudLogic
		local tkey = H:SpawnRoundedPanel("RtsTabKeyHint", body, Vector2(0, 1), Vector2(0, 1), Vector2(x, -14), Vector2(56, 26),
			Color(0.92, 0.93, 0.98, 0.9), Color(0.72, 0.74, 0.84, 0.9), 1.2)
		H:SpawnLabel("RtsTabKeyHintText", tkey, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(54, 24),
			"Tab", Color(0.38, 0.39, 0.50, 1), 13, TextAlignmentType.MiddleCenter, true)
	end

	-- 두 인자 아크탄젠트(라디안) — math.atan 두 인자판에 기대지 않는다
	method number Atan2(number y, number x)
		if x > 0 then return math.atan(y / x) end
		if x < 0 then
			if y >= 0 then return math.atan(y / x) + math.pi end
			return math.atan(y / x) - math.pi
		end
		if y > 0 then return math.pi / 2 end
		if y < 0 then return 0 - math.pi / 2 end
		return 0
	end

	-- 오각형(레이더) 한 장: parent 왼쪽 위 기준 가운데 (cx, cy)(UI 좌표 — y 위가 +), 반지름 r(5단계 꼭짓점), levels(1~5)·names 5개(위부터 시계 방향). 단계 글자 없이 모양으로만.
	--   바탕 그물 = RadarWebRUID 한 장(5겹 + 축), 값 다각형 = 삼각형 5개(가운데·꼭짓점 i·i+1)를 높이선으로 둘씩 나눈 직각삼각형 10장(RightTriRUID — 회전·가로세로 크기만으로 어떤 직각삼각형이든 된다),
	--   테두리 선 5개(흰 사각 늘려 회전) + 꼭짓점 점 + 축 이름·단계 글자
	@ExecSpace("ClientOnly")
	method void SpawnRadar(Entity parent, number cx, number cy, number r, table levels, table names)
		local H = _RtsHudLogic
		local web = H:SpawnUI("model://uisprite", "RtsRadarWeb", parent, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(r * 512 / 240, r * 512 / 240))
		web.UITransformComponent.Pivot = Vector2(0.5, 0.5)
		web.UITransformComponent.anchoredPosition = Vector2(cx, cy)
		web.SpriteGUIRendererComponent.ImageRUID = DataRef(self.RadarWebRUID)
		web.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0.9)
		web.SpriteGUIRendererComponent.RaycastTarget = false
		local n = #levels
		local pts = {}
		for i = 1, n do
			local a = math.rad(360 / n * (i - 1))
			local rr = r * math.max(1, math.min(5, levels[i])) / 5
			pts[i] = Vector2(cx + rr * math.sin(a), cy + rr * math.cos(a))
		end
		local fill = self:Mix(H:ColGold(), 0.9)
		fill = Color(fill.r, fill.g, fill.b, 0.42)
		local c = Vector2(cx, cy)
		local serial = 0
		-- 직각삼각형 한 장: 직각 꼭짓점 f, 두 다리 끝 m·v
		local function rightTri(f, m, v)
			local ux = m.x - f.x
			local uy = m.y - f.y
			local vx = v.x - f.x
			local vy = v.y - f.y
			local lu = math.sqrt(ux * ux + uy * uy)
			local lv = math.sqrt(vx * vx + vy * vy)
			if lu < 0.5 or lv < 0.5 then return end
			-- 스프라이트 = 직각이 왼쪽 아래, 가로 다리 → 세로 다리가 반시계. 두 다리가 시계 방향이면 바꿔 끼운다(뒤집기 없이)
			if ux * vy - uy * vx < 0 then
				ux, uy, vx, vy, lu, lv = vx, vy, ux, uy, lv, lu
			end
			serial = serial + 1
			local e = H:SpawnUI("model://uisprite", "RtsRadarTri" .. H:Int(serial), parent, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(lu, lv))
			local t = e.UITransformComponent
			t.Pivot = Vector2(0, 0)
			t.anchoredPosition = f
			t.ZRotation = math.deg(self:Atan2(uy, ux))
			e.SpriteGUIRendererComponent.ImageRUID = DataRef(self.RightTriRUID)
			e.SpriteGUIRendererComponent.Color = fill
			e.SpriteGUIRendererComponent.RaycastTarget = false
		end
		-- 삼각형 (a, b, d) → 가장 긴 변에 맞은편 꼭짓점에서 수선 → 직각삼각형 둘
		local function tri(a, b, d)
			local ps = { a, b, d }
			local best = 1
			local bestL = -1
			for k = 1, 3 do
				local p1 = ps[k]
				local p2 = ps[k % 3 + 1]
				local l = (p2.x - p1.x) * (p2.x - p1.x) + (p2.y - p1.y) * (p2.y - p1.y)
				if l > bestL then
					bestL = l
					best = k
				end
			end
			local x = ps[best]
			local y = ps[best % 3 + 1]
			local o = ps[(best + 1) % 3 + 1]
			if bestL < 1 then return end
			local tt = ((o.x - x.x) * (y.x - x.x) + (o.y - x.y) * (y.y - x.y)) / bestL
			local f = Vector2(x.x + (y.x - x.x) * tt, x.y + (y.y - x.y) * tt)
			rightTri(f, x, o)
			rightTri(f, y, o)
		end
		for i = 1, n do
			tri(c, pts[i], pts[i % n + 1])
		end
		-- 테두리 · 꼭짓점
		local lineCol = H:ColGold()
		for i = 1, n do
			local p1 = pts[i]
			local p2 = pts[i % n + 1]
			local dx = p2.x - p1.x
			local dy = p2.y - p1.y
			local len = math.sqrt(dx * dx + dy * dy)
			local ln = H:SpawnUI("model://uisprite", "RtsRadarEdge" .. H:Int(i), parent, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(len, 2.5))
			ln.UITransformComponent.Pivot = Vector2(0, 0.5)
			ln.UITransformComponent.anchoredPosition = p1
			ln.UITransformComponent.ZRotation = math.deg(self:Atan2(dy, dx))
			ln.SpriteGUIRendererComponent.ImageRUID = DataRef(H.WhiteRUID)
			ln.SpriteGUIRendererComponent.Color = lineCol
			ln.SpriteGUIRendererComponent.RaycastTarget = false
			local dot = H:SpawnUI("model://uisprite", "RtsRadarDot" .. H:Int(i), parent, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(9, 9))
			dot.UITransformComponent.Pivot = Vector2(0.5, 0.5)
			dot.UITransformComponent.anchoredPosition = p1
			if H.CircleMaskRUID ~= "" then dot.SpriteGUIRendererComponent.ImageRUID = DataRef(H.CircleMaskRUID) end
			dot.SpriteGUIRendererComponent.Color = lineCol
			dot.SpriteGUIRendererComponent.RaycastTarget = false
		end
		-- 축 이름만(2026-09-25 사용자 "보통/높음 이런 거 빼고 오각형의 정도로 나타내면 됨")
		for i = 1, n do
			local a = math.rad(360 / n * (i - 1))
			local lx = cx + (r + 46) * math.sin(a)
			local ly = cy + (r + 22) * math.cos(a)
			local lb = H:SpawnLabel("RtsRadarLabel" .. H:Int(i), parent, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(120, 26),
				names[i], self:Ink(), 15, TextAlignmentType.MiddleCenter, true)
			lb.UITransformComponent.Pivot = Vector2(0.5, 0.5)
			lb.UITransformComponent.anchoredPosition = Vector2(lx, ly)
		end
	end

	-- ===== 결과: 클리어 / 탈락(필드 110 · 보스 시간 초과) + 도달·처치·보스 HP%·개인 최고 + [관전하기][나가기] =====
	--   관전하기 = 팝업만 닫고 관전(F1~F8·목록 클릭 — 나가기는 상단 버튼 자리에 남는다, RtsHudLogic.RefreshRecruitButton), 나가기 = RtsRunResultLogic.RequestExit(월드에서 나감 — Phase 8 로비 이동으로 교체)

	@ExecSpace("ClientOnly")
	method void BuildResult(Entity body)
		local H = _RtsHudLogic
		local r = self.Result
		if r == nil or r.stageNo == nil then
			self:Close()
			return
		end
		local total = _RtsStageTableLogic:GetStageCount()
		local head = "클리어!"
		local headColor = self:AccentInk()
		if not r.cleared then
			headColor = Color(0.66, 0.24, 0.18, 1)
			if r.reason == "boss" then head = "탈락 — 보스 시간 초과" else head = "탈락 — 필드 110" end
		end
		H:SpawnLabel("RtsRsHead", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -4), Vector2(586, 40),
			head, headColor, 28, TextAlignmentType.MiddleLeft, true)
		local reached = _RtsStageTableLogic:GetStage(r.stageNo)
		local reachedName = ""
		if reached ~= nil then reachedName = " · " .. _RtsStageTableLogic:FullName(reached) end
		H:SpawnLabel("RtsRsReach", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -54), Vector2(586, 28),
			"도달: " .. H:Int(r.stageNo) .. " / " .. H:Int(total) .. reachedName, self:Ink(), 19, TextAlignmentType.MiddleLeft, false)
		local line3 = "처치 " .. H:FormatNumber(r.kills) .. "마리"
		if not r.cleared and r.reason == "boss" then line3 = line3 .. "   ·   보스 HP " .. string.format("%.1f", r.pct * 100) .. "%" end
		H:SpawnLabel("RtsRsKills", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -88), Vector2(586, 28),
			line3, self:Ink(), 19, TextAlignmentType.MiddleLeft, false)
		local best = "개인 최고: "
		if r.bestClear then
			best = best .. "클리어"
		else
			local bs = _RtsStageTableLogic:GetStage(r.bestNo)
			best = best .. H:Int(r.bestNo) .. " / " .. H:Int(total)
			if bs ~= nil then best = best .. " · " .. _RtsStageTableLogic:FullName(bs) end
		end
		H:SpawnLabel("RtsRsBest", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -122), Vector2(586, 28),
			best, self:Muted(), 17, TextAlignmentType.MiddleLeft, false)
		local by = -186
		-- (클리어 순위 두 줄은 뺐다 — 2026-09-25 사용자 "인게임 순위표 제거, 지금 저기서 보일 게 아니야". 클리어 기록 저장은 그대로, 순위는 대기방(Phase 13)에서)
		-- 버튼: 여럿 = 관전하기 / 나가기(대기방 — 멀티 업데이트), 솔로(방 인원 1) = 닫기 / 다시 하기(바로 새 판, 2026-09-24 솔로 출시)
		local solo = _RtsStageLogic:IsSolo()
		local bw = 180
		local bh = 44
		local closeText = "관전하기"
		if solo then closeText = "닫기" end
		local close = self:SpawnTab("RtsRsClose", body, Vector2(0, 0), Vector2(bw, bh), closeText, false, 17)
		local ct = close.Parent.UITransformComponent
		ct.AnchorsMin = Vector2(0.5, 1)
		ct.AnchorsMax = Vector2(0.5, 1)
		ct.Pivot = Vector2(1, 1)
		ct.anchoredPosition = Vector2(-10, by)
		local cc = H:SpawnClick("RtsRsCloseClick", close)
		cc:ConnectEvent(ButtonClickEvent, function(event)
			self:Close()
		end)
		local exitCol = Color(0.8, 0.35, 0.3, 1)
		local exitInk = Color(0.62, 0.19, 0.15, 1)
		local exitText = "나가기"
		if solo then
			exitCol = H:ColGold()
			exitInk = self:Ink()
			exitText = "다시하기"
		end
		local exit = H:SpawnRoundedPanel("RtsRsExit", body, Vector2(0.5, 1), Vector2(0, 1), Vector2(10, by), Vector2(bw, bh),
			self:Mix(exitCol, 0.25), exitCol, 1.5)
		H:SpawnLabel("RtsRsExitText", exit, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(bw - 8, bh - 6),
			exitText, exitInk, 17, TextAlignmentType.MiddleCenter, true)
		local ec = H:SpawnClick("RtsRsExitClick", exit)
		ec:ConnectEvent(ButtonClickEvent, function(event)
			if solo then
				self:OpenRestartConfirm()
			else
				self:Close()
				_RtsRunResultLogic:RequestExit()
			end
		end)
	end

	-- ===== 다시하기 확인(2026-09-24 사용자 "다시하기 버튼 누르면 예/아니오 확인 팝업. 진짜 다시 할 거냐 묻고") =====
	--   오른쪽 아래 다시하기 · 결과 창 다시하기 · 판이 끝난 뒤 오른쪽 버튼이 모두 여기를 거친다. 예 = RtsStageLogic.RequestRestartVote(혼자면 바로 새 판, 여럿이면 찬성)
	@ExecSpace("ClientOnly")
	method void OpenRestartConfirm()
		local st = _RtsStageLogic.RunState
		if st ~= "running" and st ~= "ended" then return end
		self:Open("restart")
	end

	@ExecSpace("ClientOnly")
	method void BuildRestart(Entity body)
		local H = _RtsHudLogic
		local solo = _RtsStageLogic:IsSolo()
		local msg = "처음부터 다시 시작합니다.\n지금 판의 유닛 · 메소 · 증강은 모두 사라집니다.\n정말 다시 할까요?"
		local yesText = "다시하기"
		if not solo then
			msg = "다시하기에 찬성합니다.\n방 인원 과반이 찬성하면 처음부터 다시 시작해요.\n찬성할까요?"
			yesText = "찬성"
		end
		if _RtsStageLogic.RunState == "running" and solo then
			msg = "진행 중인 판을 그만두고 처음부터 다시 시작합니다.\n지금 판의 유닛 · 메소 · 증강은 모두 사라집니다.\n정말 다시 할까요?"
		end
		self:BuildConfirm(body, msg, yesText, function()
			self:Close()
			_RtsStageLogic:RequestRestartVote()
		end, function()
			self:Close()
		end)
	end

	-- 예/아니오 공용(다시하기·테마·아이콘 변경 확인): 가운데 글 + 금색 [예] + [아니오]. 누르면 yesFn / noFn
	@ExecSpace("ClientOnly")
	method void BuildConfirm(Entity body, string msg, string yesText, any yesFn, any noFn)
		local H = _RtsHudLogic
		H:SpawnLabel("RtsRsConfirmMsg", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -10), Vector2(586, 110),
			msg, self:Ink(), 18, TextAlignmentType.MiddleCenter, false)
		local bw = 180
		local bh = 44
		local by = -140
		local yes = H:SpawnRoundedPanel("RtsRsConfirmYes", body, Vector2(0.5, 1), Vector2(1, 1), Vector2(-10, by), Vector2(bw, bh),
			self:Mix(H:ColGold(), 0.25), H:ColGold(), 1.5)
		H:SpawnLabel("RtsRsConfirmYesText", yes, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(bw - 8, bh - 6),
			yesText, self:Ink(), 17, TextAlignmentType.MiddleCenter, true)
		local yc = H:SpawnClick("RtsRsConfirmYesClick", yes)
		yc:ConnectEvent(ButtonClickEvent, function(event)
			yesFn()
		end)
		local no = self:SpawnTab("RtsRsConfirmNo", body, Vector2(0, 0), Vector2(bw, bh), "아니오", false, 17)
		local nt = no.Parent.UITransformComponent
		nt.AnchorsMin = Vector2(0.5, 1)
		nt.AnchorsMax = Vector2(0.5, 1)
		nt.Pivot = Vector2(0, 1)
		nt.anchoredPosition = Vector2(10, by)
		local nc = H:SpawnClick("RtsRsConfirmNoClick", no)
		nc:ConnectEvent(ButtonClickEvent, function(event)
			noFn()
		end)
	end

	-- ===== 맵 테마(2026-09-25 사용자): 탭(종류) + 테마 카드(썸네일·이름·사용 중). 카드 → 변경 확인 예/아니오 → RtsProfileLogic.RequestSetTheme =====
	--   썸네일 없는 테마는 테마 색 단색(RtsHudLogic.PaintThumb) — 썸네일·모양은 ChatGPT(docs/theme-presets.md)

	-- 스크롤 격자(프로필 [아이콘] 탭 — 테마·비석 탭은 줄마다 3장인 세로 스크롤): body 안 (27, bottom) ~ (−27, −top) 영역, 칸 cell × cell 크기·간격 gap·가로 cols칸, 넘치면 세로 스크롤
	@ExecSpace("ClientOnly")
	method Entity SpawnScrollGrid(Entity body, string name, number top, number bottom, Vector2 cell, number gap, number cols)
		local H = _RtsHudLogic
		local list = H:SpawnStretch("model://uisprite", name, body, Vector2(0, 0), Vector2(1, 1), Vector2(27, bottom), Vector2(-27, 0 - top))
		list.SpriteGUIRendererComponent.Color = self:Mix(Color.white, 0.02)
		local sg = list:AddComponent("ScrollLayoutGroupComponent")
		if sg == nil then return list end
		-- 격자 설정: 만든 직후 넣은 값이 기본값(칸 100×100·간격 0)으로 계산될 때가 있어(2026-09-25 실측 — 테마 카드가 100px 간격으로 겹침) 한 박자 뒤에 한 번 더 넣는다
		local function apply()
			if list == nil or not isvalid(list) then return end
			sg.Type = LayoutGroupType.Grid
			sg.CellSize = cell
			sg.GridSpacing = Vector2(gap, gap)
			sg.Constraint = GridLayoutConstraint.FixedColumnCount
			sg.ConstraintCount = cols
			sg.ChildAlignment = ChildAlignmentType.UpperLeft
			sg.GridChildAlignment = ChildAlignmentType.UpperLeft
			sg.UseScroll = true
			sg.ScrollBarVisible = ScrollBarVisibility.AlwaysShow
			sg.ScrollBarThickness = 8
			sg.ScrollBarHandleColor = H:ColGold()
			sg.ScrollBarBackgroundColor = Color(1, 1, 1, 0.06)
		end
		apply()
		_TimerService:SetTimerOnce(apply, 0.05)
		return list
	end

	-- ===== 프로필 설정(2026-09-25 사용자 "맵 테마 창을 프로필 설정으로, 탭을 테마/비석 두 개로" → "테마와 비석 사이에 아이콘 — 아이콘을 여기서 수정") =====
	--   위 탭 [테마] [아이콘] [비석]. 둘째 줄 종류 탭(기본/…) + 안내. 테마·비석 = 세로 스크롤 + 줄마다 정사각 3장(SpawnPresetList·Row·Card 공용), 아이콘 = 8열 스크롤 격자
	@ExecSpace("ClientOnly")
	method void BuildProfile(Entity body, number W)
		if self.ProfileTab ~= "tomb" and self.ProfileTab ~= "icon" then self.ProfileTab = "theme" end
		self.ProfileBody = body
		self.ProfileW = W
		self.ProfileBar = self:SpawnTabBar(body, "RtsProfTab", { { "theme", "테마" }, { "icon", "아이콘" }, { "tomb", "비석" } }, self.ProfileTab, 27, -10, 130, 34, 8, 16, function(key)
			self.ProfileTab = key
			self:RefreshProfileContent()
		end)
		self.ProfileContent = nil
		self:RefreshProfileContent()
	end

	-- 프로필 창 내용(종류 탭·안내·카드)만 다시 — 위 탭·창은 그대로(2026-09-25)
	@ExecSpace("ClientOnly")
	method void RefreshProfileContent()
		if self.Kind ~= "profile" or self.ProfileBody == nil or not isvalid(self.ProfileBody) then return end
		self:BarSelect(self.ProfileBar, self.ProfileTab)
		local old = self.ProfileContent
		local box = self:SpawnBox(self.ProfileBody, "RtsProfContent")
		self.ProfileContent = box
		self.PresetCards = {}
		if self.ProfileTab == "tomb" then
			self:BuildTombTab(box, self.ProfileW)
		elseif self.ProfileTab == "icon" then
			self:BuildIconTab(box, self.ProfileW)
		else
			self:BuildThemeTab(box, self.ProfileW)
		end
		self:SwapContent(old, box)
	end

	-- 프로필 창을 그 탭으로(아이콘 정보·확인 창에서 돌아올 때). 이미 프로필 창이면 내용만 다시
	@ExecSpace("ClientOnly")
	method void OpenProfileTab(string tab)
		local sameTab = self.Kind == "profile" and self.ProfileTab == tab
		if isvalid(self._T.ProfileDialog) then
			self:CloseProfileDialog()
			if sameTab then return end
		end
		self.ProfileTab = tab
		if self.Kind == "profile" then
			self:RefreshProfileContent()
		else
			self:Open("profile")
		end
	end

	-- 프로필 목록·스크롤은 유지하고 상세/확인창만 위에 얹는다.
	@ExecSpace("ClientOnly")
	method void OpenProfileDialog(string kind)
		local H = _RtsHudLogic
		local old = self._T.ProfileDialog
		local layer = H:SpawnStretch("model://uisprite", "RtsProfileDialogLayer", self.Group, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		layer.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		layer.SpriteGUIRendererComponent.RaycastTarget = false
		self._T.ProfileDialog = layer
		self._T.ProfileDialogKind = kind
		local dim = H:SpawnStretch("model://uibutton", "RtsProfileDialogDim", layer, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		dim.SpriteGUIRendererComponent.Color = Color(0.10, 0.12, 0.18, 0.22)
		dim:ConnectEvent(ButtonClickEvent, function(event) self:CloseProfileDialog() end)
		local title = "변경 확인"
		local height = 300
		if kind == "iconinfo" then title = "아이콘"; height = 370 end
		local panel = H:SpawnRoundedPanel("RtsProfileDialogPanel", layer, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(640, height),
			Color(0.98, 0.985, 1, 1), H:ColGold(), 2)
		H:SpawnLabel("RtsProfileDialogTitle", panel, Vector2(0, 1), Vector2(0, 1), Vector2(27, -18), Vector2(520, 34),
			title, self:Ink(), 24, TextAlignmentType.MiddleLeft, true)
		local close = H:SpawnRoundedPanel("RtsProfileDialogClose", panel, Vector2(1, 1), Vector2(1, 1), Vector2(-20, -18), Vector2(36, 36),
			Color.white, self:Edge(), 1)
		H:SpawnLabel("RtsProfileDialogCloseText", close, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(34, 34),
			"×", self:Ink(), 24, TextAlignmentType.MiddleCenter, true)
		local click = H:SpawnClick("RtsProfileDialogCloseClick", close)
		click:ConnectEvent(ButtonClickEvent, function(event) self:CloseProfileDialog() end)
		local body = H:SpawnStretch("model://uisprite", "RtsProfileDialogBody", panel, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, -70))
		body.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		if kind == "themeconfirm" then self:BuildThemeConfirm(body)
		elseif kind == "tombconfirm" then self:BuildTombConfirm(body)
		elseif kind == "iconinfo" then self:BuildIconInfo(body, 640)
		else self:BuildIconConfirm(body) end
		self:SwapContent(old, layer)
	end

	@ExecSpace("ClientOnly")
	method void CloseProfileDialog()
		if isvalid(self._T.ProfileDialog) then self._T.ProfileDialog:Destroy() end
		self._T.ProfileDialog = nil
		self._T.ProfileDialogKind = ""
	end

	-- 지금 탭에서 사용 중인 프리셋인가
	method boolean PresetIsCurrent(string key)
		local P = _RtsProfileLogic
		if self.ProfileTab == "tomb" then return key == P.MyTomb end
		return key == P.MyTheme
	end

	-- 사용 중 표시만 제자리에서(서버가 선택을 바꿔 보냈을 때 — RtsProfileLogic.SendProfileState): 테두리·체크 칸
	@ExecSpace("ClientOnly")
	method void RefreshPresetMarks()
		if self.Kind ~= "profile" then return end
		local H = _RtsHudLogic
		for i = 1, #self.PresetCards do
			local c = self.PresetCards[i]
			if c.card ~= nil and isvalid(c.card) then
				local on = self:PresetIsCurrent(c.key)
				local border = self:Mix(Color.white, 0.12)
				if on then border = H:ColGold() end
				if c.card.Parent ~= nil then c.card.Parent.SpriteGUIRendererComponent.Color = border end
				if c.box ~= nil and isvalid(c.box) then
					if on then c.box.SpriteGUIRendererComponent.Color = H:ColGold() else c.box.SpriteGUIRendererComponent.Color = Color(0.92, 0.93, 0.98, 0.9) end
				end
				for m = 1, #c.marks do
					if c.marks[m] ~= nil and isvalid(c.marks[m]) then c.marks[m]:SetEnable(on) end
				end
			end
		end
	end

	-- 종류 탭(2개 이상일 때만): [테마][비석] 오른쪽에서 시작. 고른 종류 이름을 돌려준다
	@ExecSpace("ClientOnly")
	method string BuildKindTabs(Entity body, string prefix, table tabs, string cur, any onPick)
		local found = false
		for i = 1, #tabs do
			if tabs[i] == cur then found = true end
		end
		if not found then cur = tabs[1] or "기본" end
		-- 둘째 줄(y −50)에 늘 보인다 — 2026-09-25 사용자 "테마·비석마다 기본/프리미엄 탭 — 지금은 기본만". 작은 탭 100×30
		local H = _RtsHudLogic
		for i = 1, #tabs do
			local nm = tabs[i]
			local tab = self:SpawnTab(prefix .. H:Int(i), body, Vector2(27 + (i - 1) * 108, -50), Vector2(100, 30), nm, nm == cur, 14)
			if nm ~= cur then
				local click = H:SpawnClick(prefix .. "Click", tab)
				click:ConnectEvent(ButtonClickEvent, function(event)
					onPick(nm)
				end)
			end
		end
		return cur
	end

	-- 종류 탭 오른쪽 안내 줄 x(종류 탭 수에 따라)
	method number KindInfoX(number tabCount)
		return 27 + tabCount * 108 + 14
	end

	-- 카드 목록(세로 스크롤): body 안 (27, 20) ~ (−27, −86). 격자 스크롤은 설정이 늦게 먹을 때 카드가 100px로 겹쳐(2026-09-25 실측) 증강·도감과 같은 세로 스크롤로.
	--   목록 846×554(창 높이 730) → 줄 830(스크롤 막대 16 뺌) = 카드 270 × 3 + 간격 10 × 2, 한 화면에 2줄(사용자 "정사각형, 가로 3개 2줄, 스크롤")
	@ExecSpace("ClientOnly")
	method Entity SpawnPresetList(Entity body, string name)
		local H = _RtsHudLogic
		local listE = H:SpawnStretch("model://uisprite", name, body, Vector2(0, 0), Vector2(1, 1), Vector2(27, 20), Vector2(-27, -86))
		listE.SpriteGUIRendererComponent.Color = self:Mix(Color.white, 0.02)
		local sg = listE:AddComponent("ScrollLayoutGroupComponent")
		if sg ~= nil then
			sg.Type = LayoutGroupType.Vertical
			sg.ChildAlignment = ChildAlignmentType.UpperLeft
			sg.Spacing = 10
			sg.UseScroll = true
			sg.ScrollBarVisible = ScrollBarVisibility.AlwaysShow
			sg.ScrollBarThickness = 8
			sg.ScrollBarHandleColor = H:ColGold()
			sg.ScrollBarBackgroundColor = Color(1, 1, 1, 0.06)
		end
		return listE
	end

	-- k번째 카드가 들어갈 줄: 3장마다 새 줄(830×270, 투명·클릭 통과)을 만들고, 아니면 row 그대로
	@ExecSpace("ClientOnly")
	method Entity SpawnPresetRow(Entity listE, string prefix, number k, Entity row)
		if (k - 1) % 3 ~= 0 and row ~= nil then return row end
		local H = _RtsHudLogic
		local r = H:SpawnUI("model://uisprite", prefix .. H:Int(math.floor((k - 1) / 3) + 1), listE, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(830, 270))
		r.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		r.SpriteGUIRendererComponent.RaycastTarget = false
		return r
	end

	-- 정사각 카드 270×270(줄 안 x = 0·280·560): 위 가운데 이름 + 오른쪽 위 체크 칸(사용 중 = 금색 + 체크 — 2026-09-25 사용자) + 그림 칸 250×200(돌려줌 — 호출한 쪽이 칠한다).
	--   사용 중 표시는 RefreshPresetMarks가 제자리에서 바꾼다(체크는 늘 만들어 두고 켜고 끔). 누르면 사용 중이 아닐 때만 onPick
	@ExecSpace("ClientOnly")
	method Entity SpawnPresetTile(Entity row, string prefix, number k, string key, string name, any onPick)
		local H = _RtsHudLogic
		local cur = self:PresetIsCurrent(key)
		local border = self:Mix(Color.white, 0.12)
		if cur then border = H:ColGold() end
		local card = H:SpawnRoundedPanel(prefix .. H:Int(k), row, Vector2(0, 1), Vector2(0, 1), Vector2(((k - 1) % 3) * 280, 0), Vector2(270, 270),
			self:Card(), border, 2)
		H:SpawnLabel(prefix .. "Name", card, Vector2(0.5, 1), Vector2(0.5, 1), Vector2(0, -8), Vector2(190, 30),
			name, self:Ink(), 18, TextAlignmentType.MiddleCenter, true)
		local boxBg = Color(0.92, 0.93, 0.98, 0.9)
		if cur then boxBg = H:ColGold() end
		local box = H:SpawnRoundedPanel(prefix .. "Check", card, Vector2(1, 1), Vector2(1, 1), Vector2(-10, -10), Vector2(26, 26), boxBg, H:ColGold(), 1.5)
		local ink = Color(0.12, 0.1, 0.08, 1)
		local ma = self:SpawnSegment(box, prefix .. "CheckA", -7, 0, -2, -5, 3.2, ink)
		local mb = self:SpawnSegment(box, prefix .. "CheckB", -2, -5, 7, 6, 3.2, ink)
		if ma ~= nil then ma:SetEnable(cur) end
		if mb ~= nil then mb:SetEnable(cur) end
		self.PresetCards[#self.PresetCards + 1] = { key = key, card = card, box = box, marks = { ma, mb } }
		local pic = H:SpawnUI("model://uisprite", prefix .. "Pic", card, Vector2(0.5, 1), Vector2(0.5, 1), Vector2(0, -44), Vector2(250, 200))
		local click = H:SpawnClick(prefix .. "Click", card)
		click:ConnectEvent(ButtonClickEvent, function(event)
			if self:PresetIsCurrent(key) then return end
			onPick()
		end)
		return pic
	end

	-- [테마] 탭: 내 구역 바닥·트랙 테마(카드 → themeconfirm → RtsProfileLogic.RequestSetTheme). 보유하지 않은 테마(free 아님)는 흐리게·클릭 없음
	@ExecSpace("ClientOnly")
	method void BuildThemeTab(Entity body, number W)
		local H = _RtsHudLogic
		local T = _RtsThemeLogic
		local P = _RtsProfileLogic
		self.ThemeTab = self:BuildKindTabs(body, "RtsThemeTab", T:GetTabs(), self.ThemeTab, function(nm)
			self.ThemeTab = nm
			self:RefreshProfileContent()
		end)
		local ix = self:KindInfoX(#T:GetTabs())
		H:SpawnLabel("RtsThemeInfo", body, Vector2(0, 1), Vector2(0, 1), Vector2(ix, -52), Vector2(W - 27 - ix, 26),
			"고르면 내 구역의 바닥 · 트랙이 바뀌어요", self:Muted(), 14, TextAlignmentType.MiddleLeft, false)
		local listE = self:SpawnPresetList(body, "RtsThemeList")
		local list = T:GetPresets()
		local k = 0
		local row = nil
		for i = 1, #list do
			local pr = list[i]
			if (pr.tab or "기본") == self.ThemeTab then
				k = k + 1
				row = self:SpawnPresetRow(listE, "RtsThemeRow", k, row)
				local key = pr.key
				local owned = P:PresetOwned(pr, P.MyThemes)
				local pic = self:SpawnPresetTile(row, "RtsThemeCard", k, key, pr.name, function()
					if not owned then return end
					P.PendingTheme = key
					self:Open("themeconfirm")
				end)
				H:PaintThumb(pic, pr)
				if not owned then pic.SpriteGUIRendererComponent.Color = Color(0.2, 0.2, 0.22, 1) end
			end
		end
	end

	-- [비석] 탭(2026-09-25 사용자 "비석도 프리셋 — 지금 비석을 기본, 일단 1개"): 카드 = 비석 그림(원본 비율) · 이름 · 사용 중 → tombconfirm → RequestSetTomb
	@ExecSpace("ClientOnly")
	method void BuildTombTab(Entity body, number W)
		local H = _RtsHudLogic
		local B = _RtsTombLogic
		local P = _RtsProfileLogic
		self.TombTab = self:BuildKindTabs(body, "RtsTombTab", B:GetTabs(), self.TombTab, function(nm)
			self.TombTab = nm
			self:RefreshProfileContent()
		end)
		local ix = self:KindInfoX(#B:GetTabs())
		H:SpawnLabel("RtsTombInfo", body, Vector2(0, 1), Vector2(0, 1), Vector2(ix, -52), Vector2(W - 27 - ix, 26),
			"탈락하면 내 구역 가운데에 이 비석이 서요", self:Muted(), 14, TextAlignmentType.MiddleLeft, false)
		local listE = self:SpawnPresetList(body, "RtsTombList")
		local list = B:GetPresets()
		local k = 0
		local row = nil
		for i = 1, #list do
			local pr = list[i]
			if (pr.tab or "기본") == self.TombTab then
				k = k + 1
				row = self:SpawnPresetRow(listE, "RtsTombRow", k, row)
				local key = pr.key
				local owned = P:PresetOwned(pr, P.MyTombs)
				local pic = self:SpawnPresetTile(row, "RtsTombCard", k, key, pr.name, function()
					if not owned then return end
					P.PendingTomb = key
					self:Open("tombconfirm")
				end)
				-- 그림 칸 250×190 안에 원본 비율로(PreserveSprite AspectOnly는 칸을 넘쳐 이름을 덮었다 — 2026-09-25 실측) → 원본 px(w·h)로 직접 맞춘다
				local k2 = math.min(250 / (pr.w or 148), 200 / (pr.h or 239))
				local pw = (pr.w or 148) * k2
				local ph = (pr.h or 239) * k2
				pic.UITransformComponent.RectSize = Vector2(pw, ph)
				pic.UITransformComponent.anchoredPosition = Vector2(0, -44 - (200 - ph) / 2)
				local r = pic.SpriteGUIRendererComponent
				r.ImageRUID = DataRef(pr.ruid)
				r.Color = Color(1, 1, 1, 1)
				if not owned then r.Color = Color(0.2, 0.2, 0.22, 1) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void BuildTombConfirm(Entity body)
		local P = _RtsProfileLogic
		local pr = _RtsTombLogic:GetPreset(P.PendingTomb)
		self:BuildConfirm(body, "비석을 변경하시겠습니까?\n→ " .. pr.name, "예", function()
			local key = P.PendingTomb
			self:Open("profile")
			P:RequestSetTomb(key)
		end, function()
			self:Open("profile")
		end)
	end

	@ExecSpace("ClientOnly")
	method void BuildThemeConfirm(Entity body)
		local P = _RtsProfileLogic
		local pr = _RtsThemeLogic:GetPreset(P.PendingTheme)
		local msg = "맵 테마를 변경하시겠습니까?\n→ " .. pr.name
		self:BuildConfirm(body, msg, "예", function()
			local key = P.PendingTheme
			self:Open("profile")
			P:RequestSetTheme(key)
		end, function()
			self:Open("profile")
		end)
	end

	-- ===== 아이콘(2026-09-25 사용자): 프로필 창 [아이콘] 탭 — 종류 탭 + 스크롤 격자(8열 — "페이징 말고 스크롤"). 보유 = 원색, 미보유 = 실루엣, 사용 중 = 금색 칸 =====
	--   칸 → 정보(획득 여부 · 획득처 · 확률 · 획득일) → [이 아이콘 사용] → 예/아니오 → RtsProfileLogic.RequestSetIcon → 이 탭으로 돌아옴.
	--   전엔 따로 'icon' 창(유저 카드 [수정]으로 열기)이었다 — 2026-09-25 사용자 "프로필 테마·비석 사이에 아이콘, 여기서 수정 / 목록의 수정 버튼 삭제"
	@ExecSpace("ClientOnly")
	method void BuildIconTab(Entity body, number W)
		local H = _RtsHudLogic
		local P = _RtsProfileLogic
		self.IconTab = self:BuildKindTabs(body, "RtsIconKind", { "기본" }, self.IconTab, function(nm)
			self.IconTab = nm
			self:RefreshProfileContent()
		end)
		local ids = P:IconIds()
		self.IconCells = {}
		local ix = self:KindInfoX(1)
		self.IconHead = H:SpawnLabel("RtsIconHead", body, Vector2(0, 1), Vector2(0, 1), Vector2(ix, -52), Vector2(W - 27 - ix, 26),
			"보유 " .. H:Int(P.MyOwnedCount) .. " / " .. H:Int(#ids) .. "  ·  유저 카드에 보이는 아이콘이에요", self:Muted(), 14, TextAlignmentType.MiddleLeft, false)
		local grid = self:SpawnPresetList(body, "RtsIconList")
		local iconRow = self:SpawnIconGridRow(grid, 0)
		self:SpawnIconNoneCell(iconRow)
		-- 탭은 바로 보이고 칸은 IconBatch개씩 나눠 만든다(위에서부터). 창이 닫히거나 탭이 바뀌면(내용 상자 교체) 멈춘다
		local nextIdx = 1
		local step = nil
		step = function()
			if self.ProfileContent ~= body or grid == nil or not isvalid(grid) then return end
			local last = math.min(#ids, nextIdx + self.IconBatch - 1)
			for i = nextIdx, last do
				if i % 6 == 0 then iconRow = self:SpawnIconGridRow(grid, i) end
				self:SpawnIconCell(iconRow, ids[i], i)
			end
			nextIdx = last + 1
			if nextIdx <= #ids then _TimerService:SetTimerOnce(step, 0.03) end
		end
		step()
	end

	@ExecSpace("ClientOnly")
	method Entity SpawnIconGridRow(Entity list, number index)
		-- 카드 높이 140에 행 사이 여백 10을 더해 이름과 다음 행 썸네일을 분리한다.
		local row = _RtsHudLogic:SpawnUI("model://uisprite", "RtsIconGridRow" .. tostring(index), list, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(818, 150))
		row.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		row.SpriteGUIRendererComponent.RaycastTarget = false
		return row
	end

	-- 아이콘 컬렉션: 공통 둥근 카드·이름·사용 상태. 색만 바꿔 선택을 갱신한다.
	@ExecSpace("ClientOnly")
	method table CreateIconTile(Entity grid, string id, string caption, number index)
		local H = _RtsHudLogic
		local cell = H:SpawnRoundedPanel("RtsIconCell" .. H:Int(index), grid, Vector2(0, 1), Vector2(0, 1), Vector2((index % 6) * 138, 0), Vector2(128, 140),
			Color.white, self:Edge(), 1.5)
		local slot = H:SpawnUI("model://uisprite", "RtsIconPortraitSlot", cell, Vector2(0.5, 1), Vector2(0.5, 0.5), Vector2(0, -66), Vector2(76, 76))
		slot.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		slot.SpriteGUIRendererComponent.RaycastTarget = false
		local face = nil
		if id ~= _RtsProfileLogic.IconNone then
			face = H:SpawnMonsterPortrait(slot, id, 76, false)
		else
			H:SpawnLabel("RtsIconNoneMark", slot, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(70, 50),
				"—", self:Muted(), 28, TextAlignmentType.MiddleCenter, false)
		end
		local label = H:SpawnLabel("RtsIconName", cell, Vector2(0.5, 0), Vector2(0.5, 0), Vector2(0, 8), Vector2(112, 26),
			caption, self:Ink(), 14, TextAlignmentType.MiddleCenter, true)
		local mark = H:SpawnLabel("RtsIconState", cell, Vector2(0.5, 1), Vector2(0.5, 1), Vector2(0, -5), Vector2(112, 20),
			"", self:AccentInk(), 12, TextAlignmentType.MiddleCenter, true)
		local c = { cell = cell, face = face, label = label, mark = mark }
		self.IconCells[id] = c
		self:PaintIconCell(id, c)
		return c
	end

	@ExecSpace("ClientOnly")
	method void PaintIconCell(string id, table c)
		if not isvalid(c.cell) then return end
		local P = _RtsProfileLogic
		local owned = id == P.IconNone or P:IsOwned(id)
		local selected = id == P.MyIcon
		local bg = Color(0.97, 0.975, 0.99, 1)
		local edge = Color(0.87, 0.89, 0.94, 1)
		if owned then bg = Color.white end
		if selected then bg = Color(0.92, 0.91, 0.99, 1); edge = _RtsHudLogic:ColGold() end
		c.cell.SpriteGUIRendererComponent.Color = bg
		c.cell.Parent.SpriteGUIRendererComponent.Color = edge
		c.label.TextComponent.FontColor = self:Muted()
		if owned then c.label.TextComponent.FontColor = self:Ink() end
		c.mark.TextComponent.Text = ""
		if selected then c.mark.TextComponent.Text = "사용 중"
		elseif not owned then c.mark.TextComponent.Text = "미획득" end
		c.mark.TextComponent.FontColor = self:Muted()
		if selected then c.mark.TextComponent.FontColor = self:AccentInk() end
		if isvalid(c.face) then
			if owned then c.face.SpriteGUIRendererComponent.Color = Color.white
			else c.face.SpriteGUIRendererComponent.Color = Color(0.22, 0.25, 0.30, 0.68) end
		end
	end

	@ExecSpace("ClientOnly")
	method void SpawnIconNoneCell(Entity grid)
		local P = _RtsProfileLogic
		local c = self:CreateIconTile(grid, P.IconNone, "선택 안 함", 0)
		local click = _RtsHudLogic:SpawnClick("RtsIconNoneClick", c.cell)
		click:ConnectEvent(ButtonClickEvent, function(event)
			if P.MyIcon == P.IconNone then return end
			P.PendingIcon = P.IconNone
			self:Open("iconconfirm")
		end)
	end

	@ExecSpace("ClientOnly")
	method void SpawnIconCell(Entity grid, string id, number index)
		local P = _RtsProfileLogic
		local mon = _RtsStageTableLogic:GetMonster(id)
		if mon == nil then return end
		local c = self:CreateIconTile(grid, id, mon.name, index)
		local click = _RtsHudLogic:SpawnClick("RtsIconCellClick", c.cell)
		click:ConnectEvent(ButtonClickEvent, function(event)
			P.PendingIcon = id
			self:Open("iconinfo")
		end)
	end

	@ExecSpace("ClientOnly")
	method void RefreshIconCells()
		if self.Kind ~= "profile" or self.ProfileTab ~= "icon" then return end
		local H = _RtsHudLogic
		local P = _RtsProfileLogic
		if isvalid(self.IconHead) then
			self.IconHead.TextComponent.Text = "보유 " .. H:Int(P.MyOwnedCount) .. " / " .. H:Int(#P:IconIds()) .. "  ·  유저 카드에 보이는 아이콘이에요"
		end
		for id, c in pairs(self.IconCells) do self:PaintIconCell(id, c) end
		if isvalid(self._T.ProfileDialog) and self._T.ProfileDialogKind == "iconinfo" then
			self:OpenProfileDialog("iconinfo")
		end
	end

	-- 아이콘 정보: 큰 초상 · 이름 · 상태(사용 중 / 보유 + 획득일 / 미획득) · 획득처 · 확률 · [이 아이콘 사용](보유·미사용) · [목록으로]
	@ExecSpace("ClientOnly")
	method void BuildIconInfo(Entity body, number W)
		local H = _RtsHudLogic
		local P = _RtsProfileLogic
		local id = P.PendingIcon
		local mon = _RtsStageTableLogic:GetMonster(id)
		if mon == nil then return end
		local slot = H:SpawnUI("model://uisprite", "RtsIconInfoSlot", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -10), Vector2(140, 140))
		slot.SpriteGUIRendererComponent.Color = Color(0.94, 0.94, 0.99, 1)
		slot.SpriteGUIRendererComponent.ImageRUID = DataRef(H.RoundedPanelRUID)
		slot.SpriteGUIRendererComponent.Type = ImageType.Sliced
		if slot.MaskComponent == nil then slot:AddComponent("MaskComponent") end
		local owned = P:IsOwned(id)
		local face = H:SpawnMonsterPortrait(slot, id, 128, owned)
		if face ~= nil and not owned then face.SpriteGUIRendererComponent.Color = Color(0.05, 0.05, 0.06, 0.8) end
		local tx = 187
		local tw = W - tx - 27
		H:SpawnLabel("RtsIconInfoName", body, Vector2(0, 1), Vector2(0, 1), Vector2(tx, -10), Vector2(tw, 34),
			mon.name, self:Ink(), 22, TextAlignmentType.MiddleLeft, true)
		local state = "미획득"
		local stateCol = self:Muted()
		if id == P.MyIcon then
			state = "사용 중"
			stateCol = self:AccentInk()
		elseif owned then
			state = "보유"
			stateCol = Color(0.55, 0.85, 0.55, 1)
		end
		local date = P:OwnedDate(id)
		if owned and date ~= "" then state = state .. "   ·   획득일 " .. date end
		H:SpawnLabel("RtsIconInfoState", body, Vector2(0, 1), Vector2(0, 1), Vector2(tx, -48), Vector2(tw, 28),
			state, stateCol, 17, TextAlignmentType.MiddleLeft, true)
		H:SpawnLabel("RtsIconInfoWhere", body, Vector2(0, 1), Vector2(0, 1), Vector2(tx, -84), Vector2(tw, 26),
			"획득처: " .. P:WhereText(id), self:Ink(), 15, TextAlignmentType.MiddleLeft, false)
		H:SpawnLabel("RtsIconInfoRate", body, Vector2(0, 1), Vector2(0, 1), Vector2(tx, -114), Vector2(tw, 26),
			"처치 시 확률: " .. P:IconDropText(true), self:Ink(), 15, TextAlignmentType.MiddleLeft, false)
		local bw = 200
		local bh = 44
		if owned and id ~= P.MyIcon then
			local use = H:SpawnRoundedPanel("RtsIconUse", body, Vector2(0.5, 0), Vector2(1, 0), Vector2(-10, 24), Vector2(bw, bh),
				self:Mix(H:ColGold(), 0.25), H:ColGold(), 1.5)
			H:SpawnLabel("RtsIconUseText", use, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(bw - 8, bh - 6),
				"이 아이콘 사용", self:Ink(), 17, TextAlignmentType.MiddleCenter, true)
			local uc = H:SpawnClick("RtsIconUseClick", use)
			uc:ConnectEvent(ButtonClickEvent, function(event)
				self:Open("iconconfirm")
			end)
		end
		local back = self:SpawnTab("RtsIconBack", body, Vector2(0, 0), Vector2(bw, bh), "목록으로", false, 17)
		local bt = back.Parent.UITransformComponent
		bt.AnchorsMin = Vector2(0.5, 0)
		bt.AnchorsMax = Vector2(0.5, 0)
		bt.Pivot = Vector2(0, 0)
		bt.anchoredPosition = Vector2(10, 24)
		if not (owned and id ~= P.MyIcon) then
			bt.Pivot = Vector2(0.5, 0)
			bt.anchoredPosition = Vector2(0, 24)
		end
		local bc = H:SpawnClick("RtsIconBackClick", back)
		bc:ConnectEvent(ButtonClickEvent, function(event)
			self:OpenProfileTab("icon")
		end)
	end

	@ExecSpace("ClientOnly")
	method void BuildIconConfirm(Entity body)
		local P = _RtsProfileLogic
		local mon = _RtsStageTableLogic:GetMonster(P.PendingIcon)
		local nm = P.PendingIcon
		if mon ~= nil then nm = mon.name end
		local none = P.PendingIcon == P.IconNone
		local msg = "아이콘을 변경하시겠습니까?\n→ " .. nm
		if none then msg = "아이콘을 없음으로 변경하시겠습니까?" end
		-- 예 → 프로필 [아이콘] 탭으로 돌아가 바로 요청(테마·비석 확인과 같은 흐름 — 사용 중 칸은 SendProfileState가 제자리에서 바꾼다)
		self:BuildConfirm(body, msg, "예", function()
			local id = P.PendingIcon
			self:OpenProfileTab("icon")
			P:RequestSetIcon(id)
		end, function()
			if none then self:OpenProfileTab("icon") else self:Open("iconinfo") end
		end)
	end

	-- 획득 팝업(RtsProfileLogic.ShowIconGot → FlushGot): 초상 · 이름 · 획득처 · 획득일 · [확인]
	@ExecSpace("ClientOnly")
	method void BuildIconGot(Entity body, number W)
		local H = _RtsHudLogic
		local P = _RtsProfileLogic
		local id = P.GotIcon
		local mon = _RtsStageTableLogic:GetMonster(id)
		if mon == nil then return end
		H:PlayUi(self.PickSound)
		local slot = H:SpawnUI("model://uisprite", "RtsIconGotSlot", body, Vector2(0.5, 1), Vector2(0.5, 1), Vector2(0, -6), Vector2(140, 140))
		slot.SpriteGUIRendererComponent.Color = self:Mix(H:ColGold(), 0.22)
		if slot.MaskComponent == nil then slot:AddComponent("MaskComponent") end
		H:SpawnMonsterPortrait(slot, id, 128, true)
		H:SpawnLabel("RtsIconGotName", body, Vector2(0.5, 1), Vector2(0.5, 1), Vector2(0, -154), Vector2(W - 54, 34),
			mon.name .. " 아이콘을 얻었어요!", self:AccentInk(), 22, TextAlignmentType.MiddleCenter, true)
		local line = "획득처: " .. P:WhereText(id)
		local date = P:OwnedDate(id)
		if date ~= "" then line = line .. "   ·   획득일 " .. date end
		H:SpawnLabel("RtsIconGotWhere", body, Vector2(0.5, 1), Vector2(0.5, 1), Vector2(0, -192), Vector2(W - 54, 26),
			line, self:Ink(), 15, TextAlignmentType.MiddleCenter, false)
		local bw = 200
		local bh = 44
		local ok = H:SpawnRoundedPanel("RtsIconGotOk", body, Vector2(0.5, 0), Vector2(0.5, 0), Vector2(0, 22), Vector2(bw, bh),
			self:Mix(H:ColGold(), 0.25), H:ColGold(), 1.5)
		H:SpawnLabel("RtsIconGotOkText", ok, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(bw - 8, bh - 6),
			"확인", self:Ink(), 17, TextAlignmentType.MiddleCenter, true)
		local oc = H:SpawnClick("RtsIconGotOkClick", ok)
		oc:ConnectEvent(ButtonClickEvent, function(event)
			self:Close()
		end)
	end

	-- ===== 순위(2026-09-24 사용자 "어려움/매우어려움/극악을 따로따로 분리해서 클리어 횟수 순위로"): 탭 = 난이도, 행 = 순위 · 닉네임 · 클리어 횟수, 아래 = 내 순위 =====
	--   서버 RtsRunResultLogic.RequestRanking → ShowRanking → SetRanking(RankCache[난이도]). 20초 안에 받은 목록은 다시 묻지 않는다
	@ExecSpace("ClientOnly")
	method void BuildRank(Entity body, number W)
		local H = _RtsHudLogic
		local names = _RtsDifficultyLogic:GetNames()
		local minD = _RtsRunResultLogic.RankMinDiff
		if self.RankDiff < minD or self.RankDiff > #names then self.RankDiff = minD end
		for d = minD, #names do
			local dd = d
			local tab = self:SpawnTab("RtsRankTab" .. H:Int(d), body, Vector2(27 + (d - minD) * 138, -10), Vector2(130, 34),
				names[d], self.RankDiff == d, 16)
			if self.RankDiff ~= d then
				local click = H:SpawnClick("RtsRankTabClick", tab)
				click:ConnectEvent(ButtonClickEvent, function(event)
					self.RankDiff = dd
					self:Open("rank")
				end)
			end
		end
		H:SpawnLabel("RtsRankInfo", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -52), Vector2(W - 54, 26),
			"그 난이도에서 검은 마법사 4페이즈를 깬 횟수 순 · 같으면 먼저 달성한 사람이 위", self:Muted(), 14, TextAlignmentType.MiddleLeft, false)
		local c = self.RankCache[self.RankDiff]
		if c == nil or _UtilLogic.ElapsedSeconds - c.at > 20 then _RtsRunResultLogic:RequestRanking(self.RankDiff) end
		if c == nil then
			H:SpawnLabel("RtsRankWait", body, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(W - 54, 40),
				"불러오는 중…", self:Muted(), 18, TextAlignmentType.MiddleCenter, false)
			return
		end
		-- 아래: 내 순위
		local my = "내 기록: 아직 없음 — 이 난이도에서 검은 마법사를 깨면 올라가요"
		if c.myCount > 0 then
			local rk = H:Int(c.myRank) .. "위"
			if c.myMore then rk = H:Int(c.myRank - 1) .. "위 밖" end
			my = "내 순위 " .. rk .. "   ·   클리어 " .. H:Int(c.myCount) .. "회"
		end
		local mine = H:SpawnRoundedPanel("RtsRankMine", body, Vector2(0, 0), Vector2(0, 0), Vector2(27, 22), Vector2(W - 54, 46),
			self:Mix(H:ColGold(), 0.14), self:Mix(H:ColGold(), 0.6), 1.5)
		H:SpawnLabel("RtsRankMineText", mine, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(W - 80, 40),
			my, self:AccentInk(), 17, TextAlignmentType.MiddleCenter, true)
		-- 목록
		local listW = W - 54
		local list = H:SpawnStretch("model://uisprite", "RtsRankList", body, Vector2(0, 0), Vector2(1, 1), Vector2(27, 80), Vector2(-27, -86))
		list.SpriteGUIRendererComponent.Color = self:Mix(Color.white, 0.02)
		local rows = {}
		for line in string.gmatch(c.rows, "[^\n]+") do
			local nick, cnt = string.match(line, "^(.-)\t(%d+)$")
			if nick ~= nil then rows[#rows + 1] = { nick = nick, cnt = tonumber(cnt) } end
		end
		if #rows == 0 then
			H:SpawnLabel("RtsRankEmpty", list, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(listW - 20, 40),
				"아직 기록이 없어요 — 첫 클리어의 주인공이 되어 보세요", self:Muted(), 17, TextAlignmentType.MiddleCenter, false)
			return
		end
		local sg = list:AddComponent("ScrollLayoutGroupComponent")
		if sg ~= nil then
			sg.Type = LayoutGroupType.Vertical
			sg.ChildAlignment = ChildAlignmentType.UpperLeft
			sg.Spacing = 4
			sg.UseScroll = true
			sg.ScrollBarVisible = ScrollBarVisibility.AlwaysShow
			sg.ScrollBarThickness = 8
			sg.ScrollBarHandleColor = H:ColGold()
			sg.ScrollBarBackgroundColor = Color(1, 1, 1, 0.06)
		end
		for i = 1, #rows do
			local top = i <= 3
			local ink = self:Ink()
			if top then ink = self:AccentInk() end
			local row = H:SpawnRoundedPanel("RtsRankRow" .. tostring(i), list, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(listW - 16, 44),
				self:Card(), self:Edge(), 1.5)
			H:SpawnLabel("RtsRankNo", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(14, 0), Vector2(70, 32),
				H:Int(i) .. "위", ink, 17, TextAlignmentType.MiddleLeft, true)
			H:SpawnLabel("RtsRankNick", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(96, 0), Vector2(listW - 280, 32),
				rows[i].nick, self:Ink(), 17, TextAlignmentType.MiddleLeft, top)
			H:SpawnLabel("RtsRankCnt", row, Vector2(1, 0.5), Vector2(1, 0.5), Vector2(-16, 0), Vector2(150, 32),
				H:Int(rows[i].cnt) .. "회", ink, 17, TextAlignmentType.MiddleRight, true)
		end
	end

	-- ===== 테스트 프리즘(개발모드, 2026-09-22 사용자 "우측 하단에 테스트 프리즘 증강 버튼 … 거기서 선택"): 프리즘 12종을 직업별로 나열, 누르면 그 직업인 내 유닛에 적용 =====

	@ExecSpace("ClientOnly")
	method void BuildDevPrism(Entity body)
		local H = _RtsHudLogic
		local T = _RtsJobTableLogic
		-- 내 유닛을 직업별로 모아 둔다(프리즘 적용 여부 표시·유닛 없음 표시)
		local mine = {}
		local nos = _RtsUnitLogic:ListZoneUnits(_RtsUnitLogic:MyZone())
		for i = 1, #nos do
			local u = _RtsUnitLogic:GetMyUnit(nos[i])
			if u ~= nil then
				if mine[u.JobId] == nil then mine[u.JobId] = {} end
				mine[u.JobId][#mine[u.JobId] + 1] = u
			end
		end
		H:SpawnLabel("RtsDpSub", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -4), Vector2(1050, 24),
			"누르면 그 직업인 내 유닛 전부에 적용(영구 잠금 포함), 적용된 걸 다시 누르면 해제. 연출 자산이 아직 없는 프리즘은 기존 스킬 연출을 그대로 쓴다", self:Muted(), 14, TextAlignmentType.MiddleLeft, false)
		local prisms = T:GetPrisms()
		local colW = 520
		local n = 0
		for i = 1, #prisms do
			local pz = prisms[i]
			if pz.job ~= "" then
				n = n + 1
				local col = (n - 1) % 2
				local row = math.floor((n - 1) / 2)
				local x = 27 + col * (colW + 20)
				local y = -40 - row * 104
				local units = mine[pz.job]
				local has = false
				local hasUnit = units ~= nil and #units > 0
				if hasUnit then
					has = true
					for k = 1, #units do
						if not T:HasPrism(units[k], pz.id) then has = false end
					end
				end
				local txt = "[" .. T:GetJobName(pz.job) .. "] " .. pz.name
				if has then txt = txt .. "   ✓ 적용됨 (누르면 해제)" elseif not hasUnit then txt = txt .. "   (유닛 없음 — 영입에서)" end
				local tab = self:SpawnTab("RtsDp" .. pz.id, body, Vector2(x, y), Vector2(colW, 40), txt, has, 15)
				if not hasUnit then tab.SpriteGUIRendererComponent.Color = self:Mix(Color.white, 0.02) end
				H:SpawnLabel("RtsDpD" .. pz.id, body, Vector2(0, 1), Vector2(0, 1), Vector2(x + 4, y - 44), Vector2(colW - 8, 52),
					pz.desc, self:Ink(), 12, TextAlignmentType.UpperLeft, false)
				if hasUnit then
					local pid = pz.id
					local click = H:SpawnClick("RtsDpClick", tab)
					click:ConnectEvent(ButtonClickEvent, function(event)
						_RtsUnitLogic:RequestDevPrism(pid)
						self:Close()
					end)
				end
			end
		end
		-- 하단: 유닛 전부 삭제(직업 바꿔 다시 영입하려고)
		local clr = self:SpawnTab("RtsDpClear", body, Vector2(27, -40 - math.ceil(n / 2) * 104), Vector2(220, 38), "내 유닛 전부 삭제", false, 15)
		clr.Parent.SpriteGUIRendererComponent.Color = Color(0.8, 0.35, 0.3, 1)
		local cclick = H:SpawnClick("RtsDpClearClick", clr)
		cclick:ConnectEvent(ButtonClickEvent, function(event)
			_RtsUnitLogic:RequestDevClear()
			self:Close()
		end)
		H:SpawnLabel("RtsDpFoot", body, Vector2(1, 0), Vector2(1, 0), Vector2(-27, 4), Vector2(700, 22),
			"개발용 — 팬텀은 영입 팝업 '영웅' 탭에서 영입. RtsUnitLogic.DevTools가 꺼지면 이 버튼은 사라진다", self:Muted(), 13, TextAlignmentType.MiddleRight, false)
	end

	-- ===== 방출 확인: 대상 한 줄 + 안내 문구(사용자 지정 텍스트) + [방출][취소] =====

	@ExecSpace("ClientOnly")
	method void BuildDismiss(Entity body)
		local H = _RtsHudLogic
		local T = _RtsJobTableLogic
		local no = self.DismissNo
		local u = _RtsUnitLogic:GetMyUnit(no)
		if u == nil then
			self:Close()
			return
		end
		local refund = _RtsUnitLogic:DismissRefund(u)
		local pct = math.floor(_RtsUnitLogic.DismissRefundRate * 100 + 0.5)
		-- 대상: "Lv.50 나이트로드 · 환급 3,000 메소"
		H:SpawnLabel("RtsDmWho", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -6), Vector2(586, 26),
			"Lv." .. string.format("%d", u.Level) .. " " .. T:GetJobNameFor(u) .. "   ·   환급 " .. H:FormatNumber(refund) .. " 메소", self:Muted(), 15, TextAlignmentType.MiddleLeft, false)
		-- 안내 문구 (사용자 지정, 2026-09-22)
		H:SpawnLabel("RtsDmMsg", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -44), Vector2(586, 90),
			"적용된 증강은 모두 소멸하며, 사용된 메소의 " .. pct .. "%만 돌려받습니다." .. "\n" .. "정말 방출하시겠습니까?", self:Ink(), 19, TextAlignmentType.MiddleCenter, true)
		-- 버튼: 방출(붉은 테두리) / 취소
		local bw = 180
		local bh = 44
		local by = -150
		local yes = H:SpawnRoundedPanel("RtsDmYes", body, Vector2(0.5, 1), Vector2(1, 1), Vector2(-10, by), Vector2(bw, bh),
			self:Mix(Color(0.8, 0.35, 0.3, 1), 0.25), Color(0.8, 0.35, 0.3, 1), 1.5)
		H:SpawnLabel("RtsDmYesText", yes, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(bw - 8, bh - 6),
			"방출", Color(0.62, 0.19, 0.15, 1), 17, TextAlignmentType.MiddleCenter, true)
		local yc = H:SpawnClick("RtsDmYesClick", yes)
		yc:ConnectEvent(ButtonClickEvent, function(event)
			local target = self.DismissNo
			self:Close()
			if target > 0 then _RtsUnitLogic:RequestDismiss(target) end
		end)
		local cancel = self:SpawnTab("RtsDmNo", body, Vector2(0, 0), Vector2(bw, bh), "취소", false, 17)
		local nt = cancel.Parent.UITransformComponent
		nt.AnchorsMin = Vector2(0.5, 1)
		nt.AnchorsMax = Vector2(0.5, 1)
		nt.Pivot = Vector2(0, 1)
		nt.anchoredPosition = Vector2(10, by)
		local nc = H:SpawnClick("RtsDmNoClick", cancel)
		nc:ConnectEvent(ButtonClickEvent, function(event)
			self:Close()
		end)
	end

	-- ===== 증강 창(2026-09-23 Phase 4 합류): 등급 탭 5 + 보유 목록(왼쪽, 스크롤) + 상세·대상 지정(오른쪽) =====
	--   보유 = RtsAugmentLogic.MyOwned(). 미지정 증강은 오른쪽에서 내 유닛 칩을 골라 [n번 유닛에 지정](1회, 변경 불가). 직업 프리즘은 그 직업 유닛만, 특수 코어는 같은 코어가 없는 유닛만(방어구 부수기는 겹쳐 붙일 수 있음)
	@ExecSpace("ClientOnly")
	method void BuildAugment(Entity body)
		-- 모든 등급을 한 목록에 표시하고 필터는 기존 행만 켜고 끈다.
		self.AugBody = body
		self.AugBar = nil
		self.AugContent = nil
		self.AugDetail = nil
		self:RefreshAugment()
	end

	-- 증강 창 내용(목록·상세·아래 줄) — 보유가 바뀌었거나 탭·숨기기가 바뀌면. 탭은 글자(개수)·켜짐만 제자리에서
	@ExecSpace("ClientOnly")
	method void BuildAugContent(Entity box, table owned)
		local H = _RtsHudLogic
		local A = _RtsAugmentLogic
		local AT = _RtsAugmentTableLogic
		-- 왼쪽 목록(선택 등급만). 행 = 등급 띠·배지·이름·지정 상태
		local listW = 440
		local top = -70
		local rows = {}
		self.AugRowRefs = {}
		for i = 1, #owned do
			local d = AT:GetDef(owned[i].id)
			if d ~= nil then rows[#rows + 1] = { k = i, id = owned[i].id, no = owned[i].no, d = d } end
		end
		-- 숨긴 증강이 선택돼 있으면 선택 풀기(아래에서 첫 미지정으로)
		if self.AugSel > 0 then
			local vis = false
			for i = 1, #rows do
				if rows[i].k == self.AugSel then vis = true end
			end
			if not vis then self.AugSel = 0 end
		end
		-- 미지정(no = 0) 증강을 항상 위로(2026-09-23 사용자), 같은 묶음 안은 받은 순서
		table.sort(rows, function(a, b)
			local an = a.no == 0
			local bn = b.no == 0
			if an ~= bn then return an end
			return a.k < b.k
		end)
		if self.AugSel > #owned then self.AugSel = 0 end
		if self.AugSel == 0 and #rows > 0 then
			-- 기본 선택 = 첫 미지정(없으면 첫 행)
			self.AugSel = rows[1].k
			for i = 1, #rows do
				if rows[i].no == 0 then
					self.AugSel = rows[i].k
					break
				end
			end
		end
		local list = H:SpawnStretch("model://uisprite", "RtsAugList", box, Vector2(0, 0), Vector2(0, 1), Vector2(27, 27), Vector2(27 + listW, top))
		list.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		self._T.AugList = list
		self._T.AugEmpty = H:SpawnLabel("RtsAugFilteredEmpty", box, Vector2(0, 1), Vector2(0, 1), Vector2(47, -230), Vector2(390, 110), "미지정 증강이 없어요\n숨기기를 해제하면 적용된 증강을 볼 수 있어요", self:Muted(), 17, TextAlignmentType.MiddleCenter, false)
		if #rows == 0 then
			local emptyText = "아직 얻은 증강이 없어요 — 지급 라운드가 시작되면 3개 중 1개를 고릅니다"
			if #owned > 0 and self.AugHideAssigned then emptyText = "미지정 증강이 없어요 — 적용된 증강은 숨겨져 있어요(위의 숨기기 체크 해제)" end
			H:SpawnLabel("RtsAugEmpty", list, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(listW - 32, 100),
				emptyText, self:Muted(), 16, TextAlignmentType.MiddleCenter, false)
		else
			local sg = list:AddComponent("ScrollLayoutGroupComponent")
			if sg ~= nil then
				sg.Type = LayoutGroupType.Vertical
				sg.ChildAlignment = ChildAlignmentType.UpperLeft
				sg.Spacing = 6
				sg.UseScroll = #rows > 8
				sg.ScrollBarVisible = ScrollBarVisibility.AlwaysShow
				sg.ScrollBarThickness = 8
				sg.ScrollBarHandleColor = H:ColGold()
				sg.ScrollBarBackgroundColor = Color(1, 1, 1, 0.06)
			end
			for i = 1, #rows do
				local r = rows[i]
				local on = r.k == self.AugSel
				local bg = self:Card()
				local border = self:Edge()
				-- 미지정은 작은 배지로, 현재 선택은 금색 테두리로 구분한다.
				local unassigned = r.no == 0
				if unassigned then
					bg = self:Card()
					border = self:Edge()
				end
				if on then
					bg = self:Mix(H:ColGold(), 0.14)
					border = H:ColGold()
				end
				local row = H:SpawnRoundedPanel("RtsAugRow" .. tostring(i), list, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(listW - 16, 86), bg, border, 1.5)
				local band = H:SpawnStretch("model://uisprite", "RtsAugRowBand", row, Vector2(0, 0), Vector2(0, 1), Vector2(0, 0), Vector2(4, 0))
				band.SpriteGUIRendererComponent.Color = self:GradeColor(r.d.grade)
				self:SpawnAugIcon(row, r.d, Vector2(10, -11), 64)
				H:SpawnLabel("RtsAugRowName", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(86, 0), Vector2(listW - 214, 48),
					r.d.name, self:Ink(), 18, TextAlignmentType.MiddleLeft, true)
				if unassigned then
					local pill = H:SpawnRoundedPanel("RtsAugRowNew", row, Vector2(1, 0.5), Vector2(1, 0.5), Vector2(-12, 0), Vector2(86, 26),
						Color(0.78, 0.25, 0.22, 1), Color(1, 0.62, 0.55, 1), 1.5)
					H:SpawnLabel("RtsAugRowNewText", pill, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(80, 26),
						"미지정", Color(1, 0.97, 0.94, 1), 14, TextAlignmentType.MiddleCenter, true)
				else
					H:SpawnLabel("RtsAugRowState", row, Vector2(1, 0.5), Vector2(1, 0.5), Vector2(-12, 0), Vector2(96, 54),
						self:AugStateText(r.no), self:Muted(), 13, TextAlignmentType.MiddleRight, false)
				end
				local kk = r.k
				self.AugRowRefs[#self.AugRowRefs + 1] = { k = kk, row = row, un = unassigned }
				local click = H:SpawnClick("RtsAugRowClick", row)
				click:ConnectEvent(ButtonClickEvent, function(event)
					if self.AugSel == kk then return end
					self.AugSel = kk
					self.AugPickNo = 0
					self:RestyleAugRows()
					self:RefreshAugDetail()
				end)
			end
		end

		self:BuildAugDetail(box, owned)

		-- 우측 하단: [v] 적용된 증강 숨기기(기본 체크) — 누르면 켜고 끄기
		local cb = H:SpawnUI("model://uisprite", "RtsAugHideBox", box, Vector2(1, 1), Vector2(1, 1), Vector2(-27, -20), Vector2(210, 28))
		cb.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		local sq = H:SpawnRoundedPanel("RtsAugHideSq", cb, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(0, 0), Vector2(20, 20), Color(0.92, 0.93, 0.98, 0.9), H:ColGold(), 1.5)
		do
			local mark = H:SpawnUI("model://uisprite", "RtsAugHideMark", sq, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(10, 10))
			mark.SpriteGUIRendererComponent.Color = H:ColGold()
			self._T.AugHideMark = mark
		end
		H:SpawnLabel("RtsAugHideText", cb, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(28, 0), Vector2(182, 28), "적용된 증강 숨기기", self:Ink(), 16, TextAlignmentType.MiddleLeft, false)
		local cbClick = H:SpawnClick("RtsAugHideClick", cb)
		cbClick:ConnectEvent(ButtonClickEvent, function(event)
			self.AugHideAssigned = not self.AugHideAssigned
			self:ApplyAugFilter()
		end)
		H:SpawnLabel("RtsAugSummary", box, Vector2(0, 1), Vector2(0, 1), Vector2(27, -17), Vector2(620, 34), "보유 증강 " .. H:Int(#owned) .. "개 · 미지정 " .. H:Int(A:MyUnassigned()) .. "개", self:Ink(), 21, TextAlignmentType.MiddleLeft, true)
		H:SpawnLabel("RtsAugFoot", box, Vector2(1, 0), Vector2(1, 0), Vector2(-27, 4), Vector2(1020, 22),
			"전체 " .. H:Int(#owned) .. "개 · 미지정 " .. H:Int(A:MyUnassigned()) .. "개 · 방출하면 그 유닛의 증강은 사라져요", self:Ink(), 14, TextAlignmentType.MiddleRight, false)
	end

	-- 증강 창 오른쪽 상세(선택·유닛 칩이 바뀌면 이것만 다시 — RefreshAugDetail)
	@ExecSpace("ClientOnly")
	method void BuildAugDetail(Entity parent, table owned)
		local H = _RtsHudLogic
		local A = _RtsAugmentLogic
		local AT = _RtsAugmentTableLogic
		local listW = 440
		local top = -70
		-- 오른쪽 상세 + 대상 지정
		local dx = 27 + listW + 23
		local dw = self.PanelW - dx - 27
		local detail = H:SpawnRoundedPanel("RtsAugDetail", parent, Vector2(0, 1), Vector2(0, 1), Vector2(dx, top), Vector2(dw, 880 - 70 - 70 - 40),
			self:Card(), self:Mix(H:ColGold(), 0.25), 1.5)
		self.AugDetail = detail.Parent
		local item = owned[self.AugSel]
		if item == nil then
			H:SpawnLabel("RtsAugDetailNone", detail, Vector2(0, 1), Vector2(0, 1), Vector2(19, -20), Vector2(dw - 40, 60),
				"증강을 고르면 여기에 효과와 대상 지정이 보여요", self:Muted(), 15, TextAlignmentType.UpperLeft, false)
		else
			local d = AT:GetDef(item.id)
			self:SpawnAugIcon(detail, d, Vector2(19, -16), 72)
			H:SpawnLabel("RtsAugDetailGrade", detail, Vector2(0, 1), Vector2(0, 1), Vector2(108, -56), Vector2(dw - 128, 24), self:GradeName(d.grade), self:Muted(), 16, TextAlignmentType.MiddleLeft, false)
			H:SpawnLabel("RtsAugDetailT", detail, Vector2(0, 1), Vector2(0, 1), Vector2(108, -18), Vector2(dw - 128, 32),
				d.name, self:Ink(), 23, TextAlignmentType.MiddleLeft, true)
			H:SpawnLabel("RtsAugDetailD", detail, Vector2(0, 1), Vector2(0, 1), Vector2(19, -112), Vector2(dw - 40, 156),
				AT:EffectText(d.id), self:Ink(), 18, TextAlignmentType.UpperLeft, false)
			H:SpawnLabel("RtsAugDetailK", detail, Vector2(0, 1), Vector2(0, 1), Vector2(19, -284), Vector2(dw - 40, 22),
				"적용 유닛", self:Muted(), 13, TextAlignmentType.MiddleLeft, false)
			if item.no ~= 0 then
				H:SpawnLabel("RtsAugDetailU", detail, Vector2(0, 1), Vector2(0, 1), Vector2(19, -312), Vector2(dw - 40, 28),
					self:AugStateText(item.no), self:Ink(), 17, TextAlignmentType.MiddleLeft, true)
			else
				H:SpawnLabel("RtsAugDetailHint", detail, Vector2(0, 1), Vector2(0, 1), Vector2(19, -312), Vector2(dw - 40, 44),
					"미지정 — 유닛을 고르고 지정(한 번 지정하면 바꿀 수 없어요)", Color(0.66, 0.26, 0.20, 1), 16, TextAlignmentType.MiddleLeft, false)
				-- 내 유닛 칩(2열). 지정 불가 유닛은 흐리게
				local nos = _RtsUnitLogic:ListZoneUnits(_RtsUnitLogic:MyZone())
				local chipW = math.floor((dw - 38 - 10) / 2)
				for i = 1, #nos do
					local no = nos[i]
					local u = _RtsUnitLogic:GetMyUnit(no)
					if u ~= nil then
						local ok = A:CanAssignTo(item.id, u)
						local col = (i - 1) % 2
						local rowi = math.floor((i - 1) / 2)
						local cbg = self:Mix(Color.white, 0.65)
						local cborder = self:Mix(H:ColGold(), 0.3)
						local ink = self:Ink()
						if self.AugPickNo == no then
							cbg = self:Mix(H:ColGold(), 0.2)
							cborder = H:ColGold()
						end
						if not ok then
							cborder = self:Edge()
							ink = Color(0.5, 0.47, 0.42, 1)
						end
						local chip = H:SpawnRoundedPanel("RtsAugChip" .. tostring(i), detail, Vector2(0, 1), Vector2(0, 1),
							Vector2(19 + col * (chipW + 10), -366 - rowi * 76), Vector2(chipW, 64), cbg, cborder, 1.5)
						local bar = H:SpawnStretch("model://uisprite", "RtsAugChipBar", chip, Vector2(0, 0), Vector2(0, 1), Vector2(0, 0), Vector2(4, 0))
						bar.SpriteGUIRendererComponent.Color = H:SeriesColor(_RtsJobTableLogic:GetSeries(u.JobId))
						H:SpawnLabel("RtsAugChipText", chip, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(12, 0), Vector2(chipW - 94, 30),
							_RtsJobTableLogic:GetJobNameFor(u), ink, 16, TextAlignmentType.MiddleLeft, true)
						H:SpawnLabel("RtsAugChipLevel", chip, Vector2(1, 0.5), Vector2(1, 0.5), Vector2(-12, 0), Vector2(62, 30),
							"Lv. " .. H:Int(u.Level), ink, 16, TextAlignmentType.MiddleRight, true)
						if ok then
							local pickNo = no
							local c = H:SpawnClick("RtsAugChipClick", chip)
							c:ConnectEvent(ButtonClickEvent, function(event)
								self.AugPickNo = pickNo
								self:RefreshAugDetail()
							end)
						end
					end
				end
				-- 지정 버튼(유닛을 골랐을 때만)
				local canGo = self.AugPickNo > 0
				local bbg = self:Card()
				local bborder = self:Mix(H:ColGold(), 0.3)
				local bink = Color(0.6, 0.55, 0.45, 1)
				if canGo then
					bbg = self:Mix(H:ColGold(), 0.9)
					bborder = H:ColGold()
					bink = Color(0.133, 0.114, 0.09, 1)
				end
				local go = H:SpawnRoundedPanel("RtsAugAssign", detail, Vector2(0, 0), Vector2(0, 0), Vector2(19, 19), Vector2(dw - 38, 52), bbg, bborder, 1.5)
				-- 버튼 글자 = 직업명(2026-09-23 사용자 "n번 유닛이 아니라 '신궁에게 지정'") + [Space] — 스페이스로도 지정(RtsUnitSelectLogic.HandleKeyDownEvent → AssignPicked)
				local goText = "유닛을 골라 주세요"
				if canGo then
					local pu = _RtsUnitLogic:GetMyUnit(self.AugPickNo)
					if pu ~= nil then goText = _RtsJobTableLogic:GetJobNameFor(pu) .. "에게 지정" else goText = "지정" end
				end
				H:SpawnLabel("RtsAugAssignText", go, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(dw - 50, 40),
					goText, bink, 17, TextAlignmentType.MiddleCenter, true)
				if canGo then
					_RtsUnitSelectLogic:SpawnKeyCap(go, "Space")
					local gc = H:SpawnClick("RtsAugAssignClick", go)
					gc:ConnectEvent(ButtonClickEvent, function(event)
						self:AssignPicked()
					end)
				end
			end
		end

	end

	-- 행 선택 표시만 제자리에서(미지정 = 붉은 테두리 · 선택 = 금색)
	@ExecSpace("ClientOnly")
	method void RestyleAugRows()
		local H = _RtsHudLogic
		for i = 1, #self.AugRowRefs do
			local r = self.AugRowRefs[i]
			if r.row ~= nil and isvalid(r.row) then
				local bg = self:Card()
				local border = self:Edge()
				if r.un then
					bg = self:Card()
					border = self:Edge()
				end
				if r.k == self.AugSel then
					bg = self:Mix(H:ColGold(), 0.14)
					border = H:ColGold()
				end
				r.row.SpriteGUIRendererComponent.Color = bg
				if r.row.Parent ~= nil then r.row.Parent.SpriteGUIRendererComponent.Color = border end
			end
		end
	end

	-- 오른쪽 상세만 다시
	@ExecSpace("ClientOnly")
	method void RefreshAugDetail()
		if self.Kind ~= "augment" or self.AugContent == nil or not isvalid(self.AugContent) then return end
		local old = self.AugDetail
		self:BuildAugDetail(self.AugContent, _RtsAugmentLogic:MyOwned())
		self:SwapContent(old, self.AugDetail)
	end

	-- 증강 창에서 고른 보유 증강(AugSel)을 고른 유닛(AugPickNo)에 지정 — 버튼·스페이스 공용
	@ExecSpace("ClientOnly")
	method void AssignPicked()
		if self.Kind ~= "augment" or self.AugSel == 0 or self.AugPickNo == 0 then return end
		local k = self.AugSel
		local target = self.AugPickNo
		self.AugPickNo = 0
		_RtsAugmentLogic:RequestAssign(k, target)
	end

	-- 지정 상태 글자: 0 미지정 / -1 해금됨(팬텀) / n "→ 3. 히어로"
	@ExecSpace("ClientOnly")
	method string AugStateText(number no)
		if no == 0 then return "미지정" end
		if no < 0 then return "해금됨" end
		local u = _RtsUnitLogic:GetMyUnit(no)
		if u == nil then return "→ " .. _RtsHudLogic:Int(no) .. "번" end
		return "→ " .. _RtsHudLogic:Int(no) .. ". " .. _RtsJobTableLogic:GetJobNameFor(u)
	end

	-- 보유 목록이 바뀌었거나 탭·숨기기가 바뀌면: 탭 글자·켜짐은 제자리, 목록·상세·아래 줄만 다시(창 전체는 그대로 — 2026-09-25)
	@ExecSpace("ClientOnly")
	method void RefreshAugment()
		if self.Kind ~= "augment" or self.AugBody == nil or not isvalid(self.AugBody) then return end
		local H = _RtsHudLogic
		local AT = _RtsAugmentTableLogic
		local owned = _RtsAugmentLogic:MyOwned()
		local old = self.AugContent
		local box = self:SpawnBox(self.AugBody, "RtsAugContent")
		self.AugContent = box
		self:BuildAugContent(box, owned)
		self:ApplyAugFilter()
		self:SwapContent(old, box)
	end

	-- 설명 앞의 "[히어로 전용] [프리즘] " 같은 머리표 떼기(도감은 직업을 칩으로 따로 보여 준다)
	method string StripTags(string t)
		local out = t
		while string.sub(out, 1, 1) == "[" do
			local e = string.find(out, "]", 1, true)
			if e == nil then break end
			out = string.sub(out, e + 1)
			while string.sub(out, 1, 1) == " " do out = string.sub(out, 2) end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void RefreshCodex()
		if self.Kind ~= "codex" or self.CodexBody == nil or not isvalid(self.CodexBody) then return end
		self:BarSelect(self.CodexBar, self.CodexGrade)
		if self.CodexInfo ~= nil and isvalid(self.CodexInfo) and self.CodexInfo.TextComponent ~= nil then self.CodexInfo.TextComponent.Text = self:CodexInfoText() end
		self:BuildCodexList(self.CodexBody, self.PanelOuter.UITransformComponent.RectSize.x)
	end

	-- 증강 도감(2026-09-24 사용자 "좌측 아래에 증강 도감 생성 — 각 등급별 증강 목록"): 탭 = 브론즈·실버·골드·프리즘,
	--   행 = 등급 띠·배지·이름·효과(프리즘은 설명 두 줄)·그 등급 안에서 나올 확률(가중치 ÷ 합). 원본 = RtsAugmentTableLogic(.info/augmentation.md)
	@ExecSpace("ClientOnly")
	method void BuildCodex(Entity body, number W)
		local H = _RtsHudLogic
		local AT = _RtsAugmentTableLogic
		AT:Ensure()
		-- 탭·안내 줄은 제자리, 목록만 다시(RefreshCodex) — 2026-09-25
		self.CodexBody = body
		local grades = { "bronze", "silver", "gold", "prism" }
		local items = {}
		for i = 1, #grades do
			local n = 0
			if AT.ByGrade[grades[i]] ~= nil then n = #AT.ByGrade[grades[i]] end
			items[i] = { grades[i], self:GradeName(grades[i]) .. " " .. H:Int(n) }
		end
		self.CodexBar = self:SpawnTabBar(body, "RtsCodexTab", items, self.CodexGrade, 27, -10, 120, 44, 8, 18, function(key)
			self.CodexGrade = key
			self:RefreshCodex()
		end)
		self:SpawnTabKeyHint(body, 27 + #grades * 128 + 4)
		self.CodexInfo = H:SpawnLabel("RtsCodexInfo", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -64), Vector2(W - 54, 26),
			self:CodexInfoText(), self:Muted(), 16, TextAlignmentType.MiddleLeft, false)
		self.CodexList = nil
		self:BuildCodexList(body, W)
	end

	method string CodexInfoText()
		local info = "라운드 지급 10장 · 기본 뽑기 확률 75.5%"
		if self.CodexGrade == "silver" then info = "라운드 지급 10장 · 기본 뽑기 확률 15%" end
		if self.CodexGrade == "gold" then info = "라운드 지급 7장 · 기본 뽑기 확률 4.5%" end
		if self.CodexGrade == "prism" then info = "자쿰 · 시그너스 · 루시드 처치 뒤 3택1 · 기본 뽑기 확률 5%(판마다 최대 2개)" end
		return info .. "   ·   오른쪽 % = 이 등급 안에서 나올 확률"
	end

	-- 도감 목록(선택 등급) — 컨테이너째 교체
	@ExecSpace("ClientOnly")
	method void BuildCodexList(Entity body, number W)
		local H = _RtsHudLogic
		local AT = _RtsAugmentTableLogic
		local old = self.CodexList
		local ids = AT.ByGrade[self.CodexGrade] or {}
		local sum = 0
		for i = 1, #ids do sum = sum + (AT.Defs[ids[i]].w or 0) end
		local listW = W - 54
		local list = H:SpawnStretch("model://uisprite", "RtsCodexList", body, Vector2(0, 0), Vector2(1, 1), Vector2(27, 27), Vector2(-27, -104))
		list.SpriteGUIRendererComponent.Color = self:Mix(Color.white, 0.02)
		self.CodexList = list
		local sg = list:AddComponent("ScrollLayoutGroupComponent")
		if sg ~= nil then
			sg.Type = LayoutGroupType.Vertical
			sg.ChildAlignment = ChildAlignmentType.UpperLeft
			sg.Spacing = 6
			sg.UseScroll = true
			sg.ScrollBarVisible = ScrollBarVisibility.AlwaysShow
			sg.ScrollBarThickness = 8
			sg.ScrollBarHandleColor = H:ColGold()
			sg.ScrollBarBackgroundColor = Color(1, 1, 1, 0.06)
		end
		local isPrism = self.CodexGrade == "prism"
		local rowH = 96
		for i = 1, #ids do
			local d = AT.Defs[ids[i]]
			local row = H:SpawnRoundedPanel("RtsCodexRow" .. tostring(i), list, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(listW - 16, rowH),
				self:Card(), self:Edge(), 1.5)
			local band = H:SpawnStretch("model://uisprite", "RtsCodexBand", row, Vector2(0, 0), Vector2(0, 1), Vector2(0, 0), Vector2(4, 0))
			band.SpriteGUIRendererComponent.Color = self:GradeColor(d.grade)
			self:SpawnAugIcon(row, d, Vector2(12, -12), 68)
			local pct = 0
			if sum > 0 then pct = (d.w or 0) / sum * 100 end
			H:SpawnLabel("RtsCodexPct", row, Vector2(1, 1), Vector2(1, 1), Vector2(-14, -12), Vector2(100, 30),
				string.format("%.1f%%", pct), self:Muted(), 15, TextAlignmentType.MiddleRight, true)
			if isPrism then
				-- 이름 왼쪽 = 직업명(직업 전용) / 공통(특수 코어) / 팬텀(영입 해금). 설명은 접어 두고 행을 누르면 그 자리에서 펼침(다시 누르면 접힘)
				local tag = "공통"
				if d.unlock ~= nil then
					tag = "팬텀"
				elseif d.job ~= nil and d.job ~= "" then
					tag = _RtsJobTableLogic:GetJobName(d.job)
				end
				local chip = H:SpawnRoundedPanel("RtsCodexJob", row, Vector2(0, 1), Vector2(0, 1), Vector2(90, -13), Vector2(140, 30),
					self:Mix(self:GradeColor("prism"), 0.16), self:Mix(self:GradeColor("prism"), 0.55), 1.5)
				H:SpawnLabel("RtsCodexJobText", chip, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(134, 26),
					tag, Color(0.43, 0.25, 0.58, 1), 14, TextAlignmentType.MiddleCenter, true)
				H:SpawnLabel("RtsCodexName", row, Vector2(0, 1), Vector2(0, 1), Vector2(242, -13), Vector2(listW - 480, 30),
					d.name, self:Ink(), 20, TextAlignmentType.MiddleLeft, true)
				local arrow = H:SpawnLabel("RtsCodexMore", row, Vector2(1, 1), Vector2(1, 1), Vector2(-124, -13), Vector2(110, 30),
					"자세히 ▾", self:Muted(), 13, TextAlignmentType.MiddleRight, false)
				local description = self:StripTags(AT:EffectText(d.id))
				local descH = 12 + _RtsUnitPopupLogic:DescLines(description, listW - 70) * 24
				local expandedH = 96 + descH + 20
				local desc = H:SpawnLabel("RtsCodexDesc", row, Vector2(0, 1), Vector2(0, 1), Vector2(24, -96), Vector2(listW - 70, descH),
					description, self:Ink(), 18, TextAlignmentType.UpperLeft, false)
				desc:SetEnable(false)
				local outer = row.Parent
				local rw2 = listW - 16
				local open = false
				local click = H:SpawnClick("RtsCodexRowClick", row)
				click:ConnectEvent(ButtonClickEvent, function(event)
					open = not open
					desc:SetEnable(open)
					local h = 96
					if open then h = expandedH end
					outer.UITransformComponent.RectSize = Vector2(rw2, h)
					if open then arrow.TextComponent.Text = "접기 ▴" else arrow.TextComponent.Text = "자세히 ▾" end
				end)
			else
				H:SpawnLabel("RtsCodexName", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(90, 22), Vector2(listW - 240, 30),
					d.name, self:Ink(), 19, TextAlignmentType.MiddleLeft, true)
				H:SpawnLabel("RtsCodexEff", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(90, -20), Vector2(listW - 236, 38),
					AT:EffectText(d.id), self:Ink(), 18, TextAlignmentType.MiddleLeft, false)
			end
		end
		self:SwapContent(old, list)
	end

	-- 증강 선택 카드는 안정적인 등급 테두리로 표시한다.
	@ExecSpace("ClientOnly")
	method void BuildPick(Entity body)
		local H = _RtsHudLogic
		local AT = _RtsAugmentTableLogic
		local offer = _RtsAugmentLogic:MyOffer()
		if #offer.ids == 0 then
			self:Close()
			return
		end
		local title = self:GradeName(offer.grade) .. " 증강 선택"
		if offer.grade == "prism" then title = "보스 처치 — 프리즘 증강 선택" end
		local pending = _RtsAugmentLogic.PendingByUser[_RtsUnitLogic:MyUserId()] or 0
		local sub = title .. " · 3개 중 하나를 골라 주세요. 받은 증강은 보유 증강 탭에서 지정할 수 있어요."
		if pending > 1 then sub = sub .. "   ·   대기 중인 선택지 " .. H:Int(pending) .. "개 / " .. H:Int(_RtsAugmentLogic.MaxPending) .. "개" end
		H:SpawnLabel("RtsPickSub", body, Vector2(0, 1), Vector2(0, 1), Vector2(27, -4), Vector2(1060, 44),
			sub, self:Muted(), 15, TextAlignmentType.MiddleCenter, false)
		-- 접기(2026-09-23 사용자): 창을 닫고 나중에 HUD '펼치기'로 고른다
		local fold = H:SpawnRoundedPanel("RtsPickFold", body, Vector2(0.5, 0), Vector2(0.5, 0), Vector2(0, 16), Vector2(220, 44),
			self:Mix(Color.white, 0.06), self:Mix(Color.white, 0.3), 1.5)
		H:SpawnLabel("RtsPickFoldText", fold, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(210, 40),
			"보유 증강으로", self:Ink(), 16, TextAlignmentType.MiddleCenter, true)
		local foldClick = H:SpawnClick("RtsPickFoldClick", fold)
		foldClick:ConnectEvent(ButtonClickEvent, function(event)
			self:OpenHubTab("augment")
		end)
		local cardW = 340
		local gap = 19
		_SoundService:PlaySound(self.PickSound, 1)
		for ci = 1, #offer.ids do
			local d = AT:GetDef(offer.ids[ci])
			if d ~= nil then
				local cx = 27 + (ci - 1) * (cardW + gap)
				-- 등급색으로 카드 가장자리를 은은하게 강조한다.
				local glow = H:SpawnUI("model://uisprite", "RtsPickGlow" .. tostring(ci), body, Vector2(0, 1), Vector2(0, 1), Vector2(cx - 3, -53), Vector2(cardW + 6, 666))
				local gc = self:GradeColor(d.grade)
				glow.SpriteGUIRendererComponent.Color = Color(gc.r, gc.g, gc.b, 0.12)
				local card = H:SpawnRoundedPanel("RtsPickCard" .. tostring(ci), body, Vector2(0, 1), Vector2(0, 1), Vector2(cx, -56), Vector2(cardW, 660),
					self:Card(), self:Mix(self:GradeColor(d.grade), 0.5), 2.5)
				-- 본문이 흔들리지 않도록 지속 반짝임을 사용하지 않는다.
				local band = H:SpawnStretch("model://uisprite", "RtsPickBand", card, Vector2(0, 1), Vector2(1, 1), Vector2(0, -6), Vector2(0, 0))
				band.SpriteGUIRendererComponent.Color = self:GradeColor(d.grade)
				self:SpawnAugIcon(card, d, Vector2((cardW - 104) / 2, -42), 104)
				H:SpawnLabel("RtsPickGrade", card, Vector2(0, 1), Vector2(0, 1), Vector2(19, -12), Vector2(cardW - 38, 24), self:GradeName(d.grade), self:Muted(), 15, TextAlignmentType.MiddleCenter, true)
				H:SpawnLabel("RtsPickT", card, Vector2(0, 1), Vector2(0, 1), Vector2(19, -158), Vector2(cardW - 38, 42),
					d.name, self:Ink(), 21, TextAlignmentType.MiddleCenter, true)
				H:SpawnLabel("RtsPickD", card, Vector2(0, 1), Vector2(0, 1), Vector2(19, -212), Vector2(cardW - 38, 364),
					AT:EffectText(d.id), self:Ink(), 18, TextAlignmentType.UpperCenter, false)
				local btn = H:SpawnRoundedPanel("RtsPickTake", card, Vector2(0.5, 0), Vector2(0.5, 0), Vector2(0, 19), Vector2(cardW - 38, 44),
					self:Mix(H:ColGold(), 0.9), H:ColGold(), 1.5)
				H:SpawnLabel("RtsPickTakeText", btn, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(cardW - 50, 40),
					"받기", Color(0.133, 0.114, 0.09, 1), 18, TextAlignmentType.MiddleCenter, true)
				local idx = ci
				local takeClick = H:SpawnClick("RtsPickTakeClick", btn)
				takeClick:ConnectEvent(ButtonClickEvent, function(event)
					if _RtsStageLogic.Paused then H:ShowHintFor("일시정지를 해제한 뒤 선택할 수 있어요", 2); return end
					_RtsAugmentLogic:ChooseFromPopup(idx)
					self:OpenHubTab("augment")
				end)
			end
		end
	end

	method string AugStatKey(table d)
		-- 능력치 증강은 정의 필드로, 스킬 강화는 전용 마름모로 표시한다.
		for _, key in ipairs({"atk", "pct", "fin", "boss", "crit", "critDmg"}) do
			if d[key] ~= nil then return key end
		end
		return "skill"
	end

	@ExecSpace("ClientOnly")
	method void ApplyAugFilter()
		-- 체크박스와 목록은 재생성하지 않는다. 선택 항목이 숨겨질 때만 상세를 바꾼다.
		local first = 0
		local count = 0
		local selectedVisible = false
		for _, ref in ipairs(self.AugRowRefs) do
			local show = not self.AugHideAssigned or ref.un
			ref.row.Parent:SetEnable(show)
			if show then
				count = count + 1
				if first == 0 then first = ref.k end
				if ref.k == self.AugSel then selectedVisible = true end
			end
		end
		if isvalid(self._T.AugHideMark) then self._T.AugHideMark:SetEnable(self.AugHideAssigned) end
		if isvalid(self._T.AugEmpty) then self._T.AugEmpty:SetEnable(count == 0 and #self.AugRowRefs > 0) end
		if isvalid(self._T.AugList) and self._T.AugList.ScrollLayoutGroupComponent ~= nil then
			self._T.AugList.ScrollLayoutGroupComponent.UseScroll = count > 8
		end
		if not selectedVisible and self.AugSel ~= first then
			self.AugSel = first
			self.AugPickNo = 0
			self:RestyleAugRows()
			self:RefreshAugDetail()
		end
	end

	@ExecSpace("ClientOnly")
	method void SwapContent(Entity old, Entity fresh)
		-- 반투명 면이 겹쳐 밝아지지 않게 준비 후 한 프레임에서 교대한다.
		if not isvalid(old) then return end
		local canvas = fresh:AddComponent("CanvasGroupComponent")
		canvas.GroupAlpha = 0
		canvas.BlocksRaycasts = false
		_TimerService:SetTimerOnce(function()
			if isvalid(old) then old:SetEnable(false); old:Destroy() end
			if isvalid(fresh) then canvas.GroupAlpha = 1; canvas.BlocksRaycasts = true end
		end, 0.12)
	end

	@ExecSpace("ClientOnly")
	method void SpawnAugIcon(Entity parent, table definition, Vector2 pos, number size)
		-- 등급 문양과 속성/스킬 그림을 고정된 한 정사각형 안에 합성한다.
		local H = _RtsHudLogic
		local grades = {
			bronze = "5a539ae0ef084ae593cdf9742e058a25",
			silver = "187b4995fe2d4ca0829d16f7d3d1ff7e",
			gold = "b74dcd80d6984e8080f197a7ed7163ba",
			prism = "3be02a668f1b462d93344f0e5352c20d",
		}
		local skills = {
			enrage = "14c64ff02eb64da0be624eed933e9d9c",
			holyunity = "53a38855164a4b64accf68785761c283",
			arrowrain = "9b0c6f6554f04b6a8ef60ade19ff76fb",
			truesnipe = "f940c35ae6c7478692338475e401530e",
			tempest = "a05d13219caa4449aa541f0daaf32995",
			transcend = "d998c591786d40cebb85a06b6eed9e6b",
			divinepunish = "3c1471ba763140878c405f2aefa9047a",
			fuma = "459228cf9906473d91d0df063132f3dd",
			dualblade = "df6c35973fe84c799e7331cff4a6772f",
			phantom = "b2091f472da549bfa7bb5f1a77a3340c",
			giant = "012ff529f8c04302bc72128d83a19da6",
		}
		local holder = H:SpawnUI("model://uisprite", "RtsAugIcon_" .. definition.id, parent, Vector2(0, 1), Vector2(0, 1), pos, Vector2(size, size))
		holder.SpriteGUIRendererComponent.ImageRUID = DataRef(grades[definition.grade] or grades.bronze)
		holder.SpriteGUIRendererComponent.Color = Color.white
		holder.SpriteGUIRendererComponent.RaycastTarget = false
		local inset = size * 0.28
		local side = size * 0.44
		if definition.grade == "prism" and skills[definition.id] ~= nil then
			local icon = H:SpawnUI("model://uisprite", "RtsPrismSkill_" .. definition.id, holder, Vector2(0, 1), Vector2(0, 1), Vector2(inset, -inset), Vector2(side, side))
			icon.SpriteGUIRendererComponent.ImageRUID = DataRef(skills[definition.id])
			icon.SpriteGUIRendererComponent.Color = Color.white
			icon.SpriteGUIRendererComponent.RaycastTarget = false
		else
			H:SpawnStatIcon(holder, self:AugStatKey(definition), Vector2(inset, -inset), side)
		end
	end

end
