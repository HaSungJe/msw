-- 계정 꾸미기(2026-09-25 사용자 — 로드맵 Phase 10 테마 + Phase 14 아이콘 → 같은 날 비석 추가, 좌상단 '프로필 설정'): 유저별 테마 · 아이콘 · 비석의 **선택 + 보유**.
--   서버가 원본을 쥔다 — 유저 DataStorage "theme"·"icon"·"tomb"(선택) · "icons"·"themes"·"tombs"(보유)에 영구 저장하고, 입장·변경·획득 때마다 그 유저에게 전체를 보낸다(SendProfileState).
--   방이 바뀌어도 입장 때 다시 읽으니 그대로 유지(사용자 "비석/아이콘/테마 모두 영구 소유, 서버 저장이라 다른 게임에 들어갈 때마다 유지 — 선택 정보랑 보유 정보").
--   기본값(사용자): 아이콘 없음("none") · 테마 헤네시스 · 비석 기본 — 선택 키가 저장돼 있지 않으면 입장 때 기본값을 저장한다("게임 시작 시 자동 설정").
--   테마·비석은 프리셋 free = true면 누구나 보유(지금 전부), 아니면 보유 목록에 있어야 고른다. 초록달팽이(M001)는 늘 보유.
--   (사용자 "아이콘이나 테마는 서버 쪽에서 항상 유저에게 전달해야 누적 — 영구 획득 정보", "획득일을 저장 — 나중에 집계할 수도")
--   테마 = 내 구역만 외형 변경(RtsThemeLogic.ApplyToZone, 밸런스 영향 없음). 아이콘 = 몬스터 247종, 기본 초록달팽이(M001)만 보유,
--   매우어려움(난이도 5)에서만 그 몬스터를 처치할 때 1%(보스 포함, 극악 제외 — 사용자 "무조건 매우어려움에서 1%").
--   창: RtsPopupLogic 'profile'([테마]·[아이콘]·[비석] 탭)·'themeconfirm'·'tombconfirm'·'iconinfo'·'iconconfirm'·'iconget'. 상자: RtsHudLogic 프로필 상자(배경 = 테마 썸네일, 왼쪽 = 내 아이콘). 카드: 유저 카드(목록 줄의 테마·아이콘 칸).
--   비석 = RtsTombLogic 프리셋, 탈락 때 RtsRunResultLogic.SpawnTomb이 그 구역 주인 것으로 세운다.
@Logic
script RtsProfileLogic extends Logic

	-- 유저 DataStorage 키(바꾸지 않는다 — 저장된 값이 사라진 것처럼 보인다)
	property string ThemeKey = "theme"

	property string IconKey = "icon"

	-- "M005:1790000000000,M131:1790000123456" — 몬스터 id : 획득 시각(UTC ms, DateTime.UtcNow.Elapsed). M001은 적지 않아도 보유
	property string IconsKey = "icons"

	property string TombKey = "tomb"

	-- 보유 목록(무료 프리셋은 적지 않는다) — "key1,key2"
	property string ThemesKey = "themes"

	property string TombsKey = "tombs"

	-- 늘 보유하는 아이콘(초록달팽이 — 2026-09-25 사용자 "기본 보유는 유지")
	property string FreeIcon = "M001"

	-- 아이콘 없음(선택 기본값 — 2026-09-25 사용자 "아이콘: 없음"). 유저 카드는 빈 원
	property string IconNone = "none"

	-- 획득 확률·난이도(5 = 매우어려움 — RtsDifficultyLogic.GetNames)
	property number DropRate = 0.01

	property number DropDiff = 5

	-- ===== 서버 상태(유저별) =====
	property table ThemeByUser = {}

	property table IconByUser = {}

	property table TombByUser = {}

	-- userId → { [키] = true } 무료가 아닌 테마·비석 보유
	property table ThemesByUser = {}

	property table TombsByUser = {}

	-- userId → { [몬스터 id] = 획득 시각 ms } (M001 = 0)
	property table OwnedByUser = {}

	-- 구역 → 주인 userId(입장·퇴장 때 갱신 — 처치마다 동기화 테이블 ZoneByUser를 훑지 않게)
	property table OwnerByZone = {}

	-- ===== 클라 상태(내 것 — SendProfileState로만 바뀐다) =====
	property string MyTheme = "henesys"

	property string MyIcon = "none"

	property string MyTomb = "basic"

	property table MyThemes = {}

	property table MyTombs = {}

	property table MyOwned = {}

	property number MyOwnedCount = 1

	-- 창에서 고른 테마 키 · 아이콘 id(확인 팝업이 쓴다)
	property string PendingTheme = ""

	property string PendingIcon = ""

	property string PendingTomb = ""

	-- 획득 팝업 대기열(보스 3택1 등 다른 창이 먼저 떠 있으면 닫힌 뒤에)
	property table GotQueue = {}

	property string GotIcon = ""

	-- 아이콘 순서(M001…M229, B01…B18) — 처음 부를 때 만든다
	property table IconIdCache = {}

	-- ===== 공용 =====

	-- "M005:123,M131:456" → { M001 = 0, M005 = 123, M131 = 456 } (틀린 조각은 버린다)
	method table ParseOwned(string packed)
		local out = {}
		out[self.FreeIcon] = 0
		if packed == nil or packed == "" then return out end
		for piece in string.gmatch(packed, "[^,]+") do
			local id, at = string.match(piece, "^%s*([MB]%d+)%s*:%s*(%d+)%s*$")
			if id == nil then id = string.match(piece, "^%s*([MB]%d+)%s*$") end
			if id ~= nil and _RtsStageTableLogic:GetMonster(id) ~= nil then
				out[id] = tonumber(at or "0") or 0
			end
		end
		return out
	end

	-- 보유 표 → 저장 문자열(M001 제외, id 순)
	method string SerializeOwned(table owned)
		local ids = {}
		for id, at in pairs(owned) do
			if id ~= self.FreeIcon then ids[#ids + 1] = id end
		end
		table.sort(ids)
		local parts = {}
		for i = 1, #ids do
			-- 획득 시각은 정수 ms(≈6.4e16) — 실수로 바꾸면 정밀도가 깨지니 그대로 정수로 쓴다
			parts[#parts + 1] = ids[i] .. ":" .. string.format("%d", math.floor(owned[ids[i]] or 0))
		end
		return table.concat(parts, ",")
	end

	-- 클라 전달용(M001 포함)
	method string PackOwned(table owned)
		local s = self:SerializeOwned(owned)
		if s == "" then return self.FreeIcon .. ":0" end
		return self.FreeIcon .. ":0," .. s
	end

	-- 테마·비석 보유 목록: "a,b" ↔ { a = true, b = true }(틀린 조각은 버린다)
	method table ParseKeys(string packed)
		local out = {}
		if packed == nil or packed == "" then return out end
		for piece in string.gmatch(packed, "[^,]+") do
			local k = string.match(piece, "^%s*([%w_]+)%s*$")
			if k ~= nil then out[k] = true end
		end
		return out
	end

	method string SerializeKeys(table set)
		local keys = {}
		if set == nil then return "" end
		for k, v in pairs(set) do
			if v then keys[#keys + 1] = k end
		end
		table.sort(keys)
		return table.concat(keys, ",")
	end

	-- 프리셋 보유 판정(서버·클라 공용): free면 누구나, 아니면 보유 목록
	method boolean PresetOwned(table preset, table set)
		if preset == nil then return false end
		if preset.free then return true end
		return set ~= nil and set[preset.key] == true
	end

	method string ThemeOf(string userId)
		local k = self.ThemeByUser[userId]
		if k == nil or k == "" then return _RtsThemeLogic.DefaultKey end
		return k
	end

	method string IconOf(string userId)
		local k = self.IconByUser[userId]
		if k == nil or k == "" then return self.IconNone end
		return k
	end

	method string TombOf(string userId)
		local k = self.TombByUser[userId]
		if k == nil or k == "" then return _RtsTombLogic.DefaultKey end
		return k
	end

	-- ===== 서버: 입장·퇴장 =====

	-- 입장(RtsBootstrapLogic.HandleUserEnterEvent): 저장소 6칸 읽기 → 틀린 값은 기본(없던 선택 키는 기본값 저장) → 내 구역에 테마 → 그 유저에게 전체 전달
	@ExecSpace("ServerOnly")
	method void OnUserEnter(string userId, number zone)
		self:Load(userId)
		if zone > 0 then self.OwnerByZone[math.floor(zone + 0.5)] = userId end
		if zone > 0 then _RtsThemeLogic:ApplyToZone(zone, self:ThemeOf(userId)) end
		self:SendState(userId)
	end

	@ExecSpace("ServerOnly")
	method void Load(string userId)
		local theme = ""
		local icon = ""
		local tomb = ""
		local packed = ""
		local themes = ""
		local tombs = ""
		-- 선택 키 3개를 읽는 데 성공했는가(읽기 실패를 '값 없음'으로 보고 기본값을 덮어쓰지 않게)
		local readTheme = false
		local readIcon = false
		local readTomb = false
		local ds = _DataStorageService:GetUserDataStorage(userId)
		if ds ~= nil then
			local c1, v1 = ds:GetAndWait(self.ThemeKey)
			readTheme = c1 == 0
			if c1 == 0 and v1 ~= nil then theme = v1 end
			local c2, v2 = ds:GetAndWait(self.IconKey)
			readIcon = c2 == 0
			if c2 == 0 and v2 ~= nil then icon = v2 end
			local c3, v3 = ds:GetAndWait(self.IconsKey)
			if c3 == 0 and v3 ~= nil then packed = v3 end
			local c4, v4 = ds:GetAndWait(self.TombKey)
			readTomb = c4 == 0
			if c4 == 0 and v4 ~= nil then tomb = v4 end
			local c5, v5 = ds:GetAndWait(self.ThemesKey)
			if c5 == 0 and v5 ~= nil then themes = v5 end
			local c6, v6 = ds:GetAndWait(self.TombsKey)
			if c6 == 0 and v6 ~= nil then tombs = v6 end
		end
		local owned = self:ParseOwned(packed)
		local themeSet = self:ParseKeys(themes)
		local tombSet = self:ParseKeys(tombs)
		-- 선택 키가 없으면(처음 들어온 유저·새로 생긴 칸) 기본값을 저장 — 사용자 "설정값이 없으면 기본값으로 게임 시작 시 자동 설정"
		if ds ~= nil then
			if readTheme and theme == "" then self:SaveDefault(ds, self.ThemeKey, _RtsThemeLogic.DefaultKey) end
			if readIcon and icon == "" then self:SaveDefault(ds, self.IconKey, self.IconNone) end
			if readTomb and tomb == "" then self:SaveDefault(ds, self.TombKey, _RtsTombLogic.DefaultKey) end
		end
		-- 없는 프리셋·보유하지 않은 것은 기본으로(저장 값은 그대로 둔다)
		if not _RtsThemeLogic:HasKey(theme) or not self:PresetOwned(_RtsThemeLogic:GetPreset(theme), themeSet) then theme = _RtsThemeLogic.DefaultKey end
		if icon ~= self.IconNone and owned[icon] == nil then icon = self.IconNone end
		if not _RtsTombLogic:HasKey(tomb) or not self:PresetOwned(_RtsTombLogic:GetPreset(tomb), tombSet) then tomb = _RtsTombLogic.DefaultKey end
		self.ThemeByUser[userId] = theme
		self.IconByUser[userId] = icon
		self.TombByUser[userId] = tomb
		self.OwnedByUser[userId] = owned
		self.ThemesByUser[userId] = themeSet
		self.TombsByUser[userId] = tombSet
		_RtsConfigLogic:Log("RtsProfile: load " .. userId .. " theme=" .. theme .. " icon=" .. icon .. " tomb=" .. tomb .. " owned=" .. string.format("%d", self:CountOwned(owned)))
	end

	-- 기본값 저장(입장 때 빈 선택 키) — 실패는 로그만(다음 입장 때 다시)
	@ExecSpace("ServerOnly")
	method void SaveDefault(any ds, string key, string value)
		ds:SetAsync(key, value, function(code, k)
			if code ~= 0 then
				_RtsConfigLogic:Log("RtsProfile: default save failed " .. key .. " code=" .. tostring(code))
				return
			end
			_RtsConfigLogic:Log("RtsProfile: default " .. key .. "=" .. value)
		end)
	end

	-- 퇴장: 빈 구역은 기본 테마로, 메모리 정리
	@ExecSpace("ServerOnly")
	method void OnUserLeave(string userId, number zone)
		if zone > 0 then
			_RtsThemeLogic:ApplyToZone(zone, _RtsThemeLogic.DefaultKey)
			if self.OwnerByZone[math.floor(zone + 0.5)] == userId then self.OwnerByZone[math.floor(zone + 0.5)] = nil end
		end
		self.ThemeByUser[userId] = nil
		self.IconByUser[userId] = nil
		self.TombByUser[userId] = nil
		self.OwnedByUser[userId] = nil
		self.ThemesByUser[userId] = nil
		self.TombsByUser[userId] = nil
	end

	method number CountOwned(table owned)
		local n = 0
		if owned == nil then return 0 end
		for _, _v in pairs(owned) do n = n + 1 end
		return n
	end

	-- 그 유저에게만 전체(선택 3 + 보유 3)
	@ExecSpace("ServerOnly")
	method void SendState(string userId)
		local owned = self.OwnedByUser[userId]
		if owned == nil then owned = self:ParseOwned("") end
		self:SendProfileState(self:ThemeOf(userId), self:IconOf(userId), self:TombOf(userId), self:PackOwned(owned),
			self:SerializeKeys(self.ThemesByUser[userId]), self:SerializeKeys(self.TombsByUser[userId]), userId)
	end

	-- 그 유저에게 전체 + 전 클라 목록(카드 배경·아이콘)
	@ExecSpace("ServerOnly")
	method void PushProfile(string userId)
		self:SendState(userId)
		_RtsBootstrapLogic:BroadcastPlayerList()
	end

	-- ===== 서버: 변경 요청(조작 RPC — senderUserId 본인 것만) =====

	-- 테마 변경: 모르는 키·구역 없음 → 무시. 저장 성공 뒤에 내 구역에 적용
	@ExecSpace("Server")
	method void RequestSetTheme(string key)
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		local zone = _RtsZoneLogic:GetZoneOfUser(userId)
		if zone < 1 then return end
		if not _RtsThemeLogic:HasKey(key) then
			_RtsConfigLogic:Log("RtsProfile: unknown theme " .. tostring(key) .. " from " .. userId)
			return
		end
		if not self:PresetOwned(_RtsThemeLogic:GetPreset(key), self.ThemesByUser[userId]) then
			_RtsConfigLogic:Log("RtsProfile: not owned theme " .. tostring(key) .. " from " .. userId)
			return
		end
		if self:ThemeOf(userId) == key then
			self:PushProfile(userId)
			return
		end
		local ds = _DataStorageService:GetUserDataStorage(userId)
		if ds == nil then return end
		ds:SetAsync(self.ThemeKey, key, function(code, k)
			if code ~= 0 then
				_RtsConfigLogic:Log("RtsProfile: theme save failed code=" .. tostring(code))
				return
			end
			self.ThemeByUser[userId] = key
			local z = _RtsZoneLogic:GetZoneOfUser(userId)
			if z > 0 then _RtsThemeLogic:ApplyToZone(z, key) end
			self:PushProfile(userId)
		end)
	end

	-- 아이콘 변경: 보유한 것만, 또는 없음("none")
	@ExecSpace("Server")
	method void RequestSetIcon(string id)
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		local owned = self.OwnedByUser[userId]
		if owned == nil or (id ~= self.IconNone and owned[id] == nil) then
			_RtsConfigLogic:Log("RtsProfile: not owned icon " .. tostring(id) .. " from " .. userId)
			return
		end
		if self:IconOf(userId) == id then
			self:PushProfile(userId)
			return
		end
		local ds = _DataStorageService:GetUserDataStorage(userId)
		if ds == nil then return end
		ds:SetAsync(self.IconKey, id, function(code, k)
			if code ~= 0 then
				_RtsConfigLogic:Log("RtsProfile: icon save failed code=" .. tostring(code))
				return
			end
			self.IconByUser[userId] = id
			self:PushProfile(userId)
		end)
	end

	-- 비석 변경: 있는 프리셋 + 보유(free 포함)만. 저장 성공 뒤 반영(다음 탈락부터 그 비석)
	@ExecSpace("Server")
	method void RequestSetTomb(string key)
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		if not _RtsTombLogic:HasKey(key) or not self:PresetOwned(_RtsTombLogic:GetPreset(key), self.TombsByUser[userId]) then
			_RtsConfigLogic:Log("RtsProfile: bad tomb " .. tostring(key) .. " from " .. userId)
			return
		end
		if self:TombOf(userId) == key then
			self:SendState(userId)
			return
		end
		local ds = _DataStorageService:GetUserDataStorage(userId)
		if ds == nil then return end
		ds:SetAsync(self.TombKey, key, function(code, k)
			if code ~= 0 then
				_RtsConfigLogic:Log("RtsProfile: tomb save failed code=" .. tostring(code))
				return
			end
			self.TombByUser[userId] = key
			self:SendState(userId)
		end)
	end

	-- ===== 서버: 처치 → 아이콘 획득(RtsMonsterComponent.Die) =====
	--   대상 = 그 구역 주인. 테스트 모드 · 매우어려움이 아님 · 이미 보유 · 난수 ≥ 1% → 아무것도 안 함.
	--   보유에 먼저 넣고(저장 중 같은 몬스터로 두 번 굴리지 않게) 저장 실패면 되돌린다
	@ExecSpace("ServerOnly")
	method void OnMonsterKilled(number zone, string monsterId)
		if _RtsUnitLogic.DevTools then return end
		local userId = self.OwnerByZone[math.floor(zone + 0.5)]
		if userId == nil or userId == "" then return end
		if _RtsDifficultyLogic:Of(userId) ~= self.DropDiff then return end
		local owned = self.OwnedByUser[userId]
		if owned == nil or owned[monsterId] ~= nil then return end
		if _RtsStageTableLogic:GetMonster(monsterId) == nil then return end
		if _UtilLogic:RandomDouble() >= self.DropRate then return end
		self:GrantIcon(userId, monsterId)
	end

	-- 획득 확정(저장 → 전달 → 획득 팝업). 시험 스크립트도 이걸 부른다
	@ExecSpace("ServerOnly")
	method void GrantIcon(string userId, string monsterId)
		local owned = self.OwnedByUser[userId]
		if owned == nil or owned[monsterId] ~= nil then return end
		local ds = _DataStorageService:GetUserDataStorage(userId)
		if ds == nil then return end
		owned[monsterId] = DateTime.UtcNow.Elapsed
		ds:SetAsync(self.IconsKey, self:SerializeOwned(owned), function(code, k)
			if code ~= 0 then
				owned[monsterId] = nil
				_RtsConfigLogic:Log("RtsProfile: icons save failed code=" .. tostring(code))
				return
			end
			_RtsConfigLogic:Log("RtsProfile: icon " .. monsterId .. " → " .. userId)
			self:PushProfile(userId)
			self:ShowIconGot(monsterId, userId)
		end)
	end

	-- ===== 클라 =====

	-- 서버 → 그 유저(마지막 인자 userId): 선택(테마·아이콘·비석) + 보유(아이콘·테마·비석) 전체. 받은 값 그대로 쓰고 열린 창·프로필 상자를 다시 그린다
	--   (2026-09-25 비석이 붙어 인자가 늘어 SendProfile → 새 이름 — 분석기가 인자 수를 캐시한다, 메모리 msw-engine)
	@ExecSpace("Client")
	method void SendProfileState(string theme, string icon, string tomb, string owned, string themes, string tombs, string userId)
		self.MyTheme = theme
		self.MyIcon = icon
		self.MyTomb = tomb
		self.MyOwned = self:ParseOwned(owned)
		self.MyOwnedCount = self:CountOwned(self.MyOwned)
		self.MyThemes = self:ParseKeys(themes)
		self.MyTombs = self:ParseKeys(tombs)
		_RtsHudLogic:RefreshProfileBox()
		-- 열린 창은 다시 열지 않고 바뀐 표시만(2026-09-25 "필요한 부분만 다시"): 프로필 [테마]·[비석] = 사용 중 체크, [아이콘] = 칸 색·보유 수(각자 지금 탭인지 본다). 아이콘 정보(작은 창)만 다시
		local k = _RtsPopupLogic.Kind
		if k == "profile" then
			_RtsPopupLogic:RefreshPresetMarks()
			_RtsPopupLogic:RefreshIconCells()
		elseif k == "iconinfo" then
			_RtsPopupLogic:Open(k)
		end
	end

	-- 서버 → 그 유저: 아이콘 획득 팝업(다른 창이 있으면 대기 — FlushGot)
	@ExecSpace("Client")
	method void ShowIconGot(string monsterId, string userId)
		self.GotQueue[#self.GotQueue + 1] = monsterId
		self:FlushGot()
	end

	-- 대기 중인 획득 팝업을 연다. 보스 3택1·다른 획득 팝업이 떠 있으면 그 창이 닫힐 때(RtsPopupLogic.Close) 다시 부른다
	@ExecSpace("ClientOnly")
	method void FlushGot()
		if #self.GotQueue == 0 then return end
		local k = _RtsPopupLogic.Kind
		if k == "pick" or k == "iconget" then return end
		self.GotIcon = self.GotQueue[1]
		table.remove(self.GotQueue, 1)
		_RtsPopupLogic:Open("iconget")
	end

	method boolean IsOwned(string id)
		return self.MyOwned[id] ~= nil
	end

	-- 획득일 "2026-09-25"(보는 사람 현지 날짜, 없거나 기본 = "") — 저장 값은 UTC ms(DateTime.UtcNow.Elapsed)
	@ExecSpace("ClientOnly")
	method string OwnedDate(string id)
		local at = self.MyOwned[id]
		if at == nil or at <= 0 then return "" end
		local ok, text = pcall(function()
			local d = _UtilLogic:GetLocalTimeFrom(DateTime(math.floor(at)))
			return string.format("%04d-%02d-%02d", d.Year, d.Month, d.Day)
		end)
		if ok and text ~= nil then return text end
		return ""
	end

	-- 아이콘 순서: 일반(M) 번호순 → 보스(B) 번호순
	method table IconIds()
		if #self.IconIdCache > 0 then return self.IconIdCache end
		local ms = {}
		local bs = {}
		for id, _m in pairs(_RtsStageTableLogic.Monsters) do
			if string.sub(id, 1, 1) == "B" then bs[#bs + 1] = id else ms[#ms + 1] = id end
		end
		table.sort(ms)
		table.sort(bs)
		local out = {}
		for i = 1, #ms do out[#out + 1] = ms[i] end
		for i = 1, #bs do out[#out + 1] = bs[i] end
		self.IconIdCache = out
		return out
	end

	-- 그 몬스터가 처음 나오는 스테이지(없으면 nil) — 아이콘 정보의 '획득처'
	method any FirstStageOf(string id)
		local list = _RtsStageTableLogic.Stages
		for i = 1, #list do
			local s = list[i]
			for j = 1, #s.mobs do
				if s.mobs[j] == id then return s end
			end
		end
		return nil
	end

	-- "매우어려움 · 12라운드 · 빅토리아 - 개미굴"
	method string WhereText(string id)
		local s = self:FirstStageOf(id)
		local diff = _RtsDifficultyLogic:GetNames()[self.DropDiff] or "매우어려움"
		if s == nil then return diff end
		return diff .. " · " .. _RtsHudLogic:Int(s.no) .. "라운드 · " .. _RtsStageTableLogic:FullName(s)
	end

end
