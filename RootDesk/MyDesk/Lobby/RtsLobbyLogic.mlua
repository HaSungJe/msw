-- Phase 8 ① (2026-09-28 사용자 — "카트라이더 매칭과 비슷한 느낌", 규칙 원본 .info/lobby.md): 로비(정적 룸 · LobbyMap)의 방 목록 · 방 만들기/입장 ·
--   빠른 참가(빈자리 있는 방에 바로 — 2026-09-29 매칭 대신) · 방 대기실(준비 · 시작 · 강퇴 · 채팅 · 방장 승계) · 혼자 하기. 게임은 방마다 인스턴스 룸(RtsMap — 인스턴스 맵)에서 한다.
--   방 채팅은 게임 중에도 이어진다(게임 방 = RtsGameChatLogic, 로비 ↔ 게임 방은 RtsRoomNoticeEvent "chat" · "chatlog" · "chatsync").
--   인스턴스 룸 키: 방 게임 "R<방 번호>_<회차>_<모드>" · 혼자 하기 "S_<번호>" (RtsStageLogic.ApplyRoomKey가 읽는다).
--   로비 상태(Rooms · UserRoom)는 정적 룸 서버에만 있다. 게임 방에서 로비로 돌아올 때 인스턴스 룸이 RtsRoomNoticeEvent로 알린다(RequestLeaveGame · OnGameUserLeave).
--   화면은 RtsLobbyUiLogic(클라) — 이 로직은 서버 판정과 그 화면으로 보내는 전달만 한다.
@Logic
script RtsLobbyLogic extends Logic

	-- 방 최대 인원(2026-09-28 사용자 "4명")
	property number RoomMax = 4

	property string LobbyMapName = "LobbyMap"

	property string GameMapName = "RtsMap"

	-- 방 제목 · 비밀번호 · 채팅 한 줄 글자 수(한글 한 글자 = 1)
	property number TitleMax = 20

	property number PwMax = 8

	property number ChatMax = 60

	-- 방마다 남겨 두는 채팅 줄 수(들어온 사람에게 보여 줄 만큼)
	property number ChatKeep = 30

	-- 인스턴스 룸을 만든 뒤 첫 유저를 기다리는 초(RoomService.CreateInstanceRoom)
	property number RoomWaitSec = 30

	-- 서버(정적 룸): 방 번호 → { no, title, pw, mode, host, members = { userId … 들어온 순 }, ready = { userId → true }, state = "wait"/"play",
	--   key = 게임 중인 인스턴스 룸 키, inGame = { userId → true — 아직 게임 방에 있음 }, chat = { 줄 … } }
	property table Rooms = {}

	-- 서버(정적 룸): userId → 방 번호
	property table UserRoom = {}

	-- 서버(정적 룸): 지금 로비(정적 룸)에 있는 유저 → true
	property table Here = {}

	-- 서버(정적 룸): userId → 닉네임(게임 방에 가 있는 동안에도 방 목록에 보이게 남겨 둔다)
	property table Nick = {}

	property number NextRoomNo = 1

	property number Gen = 0

	property number SoloSerial = 0

	-- 서버(인스턴스 룸): 우리가 로비로 보내는 중인 유저(UserLeaveEvent를 '접속 종료'로 잘못 알리지 않게)
	property table Moving = {}

	-- ===== 서버(정적 룸): 입장 · 퇴장 (RtsBootstrapLogic이 정적 룸에서만 부른다) =====

	@ExecSpace("ServerOnly")
	method void OnUserEnter(string userId)
		local e = _UserService:GetUserEntityByUserId(userId)
		local nick = userId
		if e ~= nil and e.PlayerComponent ~= nil and e.PlayerComponent.Nickname ~= "" then nick = e.PlayerComponent.Nickname end
		self.Nick[userId] = nick
		self.Here[userId] = true
		-- 화면 모드(라이트/다크) · 아이콘을 로비 화면에도(구역 없음 = 0)
		_RtsProfileLogic:OnUserEnter(userId, 0)
		local room = self:RoomOf(userId)
		if room ~= nil then
			-- 게임 방에서 돌아옴(판을 마침) — 방 대기실로
			room.inGame[userId] = nil
			self:SendChatAll(room, userId)
			self:CheckBack(room)
			self:SendRoom(room)
		else
			self.UserRoom[userId] = nil
			_RtsLobbyUiLogic:ShowLobby(userId)
			self:SendList(userId)
		end
		_RtsConfigLogic:Log("RtsLobby: enter " .. userId .. " room " .. tostring(self.UserRoom[userId]))
	end

	@ExecSpace("ServerOnly")
	method void OnUserLeave(string userId)
		self.Here[userId] = nil
		_RtsProfileLogic:OnUserLeave(userId, 0)
		local room = self:RoomOf(userId)
		-- 게임 방으로 옮겨 가는 중이면 방에 그대로 남긴다
		if room ~= nil and room.inGame[userId] then return end
		if room ~= nil then self:RemoveMember(room, userId, "님이 나갔어요") end
		self.Nick[userId] = nil
		_RtsConfigLogic:Log("RtsLobby: leave " .. userId)
	end

	-- ===== 서버(정적 룸): 채널(월드 인스턴스) 목록 · 이동(2026-09-29 사용자 "채널 이동 — 인스턴스 목록 팝업 + 이동하기") =====
	--   목록 = WorldInstanceService.GetWorldInstanceInfoPagesAsync(출시 월드에서만 — Maker는 false), 이동 = TeleportService.WarpUserToWorldInstanceAsync(출시 월드에서만).
	--   조회는 ChannelCacheSec 동안 결과를 재사용한다(인스턴스 조회·이벤트는 월드 전체 분당 1,000회 한도 — .info/lobby.md 4절)
	property string ChannelCache = ""

	property number ChannelCacheAt = -100

	property number ChannelCacheSec = 5

	@ExecSpace("Server")
	method void RequestChannels()
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		local now = _UtilLogic.ServerElapsedSeconds
		if self.ChannelCache ~= "" and now - self.ChannelCacheAt < self.ChannelCacheSec then
			_RtsLobbyUiLogic:ReceiveChannels(self.ChannelCache, userId)
			return
		end
		local mine = _WorldInstanceService.WorldInstanceId or ""
		local asker = userId
		_WorldInstanceService:GetWorldInstanceInfoPagesAsync(function(result, pages)
			if not result or pages == nil then
				-- Maker(출시 전)에선 목록을 못 본다
				_RtsLobbyUiLogic:ReceiveChannels("!maker", asker)
				return
			end
			local rows = {}
			-- 첫 쪽만(인스턴스 수가 쪽 크기를 넘는 일은 드물다 — MoveToNextPageAndWait는 Yield라 콜백 안에서 쓰지 않는다)
			local datas = pages:GetCurrentPageDatas() or {}
			for _, d in pairs(datas) do
				local flag = "0"
				if d.Id == mine then flag = "1" end
				rows[#rows + 1] = tostring(d.Id) .. "\t" .. tostring(d.ShortCode or "") .. "\t" .. string.format("%d", d.CurrentUserCount or 0) .. "\t" .. string.format("%d", d.MaxUserCount or 0) .. "\t" .. flag
			end
			self.ChannelCache = table.concat(rows, "\n")
			self.ChannelCacheAt = _UtilLogic.ServerElapsedSeconds
			_RtsLobbyUiLogic:ReceiveChannels(self.ChannelCache, asker)
		end)
	end

	-- 채널 이동: 방에 들어가 있으면 거절(먼저 나와야), 지금 채널이면 무시. 실패(가득 참·닫히는 중)는 안내
	@ExecSpace("Server")
	method void RequestChannelMove(string instanceId)
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		if instanceId == nil or instanceId == "" then return end
		if instanceId == (_WorldInstanceService.WorldInstanceId or "") then return end
		if self:RoomOf(userId) ~= nil then
			_RtsLobbyUiLogic:Toast("방에서 나온 뒤 채널을 옮길 수 있어요", userId)
			return
		end
		local mover = userId
		_RtsLobbyUiLogic:Toast("채널로 이동 중…", userId)
		_TeleportService:WarpUserToWorldInstanceAsync(userId, instanceId, "", function(ok)
			if not ok then _RtsLobbyUiLogic:Toast("채널로 옮기지 못했어요 — 가득 찼거나 닫히는 중이에요 (출시된 월드에서만 이동돼요)", mover) end
			_RtsConfigLogic:Log("RtsLobby: channel move " .. mover .. " -> " .. instanceId .. " " .. tostring(ok))
		end)
	end

	-- ===== 서버(정적 룸): 요청 =====

	@ExecSpace("Server")
	method void RequestList()
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		self:SendList(userId)
	end

	@ExecSpace("Server")
	method void RequestCreateRoom(string title, string pw, string mode)
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		if self:RoomOf(userId) ~= nil then return end
		if mode ~= "challenge" and mode ~= "race" then return end
		local t = self:Clean(title, self.TitleMax)
		if t == "" then t = (self.Nick[userId] or "") .. "님의 방" end
		local p = self:Clean(pw, self.PwMax)
		local no = self.NextRoomNo
		self.NextRoomNo = self.NextRoomNo + 1
		local room = { no = no, title = t, pw = p, mode = mode, host = userId, members = { userId }, ready = {}, state = "wait", key = "", inGame = {}, chat = {} }
		self.Rooms[no] = room
		self.UserRoom[userId] = no
		self:SystemChat(room, "방을 만들었어요 · 최대 " .. string.format("%d", self.RoomMax) .. "명")
		self:SendRoom(room)
		self:SendChatAll(room, userId)
		self:BroadcastList()
		_RtsConfigLogic:Log("RtsLobby: create room " .. string.format("%d", no) .. " " .. mode .. " by " .. userId)
	end

	@ExecSpace("Server")
	method void RequestJoinRoom(number no, string pw)
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		if self:RoomOf(userId) ~= nil then return end
		local room = self.Rooms[math.floor(no + 0.5)]
		if room == nil then
			_RtsLobbyUiLogic:Toast("없어진 방이에요", userId)
			self:SendList(userId)
			return
		end
		if room.state ~= "wait" then
			_RtsLobbyUiLogic:Toast("게임 중인 방엔 들어갈 수 없어요 — 게임이 끝나면 들어갈 수 있어요", userId)
			return
		end
		if #room.members >= self.RoomMax then
			_RtsLobbyUiLogic:Toast("방이 가득 찼어요", userId)
			return
		end
		if room.pw ~= "" and self:Clean(pw, self.PwMax) ~= room.pw then
			_RtsLobbyUiLogic:Toast("비밀번호가 달라요", userId)
			return
		end
		self:AddMember(room, userId)
	end

	-- 빠른 참가(2026-09-29 사용자 "매칭 기능 삭제 — 매칭 대신 빠른 참가, 빈자리가 있는 방에 막 들어가는 거"):
	--   대기 중 · 빈자리 있음 · 비밀번호 없는 방 가운데 하나(무작위)에 바로 들어간다. 없으면 알림
	@ExecSpace("Server")
	method void RequestQuickJoin()
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		if self:RoomOf(userId) ~= nil then return end
		local open = {}
		for no, r in pairs(self.Rooms) do
			if r.state == "wait" and r.pw == "" and #r.members < self.RoomMax then open[#open + 1] = r end
		end
		if #open == 0 then
			_RtsLobbyUiLogic:Toast("들어갈 수 있는 방이 없어요 — 방을 만들어 보세요", userId)
			return
		end
		local room = open[math.random(1, #open)]
		_RtsConfigLogic:Log("RtsLobby: quick join " .. userId .. " -> room " .. string.format("%d", room.no) .. " (" .. string.format("%d", #open) .. " open)")
		self:AddMember(room, userId)
	end

	@ExecSpace("Server")
	method void RequestLeaveRoom()
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		local room = self:RoomOf(userId)
		if room == nil then return end
		self:RemoveMember(room, userId, "님이 나갔어요")
	end

	@ExecSpace("Server")
	method void RequestReady(boolean on)
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		local room = self:RoomOf(userId)
		if room == nil or room.state ~= "wait" or room.host == userId then return end
		if on then room.ready[userId] = true else room.ready[userId] = nil end
		self:SendRoom(room)
	end

	-- 방장만: 다른 사람 내보내기
	@ExecSpace("Server")
	method void RequestKick(string targetId)
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		local room = self:RoomOf(userId)
		if room == nil or room.host ~= userId or targetId == userId or room.state ~= "wait" then return end
		if self.UserRoom[targetId] ~= room.no then return end
		_RtsLobbyUiLogic:Toast("방장이 방에서 내보냈어요", targetId)
		self:RemoveMember(room, targetId, "님을 방장이 내보냈어요")
	end

	-- 방장만: 모두(방장 빼고) 준비했으면 시작 → 게임용 인스턴스 룸을 만들고 방 인원을 옮긴다
	@ExecSpace("Server")
	method void RequestStart()
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		local room = self:RoomOf(userId)
		if room == nil or room.host ~= userId or room.state ~= "wait" then return end
		for i = 1, #room.members do
			local m = room.members[i]
			if m ~= room.host and not room.ready[m] then
				_RtsLobbyUiLogic:Toast("모두 준비해야 시작할 수 있어요", userId)
				return
			end
		end
		self.Gen = self.Gen + 1
		local key = "R" .. string.format("%d", room.no) .. "_" .. string.format("%d", self.Gen) .. "_" .. room.mode
		local ir = _RoomService:CreateInstanceRoom(key, { self.GameMapName }, self.RoomWaitSec)
		if ir == nil then
			_RtsLobbyUiLogic:Toast("게임 방을 만들지 못했어요 — 잠시 뒤 다시 시작해 주세요", userId)
			return
		end
		local ids = {}
		for i = 1, #room.members do
			local m = room.members[i]
			ids[#ids + 1] = m
			room.inGame[m] = true
		end
		room.state = "play"
		room.key = key
		room.ready = {}
		-- 이 줄은 게임 방으로 따로 보내지 않는다 — 게임 방이 첫 입장 때 기록 전체를 받아 간다("chatsync")
		self:AddChatFrom(room, "· 게임을 시작해요", true)
		self:SendRoom(room)
		self:BroadcastList()
		local moved = _RoomService:MoveUsersToInstanceRoom(key, ids, self.GameMapName)
		_RtsConfigLogic:Log("RtsLobby: start room " .. string.format("%d", room.no) .. " key " .. key .. " moved " .. tostring(moved) .. "/" .. string.format("%d", #ids))
	end

	@ExecSpace("Server")
	method void RequestChat(string text)
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		local room = self:RoomOf(userId)
		if room == nil then return end
		local t = self:Clean(text, self.ChatMax)
		if t == "" then return end
		self:AddChat(room, (self.Nick[userId] or userId) .. " : " .. t)
	end

	-- 혼자 하기: 혼자 쓰는 인스턴스 룸으로(지금까지의 솔로 판 — 일시정지 가능, 모드는 판 시작 전에 고른다)
	@ExecSpace("Server")
	method void RequestSolo()
		local userId = senderUserId
		if userId == nil or userId == "" or _RoomService:IsInstanceRoom() then return end
		if self:RoomOf(userId) ~= nil then
			_RtsLobbyUiLogic:Toast("방에서 나온 뒤 혼자 하기를 누르세요", userId)
			return
		end
		self.SoloSerial = self.SoloSerial + 1
		local key = "S_" .. string.format("%d", self.SoloSerial)
		local ir = _RoomService:CreateInstanceRoom(key, { self.GameMapName }, self.RoomWaitSec)
		if ir == nil then
			_RtsLobbyUiLogic:Toast("게임 방을 만들지 못했어요 — 잠시 뒤 다시 눌러 주세요", userId)
			return
		end
		local ok = _RoomService:MoveUserToInstanceRoom(key, userId, self.GameMapName)
		_RtsConfigLogic:Log("RtsLobby: solo " .. key .. " " .. userId .. " moved " .. tostring(ok))
	end

	-- ===== 서버(정적 룸): 게임 방에서 온 알림 =====

	@ExecSpace("ServerOnly")
	@EventSender("Service", "RoomService")
	handler HandleRtsRoomNoticeEvent(RtsRoomNoticeEvent event)
		if _RoomService:IsInstanceRoom() then
			-- 게임 방: 로비가 보낸 방 채팅(한 줄 · 기록 전체)
			if event.RoomKey ~= _RoomService.RoomKey then return end
			if event.Kind == "chat" then
				_RtsGameChatLogic:AddLine(event.Text)
			elseif event.Kind == "chatlog" then
				_RtsGameChatLogic:SetLog(event.Text)
			end
			return
		end
		local userId = event.UserId
		local room = self:RoomOf(userId)
		_RtsConfigLogic:Log("RtsLobby: notice " .. event.Kind .. " " .. userId .. " " .. event.RoomKey)
		if room == nil or room.key ~= event.RoomKey then return end
		if event.Kind == "back" then
			room.inGame[userId] = nil
			self:CheckBack(room)
		elseif event.Kind == "left" then
			self:RemoveMember(room, userId, "님이 게임 도중에 나갔어요")
		elseif event.Kind == "quit" then
			self:RemoveMember(room, userId, "님의 접속이 끊겼어요")
		elseif event.Kind == "chat" then
			-- 게임 안에서 한 말 → 방 기록 · 대기실 사람들(게임 방으로 되돌려 보내지 않는다)
			self:AddChatFrom(room, event.Text, true)
		elseif event.Kind == "chatsync" then
			self:SendToGame(room.key, "chatlog", table.concat(room.chat, "\n"))
		end
	end

	-- ===== 서버(인스턴스 룸): 로비로 보내기 =====

	-- 게임 방 → 로비: kind "back" = 판을 마치고 방 대기실로(방 게임에서 끝났을 때만 — 아직 달리는 중이면 "left"로 바꾼다) ·
	--   "left" = 도중에 나가기(방에서도 빠져 로비로 — 2026-09-28 사용자 "도중에 나가면 그냥 나가는 거임") · 혼자 하기 판은 늘 로비로
	@ExecSpace("Server")
	method void RequestLeaveGame(string kind)
		local userId = senderUserId
		if userId == nil or userId == "" or not _RoomService:IsInstanceRoom() then return end
		local S = _RtsStageLogic
		local k = "lobby"
		if S.RoomNo > 0 then
			local finished = S.RunState == "ended" or not _RtsRunResultLogic:IsAlive(userId)
			k = "left"
			if kind == "back" and finished then k = "back" end
		end
		self.Moving[userId] = true
		if S.RoomNo > 0 then self:NoticeLobby(k, userId, "") end
		_RtsConfigLogic:Log("RtsLobby: leave game " .. k .. " " .. userId .. " from " .. _RoomService.RoomKey)
		-- 옮기지 못하면(Maker에서 시작 맵이 게임 맵이라 로비 룸이 없을 때 등) 알려 준다
		if not _RoomService:MoveUserToStaticRoom(userId, self.LobbyMapName) then
			self.Moving[userId] = nil
			_RtsConfigLogic:Log("RtsLobby: move to lobby failed " .. userId)
			_RtsLobbyUiLogic:Toast("로비로 가지 못했어요 — 잠시 뒤 다시 시도해 주세요", userId)
		end
	end

	-- 인스턴스 룸 퇴장(RtsBootstrapLogic): 우리가 로비로 보낸 게 아니면 접속 종료 → 방 게임이면 로비에 알림
	@ExecSpace("ServerOnly")
	method void OnGameUserLeave(string userId)
		if self.Moving[userId] then
			self.Moving[userId] = nil
			return
		end
		if _RtsStageLogic.RoomNo > 0 then self:NoticeLobby("quit", userId, "") end
	end

	@ExecSpace("ServerOnly")
	method void NoticeLobby(string kind, string userId, string text)
		local evt = RtsRoomNoticeEvent()
		evt.Kind = kind
		evt.UserId = userId
		evt.RoomKey = _RoomService.RoomKey
		evt.Text = text
		_RoomService:RequestSendEventToRoomAsync(evt, _RoomService.StaticRoomKey, function(code, sent)
			if code ~= SendEventRequestResultCode.OK then _RtsConfigLogic:Log("RtsLobby: notice send failed " .. kind .. " " .. userId .. " code " .. tostring(code)) end
		end)
	end

	-- ===== 서버(정적 룸): 내부 =====

	@ExecSpace("ServerOnly")
	method table RoomOf(string userId)
		local no = self.UserRoom[userId]
		if no == nil then return nil end
		local room = self.Rooms[no]
		if room == nil then self.UserRoom[userId] = nil end
		return room
	end

	-- 방에 넣기(입장 · 빠른 참가 공용 — 검사는 부르는 쪽): 들어왔다는 알림 · 방 화면 · 채팅 기록 · 목록
	@ExecSpace("ServerOnly")
	method void AddMember(table room, string userId)
		room.members[#room.members + 1] = userId
		self.UserRoom[userId] = room.no
		self:SystemChat(room, (self.Nick[userId] or userId) .. "님이 들어왔어요")
		self:SendRoom(room)
		self:SendChatAll(room, userId)
		self:BroadcastList()
	end

	-- 방에서 빼기: 빈 방은 없애고, 방장이면 다음 사람(들어온 순)이 이어받는다. 로비에 있으면 로비 화면으로
	@ExecSpace("ServerOnly")
	method void RemoveMember(table room, string userId, string why)
		local idx = 0
		for i = 1, #room.members do
			if room.members[i] == userId then idx = i end
		end
		if idx > 0 then table.remove(room.members, idx) end
		room.ready[userId] = nil
		room.inGame[userId] = nil
		self.UserRoom[userId] = nil
		if self.Here[userId] then
			_RtsLobbyUiLogic:ShowLobby(userId)
			self:SendList(userId)
		end
		if #room.members == 0 then
			self.Rooms[room.no] = nil
			self:BroadcastList()
			_RtsConfigLogic:Log("RtsLobby: room " .. string.format("%d", room.no) .. " closed")
			return
		end
		if why ~= "" then self:SystemChat(room, (self.Nick[userId] or userId) .. why) end
		if room.host == userId then
			room.host = room.members[1]
			room.ready[room.host] = nil
			self:SystemChat(room, (self.Nick[room.host] or room.host) .. "님이 방장이 됐어요")
		end
		self:CheckBack(room)
		self:SendRoom(room)
		self:BroadcastList()
	end

	-- 게임 중인 방에 아무도 남지 않았으면(모두 돌아왔거나 나감) 다시 대기 — 이때부터 다른 사람이 들어올 수 있다
	@ExecSpace("ServerOnly")
	method void CheckBack(table room)
		if room.state ~= "play" then return end
		for uid, v in pairs(room.inGame) do
			if v then return end
		end
		room.state = "wait"
		room.key = ""
		room.ready = {}
		self:SystemChat(room, "모두 돌아왔어요 · 준비하면 한 판 더 할 수 있어요")
		self:SendRoom(room)
		self:BroadcastList()
	end

	@ExecSpace("ServerOnly")
	method void SystemChat(table room, string text)
		self:AddChat(room, "· " .. text)
	end

	@ExecSpace("ServerOnly")
	method void AddChat(table room, string line)
		self:AddChatFrom(room, line, false)
	end

	-- 방 채팅 한 줄기(2026-09-29 사용자 "방에서 게임 시작해도 채팅 유지"): 기록에 더하고 대기실 사람들에게 보낸다.
	--   방이 게임 중이면 게임 방에도 보낸다(fromGame = 게임 방에서 온 줄이면 되돌려 보내지 않는다)
	@ExecSpace("ServerOnly")
	method void AddChatFrom(table room, string line, boolean fromGame)
		room.chat[#room.chat + 1] = line
		while #room.chat > self.ChatKeep do table.remove(room.chat, 1) end
		for i = 1, #room.members do
			local m = room.members[i]
			if self.Here[m] and not room.inGame[m] then _RtsLobbyUiLogic:ReceiveChat(line, false, m) end
		end
		if not fromGame and room.state == "play" and room.key ~= "" then self:SendToGame(room.key, "chat", line) end
	end

	-- 로비 → 게임 방(RtsRoomNoticeEvent): 방 채팅 한 줄("chat") · 기록 전체("chatlog")
	@ExecSpace("ServerOnly")
	method void SendToGame(string key, string kind, string text)
		local evt = RtsRoomNoticeEvent()
		evt.Kind = kind
		evt.RoomKey = key
		evt.Text = text
		_RoomService:RequestSendEventToRoomAsync(evt, key, function(code, sent)
			if code ~= SendEventRequestResultCode.OK then _RtsConfigLogic:Log("RtsLobby: send to game failed " .. kind .. " " .. key .. " code " .. tostring(code)) end
		end)
	end

	@ExecSpace("ServerOnly")
	method void SendChatAll(table room, string userId)
		if not self.Here[userId] then return end
		_RtsLobbyUiLogic:ReceiveChat(table.concat(room.chat, "\n"), true, userId)
	end

	-- 방 한 개 → "번호\t제목\t모드\t상태\t비번(0/1)\t방장\n" + 사람마다 "userId\t닉네임\t준비(0/1)\t게임 중(0/1)\t프로필 아이콘" 줄
	--   (아이콘은 대기실 자리 카드의 동그란 얼굴 — 프로필을 아직 못 읽었으면 RtsProfileLogic.IconNone)
	@ExecSpace("ServerOnly")
	method string PackRoom(table room)
		local pw = "0"
		if room.pw ~= "" then pw = "1" end
		local lines = { string.format("%d", room.no) .. "\t" .. room.title .. "\t" .. room.mode .. "\t" .. room.state .. "\t" .. pw .. "\t" .. room.host }
		for i = 1, #room.members do
			local m = room.members[i]
			local ready = "0"
			if room.ready[m] then ready = "1" end
			local inGame = "0"
			if room.inGame[m] then inGame = "1" end
			lines[#lines + 1] = m .. "\t" .. (self.Nick[m] or m) .. "\t" .. ready .. "\t" .. inGame .. "\t" .. _RtsProfileLogic:IconOf(m)
		end
		return table.concat(lines, "\n")
	end

	@ExecSpace("ServerOnly")
	method void SendRoom(table room)
		local packed = self:PackRoom(room)
		for i = 1, #room.members do
			local m = room.members[i]
			if self.Here[m] and not room.inGame[m] then _RtsLobbyUiLogic:ReceiveRoom(packed, m) end
		end
	end

	-- 방 목록 → 방마다 "번호\t제목\t모드\t인원\t상태\t비번(0/1)" 줄(번호 순)
	@ExecSpace("ServerOnly")
	method string PackList()
		local rows = {}
		for no, r in pairs(self.Rooms) do rows[#rows + 1] = r end
		table.sort(rows, function(a, b) return a.no < b.no end)
		local lines = {}
		for i = 1, #rows do
			local r = rows[i]
			local pw = "0"
			if r.pw ~= "" then pw = "1" end
			lines[#lines + 1] = string.format("%d", r.no) .. "\t" .. r.title .. "\t" .. r.mode .. "\t" .. string.format("%d", #r.members) .. "\t" .. r.state .. "\t" .. pw
		end
		return table.concat(lines, "\n")
	end

	@ExecSpace("ServerOnly")
	method void SendList(string userId)
		if not self.Here[userId] then return end
		_RtsLobbyUiLogic:ReceiveList(self:PackList(), userId)
	end

	-- 방에 안 들어간 채 로비에 있는 사람 모두에게 방 목록
	@ExecSpace("ServerOnly")
	method void BroadcastList()
		local packed = self:PackList()
		for uid, here in pairs(self.Here) do
			if here and self.UserRoom[uid] == nil then _RtsLobbyUiLogic:ReceiveList(packed, uid) end
		end
	end

	-- 글 정리: 탭 · 줄바꿈 → 빈칸, 앞뒤 빈칸 제거, 글자 수(UTF-8 한 글자 = 1) max까지
	method string Clean(string s, number max)
		if s == nil then return "" end
		local t = (string.gsub(s, "[\t\r\n]", " "))
		t = (string.gsub(t, "^%s+", ""))
		t = (string.gsub(t, "%s+$", ""))
		local out = {}
		local n = 0
		for ch in string.gmatch(t, "[%z\1-\127\194-\244][\128-\191]*") do
			n = n + 1
			if n > max then break end
			out[#out + 1] = ch
		end
		return table.concat(out)
	end

end
