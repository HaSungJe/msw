-- rts-base #2: HUD v2 (화면 v2 — 아티팩트 v16) + Phase 6 (2026-09-23)
--   하단 바(미니맵·초상화·정보·스킬칸·부대지정) 전부 제거.
--   좌상단 정보 카드 한 장(라운드·스페셜·남은 시간 / 맵 이름 / 메소·필드 n / 110) / 좌측 플레이어 목록(n/8, 생존·탈락, 나, 클릭→그 구역) /
--   상단 가운데 큰 영입 버튼(한도 표시) + 오른쪽 '다시 하기' 투표(언제든) / 우측 유닛 슬롯 6 / 좌하단 증강 버튼. 팝업은 RtsPopupLogic. 스테이지·필드·영입 버튼은 RtsStageLogic.RefreshHud가 0.25초마다.
--   UI 좌표는 1920×1080 기준(목업 1cqw = 19.2px).
@Logic
script RtsHudLogic extends Logic

	property boolean Built = false

	-- 스프라이트 RUID
	property string WhiteRUID = "47b5e516b27d4625abffe8db398cd8c2"

	property string CoinRUID = "288ed505d45844c3b717ec9072738b64"

	-- 런타임 참조
	property Entity HudGroup = nil

	property Entity AnchorEntity = nil

	-- 좌상단 정보 카드(2026-09-23 사용자 "메소·필드·맵 정보 하나로"): 윗줄 라운드(+스페셜)·시간, 가운데 맵 이름, 아랫줄 메소·필드
	property Entity StageTitleText = nil

	property Entity StageSubText = nil

	property Entity StageClockText = nil

	property Entity MesoText = nil

	property Entity FieldText = nil

	-- 상단 가운데 영입 버튼(바깥 테두리·안쪽·글자)과 표시 상태
	property Entity RecruitBtn = nil

	property Entity RecruitText = nil

	property string RecruitShown = ""

	property number RecruitRoomPrev = 0

	-- 영입 칸이 새로 열릴 때(판 시작·5·자쿰·혼테일·핑크빈·시그너스) 알림음 = 증강 3택1이 뜰 때와 같은 원작 업적 달성음 sound/achievementeff/achievmentcomplete
	--   (2026-09-24 사용자 "영입 가능 표시 뜰 때 증강 나오는 것처럼 사운드" — 전엔 sound/ui/dlgnotice 5db4f31b…, RtsPopupLogic.PickSound와 같은 RUID)
	--   RecruitLimitPrev = 직전 영입 한도(진행 중이 아니면 0으로 되돌려 새 판 시작에도 울린다). 방출로 빈 칸이 생긴 건 울리지 않음
	property number RecruitLimitPrev = 0

	property string RecruitSound = "dbb38b4f04044499906bd7a2ca9c4d7c"

	-- 영입 칸이 새로 열렸을 때 반짝임 끝 시각(ElapsedSeconds)·토글
	property number RecruitFlashUntil = 0

	property boolean RecruitFlashOn = false

	property string StageShown = ""

	property Entity PlayersBox = nil

	-- 좌상단 프로필 상자(2026-09-25 사용자 "맵 테마 창을 프로필 설정으로" → "좌측을 아이콘으로, 테마를 배경으로"): 배경 = 내 테마 썸네일 + 어두운 막,
	--   왼쪽 동그란 내 아이콘 · "프로필 설정" · "테마 ○○". 누르면 프로필 창
	property Entity ProfileBg = nil

	property Entity ProfileIconSlot = nil

	property Entity ProfileIconFace = nil

	property string ProfileIconId = ""

	property Entity ProfileSummary = nil

	-- 원형 마스크 스프라이트(흰 원, assets/textures/circle-mask.png — 2026-09-25 업로드 RtsCircleMask) — 유저 카드의 동그란 아이콘 칸. ""면 네모 칸
	property string CircleMaskRUID = "69e2dced65e443d3bb391464fd64b123"

	-- 유저 카드 크기·간격(2026-09-25 사용자 "영역을 좀 키워서 — 배경 테마 썸네일, 좌측 동그라미 아이콘, 우측 닉네임"
	--   → "박스 크기를 배경 사진 비율에 맞게 — 총 4명으로 조절할 거라 조금 높아져도 됨": 280×56 → 5:3 250×150, 세로 4장)
	property number CardW = 250

	property number CardH = 150

	property number CardGap = 8

	property Entity PlayerHead = nil

	-- 플레이어 목록(유저 카드) 상태: userId → {row, shade, slot, face, tomb, name, zone, alive, nick, isMe, theme, icon} / 표시 순서
	property table Players = {}

	property table PlayerOrder = {}

	-- HUD 생성 전에 도착한 목록 통지
	property string PendingPlayers = ""

	property number WatchedZone = 0

	property string MyUserId = ""

	-- 유닛 슬롯 6: i → {box, bar, name, lv, filled}
	property table UnitSlots = {}

	property number SelectedSlot = 0

	-- HUD 생성 전에 유닛이 먼저 동기화된 경우 표시 예약
	property boolean PendingUnits = false

	-- 상단 중앙 안내(위치 이동 모드 등)
	property Entity Hint = nil

	property Entity HintText = nil

	property number HintGen = 0

	-- 좌하단 증강 버튼(안쪽·글자)과 표시 중인 미지정 수
	property Entity AugBtn = nil

	-- 증강 버튼 오른쪽 '펼치기 (n)' — 접어 둔(고르지 않은) 증강 선택지가 있을 때만(2026-09-23 사용자)
	property Entity ExpandBtn = nil

	property Entity ExpandLabel = nil

	property string ExpandShown = ""

	-- 증강 버튼 위 '증강 뽑기 n' 버튼(2026-09-23 사용자 — 메소로 증강 뽑기, 로드맵 #43). 뽑을 수 있으면 금색, 아니면 흐리게
	property Entity BuyBtn = nil

	property Entity BuyLabel = nil

	property string BuyShown = ""

	-- 뽑기 버튼의 '프리즘 남은/최대'(2026-09-24 사용자 "추가 획득 가능한 프리즘 개수 2/2") — RtsAugmentLogic.ClientTick이 SetBuyPrism으로
	property number BuyPrismLeft = 2

	property number BuyPrismMax = 2

	-- 다음 뽑기의 프리즘 확률 %(천장 포함 — RtsAugmentLogic.BuyPrismRate)
	property number BuyPrismRatePct = 5

	property Entity AugLabel = nil

	property number AugShown = -1

	-- 스테이지 칩 오른쪽 '다시 하기' 투표 버튼(2026-09-23 사용자 "죽었을 때 말고 라운드 오른쪽에 기본으로 — 언제든 도중에 투표로 다시 하기")
	property Entity RestartBtn = nil

	property Entity RestartText = nil

	property string RestartShown = ""

	-- 진행 중 실수 방지: 첫 클릭 뒤 이 시각(ElapsedSeconds)까지 한 번 더 누르면 찬성
	property number RestartConfirmUntil = 0

	-- UI 효과음(2026-09-24 사용자 "버튼 클릭 · 창 오픈 때 다 효과음"): 원작 sound/ui — BtMouseClick · MenuUp · MenuDown
	property string ClickSound = "972843e759204d3e9ad84e7d3fa94f83"

	property string OpenSound = "585c8f6d8891403f8717c378ab2f7c78"

	property string CloseSound = "69f85d65004541db82615459032e1d4a"

	-- 다시 하기 투표 패널(2026-09-24 사용자 "다시 투표 시 찬성/반대 표 나오게"): '다시 하기' 버튼 아래 — 찬성·반대 수 + 두 버튼(투표가 열려 있을 때만)
	property Entity VotePanel = nil

	property Entity VoteText = nil

	property Entity VoteYesBtn = nil

	property Entity VoteNoBtn = nil

	property string VoteShown = ""

	-- ===== UI 헬퍼 (RtsPopupLogic도 사용) =====

	@ExecSpace("ClientOnly")
	method Entity SpawnUI(string modelId, string name, Entity parent, Vector2 anchor, Vector2 pivot, Vector2 pos, Vector2 size)
		local e = _SpawnService:SpawnByModelId(modelId, name, Vector3.zero, parent)
		if e == nil then return nil end
		local t = e.UITransformComponent
		t.AnchorsMin = anchor
		t.AnchorsMax = anchor
		t.Pivot = pivot
		t.anchoredPosition = pos
		t.RectSize = size
		local sr = e.SpriteGUIRendererComponent
		if sr ~= nil then
			sr.ImageRUID = DataRef(self.WhiteRUID)
		end
		return e
	end

	-- 스크립트로 만든 UI 그룹을 화면 전체로 늘린다(2026-09-24 출시 클라이언트에서 HUD가 화면 가운데로 몰림 —
	--   model://uigroup은 크기·앵커를 주지 않으면 실제 클라이언트에서 작은 기본 크기로 가운데에 생긴다. Maker Play에선 화면 크기라 안 드러났다)
	@ExecSpace("ClientOnly")
	method void StretchFull(Entity e)
		if e == nil then return end
		local t = e.UITransformComponent
		if t == nil then return end
		t.AnchorsMin = Vector2(0, 0)
		t.AnchorsMax = Vector2(1, 1)
		t.Pivot = Vector2(0.5, 0.5)
		t.OffsetMin = Vector2(0, 0)
		t.OffsetMax = Vector2(0, 0)
	end

	-- 스트레치 배치: 앵커 구간 + 오프셋(좌하/우상)으로 부모에 맞춰 늘어나는 요소용
	@ExecSpace("ClientOnly")
	method Entity SpawnStretch(string modelId, string name, Entity parent, Vector2 aMin, Vector2 aMax, Vector2 offMin, Vector2 offMax)
		local e = _SpawnService:SpawnByModelId(modelId, name, Vector3.zero, parent)
		if e == nil then return nil end
		local t = e.UITransformComponent
		t.AnchorsMin = aMin
		t.AnchorsMax = aMax
		t.OffsetMin = offMin
		t.OffsetMax = offMax
		local sr = e.SpriteGUIRendererComponent
		if sr ~= nil then
			sr.ImageRUID = DataRef(self.WhiteRUID)
		end
		return e
	end

	@ExecSpace("ClientOnly")
	method void Tint(Entity e, number r, number g, number b, number a)
		if e == nil then return end
		local sr = e.SpriteGUIRendererComponent
		if sr ~= nil then sr.Color = Color(r, g, b, a) end
	end

	@ExecSpace("ClientOnly")
	method Entity SpawnText(string name, Entity parent, Vector2 anchor, Vector2 pivot, Vector2 pos, Vector2 size, string text, Color color)
		local e = self:SpawnUI("model://uitext", name, parent, anchor, pivot, pos, size)
		if e == nil then return nil end
		self:Tint(e, 1, 1, 1, 0)
		if e.TextComponent ~= nil then
			e.TextComponent.Text = text
			e.TextComponent.FontColor = color
		end
		return e
	end

	-- 글자 크기·정렬·굵기까지 한 번에
	@ExecSpace("ClientOnly")
	method Entity SpawnLabel(string name, Entity parent, Vector2 anchor, Vector2 pivot, Vector2 pos, Vector2 size, string text, Color color, number fontSize, any align, boolean bold)
		local e = self:SpawnText(name, parent, anchor, pivot, pos, size, text, color)
		if e == nil then return nil end
		local tc = e.TextComponent
		if tc ~= nil then
			tc.FontSize = fontSize
			tc.Alignment = align
			tc.Bold = bold
			-- 글이 칸보다 크면 칸에 맞춰 글자를 줄인다(BestFit: MaxSize = 원래 크기, MinSize = 60% — 2026-09-24 사용자 "자꾸 텍스트 영역 찐빠").
			--   칸마다 글자 수를 어림해 맞추던 방식은 어림이 빗나가면 넘치거나 두 줄로 꺾여 겹쳤다 → 모든 라벨을 여기서 한 번에 막는다.
			--   나중에 글자 크기를 바꿀 땐 FontSize가 아니라 MaxSize를 바꾼다(SetLabelSize)
			local fs = math.floor(fontSize + 0.5)
			tc.BestFit = true
			tc.MaxSize = fs
			tc.MinSize = math.max(9, math.floor(fs * 0.6))
		end
		return e
	end

	-- 라벨 글자 크기 바꾸기(BestFit 라벨은 MaxSize가 실제 최대 크기)
	@ExecSpace("ClientOnly")
	method void SetLabelSize(Entity e, number size)
		if e == nil or e.TextComponent == nil then return end
		local fs = math.floor(size + 0.5)
		local tc = e.TextComponent
		tc.FontSize = fs
		tc.MaxSize = fs
		tc.MinSize = math.max(9, math.floor(fs * 0.6))
	end

	-- 테두리 있는 패널: 바깥(테두리색) + 안쪽(배경색, thick만큼 안으로). 자식은 안쪽에 붙인다
	@ExecSpace("ClientOnly")
	method Entity SpawnPanel(string name, Entity parent, Vector2 anchor, Vector2 pivot, Vector2 pos, Vector2 size, Color bg, Color border, number thick)
		local outer = self:SpawnUI("model://uisprite", name, parent, anchor, pivot, pos, size)
		if outer == nil then return nil end
		outer.SpriteGUIRendererComponent.Color = border
		local inner = self:SpawnStretch("model://uisprite", name .. "In", outer,
			Vector2(0, 0), Vector2(1, 1), Vector2(thick, thick), Vector2(0 - thick, 0 - thick))
		inner.SpriteGUIRendererComponent.Color = bg
		return inner
	end

	-- 투명 클릭 영역 (부모 rect 전체)
	@ExecSpace("ClientOnly")
	method Entity SpawnClick(string name, Entity parent)
		local b = self:SpawnStretch("model://uibutton", name, parent, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		if b ~= nil then
			self:Tint(b, 1, 1, 1, 0.01)
			-- 모든 UI 버튼 클릭음(2026-09-24 사용자)
			b:ConnectEvent(ButtonClickEvent, function(event)
				self:PlayUi(self.ClickSound)
			end)
		end
		return b
	end

	-- 클릭음 없는 버튼(누르면 자기 소리가 따로 나는 곳 — 예: '펼치기'는 3택1 등장음이 난다, 2026-09-24 사용자 "펼칠 때 소리 중복")
	@ExecSpace("ClientOnly")
	method Entity SpawnClickQuiet(string name, Entity parent)
		local b = self:SpawnStretch("model://uibutton", name, parent, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		if b ~= nil then self:Tint(b, 1, 1, 1, 0.01) end
		return b
	end

	-- UI 효과음 한 번(클라)
	@ExecSpace("ClientOnly")
	method void PlayUi(string ruid)
		if ruid == nil or ruid == "" then return end
		_SoundService:PlaySound(ruid, 1)
	end

	-- 팔레트
	method Color ColInk()
		return Color(0.957, 0.914, 0.812, 1)
	end

	method Color ColMuted()
		return Color(0.788, 0.710, 0.541, 1)
	end

	method Color ColGold()
		return Color(0.878, 0.725, 0.353, 1)
	end

	method Color ColPanel()
		return Color(0.094, 0.082, 0.071, 0.86)
	end

	method Color ColBorder()
		return Color(0.788, 0.635, 0.290, 0.55)
	end

	method Color ColBorderSoft()
		return Color(0.788, 0.635, 0.290, 0.35)
	end

	-- 계열 색 (좌측 세로 바)
	method Color SeriesColor(string series)
		if series == "war" then return Color(0.839, 0.471, 0.353, 1) end
		if series == "arc" then return Color(0.310, 0.604, 0.388, 1) end
		if series == "mag" then return Color(0.357, 0.525, 0.847, 1) end
		if series == "thf" then return Color(0.557, 0.357, 0.847, 1) end
		return Color(0.541, 0.498, 0.439, 1)
	end

	-- ===== HUD 생성 =====

	@ExecSpace("ClientOnly")
	method void BuildHud(Entity anchorEntity)
		if self.Built then return end
		self.AnchorEntity = anchorEntity
		local ui = _EntityService:GetEntityByPath("/ui")
		if ui == nil then
			_RtsConfigLogic:Log("RtsHud: /ui not found")
			return
		end
		local lp = _UserService.LocalPlayer
		if lp ~= nil and lp.PlayerComponent ~= nil then self.MyUserId = lp.PlayerComponent.UserId end

		local grp = _SpawnService:SpawnByModelId("model://uigroup", "RtsHudGroup", Vector3.zero, ui)
		if grp == nil then
			_RtsConfigLogic:Log("RtsHud: group spawn failed")
			return
		end
		if grp.UIGroupComponent ~= nil then grp.UIGroupComponent.DefaultShow = true end
		self:StretchFull(grp)
		grp:SetEnable(true)
		self.HudGroup = grp

		-- 좌상단 정보 카드 한 장(2026-09-23 사용자 "글이 길어지면 깨진다 — 메소·필드·맵 정보 하나로 깔끔하게"):
		--   윗줄 = "109라운드  스페셜"(굵게) + 오른쪽 남은 시간 / 둘째 줄 = "지역 - 맵"(카드 폭 전체) / 셋째 줄 = 난이도(금색, RtsDifficultyLogic) / 구분선 / 아랫줄 = 메소(동전) + 오른쪽 필드 n / 110
		--   2026-09-24 사용자 "글자가 크면 높이를 늘려" — 난이도가 맵 이름 오른쪽 120px에 들어가지 않아 두 줄로 꺾여 겹쳤다 → 자기 줄로, 카드 112 → 138
		-- 2026-09-25 사용자 "프로필 상자와 정보 카드를 하나로 합치고 배경을 보여줘": 상자 하나(400×240 = 테마 썸네일 원본 크기 — 늘리거나 자르지 않는다) 안에
		--   위 64 = 프로필 줄(BuildTopBox), 그 아래 = 정보 칸 RtsInfoCard(투명, 400×168 — 안쪽 좌표는 예전 정보 카드와 같다. 난이도 줄은 RtsDifficultyLogic이 여기 붙인다)
		local card = self:BuildTopBox(grp)
		self.StageTitleText = self:SpawnLabel("RtsStageTitle", card, Vector2(0, 1), Vector2(0, 1), Vector2(14, -8), Vector2(290, 32),
			"대기 중", self:ColInk(), 22, TextAlignmentType.MiddleLeft, true)
		self.StageTitleText.TextComponent.IsRichText = true
		self.StageTitleText.TextComponent.Overflow = OverflowType.Truncate
		self.StageClockText = self:SpawnLabel("RtsStageClock", card, Vector2(1, 1), Vector2(1, 1), Vector2(-14, -8), Vector2(90, 32),
			"", self:ColInk(), 22, TextAlignmentType.MiddleRight, true)
		-- 맵 이름(2026-09-24 사용자 "맵 명이 너무 작게 표시됨" — 15 → 18). 칸 폭 전체(372) — 난이도는 아랫줄(RtsDifficultyLogic)
		self.StageSubText = self:SpawnLabel("RtsStageSub", card, Vector2(0, 1), Vector2(0, 1), Vector2(14, -38), Vector2(372, 28),
			"", Color(0.86, 0.82, 0.74, 1), 18, TextAlignmentType.MiddleLeft, false)
		self.StageSubText.TextComponent.Overflow = OverflowType.Truncate
		self.StageSubText.TextComponent.UseNBSP = true
		local line = self:SpawnUI("model://uisprite", "RtsInfoLine", card, Vector2(0, 1), Vector2(0, 1), Vector2(12, -110), Vector2(376, 1.5))
		line.SpriteGUIRendererComponent.ImageRUID = DataRef(self.WhiteRUID)
		line.SpriteGUIRendererComponent.Color = self:ColBorderSoft()
		local coin = self:SpawnUI("model://uisprite", "RtsMesoCoin", card, Vector2(0, 0), Vector2(0, 0.5), Vector2(14, 22), Vector2(24, 24))
		coin.SpriteGUIRendererComponent.ImageRUID = DataRef(self.CoinRUID)
		coin.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		self.MesoText = self:SpawnLabel("RtsMesoText", card, Vector2(0, 0), Vector2(0, 0.5), Vector2(46, 22), Vector2(200, 32),
			"0", self:ColInk(), 22, TextAlignmentType.MiddleLeft, true)
		-- 필드: 내 구역에 살아 있는 몹 수 / 110(탈락선). 90 이상 붉게
		self:SpawnLabel("RtsFieldKey", card, Vector2(1, 0), Vector2(1, 0.5), Vector2(-122, 22), Vector2(44, 28),
			"필드", Color(0.86, 0.82, 0.74, 1), 15, TextAlignmentType.MiddleRight, false)
		self.FieldText = self:SpawnLabel("RtsFieldText", card, Vector2(1, 0), Vector2(1, 0.5), Vector2(-14, 22), Vector2(104, 32),
			"0 / 110", self:ColInk(), 20, TextAlignmentType.MiddleRight, true)

		-- 좌측 유저 카드 목록 (카드는 RefreshPlayerList가 채움) — 합친 상자(y −16, 높이 240) 10px 아래. 머리 24 + 카드 4장(2026-09-25 사용자 "총 4명으로 조절할 거임")
		local box = self:SpawnUI("model://uisprite", "RtsPlayers", grp, Vector2(0, 1), Vector2(0, 1), Vector2(16, -266), Vector2(self.CardW, 24 + 4 * (self.CardH + self.CardGap)))
		self:Tint(box, 0, 0, 0, 0)
		self.PlayersBox = box
		self.PlayerHead = self:SpawnLabel("RtsPlayerHead", box, Vector2(0, 1), Vector2(0, 1), Vector2(6, 0), Vector2(200, 20),
			"0 / 8", Color(0.49, 0.525, 0.584, 1), 13, TextAlignmentType.MiddleLeft, false)

		-- 영입 버튼: 오른쪽 유닛 슬롯(6칸, y −104부터 50 간격) 바로 아래(2026-09-24 사용자 "화면 중앙에서 우측으로" — 전 상단 가운데 340×64).
		--   영입이 가능할 때(진행 중 + 빈 칸)와 '나가기'(판 끝·탈락·클리어)일 때만 보인다 — RefreshRecruitButton
		local recruit = self:SpawnPanel("RtsRecruitBtn", grp, Vector2(1, 1), Vector2(1, 1), Vector2(-16, -104 - 6 * 50), Vector2(130, 56),
			self:ColPanel(), self:ColBorder(), 2)
		self.RecruitText = self:SpawnLabel("RtsRecruitLabel", recruit, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(126, 48),
			"영입", self:ColInk(), 20, TextAlignmentType.MiddleCenter, true)
		local recruitClick = self:SpawnClick("RtsRecruitClick", recruit)
		recruitClick:ConnectEvent(ButtonClickEvent, function(event)
			self:OnTopButton()
		end)
		self.RecruitBtn = recruit
		-- 오른쪽 아래: '다시 하기'(2026-09-24 사용자 "화면 중앙에 나오지 말고 화면 우측 하단에" — 전엔 위쪽 가운데 오른편). 방 인원 과반 찬성이면 처음부터(혼자면 바로). 문구·색은 RefreshRestartButton
		local restart = self:SpawnPanel("RtsRestartBtn", grp, Vector2(1, 0), Vector2(1, 0), Vector2(-16, 16), Vector2(200, 64),
			self:ColPanel(), self:ColBorder(), 2)
		self.RestartText = self:SpawnLabel("RtsRestartLabel", restart, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(192, 56),
			"다시하기", self:ColInk(), 19, TextAlignmentType.MiddleCenter, true)
		local restartClick = self:SpawnClick("RtsRestartClick", restart)
		restartClick:ConnectEvent(ButtonClickEvent, function(event)
			self:OnRestartButton()
		end)
		self.RestartBtn = restart
		-- 다시 하기 투표 패널: 버튼 바로 위(투표 중에만)
		local vp = self:SpawnPanel("RtsVotePanel", grp, Vector2(1, 0), Vector2(1, 0), Vector2(-16, 16 + 64 + 8), Vector2(260, 76),
			self:ColPanel(), self:ColGold(), 1.5)
		self.VotePanel = vp
		self.VoteText = self:SpawnLabel("RtsVoteText", vp, Vector2(0, 1), Vector2(0, 1), Vector2(10, -4), Vector2(240, 26),
			"", self:ColInk(), 14, TextAlignmentType.MiddleLeft, true)
		self.VoteText.TextComponent.IsRichText = true
		local yes = self:SpawnPanel("RtsVoteYes", vp, Vector2(0, 0), Vector2(0, 0), Vector2(10, 8), Vector2(115, 34), self:ColPanel(), self:ColBorder(), 1.5)
		self:SpawnLabel("RtsVoteYesText", yes, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(110, 30), "찬성", self:ColInk(), 16, TextAlignmentType.MiddleCenter, true)
		local yc = self:SpawnClick("RtsVoteYesClick", yes)
		yc:ConnectEvent(ButtonClickEvent, function(event)
			_RtsStageLogic:RequestVoteChoice(1)
		end)
		self.VoteYesBtn = yes
		local no = self:SpawnPanel("RtsVoteNo", vp, Vector2(0, 0), Vector2(0, 0), Vector2(135, 8), Vector2(115, 34), self:ColPanel(), self:ColBorder(), 1.5)
		self:SpawnLabel("RtsVoteNoText", no, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(110, 30), "반대", self:ColInk(), 16, TextAlignmentType.MiddleCenter, true)
		local nc = self:SpawnClick("RtsVoteNoClick", no)
		nc:ConnectEvent(ButtonClickEvent, function(event)
			_RtsStageLogic:RequestVoteChoice(2)
		end)
		self.VoteNoBtn = no
		vp.Parent:SetEnable(false)

		-- 우측: 유닛 슬롯 6(맨 위는 엔진 시스템 버튼 자리라 비운다 — 예전 영입 버튼 높이부터)
		for i = 1, 6 do
			local y = -104 - (i - 1) * 50
			local slot = self:SpawnPanel("RtsUnitSlot" .. tostring(i), grp, Vector2(1, 1), Vector2(1, 1), Vector2(-16, y), Vector2(130, 44),
				self:ColPanel(), self:ColBorderSoft(), 1.5)
			local bar = self:SpawnStretch("model://uisprite", "RtsUnitSlotBar" .. tostring(i), slot,
				Vector2(0, 0), Vector2(0, 1), Vector2(0, 0), Vector2(4, 0))
			bar.SpriteGUIRendererComponent.Color = self:SeriesColor("")
			local name = self:SpawnLabel("RtsUnitSlotName" .. tostring(i), slot, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(10, 0), Vector2(110, 30),
				"빈 자리", self:ColMuted(), 14, TextAlignmentType.MiddleCenter, false)
			-- 긴 직업명은 잘라낸다 (ellipsis 모드는 안 맞는 글이 오면 이전 글을 그대로 보여주는 문제가 있어 Truncate)
			name.TextComponent.Overflow = OverflowType.Truncate
			name.TextComponent.UseNBSP = true
			local lv = self:SpawnLabel("RtsUnitSlotLv" .. tostring(i), slot, Vector2(1, 0.5), Vector2(1, 0.5), Vector2(-8, 0), Vector2(40, 30),
				"", self:ColMuted(), 12, TextAlignmentType.MiddleRight, false)
			local click = self:SpawnClick("RtsUnitSlotClick" .. tostring(i), slot)
			click:ConnectEvent(ButtonClickEvent, function(event)
				self:OnUnitSlotClick(i)
			end)
			self.UnitSlots[i] = { box = slot, bar = bar, name = name, lv = lv, filled = false }
			self:ApplySlotLook(i)
		end

		-- 좌하단: 증강 버튼 · 오른쪽에 펼치기 · 위에 증강 뽑기 — 서로 붙여서(2026-09-23 사용자 "버튼 패딩 없이 붙여줘")
		local aug = self:SpawnPanel("RtsAugBtn", grp, Vector2(0, 0), Vector2(0, 0), Vector2(16, 16), Vector2(130, 50),
			self:ColPanel(), self:ColBorder(), 1.5)
		self.AugBtn = aug
		self.AugLabel = self:SpawnLabel("RtsAugLabel", aug, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(126, 40),
			"증강", self:ColInk(), 20, TextAlignmentType.MiddleCenter, true)
		local augClick = self:SpawnClick("RtsAugClick", aug)
		augClick:ConnectEvent(ButtonClickEvent, function(event)
			_RtsPopupLogic:Open("augment")
		end)
		-- 증강 뽑기 버튼(높이 44) 위: 증강 도감(2026-09-24 사용자 "좌측 아래에 증강 도감 — 등급별 증강 목록")
		local codex = self:SpawnPanel("RtsCodexBtn", grp, Vector2(0, 0), Vector2(0, 0), Vector2(16, 16 + 50 + 44), Vector2(130, 40),
			self:ColPanel(), self:ColBorder(), 1.5)
		self:SpawnLabel("RtsCodexLabel", codex, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(126, 34),
			"증강 도감", self:ColInk(), 17, TextAlignmentType.MiddleCenter, true)
		local codexClick = self:SpawnClick("RtsCodexClick", codex)
		codexClick:ConnectEvent(ButtonClickEvent, function(event)
			_RtsPopupLogic:Open("codex")
		end)
		-- (게임 안 '순위' 버튼은 뺐다 — 2026-09-25 사용자 "인게임 순위표 제거, 지금 저기서 보일 게 아니야". 순위표는 대기방(로드맵 Phase 13)에서.
		--  클리어 기록 저장(RtsRunResultLogic.SaveClear)은 그대로 — 순위 창 코드(RtsPopupLogic.BuildRank)는 대기방 순위표에서 다시 쓴다)
		local ex = self:SpawnPanel("RtsExpandBtn", grp, Vector2(0, 0), Vector2(0, 0), Vector2(16 + 130, 16), Vector2(150, 50),
			Color(0.3, 0.24, 0.12, 0.96), self:ColGold(), 2)
		self.ExpandBtn = ex
		self.ExpandLabel = self:SpawnLabel("RtsExpandLabel", ex, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(146, 40),
			"펼치기", Color(1, 0.95, 0.8, 1), 19, TextAlignmentType.MiddleCenter, true)
		local exClick = self:SpawnClickQuiet("RtsExpandClick", ex)
		exClick:ConnectEvent(ButtonClickEvent, function(event)
			_RtsAugmentLogic:ExpandPick()
		end)
		ex.Parent:SetEnable(false)
		local buy = self:SpawnPanel("RtsBuyBtn", grp, Vector2(0, 0), Vector2(0, 0), Vector2(16, 16 + 50), Vector2(280, 44),
			self:ColPanel(), self:ColBorder(), 1.5)
		self.BuyBtn = buy
		self.BuyLabel = self:SpawnLabel("RtsBuyLabel", buy, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(270, 38),
			"증강 뽑기", self:ColInk(), 16, TextAlignmentType.MiddleCenter, true)
		local buyClick = self:SpawnClick("RtsBuyClick", buy)
		buyClick:ConnectEvent(ButtonClickEvent, function(event)
			_RtsAugmentLogic:BuyFromHud()
		end)

		-- 우측 하단(다시 하기 왼쪽): 테스트 프리즘 버튼(개발 도구, 2026-09-22 사용자 "우측 하단에 테스트 프리즘 증강 버튼") → 프리즘 선택 팝업
		if _RtsUnitLogic.DevTools then
			local dev = self:SpawnPanel("RtsDevBtn", grp, Vector2(1, 0), Vector2(1, 0), Vector2(-16 - 200 - 8, 16), Vector2(160, 50),
				self:ColPanel(), Color(0.55, 0.75, 1, 1), 1.5)
			self:SpawnLabel("RtsDevLabel", dev, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(156, 40),
				"테스트 프리즘", self:ColInk(), 19, TextAlignmentType.MiddleCenter, true)
			local devClick = self:SpawnClick("RtsDevClick", dev)
			devClick:ConnectEvent(ButtonClickEvent, function(event)
				_RtsPopupLogic:Open("devprism")
			end)
		end

		-- 상단 중앙 안내(기본 숨김) — 영입 버튼 아래
		local hint = self:SpawnPanel("RtsHint", grp, Vector2(0.5, 1), Vector2(0.5, 1), Vector2(0, -92), Vector2(720, 44),
			Color(0.22, 0.185, 0.118, 0.94), self:ColGold(), 1.5)
		self.HintText = self:SpawnLabel("RtsHintText", hint, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(700, 36),
			"", self:ColInk(), 17, TextAlignmentType.MiddleCenter, true)
		self.Hint = hint.Parent
		self.Hint:SetEnable(false)

		self.Built = true
		_RtsConfigLogic:Log("RtsHud: built v2")

		_RtsPopupLogic:Build(ui)
		if self.PendingPlayers ~= "" then
			local packed = self.PendingPlayers
			self.PendingPlayers = ""
			self:RefreshPlayerList(packed)
		end
		self:RefreshMyUnits()
		self:SetMeso(_RtsUnitLogic:GetMyMeso())
	end

	@ExecSpace("ClientOnly")
	method void ShowHint(string text)
		if self.Hint == nil then return end
		self.HintText.TextComponent.Text = text
		self.Hint:SetEnable(true)
	end

	@ExecSpace("ClientOnly")
	method void HideHint()
		if self.Hint == nil then return end
		self.Hint:SetEnable(false)
	end

	-- sec초 동안만 안내(같은 안내가 다시 오면 시간 연장)
	@ExecSpace("ClientOnly")
	method void ShowHintFor(string text, number sec)
		self:ShowHint(text)
		self.HintGen = self.HintGen + 1
		local gen = self.HintGen
		_TimerService:SetTimerOnce(function()
			if self.HintGen == gen then self:HideHint() end
		end, sec)
	end

	-- ===== 스테이지·메소·필드·영입 버튼 (RtsStageLogic.RefreshHud가 0.25초마다) =====

	@ExecSpace("ClientOnly")
	method void SetStageCard(string title, string sub, string clock, boolean special)
		if self.StageTitleText == nil or self.StageSubText == nil or self.StageClockText == nil then return end
		local t = title
		if special then t = title .. "  <color=#e0b95a>스페셜</color>" end
		local key = t .. "|" .. sub .. "|" .. clock
		if key == self.StageShown then return end
		self.StageShown = key
		self.StageTitleText.TextComponent.Text = t
		self.StageSubText.TextComponent.Text = sub
		-- 긴 "지역 - 맵"은 라벨 BestFit이 칸(412px)에 맞춰 줄인다
		self.StageClockText.TextComponent.Text = clock
	end

	@ExecSpace("ClientOnly")
	method void SetField(number n, number limit)
		if self.FieldText == nil or self.FieldText.TextComponent == nil then return end
		self.FieldText.TextComponent.Text = self:Int(n) .. " / " .. self:Int(limit)
		if n >= limit - 20 then
			self.FieldText.TextComponent.FontColor = Color(0.92, 0.32, 0.28, 1)
		else
			self.FieldText.TextComponent.FontColor = self:ColInk()
		end
	end

	-- 좌하단 증강 버튼: 미지정이 있으면 '증강 (n)' + 붉은 테두리(2026-09-23 Phase 4 합류 — RtsAugmentLogic.ClientTick이 0.3초마다)
	@ExecSpace("ClientOnly")
	method void SetAugmentCount(number n)
		if self.AugLabel == nil or self.AugBtn == nil then return end
		if n == self.AugShown then return end
		self.AugShown = n
		if n > 0 then
			self.AugLabel.TextComponent.Text = "증강 (" .. self:Int(n) .. ")"
			self.AugBtn.Parent.SpriteGUIRendererComponent.Color = Color(0.95, 0.45, 0.4, 1)
		else
			self.AugLabel.TextComponent.Text = "증강"
			self.AugBtn.Parent.SpriteGUIRendererComponent.Color = self:ColBorder()
		end
	end

	-- '증강 뽑기 3,000' 버튼: 가격과 뽑을 수 있는지(메소·선택지 MaxPending(10)개 미만·진행 중)에 따라 금색/흐림
	@ExecSpace("ClientOnly")
	method void SetBuyPrism(number left, number max)
		self.BuyPrismLeft = left
		self.BuyPrismMax = max
	end

	-- 뽑기 버튼의 프리즘 확률 글자(" · 7%") — 더 못 얻으면 빈칸
	method string BuyPrismRateText()
		if self.BuyPrismLeft <= 0 or self.BuyPrismRatePct <= 0 then return "" end
		return " · " .. self:Int(self.BuyPrismRatePct) .. "%"
	end

	@ExecSpace("ClientOnly")
	method void SetBuyPrismRate(number pct)
		self.BuyPrismRatePct = pct
	end

	@ExecSpace("ClientOnly")
	method void SetBuyButton(number price, boolean can)
		if self.BuyBtn == nil or self.BuyLabel == nil then return end
		local key = self:Int(price) .. "|" .. tostring(can) .. "|" .. self:Int(self.BuyPrismLeft) .. "/" .. self:Int(self.BuyPrismMax) .. "|" .. self:Int(self.BuyPrismRatePct)
		if key == self.BuyShown then return end
		self.BuyShown = key
		-- 가격 옆에 뽑기로 더 얻을 수 있는 프리즘 수(남은/최대 — 0이면 흐리게)
		local pc = "#d7b4ff"
		if self.BuyPrismLeft <= 0 then pc = "#8a8378" end
		self.BuyLabel.TextComponent.IsRichText = true
		self.BuyLabel.TextComponent.Text = "증강 뽑기  " .. self:FormatNumber(price) .. "   <size=13><color=" .. pc .. ">프리즘 " .. self:Int(self.BuyPrismLeft) .. "/" .. self:Int(self.BuyPrismMax) .. self:BuyPrismRateText() .. "</color></size>"
		if can then
			self.BuyBtn.SpriteGUIRendererComponent.Color = Color(0.3, 0.24, 0.12, 0.96)
			self.BuyBtn.Parent.SpriteGUIRendererComponent.Color = self:ColGold()
			self.BuyLabel.TextComponent.FontColor = Color(1, 0.95, 0.8, 1)
		else
			self.BuyBtn.SpriteGUIRendererComponent.Color = self:ColPanel()
			self.BuyBtn.Parent.SpriteGUIRendererComponent.Color = self:ColBorderSoft()
			self.BuyLabel.TextComponent.FontColor = self:ColMuted()
		end
	end

	-- '펼치기 (n)' 버튼: 고르지 않은 증강 선택지 수 n, 3택1 창이 닫혀 있을 때만 보인다(RtsAugmentLogic.ClientTick이 0.3초마다)
	@ExecSpace("ClientOnly")
	method void SetPendingOffers(number n, boolean visible)
		if self.ExpandBtn == nil or self.ExpandLabel == nil then return end
		local key = tostring(visible) .. "|" .. self:Int(n)
		if key == self.ExpandShown then return end
		self.ExpandShown = key
		self.ExpandBtn.Parent:SetEnable(visible)
		if n > 1 then self.ExpandLabel.TextComponent.Text = "펼치기 (" .. self:Int(n) .. ")" else self.ExpandLabel.TextComponent.Text = "펼치기" end
	end

	-- '다시 하기' 클릭: 찬성했으면 취소, 판이 끝났으면 바로 찬성, 진행 중이면 3초 안에 한 번 더 눌러야 찬성(실수로 판을 날리지 않게)
	@ExecSpace("ClientOnly")
	method void OnRestartButton()
		local st = _RtsStageLogic.RunState
		if st ~= "running" and st ~= "ended" then return end
		-- 이미 찬성했으면 다시 누르기 = 찬성 취소(확인 없이 바로)
		if _RtsStageLogic:IsMyVote() then
			self.RestartConfirmUntil = 0
			_RtsStageLogic:RequestRestartVote()
			return
		end
		-- 예/아니오 확인 팝업(2026-09-24 사용자 "다시하기 누르면 예/아니오 확인 팝업 — 진짜 다시 할 거냐 묻고" — 전엔 3초 안에 두 번 누르기).
		--   혼자면 '예' = 바로 새 판, 여럿이면 '예' = 찬성(과반이면 새 판)
		_RtsPopupLogic:OpenRestartConfirm()
	end

	-- '다시 하기' 버튼 문구·색(RtsStageLogic.RefreshHud가 0.25초마다): 표 없음 "다시 하기" / 누가 찬성 "다시 하기 1/2"(금색 테두리) /
	--   내가 찬성 "다시 하기 ✓ 1/2"(밝은 금색) / 확인 대기 "한 번 더 누르면 찬성"(붉은 테두리) / 판 시작 전 흐리게
	@ExecSpace("ClientOnly")
	method void RefreshRestartButton()
		if self.RestartBtn == nil or self.RestartText == nil then return end
		local S = _RtsStageLogic
		local st = S.RunState
		local mine = S:IsMyVote()
		local count = self:Int(S.VoteCount) .. "/" .. self:Int(S.VoteNeed)
		-- 솔로(방 인원 1)는 표 수를 안 보인다(혼자 누르면 바로 새 판 — 2026-09-24 솔로 출시)
		if S:IsSolo() then count = "" end
		local text = "다시하기"
		local mode = "off"
		if st ~= "running" and st ~= "ended" then
			mode = "idle"
		elseif mine then
			text = "다시하기 ✓ " .. count
			mode = "mine"
		elseif _UtilLogic.ElapsedSeconds < self.RestartConfirmUntil then
			text = "한 번 더 누르면 찬성"
			mode = "confirm"
		elseif S.VoteCount > 0 or st == "ended" then
			text = "다시하기 " .. count
			mode = "on"
		end
		self:RefreshVotePanel()
		local key = mode .. "|" .. text
		if key == self.RestartShown then return end
		self.RestartShown = key
		self.RestartText.TextComponent.Text = text
		local outer = self.RestartBtn.Parent
		if mode == "mine" then
			self.RestartBtn.SpriteGUIRendererComponent.Color = Color(0.45, 0.37, 0.18, 0.96)
			outer.SpriteGUIRendererComponent.Color = Color(1, 0.9, 0.55, 1)
			self.RestartText.TextComponent.FontColor = Color(1, 0.97, 0.85, 1)
		elseif mode == "confirm" then
			self.RestartBtn.SpriteGUIRendererComponent.Color = Color(0.3, 0.13, 0.11, 0.94)
			outer.SpriteGUIRendererComponent.Color = Color(0.8, 0.35, 0.3, 1)
			self.RestartText.TextComponent.FontColor = Color(0.98, 0.72, 0.66, 1)
		elseif mode == "on" then
			self.RestartBtn.SpriteGUIRendererComponent.Color = Color(0.22, 0.185, 0.118, 0.94)
			outer.SpriteGUIRendererComponent.Color = self:ColGold()
			self.RestartText.TextComponent.FontColor = Color(0.973, 0.925, 0.784, 1)
		elseif mode == "off" then
			self.RestartBtn.SpriteGUIRendererComponent.Color = self:ColPanel()
			outer.SpriteGUIRendererComponent.Color = self:ColBorder()
			self.RestartText.TextComponent.FontColor = self:ColInk()
		else
			self.RestartBtn.SpriteGUIRendererComponent.Color = self:ColPanel()
			outer.SpriteGUIRendererComponent.Color = self:ColBorderSoft()
			self.RestartText.TextComponent.FontColor = self:ColMuted()
		end
	end

	-- 투표 패널: 누가 찬성·반대를 누르면(투표 중) 보이고, 찬성 n · 반대 m / 과반 k · 남은 초 + 내 선택 강조
	@ExecSpace("ClientOnly")
	method void RefreshVotePanel()
		if self.VotePanel == nil or self.VoteText == nil then return end
		local S = _RtsStageLogic
		local active = (S.VoteCount + S.VoteNoCount) > 0
		local mine = S:MyVote()
		local left = 0
		if active then
			left = math.ceil(S.VoteStartedAt + S.VoteTimeout - _UtilLogic.ServerElapsedSeconds)
			if left < 0 then left = 0 end
		end
		local text = "다시하기 투표  <color=#8fd18a>찬성 " .. self:Int(S.VoteCount) .. "</color> · <color=#e88a7a>반대 " .. self:Int(S.VoteNoCount) .. "</color>  / 과반 " .. self:Int(S.VoteNeed) .. " · " .. self:Int(left) .. "초"
		local key = tostring(active) .. "|" .. self:Int(mine) .. "|" .. text
		if key == self.VoteShown then return end
		self.VoteShown = key
		self.VotePanel.Parent:SetEnable(active)
		if not active then return end
		self.VoteText.TextComponent.Text = text
		local btns = { self.VoteYesBtn, self.VoteNoBtn }
		for i = 1, 2 do
			local b = btns[i]
			if b ~= nil then
				if mine == i then
					b.SpriteGUIRendererComponent.Color = Color(0.45, 0.37, 0.18, 0.96)
					b.Parent.SpriteGUIRendererComponent.Color = Color(1, 0.9, 0.55, 1)
				else
					b.SpriteGUIRendererComponent.Color = self:ColPanel()
					b.Parent.SpriteGUIRendererComponent.Color = self:ColBorder()
				end
			end
		end
	end

	-- 상단 가운데 버튼 클릭: 판이 끝났거나 탈락·클리어한 뒤(관전 중)면 나가기, 아니면 영입 팝업. 다시 하기 투표는 오른쪽 아래 버튼(OnRestartButton)
	@ExecSpace("ClientOnly")
	method void OnTopButton()
		if _RtsStageLogic.RunState == "ended" or not _RtsRunResultLogic:IsMeAlive() then
			_RtsPopupLogic:Close()
			-- 솔로(방 인원 1)면 '다시 하기' — 혼자 찬성 = 바로 새 판(2026-09-24 솔로 출시), 여럿이면 '나가기'
			if _RtsStageLogic:IsSolo() then
				_RtsPopupLogic:OpenRestartConfirm()
			else
				_RtsRunResultLogic:RequestExit()
			end
			return
		end
		_RtsPopupLogic:Open("recruit")
	end

	-- 상단 가운데 버튼: '영입 가능 n'(금색) / '다음 영입 · n라운드'(흐리게) / '영입 완료' / '영입 불가'(판 시작 전·끝) / 탈락·클리어 뒤 '나가기'(붉은 테두리, 2026-09-23 사용자). 칸이 새로 열리면 1.5초 반짝
	@ExecSpace("ClientOnly")
	method void RefreshRecruitButton()
		if self.RecruitBtn == nil or self.RecruitText == nil then return end
		self:RefreshEmptySlots()
		local stageNo = _RtsStageLogic.StageNo
		local state = _RtsStageLogic.RunState
		local owned = #_RtsUnitLogic:ListZoneUnits(_RtsUnitLogic:MyZone())
		local room = _RtsStageTableLogic:RecruitLimit(stageNo) - owned
		if room < 0 then room = 0 end
		local text = ""
		local on = false
		-- 보이기(2026-09-24 사용자 "영입 가능 버튼은 영입이 가능할 때만"): '나가기'(판 끝·탈락·클리어) 또는 진행 중 + 빈 칸이 있을 때만
		local exitMode = state == "ended" or not _RtsRunResultLogic:IsMeAlive()
		local canRecruit = state == "running" and room > 0 and owned < _RtsUnitLogic:GetMaxUnits()
		self.RecruitBtn.Parent:SetEnable(exitMode or canRecruit)
		-- 판이 끝났거나 탈락·클리어했으면 '나가기'(다시 하기는 오른쪽 아래 버튼)
		if exitMode then
			self.RecruitRoomPrev = 0
			self.RecruitLimitPrev = 0
			-- 솔로(방 인원 1)면 '다시 하기'(금색), 여럿이면 '나가기'(붉은 테두리)
			local solo = _RtsStageLogic:IsSolo()
			local key = "exit"
			if solo then key = "exit_solo" end
			if key == self.RecruitShown then return end
			self.RecruitShown = key
			if solo then
				self.RecruitText.TextComponent.Text = "다시하기"
				self.RecruitBtn.SpriteGUIRendererComponent.Color = Color(0.3, 0.24, 0.12, 0.96)
				self.RecruitBtn.Parent.SpriteGUIRendererComponent.Color = self:ColGold()
				self.RecruitText.TextComponent.FontColor = Color(1, 0.95, 0.8, 1)
			else
				self.RecruitText.TextComponent.Text = "나가기"
				self.RecruitBtn.SpriteGUIRendererComponent.Color = Color(0.3, 0.13, 0.11, 0.94)
				self.RecruitBtn.Parent.SpriteGUIRendererComponent.Color = Color(0.8, 0.35, 0.3, 1)
				self.RecruitText.TextComponent.FontColor = Color(0.98, 0.72, 0.66, 1)
			end
			return
		end
		if state ~= "running" then
			text = "영입 불가"
			room = 0
			self.RecruitLimitPrev = 0
		elseif owned >= _RtsUnitLogic:GetMaxUnits() then
			text = "영입 완료"
		elseif room > 0 then
			text = "영입 가능 " .. self:Int(room)
			on = true
		else
			local nextNo = _RtsStageTableLogic:NextRecruitStage(stageNo)
			if nextNo > 0 then text = "다음 영입 · " .. self:Int(nextNo) .. "라운드" else text = "영입 완료" end
		end
		local now = _UtilLogic.ElapsedSeconds
		if room > self.RecruitRoomPrev then self.RecruitFlashUntil = now + 1.5 end
		if state == "running" then
			local limit = _RtsStageTableLogic:RecruitLimit(stageNo)
			if room > 0 and limit > self.RecruitLimitPrev then _SoundService:PlaySound(self.RecruitSound, 1) end
			self.RecruitLimitPrev = limit
		end
		-- 영입 팝업이 열려 있으면 칸 수가 바뀔 때 내용(카드 활성·하단 문구)을 다시 그린다
		if room ~= self.RecruitRoomPrev and _RtsPopupLogic.Kind == "recruit" then _RtsPopupLogic:RefreshRecruit() end
		self.RecruitRoomPrev = room
		local flash = false
		if now < self.RecruitFlashUntil then
			self.RecruitFlashOn = not self.RecruitFlashOn
			flash = self.RecruitFlashOn
		end
		local key = text .. tostring(on) .. tostring(flash)
		if key == self.RecruitShown then return end
		self.RecruitShown = key
		self.RecruitText.TextComponent.Text = text
		local outer = self.RecruitBtn.Parent
		if flash then
			self.RecruitBtn.SpriteGUIRendererComponent.Color = Color(0.45, 0.37, 0.18, 0.96)
			outer.SpriteGUIRendererComponent.Color = Color(1, 0.9, 0.55, 1)
			self.RecruitText.TextComponent.FontColor = Color(1, 0.97, 0.85, 1)
		elseif on then
			self.RecruitBtn.SpriteGUIRendererComponent.Color = Color(0.22, 0.185, 0.118, 0.94)
			outer.SpriteGUIRendererComponent.Color = self:ColGold()
			self.RecruitText.TextComponent.FontColor = Color(0.973, 0.925, 0.784, 1)
		else
			self.RecruitBtn.SpriteGUIRendererComponent.Color = Color(0.094, 0.082, 0.071, 0.6)
			outer.SpriteGUIRendererComponent.Color = self:ColBorderSoft()
			self.RecruitText.TextComponent.FontColor = self:ColMuted()
		end
	end

	-- 프로퍼티·동기화 값은 실수(1.0)로 오므로 표시용 정수 문자열은 이걸로
	method string Int(number n)
		return tostring(math.floor(n + 0.5))
	end

	method string FormatNumber(number n)
		local s = tostring(math.floor(n))
		local out = ""
		local len = string.len(s)
		for i = 1, len do
			out = out .. string.sub(s, i, i)
			local rest = len - i
			if rest > 0 and rest % 3 == 0 then out = out .. "," end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void SetMeso(number n)
		if self.MesoText == nil or self.MesoText.TextComponent == nil then return end
		self.MesoText.TextComponent.Text = self:FormatNumber(n)
	end

	-- ===== 플레이어 목록 =====

	-- 서버 통지(전 클라). packed = "userId\t닉네임\t구역\t생존(1/0)\t테마\t아이콘\n..." (구역순, 테마·아이콘은 2026-09-25 — 없으면 기본)
	@ExecSpace("Client")
	method void RefreshPlayerList(string packed)
		if not self.Built or self.PlayersBox == nil then
			self.PendingPlayers = packed
			return
		end
		-- 기존 행 제거
		for i = 1, #self.PlayerOrder do
			local p = self.Players[self.PlayerOrder[i]]
			if p ~= nil and p.row ~= nil and p.row.Parent ~= nil then p.row.Parent:Destroy() end
		end
		self.Players = {}
		self.PlayerOrder = {}

		local count = 0
		for line in string.gmatch(packed, "[^\n]+") do
			local f = {}
			for field in string.gmatch(line .. "\t", "([^\t]*)\t") do f[#f + 1] = field end
			if #f >= 4 then
				count = count + 1
				local userId = f[1]
				local zone = tonumber(f[3]) or 0
				local alive = f[4] == "1"
				local theme = f[5] or ""
				local icon = f[6] or ""
				if theme == "" then theme = _RtsThemeLogic.DefaultKey end
				if icon == "" then icon = _RtsProfileLogic.IconNone end
				self:AddPlayerCard(count, userId, f[2], zone, alive, theme, icon)
			end
		end
		if self.PlayerHead ~= nil and self.PlayerHead.TextComponent ~= nil then
			self.PlayerHead.TextComponent.Text = string.format("%d / %d", count, _RtsZoneLogic:GetZoneCount())
		end
		self:ApplyWatchLook()
	end

	-- 플레이어 목록 기준: 구역 zone의 주인이 살아 있는가(목록에 없으면 false) — 탈락 뒤 관전 배경음(RtsStageLogic.RefreshBgm)
	@ExecSpace("ClientOnly")
	method boolean IsZoneAliveClient(number zone)
		local z = math.floor(zone + 0.5)
		for i = 1, #self.PlayerOrder do
			local p = self.Players[self.PlayerOrder[i]]
			if p ~= nil and math.floor(p.zone + 0.5) == z then return p.alive == true end
		end
		return false
	end

	-- 유저 카드(2026-09-25 사용자): 배경 = 그 유저 테마 썸네일(없으면 테마 색) + 얇은 막, 사진 영역 가운데 큰 동그란 아이콘(원형 마스크 + 몬스터 초상), 아래 어두운 띠에 닉네임.
	--   카드 250×150 = 썸네일과 같은 5:3(2026-09-25 사용자 "박스 크기를 배경 사진 비율에 맞게") — 전엔 280×56에 썸네일을 늘려 찌그러졌다.
	--   내 카드 = "(나)" 글자 대신 조금 굵은 초록 테두리. 카드 클릭 = 그 구역으로 카메라(OnPlayerRowClick).
	--   아이콘 바꾸기는 프로필 창 [아이콘] 탭 — 2026-09-25 사용자 "회원 목록에서의 수정 버튼 삭제"로 카드의 [수정]을 뺐다
	@ExecSpace("ClientOnly")
	method void AddPlayerCard(number index, string userId, string nick, number zone, boolean alive, string theme, string icon)
		local W = self.CardW
		local H = self.CardH
		local isMe = (userId == self.MyUserId)
		local y = -24 - (index - 1) * (H + self.CardGap)
		local thick = 1.5
		if isMe then thick = 3 end
		local preset = _RtsThemeLogic:GetPreset(theme)
		local row = self:SpawnPanel("RtsPlayerRow" .. self:Int(index), self.PlayersBox, Vector2(0, 1), Vector2(0, 1), Vector2(0, y), Vector2(W, H),
			preset.color, self:ColBorderSoft(), thick)
		if preset.thumb ~= nil and preset.thumb ~= "" then
			row.SpriteGUIRendererComponent.ImageRUID = DataRef(preset.thumb)
			row.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		end
		local shade = self:SpawnStretch("model://uisprite", "RtsPlayerShade", row, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		-- 아래 띠(높이 40): 닉네임·비석 표시 자리 — 사진 위에서도 글자가 읽히게
		local band = self:SpawnStretch("model://uisprite", "RtsPlayerBand", row, Vector2(0, 0), Vector2(1, 0), Vector2(0, 0), Vector2(0, 40))
		band.SpriteGUIRendererComponent.Color = Color(0.06, 0.05, 0.04, 0.62)
		band.SpriteGUIRendererComponent.RaycastTarget = false
		-- 아이콘이 있을 때만 사진 영역 중앙에 작게 얹는다. 없으면 풍경 썸네일을 온전히 보여 준다.
		local slot = nil
		local face = nil
		if icon ~= _RtsProfileLogic.IconNone then
			-- 아이콘 뒤 그림자·배경 원 없음 — 투명(2026-09-25 사용자 "아이콘 쪽 투명한 색으로"). 칸은 원형 마스크 틀로만 남긴다
			slot = self:SpawnUI("model://uisprite", "RtsPlayerIconSlot", row, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 20), Vector2(80, 80))
			if self.CircleMaskRUID ~= "" then slot.SpriteGUIRendererComponent.ImageRUID = DataRef(self.CircleMaskRUID) end
			slot.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)  -- 아이콘 배경 원 = 투명(2026-09-25 사용자 검정 → 흰색 → "투명한 색으로")
			slot.SpriteGUIRendererComponent.RaycastTarget = false
			face = self:SpawnMonsterPortrait(slot, icon, 80, false)  -- 배경이 투명이라 원형 마스크 없이 썸네일 그대로
			if face == nil then
				slot:Destroy()
				slot = nil
			end
		end
		local name = self:SpawnLabel("RtsPlayerName", row, Vector2(0, 0), Vector2(0, 0), Vector2(10, 5), Vector2(W - 44, 30),
			nick, self:ColInk(), 17, TextAlignmentType.MiddleLeft, true)
		if name.TextComponent ~= nil then name.TextComponent.IsRichText = false end
		local tomb = self:SpawnUI("model://uisprite", "RtsPlayerTomb", row, Vector2(1, 0), Vector2(1, 0), Vector2(-10, 11), Vector2(14, 17))
		local tombIn = self:SpawnStretch("model://uisprite", "RtsPlayerTombIn", tomb, Vector2(0, 0), Vector2(1, 1), Vector2(1.5, 1.5), Vector2(-1.5, -1.5))
		self:Tint(tomb, 0.29, 0.27, 0.235, 1)
		self:Tint(tombIn, 0.55, 0.51, 0.45, 1)
		local click = self:SpawnClick("RtsPlayerClick", row)
		click:ConnectEvent(ButtonClickEvent, function(event)
			self:OnPlayerRowClick(userId)
		end)
		local p ={ row = row, shade = shade, slot = slot, face = face, tomb = tomb, name = name, zone = zone, alive = alive, nick = nick,
			isMe = isMe, theme = theme, icon = icon }
		self.Players[userId] = p
		self.PlayerOrder[#self.PlayerOrder + 1] = userId
		self:ApplyPlayerLook(userId)
	end

	-- 카드 모양: 테두리 = 나(초록, 굵게) / 보는 중(금색) / 그 외(흐린 금). 탈락 = 어두운 막 짙게 + 아이콘 회색 + 비석
	@ExecSpace("ClientOnly")
	method void ApplyPlayerLook(string userId)
		local p = self.Players[userId]
		if p == nil or p.row == nil or not isvalid(p.row) then return end
		local watching = (p.zone == self.WatchedZone)
		local border = self:ColBorderSoft()
		if p.isMe then
			border = Color(0.35, 0.8, 0.42, 1)
		elseif watching then
			border = self:ColGold()
		end
		p.row.Parent.SpriteGUIRendererComponent.Color = border
		if p.alive then
			p.shade.SpriteGUIRendererComponent.Color = Color(0.06, 0.05, 0.04, 0.12)
			p.name.TextComponent.FontColor = self:ColInk()
			p.tomb:SetEnable(false)
			if p.face ~= nil and isvalid(p.face) then p.face.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1) end
		else
			p.shade.SpriteGUIRendererComponent.Color = Color(0.06, 0.05, 0.04, 0.68)
			p.name.TextComponent.FontColor = Color(0.604, 0.561, 0.502, 1)
			p.tomb:SetEnable(true)
			if p.face ~= nil and isvalid(p.face) then p.face.SpriteGUIRendererComponent.Color = Color(0.45, 0.45, 0.45, 1) end
		end
	end

	-- ===== 좌상단 상자(프로필 + 정보 — 2026-09-25 테마 상자 → 프로필 상자 → "프로필·정보 카드 하나로 합치고 배경을 보여줘") =====

	-- 상자 400×240(= 테마 썸네일 원본 크기, 늘리거나 자르지 않는다): 배경 = 내 테마 썸네일 + 어두운 막(글자 대비).
	--   위 64 = 프로필 줄(왼쪽 동그란 내 아이콘 48 — 유저 카드와 같은 원형 마스크 + 몬스터 초상, 없음이면 빈 원 · "프로필 설정" · 요약 · 오른쪽 "변경 ›", 이 줄만 클릭 → 프로필 창),
	--   구분선, 그 아래 = 정보 칸(투명, 돌려줌 — BuildHud가 라운드·맵·메소·필드를 채우고 RtsDifficultyLogic이 난이도 줄을 붙인다)
	@ExecSpace("ClientOnly")
	method Entity BuildTopBox(Entity grp)
		local box = self:SpawnPanel("RtsTopBox", grp, Vector2(0, 1), Vector2(0, 1), Vector2(16, -16), Vector2(400, 240),
			self:ColPanel(), self:ColBorder(), 1.5)
		self.ProfileBg = self:SpawnStretch("model://uisprite", "RtsProfileBg", box, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		self.ProfileBg.SpriteGUIRendererComponent.RaycastTarget = false
		local shade = self:SpawnStretch("model://uisprite", "RtsProfileShade", box, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		shade.SpriteGUIRendererComponent.Color = Color(0.06, 0.05, 0.04, 0.55)
		shade.SpriteGUIRendererComponent.RaycastTarget = false
		local row = self:SpawnStretch("model://uisprite", "RtsProfileRow", box, Vector2(0, 1), Vector2(1, 1), Vector2(0, -64), Vector2(0, 0))
		row.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		local slot = self:SpawnUI("model://uisprite", "RtsProfileIconSlot", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(10, 0), Vector2(48, 48))
		if self.CircleMaskRUID ~= "" then slot.SpriteGUIRendererComponent.ImageRUID = DataRef(self.CircleMaskRUID) end
		slot.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)  -- 아이콘 배경 원 = 투명(2026-09-25 사용자). 아이콘 없음일 때만 옅은 원(RefreshProfileBox)
		slot.SpriteGUIRendererComponent.RaycastTarget = false
		self.ProfileIconSlot = slot
		self.ProfileIconFace = nil
		self.ProfileIconId = ""
		self:SpawnLabel("RtsProfileTitle", row, Vector2(0, 1), Vector2(0, 1), Vector2(70, -6), Vector2(220, 28),
			"프로필 설정", self:ColInk(), 18, TextAlignmentType.MiddleLeft, true)
		self.ProfileSummary = self:SpawnLabel("RtsProfileSummary", row, Vector2(0, 1), Vector2(0, 1), Vector2(70, -34), Vector2(250, 24),
			"", Color(0.86, 0.82, 0.74, 1), 14, TextAlignmentType.MiddleLeft, false)
		self:SpawnLabel("RtsProfileChange", row, Vector2(1, 0.5), Vector2(1, 0.5), Vector2(-14, 0), Vector2(80, 30),
			"변경 ›", self:ColGold(), 16, TextAlignmentType.MiddleRight, true)
		local click = self:SpawnClick("RtsProfileClick", row)
		click:ConnectEvent(ButtonClickEvent, function(event)
			_RtsPopupLogic:Open("profile")
		end)
		local line = self:SpawnUI("model://uisprite", "RtsTopLine", box, Vector2(0, 1), Vector2(0, 1), Vector2(12, -67), Vector2(376, 1.5))
		line.SpriteGUIRendererComponent.ImageRUID = DataRef(self.WhiteRUID)
		line.SpriteGUIRendererComponent.Color = self:ColBorderSoft()
		line.SpriteGUIRendererComponent.RaycastTarget = false
		local info = self:SpawnStretch("model://uisprite", "RtsInfoCard", box, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, -72))
		info.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		info.SpriteGUIRendererComponent.RaycastTarget = false
		self:RefreshProfileBox()
		return info
	end

	-- 내 테마·아이콘(RtsProfileLogic.MyTheme·MyIcon — 서버가 보낸 값)으로 배경·아이콘·요약 줄. 썸네일이 없으면 테마 색.
	--   아이콘 초상은 바뀌었을 때만 다시 만든다(서버 통지마다 부른다)
	@ExecSpace("ClientOnly")
	method void RefreshProfileBox()
		if self.ProfileBg == nil or not isvalid(self.ProfileBg) then return end
		local P = _RtsProfileLogic
		local preset = _RtsThemeLogic:GetPreset(P.MyTheme)
		self:PaintThumb(self.ProfileBg, preset)
		if self.ProfileIconSlot ~= nil and isvalid(self.ProfileIconSlot) and self.ProfileIconId ~= P.MyIcon then
			if self.ProfileIconFace ~= nil and isvalid(self.ProfileIconFace) then self.ProfileIconFace:Destroy() end
			self.ProfileIconFace = self:SpawnMonsterPortrait(self.ProfileIconSlot, P.MyIcon, 48, false)
			if self.ProfileIconFace == nil then self.ProfileIconSlot.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0.15)
			else self.ProfileIconSlot.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0) end
			self.ProfileIconId = P.MyIcon
		end
		if self.ProfileSummary ~= nil and self.ProfileSummary.TextComponent ~= nil then
			self.ProfileSummary.TextComponent.IsRichText = false
			self.ProfileSummary.TextComponent.Text = "테마 " .. preset.name
		end
	end

	-- 썸네일 칠하기(테마 상자·테마 창 카드 공용): thumb RUID가 있으면 그림, 없으면 테마 색 단색
	@ExecSpace("ClientOnly")
	method void PaintThumb(Entity e, table preset)
		if e == nil or e.SpriteGUIRendererComponent == nil then return end
		local r = e.SpriteGUIRendererComponent
		if preset.thumb ~= nil and preset.thumb ~= "" then
			r.ImageRUID = DataRef(preset.thumb)
			r.Color = Color(1, 1, 1, 1)
		else
			r.ImageRUID = DataRef(self.WhiteRUID)
			r.Color = preset.color
		end
	end

	-- ===== 몬스터 초상(정보 창·아이콘·유저 카드·획득 팝업 공용, 2026-09-25) =====
	--   칸(size×size) 가운데에 몬스터 그림: animated = 걷기 클립 반복(정보 창), 아니면 표 icon(걷기 첫 3프레임 중 크기 기준 프레임 스프라이트 — 없으면 걷기 클립).
	--   클립·프레임은 기준점(발끝)이 칸 가운데에 오게 그려진다 → 원본 크기(NativeSize)로 두고, 표의 그림 테두리(boxW/0.7 · boxH/0.8, 기준점 → 그림 가운데 = boxX · boxY, 단위 100px)로
	--   칸에 맞게 키운 뒤 그 가운데를 칸 가운데로(2026-09-24 사용자 "사각형 안에 점 찍고 거기에 몬스터 모습이 정중앙에"). 크기·위치는 RUID를 넣은 뒤에
	--   2026-09-25 사용자 "썸네일 추가됐어 — 프로필·유저 목록 등 전부 이걸로": 썸네일(RtsMonsterThumbLogic, 256×256 정사각·가운데 정렬)이 있으면 그것을 칸 크기 그대로 —
	--   걷기 클립(animated)보다 우선. 썸네일이 없는 ID만 아래 원작 스프라이트 맞춤
	@ExecSpace("ClientOnly")
	method Entity SpawnMonsterPortrait(Entity parent, string monsterId, number size, boolean animated)
		local mon = _RtsStageTableLogic:GetMonster(monsterId)
		if mon == nil or parent == nil then return nil end
		local thumb = _RtsMonsterThumbLogic:GetThumb(monsterId)
		if thumb ~= "" then
			local t = self:SpawnUI("model://uisprite", "RtsPortrait", parent, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(size, size))
			if t == nil then return nil end
			local tr = t.SpriteGUIRendererComponent
			tr.RaycastTarget = false
			tr.Color = Color(1, 1, 1, 1)
			tr.ImageRUID = DataRef(thumb)
			return t
		end
		local ruid = mon.icon
		local clip = animated or ruid == nil or ruid == ""
		if clip then ruid = mon.walk end
		if ruid == nil or ruid == "" then return nil end
		local e = self:SpawnUI("model://uisprite", "RtsPortrait", parent, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(size, size))
		if e == nil then return nil end
		local r = e.SpriteGUIRendererComponent
		r.RaycastTarget = false
		local fw = (mon.boxW or 0.28) / 0.7 * 100
		local fh = (mon.boxH or 0.24) / 0.8 * 100
		local fit = math.min(size / fw, size / fh, 2.5)
		r.PreserveSprite = PreserveSpriteType.NativeSize
		if clip then r.AnimClipPlayType = SpriteAnimClipPlayType.Loop end
		r.Color = Color(1, 1, 1, 1)
		r.ImageRUID = DataRef(ruid)
		r.LocalScale = Vector2(fit, fit)
		r.LocalPosition = Vector2(-(mon.boxX or 0) * 100 * fit, -(mon.boxY or 0) * 100 * fit)
		return e
	end

	@ExecSpace("ClientOnly")
	method void ApplyWatchLook()
		for i = 1, #self.PlayerOrder do
			self:ApplyPlayerLook(self.PlayerOrder[i])
		end
	end

	@ExecSpace("ClientOnly")
	method void SetPlayerAlive(string userId, boolean alive)
		local p = self.Players[userId]
		if p == nil then return end
		p.alive = alive
		self:ApplyPlayerLook(userId)
	end

	-- 지금 보고 있는 구역 (JumpToZone에서 호출)
	@ExecSpace("ClientOnly")
	method void SetWatchedZone(number n)
		self.WatchedZone = n
		if not self.Built then return end
		self:ApplyWatchLook()
	end

	@ExecSpace("ClientOnly")
	method void OnPlayerRowClick(string userId)
		local p = self.Players[userId]
		if p == nil or p.zone < 1 or self.AnchorEntity == nil then return end
		local anchor = self.AnchorEntity.RtsCameraAnchorComponent
		if anchor ~= nil then anchor:JumpToZone(p.zone) end
	end

	-- ===== 유닛 슬롯 (내 유닛 = RtsUnitLogic, 번호 = 슬롯) =====

	-- 내 유닛 6칸을 다시 채운다. HUD가 아직 없으면 생성 뒤에 한 번
	@ExecSpace("ClientOnly")
	method void RefreshMyUnits()
		if not self.Built then
			self.PendingUnits = true
			return
		end
		self.PendingUnits = false
		for i = 1, _RtsUnitLogic:GetMaxUnits() do
			local u = _RtsUnitLogic:GetMyUnit(i)
			if u ~= nil then
				self:SetUnitSlot(i, u.No, _RtsJobTableLogic:GetJobNameFor(u), u.Level, _RtsJobTableLogic:GetSeries(u.JobId))
			else
				self:ClearUnitSlot(i)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetUnitSlot(number i, number no, string jobName, number level, string series)
		local s = self.UnitSlots[i]
		if s == nil then return end
		s.filled = true
		-- 리치텍스트 태그는 말줄임(ellipsis)에 잘려 그대로 노출되므로 평문으로
		s.name.TextComponent.Text = self:Int(no) .. ". " .. jobName
		s.name.TextComponent.Alignment = TextAlignmentType.MiddleLeft
		s.name.UITransformComponent.RectSize = Vector2(80, 30)
		self:SetLabelSize(s.name, 13)
		s.lv.TextComponent.Text = "Lv " .. self:Int(level)
		s.bar.SpriteGUIRendererComponent.Color = self:SeriesColor(series)
		self:ApplySlotLook(i)
	end

	-- 빈 슬롯 문구(2026-09-24 사용자 "우측 유닛 목록의 빈자리 텍스트를 어느 라운드에 해금 이런 거"): i번째 칸이 열리는 순번 = RtsStageTableLogic.RecruitAt[i].
	--   진행 중이고 이미 열린 칸이면 '빈 자리', 아니면 'n라운드 해금'(n = 정보 카드의 라운드 번호와 같은 순번)
	@ExecSpace("ClientOnly")
	method string EmptySlotText(number i)
		local T = _RtsStageTableLogic
		T:Ensure()
		local at = T.RecruitAt[i]
		if at == nil then return "빈 자리" end
		local S = _RtsStageLogic
		if S.RunState == "running" and S.StageNo >= at then return "빈 자리" end
		return self:Int(at) .. "라운드 해금"
	end

	-- 빈 슬롯 문구 갱신(라운드가 바뀌면 '해금' → '빈 자리') — RefreshRecruitButton이 주기적으로 부른다
	@ExecSpace("ClientOnly")
	method void RefreshEmptySlots()
		if self.UnitSlots == nil then return end
		for i = 1, 6 do
			local s = self.UnitSlots[i]
			if s ~= nil and not s.filled and s.name ~= nil and isvalid(s.name) then
				local t = self:EmptySlotText(i)
				if s.name.TextComponent.Text ~= t then s.name.TextComponent.Text = t end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearUnitSlot(number i)
		local s = self.UnitSlots[i]
		if s == nil then return end
		s.filled = false
		s.name.TextComponent.Text = self:EmptySlotText(i)
		s.name.TextComponent.Alignment = TextAlignmentType.MiddleCenter
		s.name.UITransformComponent.RectSize = Vector2(114, 30)
		self:SetLabelSize(s.name, 13)
		s.lv.TextComponent.Text = ""
		s.bar.SpriteGUIRendererComponent.Color = self:SeriesColor("")
		if self.SelectedSlot == i then self.SelectedSlot = 0 end
		self:ApplySlotLook(i)
	end

	@ExecSpace("ClientOnly")
	method void ApplySlotLook(number i)
		local s = self.UnitSlots[i]
		if s == nil then return end
		local outer = s.box.Parent
		if not s.filled then
			s.box.SpriteGUIRendererComponent.Color = Color(0.094, 0.082, 0.071, 0.35)
			outer.SpriteGUIRendererComponent.Color = Color(0.788, 0.635, 0.290, 0.2)
			s.name.TextComponent.FontColor = Color(0.788, 0.710, 0.541, 0.5)
			s.bar.SpriteGUIRendererComponent.Color = Color(0.541, 0.498, 0.439, 0.35)
			return
		end
		s.name.TextComponent.FontColor = self:ColInk()
		if self.SelectedSlot == i then
			s.box.SpriteGUIRendererComponent.Color = Color(0.22, 0.185, 0.118, 0.92)
			outer.SpriteGUIRendererComponent.Color = self:ColGold()
		else
			s.box.SpriteGUIRendererComponent.Color = self:ColPanel()
			outer.SpriteGUIRendererComponent.Color = self:ColBorderSoft()
		end
	end

	-- 슬롯 클릭 = 선택 표시 + 유닛 정보 팝업
	@ExecSpace("ClientOnly")
	method void OnUnitSlotClick(number i)
		local s = self.UnitSlots[i]
		if s == nil or not s.filled then return end
		local prev = self.SelectedSlot
		self.SelectedSlot = i
		if prev > 0 then self:ApplySlotLook(prev) end
		self:ApplySlotLook(i)
		_RtsUnitPopupLogic:OpenUnit(i)
	end

end
