-- rts-base #2: HUD v2 (화면 v2 — 아티팩트 v16)
--   하단 바(미니맵·초상화·정보·스킬칸·부대지정) 전부 제거.
--   좌상단 시간·메소 칩 / 좌측 플레이어 목록(n/8, 생존·탈락, 나, 클릭→그 구역) /
--   우측 영입 버튼 + 유닛 슬롯 6 / 좌하단 증강 버튼. 팝업은 RtsPopupLogic.
--   UI 좌표는 1920×1080 기준(목업 1cqw = 19.2px).
@Logic
script RtsHudLogic extends Logic

	property boolean Built = false

	-- 스프라이트 RUID
	property string WhiteRUID = "47b5e516b27d4625abffe8db398cd8c2"

	property string CoinRUID = "288ed505d45844c3b717ec9072738b64"

	-- 런타임 참조
	property Entity HudGroup = nil

	property Entity AnchorEntity = nil

	property Entity TimeText = nil

	property Entity MesoText = nil

	property Entity PlayersBox = nil

	property Entity PlayerHead = nil

	-- 플레이어 목록 상태: userId → {row, bar, dot, tomb, name, zone, alive, nick, isMe} / 표시 순서
	property table Players = {}

	property table PlayerOrder = {}

	-- HUD 생성 전에 도착한 목록 통지
	property string PendingPlayers = ""

	property number WatchedZone = 0

	property string MyUserId = ""

	-- 유닛 슬롯 6: i → {box, bar, name, lv, filled}
	property table UnitSlots = {}

	property number SelectedSlot = 0

	-- HUD 생성 전에 유닛이 먼저 동기화된 경우 표시 예약
	property boolean PendingUnits = false

	-- 상단 중앙 안내(위치 이동 모드 등)
	property Entity Hint = nil

	property Entity HintText = nil

	-- ===== UI 헬퍼 (RtsPopupLogic도 사용) =====

	@ExecSpace("ClientOnly")
	method Entity SpawnUI(string modelId, string name, Entity parent, Vector2 anchor, Vector2 pivot, Vector2 pos, Vector2 size)
		local e = _SpawnService:SpawnByModelId(modelId, name, Vector3.zero, parent)
		if e == nil then return nil end
		local t = e.UITransformComponent
		t.AnchorsMin = anchor
		t.AnchorsMax = anchor
		t.Pivot = pivot
		t.anchoredPosition = pos
		t.RectSize = size
		local sr = e.SpriteGUIRendererComponent
		if sr ~= nil then
			sr.ImageRUID = DataRef(self.WhiteRUID)
		end
		return e
	end

	-- 스트레치 배치: 앵커 구간 + 오프셋(좌하/우상)으로 부모에 맞춰 늘어나는 요소용
	@ExecSpace("ClientOnly")
	method Entity SpawnStretch(string modelId, string name, Entity parent, Vector2 aMin, Vector2 aMax, Vector2 offMin, Vector2 offMax)
		local e = _SpawnService:SpawnByModelId(modelId, name, Vector3.zero, parent)
		if e == nil then return nil end
		local t = e.UITransformComponent
		t.AnchorsMin = aMin
		t.AnchorsMax = aMax
		t.OffsetMin = offMin
		t.OffsetMax = offMax
		local sr = e.SpriteGUIRendererComponent
		if sr ~= nil then
			sr.ImageRUID = DataRef(self.WhiteRUID)
		end
		return e
	end

	@ExecSpace("ClientOnly")
	method void Tint(Entity e, number r, number g, number b, number a)
		if e == nil then return end
		local sr = e.SpriteGUIRendererComponent
		if sr ~= nil then sr.Color = Color(r, g, b, a) end
	end

	@ExecSpace("ClientOnly")
	method Entity SpawnText(string name, Entity parent, Vector2 anchor, Vector2 pivot, Vector2 pos, Vector2 size, string text, Color color)
		local e = self:SpawnUI("model://uitext", name, parent, anchor, pivot, pos, size)
		if e == nil then return nil end
		self:Tint(e, 1, 1, 1, 0)
		if e.TextComponent ~= nil then
			e.TextComponent.Text = text
			e.TextComponent.FontColor = color
		end
		return e
	end

	-- 글자 크기·정렬·굵기까지 한 번에
	@ExecSpace("ClientOnly")
	method Entity SpawnLabel(string name, Entity parent, Vector2 anchor, Vector2 pivot, Vector2 pos, Vector2 size, string text, Color color, number fontSize, any align, boolean bold)
		local e = self:SpawnText(name, parent, anchor, pivot, pos, size, text, color)
		if e == nil then return nil end
		local tc = e.TextComponent
		if tc ~= nil then
			tc.FontSize = fontSize
			tc.Alignment = align
			tc.Bold = bold
		end
		return e
	end

	-- 테두리 있는 패널: 바깥(테두리색) + 안쪽(배경색, thick만큼 안으로). 자식은 안쪽에 붙인다
	@ExecSpace("ClientOnly")
	method Entity SpawnPanel(string name, Entity parent, Vector2 anchor, Vector2 pivot, Vector2 pos, Vector2 size, Color bg, Color border, number thick)
		local outer = self:SpawnUI("model://uisprite", name, parent, anchor, pivot, pos, size)
		if outer == nil then return nil end
		outer.SpriteGUIRendererComponent.Color = border
		local inner = self:SpawnStretch("model://uisprite", name .. "In", outer,
			Vector2(0, 0), Vector2(1, 1), Vector2(thick, thick), Vector2(0 - thick, 0 - thick))
		inner.SpriteGUIRendererComponent.Color = bg
		return inner
	end

	-- 투명 클릭 영역 (부모 rect 전체)
	@ExecSpace("ClientOnly")
	method Entity SpawnClick(string name, Entity parent)
		local b = self:SpawnStretch("model://uibutton", name, parent, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		if b ~= nil then self:Tint(b, 1, 1, 1, 0.01) end
		return b
	end

	-- 팔레트
	method Color ColInk()
		return Color(0.957, 0.914, 0.812, 1)
	end

	method Color ColMuted()
		return Color(0.788, 0.710, 0.541, 1)
	end

	method Color ColGold()
		return Color(0.878, 0.725, 0.353, 1)
	end

	method Color ColPanel()
		return Color(0.094, 0.082, 0.071, 0.86)
	end

	method Color ColBorder()
		return Color(0.788, 0.635, 0.290, 0.55)
	end

	method Color ColBorderSoft()
		return Color(0.788, 0.635, 0.290, 0.35)
	end

	-- 계열 색 (좌측 세로 바)
	method Color SeriesColor(string series)
		if series == "war" then return Color(0.839, 0.471, 0.353, 1) end
		if series == "arc" then return Color(0.310, 0.604, 0.388, 1) end
		if series == "mag" then return Color(0.357, 0.525, 0.847, 1) end
		if series == "thf" then return Color(0.557, 0.357, 0.847, 1) end
		return Color(0.541, 0.498, 0.439, 1)
	end

	-- ===== HUD 생성 =====

	@ExecSpace("ClientOnly")
	method void BuildHud(Entity anchorEntity)
		if self.Built then return end
		self.AnchorEntity = anchorEntity
		local ui = _EntityService:GetEntityByPath("/ui")
		if ui == nil then
			log("RtsHud: /ui not found")
			return
		end
		local lp = _UserService.LocalPlayer
		if lp ~= nil and lp.PlayerComponent ~= nil then self.MyUserId = lp.PlayerComponent.UserId end

		local grp = _SpawnService:SpawnByModelId("model://uigroup", "RtsHudGroup", Vector3.zero, ui)
		if grp == nil then
			log("RtsHud: group spawn failed")
			return
		end
		if grp.UIGroupComponent ~= nil then grp.UIGroupComponent.DefaultShow = true end
		grp:SetEnable(true)
		self.HudGroup = grp

		-- 좌상단: 시간 칩 → 메소 칩
		local timeChip = self:SpawnPanel("RtsTimeChip", grp, Vector2(0, 1), Vector2(0, 1), Vector2(16, -16), Vector2(170, 44),
			self:ColPanel(), self:ColBorder(), 1.5)
		self:SpawnLabel("RtsTimeKey", timeChip, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(12, 0), Vector2(40, 30),
			"시간", self:ColMuted(), 15, TextAlignmentType.MiddleLeft, false)
		self.TimeText = self:SpawnLabel("RtsTimeText", timeChip, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(58, 0), Vector2(100, 34),
			"--:--", self:ColInk(), 28, TextAlignmentType.MiddleLeft, true)

		local mesoChip = self:SpawnPanel("RtsMesoChip", grp, Vector2(0, 1), Vector2(0, 1), Vector2(16, -68), Vector2(170, 44),
			self:ColPanel(), self:ColBorder(), 1.5)
		local coin = self:SpawnUI("model://uisprite", "RtsMesoCoin", mesoChip, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(12, 0), Vector2(26, 26))
		coin.SpriteGUIRendererComponent.ImageRUID = DataRef(self.CoinRUID)
		coin.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		self.MesoText = self:SpawnLabel("RtsMesoText", mesoChip, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(48, 0), Vector2(110, 34),
			"0", self:ColInk(), 28, TextAlignmentType.MiddleLeft, true)

		-- 좌측 플레이어 목록 (행은 RefreshPlayerList가 채움)
		local box = self:SpawnUI("model://uisprite", "RtsPlayers", grp, Vector2(0, 1), Vector2(0, 1), Vector2(16, -123), Vector2(221, 400))
		self:Tint(box, 0, 0, 0, 0)
		self.PlayersBox = box
		self.PlayerHead = self:SpawnLabel("RtsPlayerHead", box, Vector2(0, 1), Vector2(0, 1), Vector2(6, 0), Vector2(200, 20),
			"0 / 8", Color(0.49, 0.525, 0.584, 1), 13, TextAlignmentType.MiddleLeft, false)

		-- 우측: 영입 버튼 + 유닛 슬롯 6
		local recruit = self:SpawnPanel("RtsRecruitBtn", grp, Vector2(1, 1), Vector2(1, 1), Vector2(-16, -104), Vector2(130, 50),
			self:ColPanel(), self:ColBorder(), 1.5)
		self:SpawnLabel("RtsRecruitLabel", recruit, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(120, 40),
			"영입", self:ColInk(), 20, TextAlignmentType.MiddleCenter, true)
		local recruitClick = self:SpawnClick("RtsRecruitClick", recruit)
		recruitClick:ConnectEvent(ButtonClickEvent, function(event)
			_RtsPopupLogic:Open("recruit")
		end)

		for i = 1, 6 do
			local y = -168 - (i - 1) * 50
			local slot = self:SpawnPanel("RtsUnitSlot" .. tostring(i), grp, Vector2(1, 1), Vector2(1, 1), Vector2(-16, y), Vector2(130, 44),
				self:ColPanel(), self:ColBorderSoft(), 1.5)
			local bar = self:SpawnStretch("model://uisprite", "RtsUnitSlotBar" .. tostring(i), slot,
				Vector2(0, 0), Vector2(0, 1), Vector2(0, 0), Vector2(4, 0))
			bar.SpriteGUIRendererComponent.Color = self:SeriesColor("")
			local name = self:SpawnLabel("RtsUnitSlotName" .. tostring(i), slot, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(10, 0), Vector2(110, 30),
				"빈 자리", self:ColMuted(), 14, TextAlignmentType.MiddleCenter, false)
			-- 긴 직업명은 잘라낸다 (ellipsis 모드는 안 맞는 글이 오면 이전 글을 그대로 보여주는 문제가 있어 Truncate)
			name.TextComponent.Overflow = OverflowType.Truncate
			name.TextComponent.UseNBSP = true
			local lv = self:SpawnLabel("RtsUnitSlotLv" .. tostring(i), slot, Vector2(1, 0.5), Vector2(1, 0.5), Vector2(-8, 0), Vector2(40, 30),
				"", self:ColMuted(), 12, TextAlignmentType.MiddleRight, false)
			local click = self:SpawnClick("RtsUnitSlotClick" .. tostring(i), slot)
			click:ConnectEvent(ButtonClickEvent, function(event)
				self:OnUnitSlotClick(i)
			end)
			self.UnitSlots[i] = { box = slot, bar = bar, name = name, lv = lv, filled = false }
			self:ApplySlotLook(i)
		end

		-- 좌하단: 증강 버튼
		local aug = self:SpawnPanel("RtsAugBtn", grp, Vector2(0, 0), Vector2(0, 0), Vector2(16, 16), Vector2(100, 50),
			self:ColPanel(), self:ColBorder(), 1.5)
		self:SpawnLabel("RtsAugLabel", aug, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(96, 40),
			"증강", self:ColInk(), 20, TextAlignmentType.MiddleCenter, true)
		local augClick = self:SpawnClick("RtsAugClick", aug)
		augClick:ConnectEvent(ButtonClickEvent, function(event)
			_RtsPopupLogic:Open("augment")
		end)

		-- 상단 중앙 안내(기본 숨김)
		local hint = self:SpawnPanel("RtsHint", grp, Vector2(0.5, 1), Vector2(0.5, 1), Vector2(0, -16), Vector2(720, 44),
			Color(0.22, 0.185, 0.118, 0.94), self:ColGold(), 1.5)
		self.HintText = self:SpawnLabel("RtsHintText", hint, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(700, 36),
			"", self:ColInk(), 17, TextAlignmentType.MiddleCenter, true)
		self.Hint = hint.Parent
		self.Hint:SetEnable(false)

		self.Built = true
		log("RtsHud: built v2")

		_RtsPopupLogic:Build(ui)
		if self.PendingPlayers ~= "" then
			local packed = self.PendingPlayers
			self.PendingPlayers = ""
			self:RefreshPlayerList(packed)
		end
		self:RefreshMyUnits()
		self:SetMeso(_RtsUnitLogic:GetMyMeso())
	end

	@ExecSpace("ClientOnly")
	method void ShowHint(string text)
		if self.Hint == nil then return end
		self.HintText.TextComponent.Text = text
		self.Hint:SetEnable(true)
	end

	@ExecSpace("ClientOnly")
	method void HideHint()
		if self.Hint == nil then return end
		self.Hint:SetEnable(false)
	end

	-- ===== 시간·메소 =====

	@ExecSpace("ClientOnly")
	method void SetTime(string text)
		if self.TimeText == nil or self.TimeText.TextComponent == nil then return end
		self.TimeText.TextComponent.Text = text
	end

	-- 프로퍼티·동기화 값은 실수(1.0)로 오므로 표시용 정수 문자열은 이걸로
	method string Int(number n)
		return tostring(math.floor(n + 0.5))
	end

	method string FormatNumber(number n)
		local s = tostring(math.floor(n))
		local out = ""
		local len = string.len(s)
		for i = 1, len do
			out = out .. string.sub(s, i, i)
			local rest = len - i
			if rest > 0 and rest % 3 == 0 then out = out .. "," end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void SetMeso(number n)
		if self.MesoText == nil or self.MesoText.TextComponent == nil then return end
		self.MesoText.TextComponent.Text = self:FormatNumber(n)
	end

	-- ===== 플레이어 목록 =====

	-- 서버 통지(전 클라). packed = "userId\t닉네임\t구역\t생존(1/0)\n..." (구역순)
	@ExecSpace("Client")
	method void RefreshPlayerList(string packed)
		if not self.Built or self.PlayersBox == nil then
			self.PendingPlayers = packed
			return
		end
		-- 기존 행 제거
		for i = 1, #self.PlayerOrder do
			local p = self.Players[self.PlayerOrder[i]]
			if p ~= nil and p.row ~= nil and p.row.Parent ~= nil then p.row.Parent:Destroy() end
		end
		self.Players = {}
		self.PlayerOrder = {}

		local count = 0
		for line in string.gmatch(packed, "[^\n]+") do
			local f = {}
			for field in string.gmatch(line .. "\t", "([^\t]*)\t") do f[#f + 1] = field end
			if #f >= 4 then
				count = count + 1
				local userId = f[1]
				local zone = tonumber(f[3]) or 0
				local alive = f[4] == "1"
				self:AddPlayerRow(count, userId, f[2], zone, alive)
			end
		end
		if self.PlayerHead ~= nil and self.PlayerHead.TextComponent ~= nil then
			self.PlayerHead.TextComponent.Text = string.format("%d / %d", count, _RtsZoneLogic:GetZoneCount())
		end
		self:ApplyWatchLook()
	end

	@ExecSpace("ClientOnly")
	method void AddPlayerRow(number index, string userId, string nick, number zone, boolean alive)
		local y = -24 - (index - 1) * 37
		local row = self:SpawnPanel("RtsPlayerRow" .. tostring(index), self.PlayersBox, Vector2(0, 1), Vector2(0, 1), Vector2(0, y), Vector2(221, 32),
			self:ColPanel(), self:ColBorderSoft(), 1.5)
		local bar = self:SpawnStretch("model://uisprite", "RtsPlayerBar", row, Vector2(0, 0), Vector2(0, 1), Vector2(0, 0), Vector2(5, 0))
		local dot = self:SpawnUI("model://uisprite", "RtsPlayerDot", row, Vector2(0, 0.5), Vector2(0.5, 0.5), Vector2(20, 0), Vector2(13, 13))
		local tomb = self:SpawnUI("model://uisprite", "RtsPlayerTomb", row, Vector2(0, 0.5), Vector2(0.5, 0.5), Vector2(20, 0), Vector2(14, 17))
		local tombIn = self:SpawnStretch("model://uisprite", "RtsPlayerTombIn", tomb, Vector2(0, 0), Vector2(1, 1), Vector2(1.5, 1.5), Vector2(-1.5, -1.5))
		self:Tint(tomb, 0.29, 0.27, 0.235, 1)
		self:Tint(tombIn, 0.55, 0.51, 0.45, 1)
		local name = self:SpawnLabel("RtsPlayerName", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(36, 0), Vector2(180, 28),
			nick, self:ColInk(), 16, TextAlignmentType.MiddleLeft, false)
		if name.TextComponent ~= nil then name.TextComponent.IsRichText = true end
		local click = self:SpawnClick("RtsPlayerClick", row)
		click:ConnectEvent(ButtonClickEvent, function(event)
			self:OnPlayerRowClick(userId)
		end)
		local p = { row = row, bar = bar, dot = dot, tomb = tomb, name = name, zone = zone, alive = alive, nick = nick,
			isMe = (userId == self.MyUserId) }
		self.Players[userId] = p
		self.PlayerOrder[#self.PlayerOrder + 1] = userId
		self:ApplyPlayerLook(userId)
	end

	-- 행 모양: 생존(초록 점) / 탈락(회색 테두리 + 비석 + 취소선) / 나(금색 바 + (나)) / 보는 중(밝게)
	@ExecSpace("ClientOnly")
	method void ApplyPlayerLook(string userId)
		local p = self.Players[userId]
		if p == nil then return end
		local watching = (p.zone == self.WatchedZone)
		local label = p.nick
		if p.isMe then label = label .. " <color=#e0b95a><b>(나)</b></color>" end
		if p.alive then
			p.dot:SetEnable(true)
			p.tomb:SetEnable(false)
			self:Tint(p.dot, 0.247, 0.643, 0.435, 1)
			p.name.TextComponent.FontColor = self:ColInk()
			p.name.TextComponent.Text = label
			if watching then
				p.row.SpriteGUIRendererComponent.Color = Color(0.22, 0.185, 0.118, 0.92)
				p.row.Parent.SpriteGUIRendererComponent.Color = self:ColGold()
			else
				p.row.SpriteGUIRendererComponent.Color = self:ColPanel()
				p.row.Parent.SpriteGUIRendererComponent.Color = self:ColBorderSoft()
			end
			if p.isMe then
				p.bar.SpriteGUIRendererComponent.Color = self:ColGold()
			else
				p.bar.SpriteGUIRendererComponent.Color = Color(0.788, 0.635, 0.290, 0.6)
			end
		else
			p.dot:SetEnable(false)
			p.tomb:SetEnable(true)
			p.name.TextComponent.FontColor = Color(0.604, 0.561, 0.502, 1)
			p.name.TextComponent.Text = label
			p.row.SpriteGUIRendererComponent.Color = Color(0.094, 0.082, 0.071, 0.7)
			local grey = Color(0.42, 0.388, 0.341, 1)
			if watching then grey = self:ColGold() end
			p.row.Parent.SpriteGUIRendererComponent.Color = grey
			p.bar.SpriteGUIRendererComponent.Color = Color(0.42, 0.388, 0.341, 1)
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyWatchLook()
		for i = 1, #self.PlayerOrder do
			self:ApplyPlayerLook(self.PlayerOrder[i])
		end
	end

	@ExecSpace("ClientOnly")
	method void SetPlayerAlive(string userId, boolean alive)
		local p = self.Players[userId]
		if p == nil then return end
		p.alive = alive
		self:ApplyPlayerLook(userId)
	end

	-- 지금 보고 있는 구역 (JumpToZone에서 호출)
	@ExecSpace("ClientOnly")
	method void SetWatchedZone(number n)
		self.WatchedZone = n
		if not self.Built then return end
		self:ApplyWatchLook()
	end

	@ExecSpace("ClientOnly")
	method void OnPlayerRowClick(string userId)
		local p = self.Players[userId]
		if p == nil or p.zone < 1 or self.AnchorEntity == nil then return end
		local anchor = self.AnchorEntity.RtsCameraAnchorComponent
		if anchor ~= nil then anchor:JumpToZone(p.zone) end
	end

	-- ===== 유닛 슬롯 (내 유닛 = RtsUnitLogic, 번호 = 슬롯) =====

	-- 내 유닛 6칸을 다시 채운다. HUD가 아직 없으면 생성 뒤에 한 번
	@ExecSpace("ClientOnly")
	method void RefreshMyUnits()
		if not self.Built then
			self.PendingUnits = true
			return
		end
		self.PendingUnits = false
		for i = 1, _RtsUnitLogic:GetMaxUnits() do
			local u = _RtsUnitLogic:GetMyUnit(i)
			if u ~= nil then
				self:SetUnitSlot(i, u.No, _RtsJobTableLogic:GetJobName(u.JobId), u.Level, _RtsJobTableLogic:GetSeries(u.JobId))
			else
				self:ClearUnitSlot(i)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetUnitSlot(number i, number no, string jobName, number level, string series)
		local s = self.UnitSlots[i]
		if s == nil then return end
		s.filled = true
		-- 리치텍스트 태그는 말줄임(ellipsis)에 잘려 그대로 노출되므로 평문으로
		s.name.TextComponent.Text = self:Int(no) .. ". " .. jobName
		s.name.TextComponent.Alignment = TextAlignmentType.MiddleLeft
		s.name.UITransformComponent.RectSize = Vector2(80, 30)
		s.name.TextComponent.FontSize = 13
		s.lv.TextComponent.Text = "Lv " .. self:Int(level)
		s.bar.SpriteGUIRendererComponent.Color = self:SeriesColor(series)
		self:ApplySlotLook(i)
	end

	@ExecSpace("ClientOnly")
	method void ClearUnitSlot(number i)
		local s = self.UnitSlots[i]
		if s == nil then return end
		s.filled = false
		s.name.TextComponent.Text = "빈 자리"
		s.name.TextComponent.Alignment = TextAlignmentType.MiddleCenter
		s.name.UITransformComponent.RectSize = Vector2(110, 30)
		s.name.TextComponent.FontSize = 14
		s.lv.TextComponent.Text = ""
		s.bar.SpriteGUIRendererComponent.Color = self:SeriesColor("")
		if self.SelectedSlot == i then self.SelectedSlot = 0 end
		self:ApplySlotLook(i)
	end

	@ExecSpace("ClientOnly")
	method void ApplySlotLook(number i)
		local s = self.UnitSlots[i]
		if s == nil then return end
		local outer = s.box.Parent
		if not s.filled then
			s.box.SpriteGUIRendererComponent.Color = Color(0.094, 0.082, 0.071, 0.35)
			outer.SpriteGUIRendererComponent.Color = Color(0.788, 0.635, 0.290, 0.2)
			s.name.TextComponent.FontColor = Color(0.788, 0.710, 0.541, 0.5)
			s.bar.SpriteGUIRendererComponent.Color = Color(0.541, 0.498, 0.439, 0.35)
			return
		end
		s.name.TextComponent.FontColor = self:ColInk()
		if self.SelectedSlot == i then
			s.box.SpriteGUIRendererComponent.Color = Color(0.22, 0.185, 0.118, 0.92)
			outer.SpriteGUIRendererComponent.Color = self:ColGold()
		else
			s.box.SpriteGUIRendererComponent.Color = self:ColPanel()
			outer.SpriteGUIRendererComponent.Color = self:ColBorderSoft()
		end
	end

	-- 슬롯 클릭 = 선택 표시 + 유닛 정보 팝업
	@ExecSpace("ClientOnly")
	method void OnUnitSlotClick(number i)
		local s = self.UnitSlots[i]
		if s == nil or not s.filled then return end
		local prev = self.SelectedSlot
		self.SelectedSlot = i
		if prev > 0 then self:ApplySlotLook(prev) end
		self:ApplySlotLook(i)
		_RtsUnitPopupLogic:OpenUnit(i)
	end

end
