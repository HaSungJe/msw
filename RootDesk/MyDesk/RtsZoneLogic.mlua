-- rts-base #4 (화면 v2): 구역 시스템 — 배정(서버 권위) + 그리드 트랙/발판 좌표(단일 소스) + 시각화(서버 1회)
-- 트랙: 16×13 그리드(2026-09-20: 18×12에서 우측 2열 삭제·아래 1행 추가) 위 경로 M2(2026-09-25 사용자 "보스 영역을 맵 가운데로 … 트랙·배치 칸 조정", "매듭 2개는 이어지고 1개는 멀리, 난잡한 형태").
--   t=0 = S(15열 9행, 왼쪽으로 출발), t=1 = E(11열 6행 — 보스 오른쪽), 77칸, 등속(경로 길이 비례). 교차 4곳(6,4)(10,11)(12,11)(14,4).
--   매듭 = 트랙이 발판 한 칸을 네 방향으로 감는 곳 — 둘레 8칸이 전부 트랙인 칸 (9,10)·(13,12)(붙은 둘)·(5,3)(멀리 하나). 근접 유닛 자리.
--   E에 닿은 몹은 S로 되돌린다(순환은 몹 로직이 t를 0으로 — Phase 3).
-- 발판: 그리드 안의 트랙·보스 영역이 아닌 칸 전부(2026-09-23 — 트랙 인접 조건 삭제). 유닛은 발판에만 1기씩.
-- 보스 영역: 8~9열 × 6~7행 2×2(2026-09-25 사용자 "맵의 가운데쪽에 보스영역 타일 4개" — 13줄이라 정중앙 대신 반 칸 위) — 유닛 배치 불가, 보스는 영역 가운데 3×3칸 상자에 맞춰 선다(RtsBossLogic), 반투명 붉은 판으로 표시.
-- 칸 좌표는 1-기반 (col 1~16, row 1~13, row는 위에서 아래로).
@Logic
script RtsZoneLogic extends Logic

	property SyncTable<string, number> ZoneByUser

	property boolean VisualsBuilt = false

	property boolean PathBuilt = false

	-- 경로 칸 목록(순서 보존, 교차 칸은 두 번 등장) / 트랙 칸 집합 / 발판 목록(행 우선)
	property table PathCells = {}

	property table RoadSet = {}

	property table PadList = {}

	-- 구역 → 세운 장식물 수(테마 전환 시 제거용 — 구역마다 테마가 달라 개수도 다르다, 2026-09-25)
	property table DecorCountByZone = {}

	-- 보스 영역(1-기반 왼쪽 위 칸 + 한 변 칸 수). 2026-09-23 아래 가운데 4×5(8~11열 × 9~13행) → 2026-09-25 사용자 "맵의 가운데쪽에 보스영역 타일 4개": 8~9열 × 6~7행.
	--   둘레 한 겹(7~10열 × 5~8행)은 발판, 그 밖을 트랙이 네 면 다 지나간다
	property number BossAreaCol = 8

	property number BossAreaRow = 6

	property number BossAreaCols = 2

	property number BossAreaRows = 2

	-- 보스 영역 표시 판: 흰 스프라이트(RtsHudLogic.WhiteRUID — 스케일 1 = 0.08유닛)를 영역 크기로 늘려 반투명 붉게
	property string BossAreaRUID = "47b5e516b27d4625abffe8db398cd8c2"

	property number WhiteUnit = 0.08

	method number GetZoneCount()
		return _RtsConfigLogic:GetZoneCols() * _RtsConfigLogic:GetZoneRows()
	end

	-- ===== 경로 정의 =====

	-- 꺾임점 20개 (1-기반 {col,row}) — M2(2026-09-25). tools/gen-track-grid.js SEQ와 0/1-기반만 다르다(경로를 바꾸면 둘 다 + 텍스처 재업로드).
	method table GetTurnPoints()
		return {
			{15, 9}, {12, 9}, {12, 13}, {14, 13}, {14, 11}, {8, 11}, {8, 9}, {10, 9}, {10, 13}, {2, 13},
			{2, 11}, {6, 11}, {6, 2}, {4, 2}, {4, 4}, {16, 4}, {16, 1}, {14, 1}, {14, 6}, {11, 6},
		}
	end

	-- 프로퍼티·동기화·RPC로 온 칸 번호는 실수(4.0)일 수 있어 정수로 맞춘다 ("4.0,3.0" ≠ "4,3" — 2026-09-15 실측)
	method string CellKey(number col, number row)
		return string.format("%d,%d", math.floor(col + 0.5), math.floor(row + 0.5))
	end

	method void EnsurePath()
		if self.PathBuilt then return end
		local turns = self:GetTurnPoints()
		local cells = {}
		local road = {}
		local first = turns[1]
		cells[#cells + 1] = { first[1], first[2] }
		road[self:CellKey(first[1], first[2])] = true
		for i = 1, #turns - 1 do
			local a = turns[i]
			local b = turns[i + 1]
			local dc = 0
			local dr = 0
			if b[1] > a[1] then dc = 1 elseif b[1] < a[1] then dc = -1 end
			if b[2] > a[2] then dr = 1 elseif b[2] < a[2] then dr = -1 end
			local c = a[1]
			local r = a[2]
			while c ~= b[1] or r ~= b[2] do
				c = c + dc
				r = r + dr
				cells[#cells + 1] = { c, r }
				road[self:CellKey(c, r)] = true
			end
		end
		self.PathCells = cells
		self.RoadSet = road

		-- 발판: 그리드 안의 트랙이 아닌 칸 전부, 행 우선(위→아래, 왼→오른). 2026-09-23 사용자 "트랙에 인접하지 않았더라도 배치 가능" — 전엔 트랙에 4방향으로 면한 칸만
		local pads = {}
		for r = 1, _RtsConfigLogic:GetGridRows() do
			for c = 1, _RtsConfigLogic:GetGridCols() do
				if road[self:CellKey(c, r)] == nil and not self:IsBossAreaCell(c, r) then pads[#pads + 1] = { c, r } end
			end
		end
		self.PadList = pads
		self.PathBuilt = true
	end

	-- ===== 칸 ↔ 월드 =====

	method Vector2 GetCellCenter(number zone, number col, number row)
		local c = _RtsConfigLogic:GetZoneCenter(zone)
		local cell = _RtsConfigLogic:GetGridCell()
		local x = c.x + _RtsConfigLogic:GetGridLeft() + (col - 0.5) * cell
		local y = c.y + _RtsConfigLogic:GetGridTop() - (row - 0.5) * cell
		return Vector2(x, y)
	end

	method boolean IsRoadCell(number col, number row)
		self:EnsurePath()
		return self.RoadSet[self:CellKey(col, row)] == true
	end

	-- 발판 = 그리드 안의 트랙·보스 영역이 아닌 칸(트랙 인접 여부 무관 — 2026-09-23 사용자)
	method boolean IsPadCell(number col, number row)
		self:EnsurePath()
		local c = math.floor(col + 0.5)
		local r = math.floor(row + 0.5)
		if c < 1 or r < 1 or c > _RtsConfigLogic:GetGridCols() or r > _RtsConfigLogic:GetGridRows() then return false end
		if self:IsBossAreaCell(c, r) then return false end
		return self.RoadSet[self:CellKey(c, r)] ~= true
	end

	-- 보스 영역 칸인가
	method boolean IsBossAreaCell(number col, number row)
		local c = math.floor(col + 0.5)
		local r = math.floor(row + 0.5)
		return c >= self.BossAreaCol and c < self.BossAreaCol + self.BossAreaCols and r >= self.BossAreaRow and r < self.BossAreaRow + self.BossAreaRows
	end

	-- 보스 영역 가운데(세계)
	method Vector2 GetBossAreaCenter(number zone)
		return self:GetCellCenter(zone, self.BossAreaCol + (self.BossAreaCols - 1) / 2, self.BossAreaRow + (self.BossAreaRows - 1) / 2)
	end

	-- 8방향 칸 거리 = 열·행 차이 중 큰 값 (사거리 판정의 기준)
	method number CellDistance(number c1, number r1, number c2, number r2)
		return math.max(math.abs(c1 - c2), math.abs(r1 - r2))
	end

	-- ===== 트랙 =====

	-- 경로 칸 수 − 1 = 이동 칸 수(77 — M2, 교차 칸은 두 번 센다)
	method number GetTrackSteps()
		self:EnsurePath()
		return #self.PathCells - 1
	end

	method number GetTrackLength()
		return self:GetTrackSteps() * _RtsConfigLogic:GetGridCell()
	end

	-- 트랙 위 점: t∈[0,1], 0=S, 1=E, 경로 길이 비례. 범위 밖은 양끝으로 고정
	method Vector2 GetTrackPoint(number zone, number t)
		self:EnsurePath()
		local steps = self:GetTrackSteps()
		if t < 0 then t = 0 end
		if t > 1 then t = 1 end
		local d = t * steps
		local i = math.floor(d)
		if i >= steps then
			local last = self.PathCells[steps + 1]
			return self:GetCellCenter(zone, last[1], last[2])
		end
		local frac = d - i
		local a = self.PathCells[i + 1]
		local b = self.PathCells[i + 2]
		local pa = self:GetCellCenter(zone, a[1], a[2])
		local pb = self:GetCellCenter(zone, b[1], b[2])
		return Vector2(pa.x + (pb.x - pa.x) * frac, pa.y + (pb.y - pa.y) * frac)
	end

	method number GetSpawnT()
		return 0
	end

	method Vector2 GetSpawnPoint(number zone)
		return self:GetTrackPoint(zone, 0)
	end

	method Vector2 GetEndPoint(number zone)
		return self:GetTrackPoint(zone, 1)
	end

	-- 비석 자리(RtsRunResultLogic.SpawnTomb): 구역 화면 중앙. 이름은 Phase 7 보스 자리 시절 그대로 — 보스는 이제 보스 영역(GetBossAreaCenter)
	method Vector2 GetBossPoint(number zone)
		return _RtsConfigLogic:GetZoneCenter(zone)
	end

	-- ===== 발판 (배치 슬롯) =====

	method number GetPadCount()
		self:EnsurePath()
		return #self.PadList
	end

	-- 이름 유지(로드맵 #14 참조) — 값은 발판 수
	method number GetPlacementSlotCount()
		return self:GetPadCount()
	end

	-- index번째 발판 칸 (1~81, 범위 밖은 양끝으로 고정). x=col, y=row
	method Vector2 GetPadCell(number index)
		self:EnsurePath()
		local n = #self.PadList
		if index < 1 then index = 1 end
		if index > n then index = n end
		local p = self.PadList[index]
		return Vector2(p[1], p[2])
	end

	method Vector2 GetPlacementSlot(number zone, number index)
		local p = self:GetPadCell(index)
		return self:GetCellCenter(zone, p.x, p.y)
	end

	-- ===== 배정 (서버 권위) =====

	@ExecSpace("ServerOnly")
	method number AssignZone(string userId)
		local exist = self.ZoneByUser[userId]
		if exist ~= nil then return exist end
		for n = 1, self:GetZoneCount() do
			if not self:IsZoneOccupied(n) then
				self.ZoneByUser[userId] = n
				return n
			end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void ReleaseZone(string userId)
		local n = self.ZoneByUser[userId]
		if n == nil then return end
		self.ZoneByUser[userId] = nil
	end

	method number GetZoneOfUser(string userId)
		local n = self.ZoneByUser[userId]
		if n == nil then return 0 end
		return n
	end

	method boolean IsZoneOccupied(number zone)
		for userId, n in pairs(self.ZoneByUser) do
			if n == zone then return true end
		end
		return false
	end

	-- ===== 시각화 (서버 1회 생성 — EnsureGroundTiles 형제 패턴) =====

	-- 월드 스프라이트 엔티티: 네이티브 모델 MapObject(Transform + SpriteRenderer, 카메라 없음 — 2026-09-14 실측)
	--   (이전의 defaultplayer 복제 + 카메라 비활성 우회는 폐기)
	@ExecSpace("ServerOnly")
	method Entity SpawnProp(string name, Entity parent, Vector2 at, string ruid, number order)
		local e = _SpawnService:SpawnByModelId("model://MapObject", name, Vector3(at.x, at.y, 0), parent)
		if e == nil then return nil end
		if e.SpriteRendererComponent == nil then e:AddComponent("SpriteRendererComponent") end
		local sr = e.SpriteRendererComponent
		sr.SpriteRUID = ruid
		sr.SortingLayer = "MapLayer0"
		sr.OrderInLayer = order
		return e
	end

	-- 구역마다 그리드 텍스처 1장 (트랙+발판+S 화살표·E 되돌리기). 경계선 없음 — 구역 = 화면. 텍스처는 테마 프리셋이 정한다
	@ExecSpace("ServerOnly")
	method void EnsureZoneVisuals()
		if self.VisualsBuilt then return end
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		if mapRoot == nil then return end
		if _EntityService:GetEntityByPath("/maps/RtsMap/ZoneGrid1") ~= nil then
			self.VisualsBuilt = true
			return
		end

		local cell = _RtsConfigLogic:GetGridCell()
		local offX = _RtsConfigLogic:GetGridLeft() + _RtsConfigLogic:GetGridCols() * cell * 0.5
		local offY = _RtsConfigLogic:GetGridTop() - _RtsConfigLogic:GetGridRows() * cell * 0.5
		local scale = _RtsConfigLogic:GetGridTextureScale()
		-- 처음엔 모든 구역을 기본 테마로(유저가 들어오면 RtsProfileLogic이 그 구역만 자기 테마로 — RtsThemeLogic.ApplyToZone)
		local preset = _RtsThemeLogic:GetPreset(_RtsThemeLogic.DefaultKey)
		local ruid = preset.gridRUID

		for n = 1, self:GetZoneCount() do
			local c = _RtsConfigLogic:GetZoneCenter(n)
			self:SetZoneBackground(n, preset.backgroundRUID, preset.backgroundAlpha)
			local grid = self:SpawnProp("ZoneGrid" .. tostring(n), mapRoot, Vector2(c.x + offX, c.y + offY), ruid, 100)
			if grid ~= nil then
				grid.TransformComponent.Scale = Vector3(scale, scale, 1)
			end
			self:SpawnBossArea(n, mapRoot)
		end
		for n = 1, self:GetZoneCount() do self:SetZoneDecor(n, preset.decor) end
		self.VisualsBuilt = true
		_RtsConfigLogic:Log("RtsZone: visuals built (grid track x" .. tostring(self:GetZoneCount()) .. ")")
	end

	-- 보스 영역 표시: 영역(4×5) 칸 위 반투명 붉은 판(그리드 100 위, 장식 110·유닛·몹 아래). 칸 경계선이 보이게 가장자리를 살짝 안으로
	@ExecSpace("ServerOnly")
	method void SpawnBossArea(number zone, Entity mapRoot)
		local at = self:GetBossAreaCenter(zone)
		local e = self:SpawnProp("ZoneBossArea" .. tostring(zone), mapRoot, at, self.BossAreaRUID, 105)
		if e == nil then return end
		local cell = _RtsConfigLogic:GetGridCell()
		local sx = (cell * self.BossAreaCols - 0.12) / self.WhiteUnit
		local sy = (cell * self.BossAreaRows - 0.12) / self.WhiteUnit
		e.TransformComponent.Scale = Vector3(sx, sy, 1)
		e.SpriteRendererComponent.Color = Color(0.85, 0.16, 0.12, 0.28)
	end

	-- 배경 사물(구역 하나): 그 구역의 옛 장식을 지우고 목록대로 다시 세운다. 자리·층·투명도는 프리셋이 정한다(트랙 바깥 여백, 그리드 위 110, 불투명). 유닛·몹(200~)은 더 위
	--   2026-09-25 구역마다 테마가 다를 수 있어 구역 단위로(RtsThemeLogic.ApplyToZone). 전엔 8구역 한꺼번에 SetDecor
	@ExecSpace("ServerOnly")
	method void SetZoneDecor(number zone, table list)
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		if mapRoot == nil then return end
		local n = math.floor(zone + 0.5)
		-- 옛 장식: 기록한 개수까지 + 그 뒤로도 이름이 이어지는 동안 지운다(개수 기록이 없는 경로에서도 남지 않게)
		local old = self.DecorCountByZone[n] or 0
		local i = 1
		while true do
			local e = _EntityService:GetEntityByPath("/maps/RtsMap/ZoneDecor" .. string.format("%d_%d", n, i))
			if e == nil and i > old then break end
			if e ~= nil then e:Destroy() end
			i = i + 1
		end
		if list == nil then list = {} end
		self.DecorCountByZone[n] = #list
		local order = _RtsThemeLogic:GetDecorOrder()
		local alpha = _RtsThemeLogic:GetDecorAlpha()
		for i = 1, #list do
			local d = list[i]
			local at = self:GetCellCenter(n, d.col, d.row)
			local e = self:SpawnProp("ZoneDecor" .. string.format("%d_%d", n, i), mapRoot, at, d.ruid, order)
			if e ~= nil then
				e.SpriteRendererComponent.Color = Color(1, 1, 1, alpha)
				if d.scale ~= nil and d.scale ~= 1 then
					e.TransformComponent.Scale = Vector3(d.scale, d.scale, 1)
				end
				if d.flip == true then e.SpriteRendererComponent.FlipX = true end  -- 2026-09-25 테마 장식 좌우 뒤집기(커닝 공사장 표식을 전투판 쪽으로)
			end
		end
	end

	-- 마을 풍경(구역 하나): 바닥 타일 위·트랙 판 아래. 1920×1080/PPU 100을 화면 42.67×24유닛에 맞춘다.
	@ExecSpace("ServerOnly")
	method void SetZoneBackground(number zone, string ruid, number alpha)
		if ruid == nil or ruid == "" then return end
		local n = math.floor(zone + 0.5)
		local name = "ZoneBackground" .. string.format("%d", n)
		local bg = _EntityService:GetEntityByPath("/maps/RtsMap/" .. name)
		if bg == nil then
			local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
			if mapRoot == nil then return end
			bg = self:SpawnProp(name, mapRoot, _RtsConfigLogic:GetZoneCenter(n), ruid, 90)
			if bg == nil then return end
		end
		local scale = _RtsConfigLogic:GetGridTextureScale()
		bg.TransformComponent.Scale = Vector3(scale, scale, 1)
		bg.SpriteRendererComponent.SpriteRUID = ruid
		bg.SpriteRendererComponent.Color = Color(1, 1, 1, alpha or 1)
	end

	-- 트랙 판(구역 하나): 이미 세워진 ZoneGrid{n}의 텍스처·색만 바꾼다(RtsThemeLogic.ApplyToZone)
	@ExecSpace("ServerOnly")
	method void SetZoneGrid(number zone, string ruid, Color tint)
		local grid = _EntityService:GetEntityByPath("/maps/RtsMap/ZoneGrid" .. string.format("%d", math.floor(zone + 0.5)))
		if grid == nil or grid.SpriteRendererComponent == nil then return end
		grid.SpriteRendererComponent.SpriteRUID = ruid
		grid.SpriteRendererComponent.Color = tint
	end

end
