-- Phase 6 (2026-09-23): 구역별 몬스터 웨이브. 몬스터 스테이지마다 살아 있는 구역에 40마리를 0.5초 간격으로 트랙 S(t=0)에서 내보낸다(20초).
--   스폰 순서 = 스테이지 몹 목록을 40칸에 고르게 채우고 섞은 배열. 몹은 E에 닿으면 S로 돌아가 계속 돈다(순환).
--   필드 수(구역에 살아 있는 몹 수, 동기화)가 110이 되면 그 구역 주인은 탈락. 보스 스테이지 동안 일반 몹은 보관(숨김·정지·대상 제외)했다가 보스전 뒤 같은 자리에서 다시 돈다.
--   몬스터 엔티티 생성(SpawnMonsterEntity)은 보스(RtsBossLogic)도 같이 쓴다 — 크기·피격 박스·체력바 높이는 RtsStageTableLogic 몬스터 표.
@Logic
script RtsWaveLogic extends Logic

	-- 구역별 필드 수: key = 구역 번호 문자열("1"~"8")
	@Sync
	property SyncTable<string, number> FieldByZone

	property number FieldLimit = 110

	property number SpawnInterval = 0.5

	-- 서버: 구역 → 스폰 순서(몬스터 id 배열) / 다음 순번
	property table Queue = {}

	property table QueuePos = {}

	-- 서버: 구역 → { [엔티티 이름] = 엔티티 } (보관·정리용, 살아 있는 일반 몹만)
	property table Mobs = {}

	property number SpawnStage = 0

	property number SpawnTimer = 0

	property boolean Spawning = false

	-- 엔티티 이름 일련번호(구역 공통)
	property number Serial = 0

	property number MobSpeed = 100

	-- 클라: 사망음 겹침 제한(마지막 재생 시각 · 최소 간격 · 음량)
	property number LastDieSound = 0

	property number DieSoundGap = 0.08

	property number DieSoundVol = 0.5

	-- ===== 공용 =====

	method string ZoneKey(number zone)
		return string.format("%d", math.floor(zone + 0.5))
	end

	method number GetField(number zone)
		if zone < 1 then return 0 end
		local v = self.FieldByZone[self:ZoneKey(zone)]
		if v == nil then return 0 end
		return v
	end

	-- 사망음(RtsMonsterComponent.PlayDie — 보고 있는 구역만). 한꺼번에 죽어도 DieSoundGap초에 한 번
	@ExecSpace("ClientOnly")
	method void PlayDieSound(string ruid)
		local now = _UtilLogic.ElapsedSeconds
		if now - self.LastDieSound < self.DieSoundGap then return end
		self.LastDieSound = now
		_SoundService:PlaySound(ruid, self.DieSoundVol)
	end

	-- ===== 서버: 몬스터 엔티티 =====

	-- 몬스터 엔티티 = 스프라이트(이동 클립·표 스케일) + HitComponent(표 피격 박스, 로컬) + DamageSkinSpawner(체력바 위) + RtsMonsterComponent + RtsTrackWalkerComponent(t=0에서 출발)
	--   표에 없는 id는 초록달팽이(M001)로 대신한다
	@ExecSpace("ServerOnly")
	method Entity SpawnMonsterEntity(string name, number zone, string mobId, number hp, boolean isBoss)
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		if mapRoot == nil then return nil end
		local id = mobId
		local mon = _RtsStageTableLogic:GetMonster(id)
		if mon == nil then
			id = "M001"
			mon = _RtsStageTableLogic:GetMonster(id)
		end
		local at = _RtsZoneLogic:GetTrackPoint(zone, 0)
		local e = _RtsZoneLogic:SpawnProp(name, mapRoot, at, mon.walk, 200)
		if e == nil then return nil end
		local s = mon.scale or 1
		e.TransformComponent.Scale = Vector3(s, s, 1)
		local hit = e:AddComponent("HitComponent")
		if hit ~= nil then
			hit.BoxSize = Vector2(mon.boxW, mon.boxH)
			hit.ColliderOffset = Vector2(mon.boxX, mon.boxY)
		end
		-- 데미지 숫자 시작 높이(세계): 체력바 위
		local skin = e:AddComponent("DamageSkinSpawnerComponent")
		if skin ~= nil then skin.DamageSkinOffset = Vector2(0, (mon.barY or 1.15) + 0.2) end
		local m = e:AddComponent("RtsMonsterComponent")
		if m ~= nil then
			m.MonsterId = id
			m.MaxHp = hp
			m.Hp = hp
			m.Zone = zone
			m.IsBoss = isBoss
		end
		local w = e:AddComponent("RtsTrackWalkerComponent")
		if w ~= nil then
			w.Zone = zone
			w.T = 0
			w.Speed = self.MobSpeed
			w.Loop = not isBoss
		end
		return e
	end

	-- ===== 서버: 스폰 =====

	@ExecSpace("ServerOnly")
	method void StartSpawn(number n)
		self:StopSpawn()
		local s = _RtsStageTableLogic:GetStage(n)
		if s == nil or s.kind ~= "mob" or #s.mobs == 0 then return end
		self.SpawnStage = n
		local total = _RtsStageTableLogic.SpawnPerStage
		local zones = _RtsRunResultLogic:AliveZones()
		for zi = 1, #zones do
			local zone = zones[zi]
			local list = {}
			for i = 1, total do list[i] = s.mobs[((i - 1) % #s.mobs) + 1] end
			for i = #list, 2, -1 do
				local j = _UtilLogic:RandomIntegerRange(1, i)
				list[i], list[j] = list[j], list[i]
			end
			self.Queue[zone] = list
			self.QueuePos[zone] = 1
		end
		self.Spawning = true
		self.SpawnTimer = _TimerService:SetTimerRepeat(function() self:SpawnTick() end, self.SpawnInterval, 0.05)
	end

	-- 0.5초마다 구역마다 1마리. 줄이 다 비면 타이머를 멈춘다
	@ExecSpace("ServerOnly")
	method void SpawnTick()
		local spawned = false
		for zone, list in pairs(self.Queue) do
			local pos = self.QueuePos[zone] or 1
			if pos <= #list and _RtsRunResultLogic:IsZoneAlive(zone) then
				self.QueuePos[zone] = pos + 1
				self:SpawnMob(zone, list[pos])
				spawned = true
			end
		end
		if not spawned then self:StopSpawn() end
	end

	@ExecSpace("ServerOnly")
	method void StopSpawn()
		if self.Spawning then _TimerService:ClearTimer(self.SpawnTimer) end
		self.Spawning = false
		self.SpawnTimer = 0
		self.Queue = {}
		self.QueuePos = {}
	end

	@ExecSpace("ServerOnly")
	method void SpawnMob(number zone, string mobId)
		local s = _RtsStageTableLogic:GetStage(self.SpawnStage)
		if s == nil then return end
		self.Serial = self.Serial + 1
		local name = "Mob" .. self:ZoneKey(zone) .. "_" .. string.format("%d", self.Serial)
		-- 난이도 체력 배율(2026-09-24 — RtsDifficultyLogic: 그 구역 주인의 난이도 × 극악 곡선)
		local hp = math.max(1, math.floor(s.hp * _RtsDifficultyLogic:HpMul(zone, self.SpawnStage) + 0.5))
		local e = self:SpawnMonsterEntity(name, zone, mobId, hp, false)
		if e == nil then return end
		if e.RtsMonsterComponent ~= nil then
			e.RtsMonsterComponent.Meso = _RtsStageTableLogic:GetMobMeso(self.SpawnStage)
			e.RtsMonsterComponent.StageNo = self.SpawnStage
			-- 일반 몬스터 방어율(표 def — 자쿰 뒤 10, 핑크빈 뒤 20, 아케인리버 30. 2026-09-23 사용자)
			e.RtsMonsterComponent.Defense = s.def or 0
		end
		local z = math.floor(zone + 0.5)
		if self.Mobs[z] == nil then self.Mobs[z] = {} end
		self.Mobs[z][name] = e
		local field = self:GetField(z) + 1
		self.FieldByZone[self:ZoneKey(z)] = field
		if field >= self.FieldLimit then
			_RtsRunResultLogic:Eliminate(_RtsRunResultLogic:OwnerOfZone(z), "field", 0)
		end
	end

	-- 일반 몹이 죽었을 때(RtsMonsterComponent.Die) — 목록에서 빼고 필드 −1
	@ExecSpace("ServerOnly")
	method void OnMobGone(number zone, string name)
		local z = math.floor(zone + 0.5)
		local list = self.Mobs[z]
		if list == nil or list[name] == nil then return end
		list[name] = nil
		local field = self:GetField(z) - 1
		if field < 0 then field = 0 end
		self.FieldByZone[self:ZoneKey(z)] = field
	end

	-- ===== 서버: 보관(보스 스테이지) =====

	@ExecSpace("ServerOnly")
	method void StashAll()
		for zone, list in pairs(self.Mobs) do
			for name, e in pairs(list) do
				if e ~= nil and isvalid(e) then self:SetStashed(e, true) end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void UnstashAll()
		for zone, list in pairs(self.Mobs) do
			for name, e in pairs(list) do
				if e ~= nil and isvalid(e) then self:SetStashed(e, false) end
			end
		end
	end

	-- 보관 = 대상 제외(Stashed) + 걷기 정지(Paused) + 엔티티 비활성(그림·체력바 숨김, 동기화)
	@ExecSpace("ServerOnly")
	method void SetStashed(Entity e, boolean on)
		local m = e.RtsMonsterComponent
		if m ~= nil then m.Stashed = on end
		local w = e.RtsTrackWalkerComponent
		if w ~= nil then w.Paused = on end
		e:SetEnable(not on)
	end

	-- ===== 서버: 정리 =====

	-- 구역 몹 전부 제거(탈락·퇴장) + 그 구역 스폰 줄 비우기
	@ExecSpace("ServerOnly")
	method void ClearZone(number zone)
		if zone < 1 then return end
		local z = math.floor(zone + 0.5)
		local list = self.Mobs[z]
		if list ~= nil then
			for name, e in pairs(list) do
				if e ~= nil and isvalid(e) then e:Destroy() end
			end
		end
		self.Mobs[z] = {}
		self.Queue[z] = nil
		self.QueuePos[z] = nil
		self.FieldByZone[self:ZoneKey(z)] = 0
	end

	@ExecSpace("ServerOnly")
	method void ClearAll()
		for n = 1, _RtsZoneLogic:GetZoneCount() do self:ClearZone(n) end
		-- 죽는 연출 중인 시체까지(이름 "Mob…")
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		if mapRoot == nil then return end
		local comps = mapRoot:GetChildComponentsByTypeName("RtsMonsterComponent", false)
		for i = 1, #comps do
			local m = comps[i]
			if m ~= nil and m.Entity ~= nil and isvalid(m.Entity) then m.Entity:Destroy() end
		end
	end

end
