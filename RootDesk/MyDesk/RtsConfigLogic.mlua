@Logic
script RtsConfigLogic extends Logic

	-- 구역: 2열×4행. 구역 = 카메라 뷰 한 장(화면 v2 — HUD가 하단을 가리지 않아 뷰 전체를 쓴다)
	-- 실측(2026-08-18): 최대 줌아웃 뷰 = 42.66×24.00 (엔진 줌 하한 30%)
	-- 구역 배치는 여백 포함 피치 48×32 → 맵 96×128 (바닥 타일 8유닛 단위 유지)
	property number ZoneCols = 2

	property number ZoneRows = 4

	property number ZoneWidth = 42.66

	property number ZoneHeight = 24

	-- 구역 사이 여백. 앵커가 구역 정중앙이라 여백이 0보다 크면 이웃 구역은 화면에 안 들어온다.
	property number ZoneGapX = 5.34

	property number ZoneGapY = 8

	property number CellSize = 1

	-- 이동 속도 수치: 속도 100 = 초당 3.5유닛(2026-09-14 사용자 확정 — 달팽이 시연 속도를 100으로). 실제 속도 = 수치/100 × 이 값
	--   칸 1개 ≈ 0.5초, 트랙 한 바퀴(117.3유닛) ≈ 33.5초
	property number SpeedUnitPerSec = 3.5

	-- 바닥 타일 한 칸(유닛). 공식 헤네시스 RectTile은 4가 선명(8은 흐림 — 2026-09-14 실측). 맵 크기(96×128)는 4·8 모두 나누어떨어짐
	property number FloorTileUnit = 4

	-- 카메라: 최대 줌아웃, 앵커 = 구역 정중앙(오프셋 없음)
	property number CameraZoomPercent = 30

	property number CameraOffsetY = 0

	property number CameraViewWidth = 42.66

	property number CameraViewHeight = 24

	-- 그리드 트랙 (아티팩트 v16). 1유닛 = 45px(1920/42.66) → 칸 80px = 16/9 유닛
	--   2026-09-20 사용자: 18×12 → **16×13**(우측 2열 삭제로 좌우 대칭, 아래 1행 추가). 그리드 폭 28.44 = 뷰 42.66 − 여백 7.11×2 → GridLeft = −14.22.
	--   높이 23.11 = 뷰 24 − 위아래 0.44씩 → GridTop = 11.56("위에 남는 공간 활용해 위로 살짝 당김"). 텍스처 1280×1040은 tools/gen-track-grid.js
	--   그리드 좌상단 = 구역 중앙 + (GridLeft, GridTop). 행(row)은 위에서 아래로 센다
	property number GridCols = 16

	property number GridRows = 13

	property number GridCell = 1.7777778

	property number GridLeft = -14.2222222

	property number GridTop = 11.5555556

	-- 그리드 텍스처 1280×1040(PPU 100 = 12.8×10.4유닛) → 28.44유닛 폭(16칸)에 맞추는 스케일(칸 80px → 1.7778유닛이면 항상 2.2222)
	property number GridTextureScale = 2.2222222

	method number GetZoneCols()
		return self.ZoneCols
	end

	method number GetZoneRows()
		return self.ZoneRows
	end

	method number GetZoneWidth()
		return self.ZoneWidth
	end

	method number GetZoneHeight()
		return self.ZoneHeight
	end

	-- 구역 배치 간격(구역 크기 + 여백). 구역 중앙 좌표와 맵 크기의 기준
	method number GetZonePitchX()
		return self.ZoneWidth + self.ZoneGapX
	end

	method number GetZonePitchY()
		return self.ZoneHeight + self.ZoneGapY
	end

	method number GetMapCellsX()
		return self.ZoneCols * self:GetZonePitchX()
	end

	method number GetMapCellsY()
		return self.ZoneRows * self:GetZonePitchY()
	end

	method number GetCameraViewWidth()
		return self.CameraViewWidth
	end

	method number GetCameraViewHeight()
		return self.CameraViewHeight
	end

	method number GetCameraZoomPercent()
		return self.CameraZoomPercent
	end

	method number GetCameraOffsetY()
		return self.CameraOffsetY
	end

	-- 속도 수치(100 기준) → 유닛/초
	method number SpeedToUnitsPerSec(number speed)
		return speed / 100 * self.SpeedUnitPerSec
	end

	method number GetFloorTileUnit()
		return self.FloorTileUnit
	end

	method number GetGridCols()
		return self.GridCols
	end

	method number GetGridRows()
		return self.GridRows
	end

	method number GetGridCell()
		return self.GridCell
	end

	method number GetGridLeft()
		return self.GridLeft
	end

	method number GetGridTop()
		return self.GridTop
	end

	method number GetGridTextureScale()
		return self.GridTextureScale
	end

	-- 구역 n(1~8, 위에서부터 행 우선: 1·2 / 3·4 / 5·6 / 7·8) → 구역 중앙 월드 좌표
	method Vector2 GetZoneCenter(number n)
		local idx = n - 1
		local col = idx % self.ZoneCols
		local row = math.floor(idx / self.ZoneCols)
		local pitchX = self:GetZonePitchX()
		local pitchY = self:GetZonePitchY()
		local cx = col * pitchX + pitchX * 0.5
		local cy = (self.ZoneRows - 1 - row) * pitchY + pitchY * 0.5
		return Vector2(cx, cy)
	end

	method Vector2 GetMapLeftBottom()
		return Vector2(0, 0)
	end

	method Vector2 GetMapRightTop()
		return Vector2(self:GetMapCellsX(), self:GetMapCellsY())
	end

end
