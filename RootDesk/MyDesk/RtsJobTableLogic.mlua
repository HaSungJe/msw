				-- 쿼드러플 스로우 연출(2026-09-20): 원작 4121013 — 시전 클립 effect(던지는 손 궤적 흰·붉은 호, 9프레임, 왼쪽 보기 그림) + 표창 투사체(뇌전수리검 02070011 bullet — 주황 별 + 번개, 사용자 지정) 4발 0.1초 간격. 사거리 2(사용자 2026-09-20, 3에서)
				--   + 타격 hit/0(흰 빛 터짐 + 파편) ×4(0.1초 간격), 시전음 use, 타격음 hit. 쉐도우 파트너(30)는 등 뒤(projShadowDx)에서 같은 표창 4발을 0.5초 늦게(본체 4발이 다 나간 뒤 이어서 — 2026-09-22 사용자, 그림자 동작도 0.5초 늦게 RtsSkillFxLogic.ShadowActionDelay) 어둡게 던지고 타격 4회 ½(st.halfHits)
				--   모션 = swingO1 + 무기 가림(2026-09-20 사용자 확정 — shootF는 활 쏘는 자세라 표창과 안 맞음. 표창 던지기 전용 액션은 없음). 표창 출발 = 배 앞(projDx 0.35·projDy 0.55 — "머리 뒤에서 나온다")
				--   쉐도우 파트너 그림자 = 유닛 자식 "Shadow" 스프라이트(원작 4111002/special 검은 실루엣, RtsUnitLogic.EnsureShadow, 30레벨~) — 등 뒤 0.44, 본체 액션과 같은 이름의 클립을 따라 재생
				{ lv = 1, kind = "액티브", name = "쿼드러플 스로우", desc = "사거리 2 안의 적 1마리를 110%의 데미지로 4회 공격한다.", target = false, range = 2,
					fx = { motion = "swingO1", hideWeapon = true, hideWeaponSec = 0.6, clip = "ff9ced53e871474c9a2ae167e0c75ef1", scale = 1.4, feetDx = 0, feetDy = 0, assetFacesLeft = true, sound = "747c5e5435b942a494f94032dabbffb2",
						proj = "99a112c1dcbb4cf69fccfca53fbb6620", projCount = 4, projStagger = 0.1, projSec = 0.2, projDx = 0.35, projDy = 0.55, projScale = 1.2,
						projShadowLv = 30, projShadowDx = 0.5, projShadowDelay = 0.5,
						hitDelay = 0.3, hitGap = 0.1, hitClip = "6d26a151289342db913d50bf9f84a96b", hitScale = 1.4, hitDy = 0.6, hitSound = "4709f06b2fb543f7a980fdbbb23441b1" } },
				{ lv = 10, kind = "패시브", name = "자벨린 마스터리", desc = "최종 데미지가 10% 증가한다.", target = false },
				{ lv = 20, kind = "패시브", name = "크리티컬 마스터리", desc = "크리티컬 확률이 30%, 크리티컬 데미지가 25% 증가한다.", target = false },
				{ lv = 30, kind = "패시브", name = "쉐도우 파트너", desc = "그림자 분신을 소환한다. 분신은 쿼드러플 스로우를 따라 표창 4개를 추가로 던지며, 분신의 표창은 절반의 데미지를 준다.", target = false },
				{ lv = 40, kind = "패시브", name = "자벨린 마스터리", desc = "최종 데미지가 10%, 공격력이 100 증가한다.", target = false },
				{ lv = 50, kind = "패시브", name = "레디 투 다이", desc = "최종 데미지가 20% 증가한다.", target = false },
			}
		end
		if jobId == "shad" then
			return {
				-- 새비지 블로우 연출(2026-09-20): 시전 클립 = 신형 4201012/effect(사용자 지정 — 붉은 참격 선, 4201005 폴더엔 타격음뿐) + 빠른 한손 베기 모션(swingO2) + 타격마다 4221007(부메랑 스텝)/hit/0 분홍 참격 폭발 ×8(0.05초 간격) + 타격마다 새비지 타격음(사용자 2026-09-20 "8번 파파박")
				{ lv = 1, kind = "액티브", name = "새비지 블로우", desc = "사거리 1 안의 적 1마리를 29.2%의 데미지로 8회 공격한다.", target = false, range = 1,
					fx = { motion = "swingO2", clip = "895ac1e384ea42ca8dd084f54ff3346b", scale = 1.6, feetDx = 0, feetDy = 0, assetFacesLeft = true,
						hitDelay = 0.1, hitGap = 0.05, hitClip = "6614245a414645089d41ec1f60df1fab", hitScale = 1.3, hitDy = 0.6, hitSound = "23250468023a4767b32611f2fd8ec49b" } },
				{ lv = 10, kind = "패시브", name = "대거 마스터리", desc = "공격력이 30% 증가한다.", target = false },
				{ lv = 20, kind = "패시브", name = "크리티컬 마스터리", desc = "크리티컬 확률이 30%, 크리티컬 데미지가 20% 증가한다.", target = false },
				-- 메소 익스플로전 연출 1차: 원작 4211006 — 시전 클립 effect(발 아래 보라 소용돌이) + 타격 hit/0(흰 폭발 + 연두 불꽃) + 타격음 hit. 사거리 1·10마리(메인 대상 곁 1칸 규칙)
