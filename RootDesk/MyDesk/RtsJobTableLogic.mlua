-- Phase 2 #6 (부분, 2026-09-15): 직업 정의 단일 소스 — .info/character.md의 히어로·팔라딘·다크나이트 그대로.
--   비용 곡선은 .info/level.md, DPS 계산은 .info/balance-detail.md 규칙(방어율 제외)과 동일. 목업(hud-layout.html v27)의 JOBS/COST와 1:1.
--   궁수 이하 나머지 직업은 정의가 생기면 여기에 추가한다(외형 세트가 없는 직업은 스폰하지 않는다).
@Logic
script RtsJobTableLogic extends Logic

	property number MaxLevel = 50

	-- 크리티컬 기본값: 확률 0%, 크리티컬 데미지 20%(원작 메이플 기본). 스킬·증강의 크리 확률/데미지는 각각 합연산
	property number BaseCritRate = 0

	property number BaseCritDamage = 20

	-- 레벨 L→L+1 비용(level.md 블록). 인덱스 = 도달 레벨(2~50)
	property table Costs = {}

	method void EnsureCosts()
		if #self.Costs > 0 then return end
		local c = { 0 }
		local blocks = { { 100, 8, 200 }, { 250, 9, 750 }, { 600, 9, 1600 }, { 1700, 9, 7700 }, { 6000, 9, 40000 } }
		for b = 1, #blocks do
			for i = 1, blocks[b][2] do c[#c + 1] = blocks[b][1] end
			c[#c + 1] = blocks[b][3]
		end
		self.Costs = c
	end

	-- 다음 레벨(nextLevel)에 도달하는 비용. 범위 밖은 0
	method number GetLevelCost(number nextLevel)
		self:EnsureCosts()
		local v = self.Costs[nextLevel]
		if v == nil then return 0 end
		return v
	end

	-- 1레벨부터 level까지 누적 투자
	method number GetCumCost(number level)
		self:EnsureCosts()
		local t = 0
		for i = 2, level do t = t + self:GetLevelCost(i) end
		return t
	end

	-- 10·20·30·40·50 = 벽(구간 마지막 칸이 비싸다)
	method boolean IsWallLevel(number level)
		return level % 10 == 0
	end

	method number GetMaxLevel()
		return self.MaxLevel
	end

	-- 능력치표의 공격 주기(초): period가 있으면 공격속도와 무관하게 그 값(폭풍의 시 0.2초), 없으면 공격속도 이름으로
	method number GetPeriod(table st)
		if st.period ~= nil then return st.period end
		return self:GetSpeedSec(st.speed)
	end

	-- 공격속도 이름 → 주기(초)
	method number GetSpeedSec(string speed)
		if speed == "매우느림" then return 1.5 end
		if speed == "느림" then return 1.25 end
		if speed == "빠름" then return 0.75 end
		if speed == "매우빠름" then return 0.5 end
		return 1.0
	end

	-- 직업 id(character.md 순): hero 히어로 / paladin 팔라딘 / dk 다크나이트 / bow 보우마스터 / marks 신궁 / il 아크메이지(썬·콜) / fp 아크메이지(불·독)
	--   / bishop 비숍 / nl 나이트로드 / shad 섀도어 / phantom 팬텀(히든, 프리즘 '팬텀 영입')
	method table GetJobIds()
		return { "hero", "paladin", "dk", "bow", "marks", "il", "fp", "bishop", "nl", "shad", "phantom" }
	end

	method boolean HasJob(string jobId)
		return self:GetJobName(jobId) ~= jobId
	end

	method string GetJobName(string jobId)
		if jobId == "hero" then return "히어로" end
		if jobId == "paladin" then return "팔라딘" end
		if jobId == "dk" then return "다크나이트" end
		if jobId == "bow" then return "보우마스터" end
		if jobId == "marks" then return "신궁" end
		if jobId == "il" then return "아크메이지(썬·콜)" end
		if jobId == "fp" then return "아크메이지(불·독)" end
		if jobId == "bishop" then return "비숍" end
		if jobId == "nl" then return "나이트로드" end
		if jobId == "shad" then return "섀도어" end
		if jobId == "phantom" then return "팬텀" end
		return jobId
	end

	method string GetJobGroup(string jobId)
		local s = self:GetSeries(jobId)
		if jobId == "phantom" then return "영웅 · 도적" end -- 2026-09-20 사용자: 팬텀은 모험가가 아니라 영웅 직업군
		if s == "arc" then return "모험가 · 궁수" end
		if s == "mag" then return "모험가 · 마법사" end
		if s == "thf" then return "모험가 · 도적" end
		return "모험가 · 전사"
	end

	-- 계열 키(HUD 슬롯 색): war/arc/mag/thf
	method string GetSeries(string jobId)
		if jobId == "bow" or jobId == "marks" then return "arc" end
		if jobId == "il" or jobId == "fp" or jobId == "bishop" then return "mag" end
		if jobId == "nl" or jobId == "shad" or jobId == "phantom" then return "thf" end
		return "war"
	end

	-- 1레벨 공격력 / 레벨업당 공격력 / 공격속도 이름 (character.md 능력치)
	method number GetBaseAttack(string jobId)
		if jobId == "paladin" then return 80 end
		if jobId == "hero" then return 40 end
		if jobId == "bow" then return 30 end
		if jobId == "fp" or jobId == "bishop" or jobId == "nl" then return 20 end
		if jobId == "phantom" then return 100 end
		return 50
	end

	method number GetAttackPerLevel(string jobId)
		if jobId == "hero" then return 12 end
		if jobId == "marks" then return 15 end
		if jobId == "il" then return 3 end
		if jobId == "fp" or jobId == "bishop" or jobId == "nl" then return 5 end
		if jobId == "phantom" then return 0 end
		return 10
	end

	method string GetBaseSpeed(string jobId)
		if jobId == "paladin" or jobId == "dk" or jobId == "marks" then return "느림" end
		if jobId == "bow" or jobId == "phantom" then return "매우빠름" end
		if jobId == "nl" or jobId == "shad" then return "빠름" end
		return "보통"
	end

	-- 무기 종류(.info/weapon.md, 2026-09-19): 직업마다 무기가 정해져 있고, 타격마다 최종 데미지에 무기별 최소~최대 비율을 균등 난수로 곱한다(방어율 계산 전). 케인(팬텀) 0.85~1.2(사용자 2026-09-19)
	method string GetWeaponType(string jobId)
		if jobId == "hero" then return "두손검" end
		if jobId == "paladin" then return "양손둔기" end
		if jobId == "dk" then return "창" end
		if jobId == "bow" then return "활" end
		if jobId == "marks" then return "석궁" end
		if jobId == "il" or jobId == "fp" then return "스태프" end
		if jobId == "bishop" then return "완드" end
		if jobId == "nl" then return "아대" end
		if jobId == "shad" then return "단검" end
		if jobId == "phantom" then return "케인" end
		return ""
	end

	-- 무기별 데미지 비율 {최소, 최대}
	method table GetWeaponRange(string weapon)
		if weapon == "두손검" then return { 0.8, 1.2 } end
		if weapon == "양손둔기" then return { 0.75, 1.25 } end
		if weapon == "창" then return { 0.7, 1.5 } end
		if weapon == "스태프" then return { 0.9, 1.1 } end
		if weapon == "완드" then return { 0.85, 1.05 } end
		if weapon == "아대" then return { 0.8, 1.3 } end
		if weapon == "단검" then return { 0.7, 1.2 } end
		if weapon == "활" then return { 0.75, 1.3 } end
		if weapon == "석궁" then return { 0.6, 1.35 } end
		if weapon == "케인" then return { 0.85, 1.2 } end
		return { 1.0, 1.0 }
	end

	-- 타격 1회의 무기 배율 굴림(균등 난수). 기대값 = (최소+최대)/2 — 표(balance-detail.md)는 이 기대값을 곱해 둔다
	method number RollWeapon(string jobId)
		local r = self:GetWeaponRange(self:GetWeaponType(jobId))
		return r[1] + (r[2] - r[1]) * _UtilLogic:RandomDouble()
	end

	method number WeaponMean(string jobId)
		local r = self:GetWeaponRange(self:GetWeaponType(jobId))
		return (r[1] + r[2]) / 2
	end

	-- 기본 외형 = 공식 "모험가 ○○" 세트(아바타 아이템 RUID). 없는 직업은 nil
	--   슬롯: longcoat / weapon2h 또는 weapon1h / shoes / hair / face(얼굴, 없으면 기본) / cap(모자) / faceAcc(얼굴 장식). 세트의 캐시 무기는 잔상이 두손검(swordTS/swordOL)이라
	--   무기 = 각 세트의 전용 무기(사용자 2026-09-17 최종 — 캐시 무기라 공격 모션에 두손검 계열 잔상(swordTS/swordOL)이 나오지만 의상과 색이 맞는 쪽을 택함).
	--   마법사·섀도어·나이트로드는 **한손 판**(stand1, 한손으로 드는 모션), 활·석궁·전사 무기는 두손 판. 팬텀은 세트가 없어 팬텀 오리지날티(케인).
	--   대안(잔상이 정상인 진짜 무기): 리버스 니플하임 5d0abb01… / 리버스 벨로체 6083bc6e… / 타임리스 알슈피스 164067c8… / 타임리스 엔가우 9e8fe977… / 리버스 블랙뷰티 676ca51a…
	--   / 타임리스 엔릴 티어 9886e145… / 타임리스 람피온 11f2459e… / 타임리스 킬릭 f92581fa… / 타임리스 페르소나 b5150885…
	--   성별(사용자 2026-09-17): 전사 3·나로·팬텀 = 남(롱코트 01050xxx/01054xxx, 헤어 65xxx, 기본 얼굴) / 보마·신궁·썬콜·불독·비숍·섀도어 = 여(롱코트 01051xxx, 부츠 01071xxx, 헤어 67xxx, 얼굴 = 청아한 얼굴 21259)
	method table GetCostume(string jobId)
		if jobId == "hero" then
			return { longcoat = "c92ab70d7a064aafaa34298c2e9890e3", weapon2h = "c4f9b9c993754161816092e680584ce3",
				shoes = "186a55d192d24b4da5201801422bebf7", hair = "931c0ed47c3e4df69734fe19247a7b33" }
		end
		if jobId == "paladin" then
			return { longcoat = "3db1f00384854ab6aa9e6148efa942d9", weapon2h = "ba9a04c1dc1f42049f0ec88e95052c76",
				shoes = "790ae27c0b30414eb369bda472df4799", hair = "9188a9716ae947b5a1e518bd0d1c0252" }
		end
		if jobId == "dk" then
			-- 창 = 타임리스 알슈피스(진짜 창, afterImage spear — 2026-09-18 사용자 "다크나이트만 리버스로": 세트 캐시 창 acd581b7…의 빨간 두손검 참격이 스피어 버스터와 겹쳐서. 리버스 창(로렌티우스)은 라이브러리에 없어 자매 세트 타임리스로. 대안 레볼루션 스피어 44d92464…)
			return { longcoat = "a529865cf7be417c97b7855eed344004", weapon2h = "164067c82a8347d681cf49a8be3db5df",
				shoes = "f6f89e92db4f498e9b5fb6ec7ee81dda", hair = "e8d9dda3dfd34b68b62426838e951723" }
		end
		if jobId == "bow" then
			-- 모험가 보우마스터 세트(여): 슈트(여 01051806) · 부츠 · 검은색 헤어(67060) · 깃털 모자 + 활 = 타임리스 엔가우(진짜 활, afterImage bow — 2026-09-18 사용자: 세트 캐시 활 37ad1f37…의 파란 폭발 잔상이 초당 5발 폭풍의 시와 겹쳐서 교체)
			return { longcoat = "485c62e590af4b0b943a202ec9890252", weapon2h = "9e8fe977ff9540d180f3f08dc420d087",
				shoes = "44f0f373baed42cc91d160b20d01fe7b", hair = "c97a920273e243a28a81772834cbba05", face = "9edd3b016f6b4afaa7973c7259d46c69", cap = "74aa2fe40c304ec7b91f5bf2ce1cc128" }
		end
		if jobId == "marks" then
			-- 모험가 신궁 세트(여): 슈트(여 01051810) · 부츠 · 검은색 헤어(67070) · 모자 + 세트 석궁(두손 판)
			return { longcoat = "05a8f762ba03471dbbded534436646c3", weapon2h = "2ae7ec2367cc45ecb6b49ec12ac4d05b",
				shoes = "d79e6681a08c467fa69b37ab0e9023be", hair = "d944c2c9ac264e8ca0272f35e9f13fb6", face = "9edd3b016f6b4afaa7973c7259d46c69", cap = "9defd0fd49cd45629d1c8beefc10ebd9" }
		end
		if jobId == "il" then
			-- 모험가 썬콜 세트(여): 로브(여 01051805) · 부츠(여 01071193) · 검은색 헤어(67050) · 머리띠 + 세트 스태프(한손 판)
			return { longcoat = "8a6b5acc6a02447cb25ce366945d09e7", weapon1h = "3dcc26b9213d4b1193377a5c676bffdb",
				shoes = "1a2b66f0496f4926bd9d6d7d1f77ccb4", hair = "9110ec2d96ba489cb958cad1132c0ab6", face = "9edd3b016f6b4afaa7973c7259d46c69", cap = "39f032dee08e47dc84fd6ab0019b12f9" }
		end
		if jobId == "fp" then
			-- 모험가 불독 세트(여): 로브(여 01051803) · 부츠(여 01071191) · 검은색 헤어(67030), 모자 없음 + 세트 완드(한손 판)
			return { longcoat = "c449931dbadc42d08b9386faf5c0fc62", weapon1h = "37d1f2f65ace4ff583e388243b756682",
				shoes = "baeca0b68837465bbf1dead9755313c8", hair = "47575a7d509d4f6fa8878f20c372ebef", face = "9edd3b016f6b4afaa7973c7259d46c69" }
		end
		if jobId == "bishop" then
			-- 모험가 비숍 세트(여): 로브(여 01051804) · 부츠(여 01071192) · 검은색 헤어(67040) · 모자 + 세트 완드(한손 판)
			return { longcoat = "f6ded93c726f4974972392fdeecce574", weapon1h = "ffa0f813b710492088cbd93b3d4a7db6",
				shoes = "2fecfe3a5d944e43825ca6ef73d816ab", hair = "2ae23cf95ae0413085f2534258771533", face = "9edd3b016f6b4afaa7973c7259d46c69", cap = "2d2c164b8cda45aaa0ca59cdff242e59" }
		end
		if jobId == "nl" then
			-- 모험가 나이트로드 세트: 슈트(01054091) · 부츠 · 검은색 헤어(65080) · 헤어밴드(01001160) + 세트 표창(한손 판)
			return { longcoat = "b2f43a0a2ce344d6a3eb7e5c5f288415", weapon1h = "37cdd4cecceb4315864f1e014711a8cc",
				shoes = "4539394af12f41afa9f1a6e4736717a6", hair = "2c0ae06e45744e7fa4a8e986f8249b14", cap = "ed9795ce9c2348d58423f49b9e65eabf" }
		end
		if jobId == "shad" then
			-- 모험가 섀도어 세트(여): 슈트(01054093) · 부츠 · 검은색 헤어(67100) · 마스크(얼굴 장식) + 세트 단검(한손 판)
			return { longcoat = "57b8678927dd4f139ce0f333683379ea", weapon1h = "bbbede914dc44d2eb7cd2568c0156255",
				shoes = "5da19bc56d624e5c9edd267f324e9c6d", hair = "cdb752c2a72c4e4799d0abca54f02944", face = "9edd3b016f6b4afaa7973c7259d46c69", faceAcc = "ddaed699a27c40c4a9be7b2339ca9a9d" }
		end
		if jobId == "phantom" then
			-- 팬텀(히든, 원작 NPC 1540482 기준 — 금발 남성): 미스틱 팬텀 슈트 · 할로윈 팬텀 부츠 · 노란색 괴도 팬텀 헤어(40323) · 괴도 팬텀 얼굴 · Vampire Phantom Hat(팬텀 모자 실루엣 — 원작 흰 모자는 라이브러리에 없고 '팬텀 히어로즈 페더'는 깃털만) + 팬텀 오리지날티(팬텀 전용 케인, 1H)
			--   (2026-09-17 사용자: 검은색 팬텀 뱅 헤어는 여자처럼 보임 → 원작 헤어·얼굴로)
			return { longcoat = "d47ad12df0af43d9a901b44edbe8e1a4", weapon1h = "19c6b905f16141deb53f6ffe760045cc",
				shoes = "8e39e34a94c74154be9d666693c4cc0f", hair = "e0c743eebb2b4856ab3b2682af8159ab", face = "92fc1e7650ad402da7a2a7bebcdd6c51", cap = "cf9ef0959fa143229d4bdcfd6e760246" }
		end
		return nil
	end

	-- 스킨 2종: 1 기본 세트 / 2 월드 아바타(내 메이플월드 코디 — 월드코인 결제로 30일 해금). 인덱스는 0-기반 값 Skin(0/1)+1
	method table GetSkinNames(string jobId)
		if jobId == "phantom" then return { "영웅 팬텀", "월드 아바타" } end
		return { "모험가 " .. self:GetJobName(jobId), "월드 아바타" }
	end

	-- 스킬 목록(획득 레벨 순). kind = 액티브/패시브, target = 대상 지정 스킬
	--   fx(있으면) = 연출 정의: motion 아바타 액션 / frames 플립북 스프라이트 RUID(frameSec 간격, SpriteRUID 교체 재생) / scale 월드 스케일
	--   / feetDx·feetDy 캔버스 중심→발 오프셋(×scale, 유닛 발에 맞춤) / sound 시전음 / hitSound 타격음. 전투(Phase 3)가 이걸 읽어 재생한다
	--   motion 하나 또는 motions = {…} + motionGap(초)로 아바타 액션을 이어 재생, motionRate = 액션 재생 속도(1 원속, 0.56 = 0.44초 swing이 0.78초), motionLoop = 공격하는 동안 그 액션을 루프로 유지(폭풍의 시; motionFrame·motionFrameEnd = 그 프레임 구간만), motionCycle = motions를 motionGap 간격으로 공격이 이어지는 동안 차례로 반복(조커) / loopClip·loopScale·loopDx·loopDy·loopAlpha·loopOrder = 공격 중 유닛 위에 계속 도는 클립(시전이 0.6초 끊기면 정리, 유지 자세도 함께; loopOrder 190 = 아바타 뒤 — 조커) / loopIntro·loopIntroScale·loopIntroDy·loopIntroLife·loopIntroSound = 루프가 처음 생길 때 같은 자리에 1회 클립·소리(그동안 루프는 투명 — 애로우 레인 활 소환) / loopFrameA·loopFrameB = 루프 클립의 프레임 구간(0부터)만 반복 / loopSound·loopSoundVol = 루프 동안 반복 소리(끝나면 StopSound), loopEnd·loopEndLife·loopEndSound = 루프가 끊길 때 같은 자리 1회 클립·소리(디바인 퍼니시먼트), loopAt "target" = 루프(인트로·엔드 포함)를 유닛이 아니라 메인 대상 몬스터의 자식으로(피격 박스 중앙 + loopDy, loopAtTop이면 박스 윗변 기준, 대상 바뀌면 재생성) / 요소별 방향: clipFacesLeft·framesFacesLeft·bodyFacesLeft·loopFacesLeft·projFacesLeft가 있으면 assetFacesLeft보다 우선 / proj·projSec·projDy·projScale = 유닛에서 대상까지 날아가는 투사체 클립(비행 방향으로 회전, projNoRotate로 끔; projs = {…}면 발마다 차례로(라운드 로빈) 1개 — 조커 카드 4종) / markClip·markLife·markLoop = 시전 순간 대상 위 표식 클립(스나이핑 조준; 위치 = 피격 박스 중앙, 크기 = markFit × 박스 긴 쪽 — 없으면 markScale·markDy; markClips = {…} 무작위 1개, markAt = "feet"면 발 위치 + markDx·markDy, markDelay 초 뒤 + 대상마다 markStagger 초씩 늦게(서버 hitStagger와 짝), markPattern "alternate" = 같은 대상 반복 표식을 좌·우 번갈아 markAltDists 거리로(블리자드 템페스트), markScaleX = 가로만 추가 배율; marks = { {clip, clips, delay, life, scale, at, dx, dy, fit, pivotDy, loop, stagger, pattern, scaleX} … } = 표식 여러 벌(블레이드 토네이도 → 카르마 퓨리)) / sound2·sound2Delay·sound2Vol·sound2Pitch = 두 번째 시전음 / beam·beamDelay·beamScale·beamSeg·beamDx·beamDy·beamLife = 유닛 손→대상까지 클립 조각을 이어 붙인 빔(체인 라이트닝) / projCount·projStagger·projFrom("around" 유닛 주변 / "sky" 대상 머리 위 projSkyHeight에서 ±projSkySpread 흩어져 수직 낙하 — 애로우 레인)·projSpread(안쪽 고리 반지름)·projGap(구체 간격 = 고리 간격)·projLife = 구체 여러 개(도트 퍼니셔, 동심원 고리 채우기 OrbSpawnOffset), projHover = 생성 뒤 떠 있는 초, projSpeed = 유닛/초(있으면 비행 시간 = 거리÷속도, 판정도 그 시각), projFlySprites·projHitSprites·projFrameSec = 비행 중 돌릴 프레임 sprite 목록 / 닿은 뒤 한 번 돌릴 폭발 프레임 목록(클립 프레임 범위 지정은 안 먹음), projSpin = 자전 도/초, projArc = 포물선 높이(유닛; 비행 방향에 수직·항상 위로 4t(1−t) 튀어오름, 발마다 50~100% — projArcRandom=true면 위/아래 무작위; projArcByDist = { 1칸, 2칸, 3칸, 4칸+ } 있으면 대상까지 칸 거리로 고른 값 그대로) / zoneClips·zoneScale·zoneAlpha·zoneLife·zoneOrder = 구역 트랙 모든 칸 위 지대 클립(포이즌 리전) / backClip·backScale·backDx·backDy·backLife·backAlpha·backDelay = 캐릭터 뒤(190) 클립(블리자드 기둥; backDelay 초 뒤 — 카르마 퓨리) / 스킬 항목의 after = 후딜 초(다음 공격까지 쉼), dot = { pct, period, dur } 서버 지속 피해, freeze = 빙결 초, range = 사거리 칸(기본 공격은 st.range가 우선, 없으면 2), targets = 타겟 수(없으면 st.targets), aoe = 메인 대상(사거리 안 가장 가까운 적) 곁 몇 칸까지 나머지 대상을 잡는지(범위 공격 기본 1, 체인 라이트닝만 3 — 2026-09-19 사용자), area = 전체 광역기(제네시스·생츄어리·블리자드·드래곤 로어: 메인 대상 없이 사거리 안 적을 랜덤으로 n마리), 지대 dot·구체 spread(도트 퍼니셔)는 사거리 제한 없이 구역 전체가 후보 — RtsCombatLogic.PickTargets, spread = 타격을 대상들에 돌아가며 1회씩(도트 퍼니셔), projEach = 대상마다 투사체 1발(RtsCombatLogic) / clip(있으면) = 플립북 대신 애니메이션 클립 RUID 1회 재생(clipDelay 초 뒤), clips = { ruid 또는 {ruid, dx, dy, scale, delay, life} … } 같은 원점에 함께 띄우는 추가 클립들(스피어 버스터; life = 제거 시각 — 마지막 프레임이 긴 클립은 EndFrame 정리에 잘리므로 클립 총길이를 준다), clipHold = clip도 EndFrame 정리 대신 clipLife까지, clipOrder = 시전 클립 레이어(기본 300 앞, −10 = 아바타 뒤), motionDelay = 첫 모션 지연 초 / hideWeapon·hideWeaponSec = 스킬 동안 캐릭터 무기·무기 잔상 숨김(이펙트에 검이 들어 있는 레이징 블로우) / bodyClip·bodyScale·bodyDy·bodyLife = 아바타 위 몸 덧그림(원작 effect0, RtsSkillFxLogic.PlayBody) / assetFacesLeft = 원작(왼쪽 보기) 자산 — 유닛이 보는 방향(RtsUnitComponent.FaceDir)에 맞춰 반전, noFlip = 대칭 오라(반전 안 함) / sound·soundDelay·soundPitch = 시전음(soundDelay 초 뒤 재생, soundPitch = 재생 속도) / hitDelay 시전→첫 판정 초 / hitGap 타격 간격(타격마다 따로 판정·크리) / hitStagger 같은 타격 안에서 대상마다 늦추는 초(블리자드 템페스트 15개 낙하) / hitClip·hitScale·hitDy 몬스터 위 타격 클립(hitClips = {…}면 타격마다 무작위 1개 — 조커 3색) / hitSound·hitSoundPitch·hitSoundVol·hitSoundEvery 타격음(피치 = 재생 속도, RtsSkillFxLogic.PlaySfx; hitSoundEvery = n타마다 1번), hitPhases = { {upto, clips, scale, sound, vol} … } 타격 번호 구간별 타격 클립·타격음(sound "" = 무음; hitKinds = { 타격마다 phase 번호 } 가 있으면 구간 대신 그 번호) (RtsCombatLogic·RtsMonsterComponent)
	--   lock(액티브만, 없으면 0) = 잠금 설정 기본값: 0 사용 / 1 보스전 잠금 / 2 잠금 (드래곤 로어는 기본 보스전 잠금) / cd(초) = 쿨타임 — 있으면 준비됐을 때 기본 공격 대신 우선 사용(RtsCombatLogic)
	-- 연출 미리보기용 덮어쓰기(클라 스크립트에서 FxOverrides["hero:1"] = {...}로 넣으면 GetSkills가 그 스킬의 fx를 바꿔 준다. 확정되면 표에 옮기고 비운다)
	property table FxOverrides = {}

	-- 구체(도트 퍼니셔) i번째의 생성 오프셋(유닛 손 높이 기준, 유닛) — 서버(판정·대상 선택)와 클라(그림)가 같은 값을 쓴다.
	--   동심원 고리 채우기: 안쪽 고리 반지름 projSpread(캐릭터와의 최소 간격), 고리 하나에 둘레 ÷ projGap(구체 지름 + 여유)개씩 균등 배치, 다 차면 projGap 바깥 고리로 — 캐릭터와도 서로도 최소 구체 크기만큼 떨어진다(사용자 2026-09-18). 30개 = 2.0/3.2/4.4 고리에 10·16·4개
	method table OrbSpawnOffset(number i, number n, table fx)
		local gap = fx.projGap or 1.2
		local r = fx.projSpread or 2.0
		local idx = i - 1
		local ring = 0
		while ring < 20 do
			local cap = math.max(1, math.floor(2 * math.pi * r / gap))
			if idx < cap then
				-- 고리마다 반 칸씩 엇갈려 방사형 줄이 생기지 않게
				local a = 2 * math.pi * idx / cap + (math.pi / cap) * (0.5 + (ring % 2) * 0.5)
				return { x = math.cos(a) * r, y = math.sin(a) * r }
			end
			idx = idx - cap
			r = r + gap
			ring = ring + 1
		end
		return { x = r, y = 0 }
	end

	method table GetSkills(string jobId)
		local list = self:GetSkillsRaw(jobId)
		for i = 1, #list do
			local o = self.FxOverrides[jobId .. ":" .. string.format("%d", i)]
			if o ~= nil then list[i].fx = o end
		end
		return list
	end

	method table GetSkillsRaw(string jobId)
		if jobId == "hero" then
			return {
				-- 레이징 블로우 연출(2026-09-18 사용자 지정: 클립 fa2bfe8f…(1121008/effect/2), 사운드 d621d7a5…(1121008/hit)).
				--   클립 14프레임 0.78초(0.06초/프레임): 0.06~0.24 캐릭터 뒤쪽 잔상(원점 왼쪽 30px, 오른쪽으로 뻗음 = 왼쪽 보기 자산의 등 뒤) → 0.24~0.54 큰 초승달 참격(230×247px, 원점이 오른쪽 끝 → 앞으로) → 0.54~0.78 수평 마무리 참격(340×60~120px).
				--   확정(2026-09-19 사용자 "지금 딱 좋아"): hideWeapon으로 캐릭터 검·무기 잔상을 숨기고(이펙트의 금색 대검이 검 역할) 몸 동작은 swingO3(뒤→앞 가로 휘두르기; T3 올려베기·T1·T2 내려베기는 "안 어울림"/"칼이 위에서 시작") 하나를 0.58배속으로 늘려(motionRate — 0.45초 → 0.78초 = 클립 길이) 클립과 동시에 시작(2026-09-19 사용자 "첫 모션만 늘려서 싱크" → "초승달(swingT3 올려베기)은 안 어울림" — 클립 궤적이 위→앞 아래 내려베기라 T1): 휘두름 정점 ≈0.39초가 초승달(0.24~0.54)과, 후속 동작이 수평 참격(0.54~0.78)과 겹침. 판정 0.4초·0.65초(hitGap 0.25) = 2회 타격. 사운드는 초승달 시작(soundDelay 0.24)에 한 번 — 원작 hit음이라 타격마다 또 울리지 않게 hitSound 없음.
				--   몬스터 위 타격 클립 7d4fd3b7…(1121008/hit/0). 원작 effect0류 몸 덧그림(bodyClip)은 맨몸 실루엣이 아바타와 겹쳐 보여 쓰지 않는다. 비교 후 안 쓴 후보: 1101011/effect 8b26a0cd…, 11101008/effect/1 5c2c13c4…, 1121008/effect dee33ecf…·use d3df4514….
				{ lv = 1, kind = "액티브", name = "레이징 블로우", desc = "사거리 1 안의 적을 최대 3마리까지 140%의 데미지로 2회 공격한다.", target = false, range = 1,
					fx = { motion = "swingO3", motionRate = 0.58, hideWeapon = true, hideWeaponSec = 0.85, clip = "fa2bfe8ff4f543fb815dd7ee5e02eac9", clipDelay = 0, scale = 2.0, feetDx = 0, feetDy = 0, assetFacesLeft = true, sound = "d621d7a5bffb427cac3f1e00db9d451b", soundDelay = 0.24,
						hitDelay = 0.4, hitGap = 0.25, hitClip = "7d4fd3b71abd42d6b37f49652d13a8d7", hitScale = 2.0, hitDy = 0.6 } },
				{ lv = 10, kind = "패시브", name = "콤보 어택", desc = "몬스터의 방어율을 5% 무시한다.", target = false },
				{ lv = 20, kind = "패시브", name = "어드벤스드 콤보 어택", desc = "몬스터의 방어율을 추가로 10% 무시한다.", target = false },
				{ lv = 40, kind = "패시브", name = "어드벤스드 콤보 어택 강화", desc = "공격력이 100% 증가한다.", target = false },
				{ lv = 40, kind = "패시브", name = "레이징 블로우 강화", desc = "레이징 블로우의 데미지가 150% 증가하고, 사거리가 2로, 공격 대상이 최대 6마리로 늘어난다.", target = false },
				{ lv = 50, kind = "패시브", name = "발할라", desc = "몬스터의 방어율을 100% 무시한다. 공격력이 30%, 보스 공격 시 데미지가 15% 증가한다.", target = false },
			}
		end
		if jobId == "paladin" then
			return {
				-- 디바인 차지 연출(2026-09-18 사용자 "지금 것 그대로, 원작 재탐색 ㄴㄴ" = character.md 값): swingTF + 시전 클립 1221004/effect/1(cb9cff6c…, 0.65초) + 시전음 1221004/use(e2989dca…)
				--   타격 0.3초 뒤 1회(200%). 타격 클립·타격음 미지정 → 몬스터 번쩍임만. 클립은 왼쪽 보기 자산(무기 빛 → 앞쪽에 문양 폭발)이라 assetFacesLeft, 스케일 1.4(2.0은 문양이 두 칸 크기)
				{ lv = 1, kind = "액티브", name = "디바인 차지", desc = "사거리 1 안의 적을 최대 4마리까지 120%의 데미지로 공격한다.", target = false, range = 1,
					fx = { motion = "swingTF", clip = "cb9cff6c57fd4cb18a05db3d47277031", scale = 1.4, feetDx = 0, feetDy = 0, assetFacesLeft = true, sound = "e2989dcac9054d689e379b9feff55f54",
						hitDelay = 0.3 } },
				{ lv = 10, kind = "패시브", name = "가드 크러쉬", desc = "사거리 4 안에 있는 적의 방어율을 10% 감소시킨다.", target = false },
				-- 생츄어리 연출(character.md 값): swingT1 + 시전 클립 1221011/effect(d577178a…, 0.9초, 첫 재생 로딩 → Preload) + 시전음 1221011/use / 타격 0.5초 뒤 1회, 맞는 몬스터 위 1221011/hit/0 + 타격음 1221011/hit. cd = 쿨타임 초(전투 루프가 준비되면 기본 공격 대신 쓴다)
				{ lv = 20, kind = "액티브", name = "생츄어리", desc = "사거리 4 안의 적을 최대 15마리까지 200%의 데미지로 공격한다. 재사용 대기시간 15초", target = false, area = true, cd = 15, ratio = 200, hits = 1, targets = 15, range = 4, after = 1.5,
					fx = { motion = "swingT1", clip = "d577178a8212489e8319a4c5b16e897b", scale = 1.2, feetDx = 0, feetDy = 0, assetFacesLeft = true, sound = "aa96c1117c634a23b56440be8de39037",
						hitDelay = 0.5, hitClip = "5df303c326dd488cbeb17028892b5238", hitScale = 1.6, hitDy = 0.6, hitSound = "2cc05078af454fa3a7856b9fb65ed61f" } },
				{ lv = 30, kind = "패시브", name = "디바인 블레싱", desc = "최종 데미지가 50% 증가한다.", target = false },
				{ lv = 40, kind = "패시브", name = "가드 크러쉬 강화", desc = "가드 크러쉬의 방어율 감소가 20%로 증가한다.", target = false },
				-- 홀리 유니티(40 패시브 +20%)는 2026-09-20 삭제 → 프리즘 스킬 "홀리 유니티"(지정 유닛 최종 +40% — 2026-09-22, 처음 +100%)로 이동. 프리즘 스킬 표는 증강 시스템(Phase 6)에서 얹는다(target = true 항목이 그때 생김)
				{ lv = 50, kind = "패시브", name = "디바인 차지 강화", desc = "디바인 차지의 데미지가 70% 증가하고, 사거리가 2로, 공격 대상이 최대 6마리, 공격 횟수가 2회로 늘어난다. 보스 공격 시 데미지가 40% 증가한다.", target = false },
			}
