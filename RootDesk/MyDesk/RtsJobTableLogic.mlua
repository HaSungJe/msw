-- Phase 2 #6 (부분, 2026-09-15): 직업 정의 단일 소스 — .info/character.md의 히어로·팔라딘·다크나이트 그대로.
--   비용 곡선은 .info/level.md, DPS 계산은 .info/balance-detail.md 규칙(방어율 제외)과 동일. 목업(hud-layout.html v27)의 JOBS/COST와 1:1.
--   궁수 이하 나머지 직업은 정의가 생기면 여기에 추가한다(외형 세트가 없는 직업은 스폰하지 않는다).
@Logic
script RtsJobTableLogic extends Logic

	property number MaxLevel = 50

	method boolean HasMageSkin(string jobId)
		-- 원화 적용 직업: 서버 스폰과 클라이언트 표시가 같은 분기를 사용한다.
		return jobId == "il" or jobId == "fp" or jobId == "bishop" or jobId == "hero"
	end

	-- 대기는 3장의 호흡 동작, 공격은 스킬마다 그린 연결 프레임을 재생한다.
	@ExecSpace("ClientOnly")
	method table GetMageSkinFrames(string jobId)
		if jobId == "il" then
			return {
				stand1 = { "fe0c6be3795d49e29a311b3edb8e89ab", "6b91e70ed2a64198a41f368191d834c8", "fe0c6be3795d49e29a311b3edb8e89ab", "0f16c5bda207468aa1fe9dcb05cb4ed6" },
				swingO1 = { "66b1f0af75c745bdaf10c9710486b867", "b2bd84ff10da4d40a6e1f0e80a90c8f6", "0c4635067dcc4aae9ed3987fc3820dcd", "263444c070344cceb0196534f9997395", "307d3b6aa3d7485d932c9fcde44642ed" },
				swingO3 = { "cfb678afe3fe423ca87a610f41f5c989", "d0415a8c09d746868c66b9d776babdf1", "08f5c40cb8fa4af28fab2f6b996fdd41", "7b877eaff02f4cc6b408f82d4a3f9e19", "3821ebdc6c2346c2b2561fec50b9900c" },
			}
		end
		if jobId == "fp" then
			return {
				stand1 = { "762ba8485e584f60a94bc71631ee7881", "43f43917582b4fe6848b525f32d69652", "762ba8485e584f60a94bc71631ee7881", "49312816d1bb4c2d87f0452e8af0f89b" },
				poisonRegion = { "3d29ef1ad55541d2a91af4400a0a22ed", "4669d925ba604b28852c02b0baa4a567", "413bb52e0b4f47cabe7600bab0a89919", "d3360cf51ebf48e1ba9d5b9f1d58425e", "b987d27c6aba4867abfd690cf7960cd8" },
				dotPunisher = { "61f1428a7d9d4bd7aa94d7f57ceb3ab2", "dfd12d4d6d1e4ab28d76cbb4e7779264", "1f61ca3ebc5e46a381af77bdadf5e3d3", "16de092651e1436cb7bffb5ec142d6c0", "2581e6d505a2401aab26d85c57cca9df" },
			}
		end
		if jobId == "bishop" then
			return {
				stand1 = { "99dcc70fd0c04167aa3c7bebdd72bb5b", "049e7e1c48364faca8efbed9ddca1afc", "99dcc70fd0c04167aa3c7bebdd72bb5b", "7b64b5c05ae444f8baab5737fdcff112" },
				swingO1 = { "074de3777cbb42839c997bd1f1f958ae", "72e53ccff7c74860b1cf984fa020720d", "a68dc71362dd47119b9477d261175de5", "9781d9083bac4ea786fd95228d147f92", "2246d2a21d1948c1b1b57d56f7776d63" },
				swingO3 = { "55f8fb5d2d4f45ab9bae87a6a79837af", "8814b38104ea4eb1bd7e4ee22e88fa0b", "97aab06bc9c64d6faa2caee8105443cd", "485d02497a384434a91be5a7396cac8c", "23f7adea4a5246f2995c3c1593b382ae" },
				divinePunishment = { "fa8ad8e0822a45368697bc884853d364", "a235e087ff374bec8f71c2453dc31bdc", "bdd116091aa447d9927b5f7ed0375fab", "e5df8c553e8b4870a0db442531e0057b", "9345eeebfda54f2690c9849661bcd988" },
			}
		end
		if jobId == "hero" then
			return {
				stand1 = { "fb4c72bd02e24790b948edfd2e78696d", "5c32a751b5864e4f802b1cbfe2f6980d", "fb4c72bd02e24790b948edfd2e78696d", "bf6a1a79ae3e47419571fb82b46a26fa" },
				swingO3 = { "a4b2f29361fd49dda2104ce70a4b4f82", "e81fe579b29846c4a93f4a5e3decd341", "2ab55adc7e964164a2675fe41720dd35", "f952fd92a3b140f1a896e60ea777278f", "a94516dd5ddb4c12b55d7877ce927eca", "a63a0e835c3e46dfb862a1727e898d56", "b8f0b7d9b63d4738ba1c40bf7f7d6ed3", "4ff13f32715d4446b32cc3cd81ac01ad" },
				enragedRagingBlow = { "921342b83ead49499ebcb1305c051f79", "2252822c3c544150b2b11d2c689df015", "0e8533552bca4a7dbdeca19be5b65e23", "bd5b06cb3c6e4dcf8708ceae77c33ff5", "fd0f61326882439783495af1c34284b6", "b60553dd8f9f48fc8a449df949625cbe", "6fd0859ce3d44c37a80d2c3c8c21dc1c" },
			}
		end
		return {}
	end

	-- 선택창·상세정보 공용 흉상.
	@ExecSpace("ClientOnly")
	method string GetMagePortraitRUID(string jobId)
		if jobId == "il" then return "f93cfcc7a46d428cb6ed2bb3d71fc986" end
		if jobId == "fp" then return "81c1c00cd1aa4ff3b08f9894b42c819b" end
		if jobId == "bishop" then return "778abb348ac2432eb2ca8916a0ce24b9" end
		if jobId == "hero" then return "01d1da2e721b4dd893e314ef3d64e2e1" end
		return ""
	end

	-- 기존 효과 시작·타격 시점과 시전 전체 길이를 유지하며 중간 자세만 추가한다.
	@ExecSpace("ClientOnly")
	method table GetMageSkinFrameDurations(string jobId)
		if jobId == "il" then return { stand1 = { 0.65, 0.45, 0.65, 0.45 }, swingO1 = { 0.18, 0.12, 0.08, 0.07, 0.35 }, swingO3 = { 0.21, 0.09, 0.93, 0.09, 0.48 } } end
		if jobId == "fp" then return { stand1 = { 0.65, 0.45, 0.65, 0.45 }, poisonRegion = { 0.25, 0.15, 0.30, 0.15, 0.35 }, dotPunisher = { 0.20, 0.15, 0.25, 0.15, 0.45 } } end
		if jobId == "bishop" then return { stand1 = { 0.65, 0.45, 0.65, 0.45 }, swingO1 = { 0.09, 0.06, 0.18, 0.12, 0.35 }, swingO3 = { 0.35, 0.15, 0.30, 0.15, 0.55 }, divinePunishment = { 0.15, 0.10, 0.15, 0.10, 0.30 } } end
		if jobId == "hero" then return { stand1 = { 0.65, 0.45, 0.65, 0.45 }, swingO3 = { 0.06, 0.18, 0.06, 0.12, 0.06, 0.12, 0.18, 0.12 }, enragedRagingBlow = { 0.18, 0.12, 0.12, 0.08, 0.12, 0.08, 0.20 } } end
		return {}
	end

	-- 크리티컬 기본값: 확률 0%, 크리티컬 데미지 20%(원작 메이플 기본). 스킬·증강의 크리 확률/데미지는 각각 합연산
	property number BaseCritRate = 0

	property number BaseCritDamage = 20

	-- 레벨 L→L+1 비용(level.md 블록). 인덱스 = 도달 레벨(2~50)
	property table Costs = {}

	method void EnsureCosts()
		if #self.Costs > 0 then return end
		local c = { 0 }
		local blocks = { { 70, 8, 440 }, { 350, 9, 1140 }, { 470, 9, 1420 }, { 630, 9, 1710 }, { 6900, 9, 47580 } }
		for b = 1, #blocks do
			for i = 1, blocks[b][2] do c[#c + 1] = blocks[b][1] end
			c[#c + 1] = blocks[b][3]
		end
		self.Costs = c
	end

	-- 다음 레벨(nextLevel)에 도달하는 비용. 범위 밖은 0
	method number GetLevelCost(number nextLevel)
		self:EnsureCosts()
		local v = self.Costs[nextLevel]
		if v == nil then return 0 end
		return v
	end

	-- 1레벨부터 level까지 누적 투자
	method number GetCumCost(number level)
		self:EnsureCosts()
		local t = 0
		for i = 2, level do t = t + self:GetLevelCost(i) end
		return t
	end

	-- 10·20·30·40·50 = 벽(구간 마지막 칸이 비싸다)
	method boolean IsWallLevel(number level)
		return level % 10 == 0
	end

	method number GetMaxLevel()
		return self.MaxLevel
	end

	-- 능력치표의 공격 주기(초): period가 있으면 공격속도와 무관하게 그 값(폭풍의 시 0.2초), 없으면 공격속도 이름으로
	method number GetPeriod(table st)
		if st.period ~= nil then return st.period end
		return self:GetSpeedSec(st.speed)
	end

	-- 공격속도 이름 → 주기(초)
	method number GetSpeedSec(string speed)
		if speed == "매우느림" then return 1.5 end
		if speed == "느림" then return 1.25 end
		if speed == "빠름" then return 0.75 end
		if speed == "매우빠름" then return 0.5 end
		return 1.0
	end

	-- 직업 id(character.md 순): hero 히어로 / paladin 팔라딘 / dk 다크나이트 / bow 보우마스터 / marks 신궁 / il 아크메이지(썬·콜) / fp 아크메이지(불·독)
	--   / bishop 비숍 / nl 나이트로드 / shad 섀도어 / phantom 팬텀(히든, 프리즘 '팬텀 영입')
	method table GetJobIds()
		return { "hero", "paladin", "dk", "bow", "marks", "il", "fp", "bishop", "nl", "shad", "phantom" }
	end

	method boolean HasJob(string jobId)
		return self:GetJobName(jobId) ~= jobId
	end

	method string GetJobName(string jobId)
		if jobId == "hero" then return "히어로" end
		if jobId == "paladin" then return "팔라딘" end
		if jobId == "dk" then return "다크나이트" end
		if jobId == "bow" then return "보우마스터" end
		if jobId == "marks" then return "신궁" end
		if jobId == "il" then return "아크메이지(썬·콜)" end
		if jobId == "fp" then return "아크메이지(불·독)" end
		if jobId == "bishop" then return "비숍" end
		if jobId == "nl" then return "나이트로드" end
		if jobId == "shad" then return "섀도어" end
		if jobId == "phantom" then return "팬텀" end
		return jobId
	end

	method string GetJobGroup(string jobId)
		-- 상세정보와 영입 목록이 같은 소속·계열 분류를 사용한다.
		local faction = self:GetJobFaction(jobId)
		local factionName = faction
		for _, item in ipairs(self:GetRecruitFactions()) do
			if item[1] == faction then factionName = item[2] end
		end
		local series = self:GetSeries(jobId)
		for _, group in ipairs(self:GetRecruitGroups(faction)) do
			if group[3] == series then return factionName .. " · " .. group[1] end
		end
		return factionName
	end

	method table GetRecruitFactions()
		-- 출시된 소속 탭. 새 소속을 여기에 등록하면 동일한 다섯 계열 열을 사용한다.
		return { { "adv", "모험가", 100 }, { "hero", "영웅", 90 } }
	end

	method string GetJobFaction(string jobId)
		-- 히어로 직업(hero)은 모험가, 팬텀은 영웅 소속이다.
		if jobId == "phantom" then return "hero" end
		return "adv"
	end

	method table GetRecruitGroups(string faction)
		-- 빈 계열도 반환하므로 모든 소속이 전사/궁수/마법사/도적/해적 순서를 유지한다.
		local groups = { { "전사", {}, "war" }, { "궁수", {}, "arc" }, { "마법사", {}, "mag" }, { "도적", {}, "thf" }, { "해적", {}, "pir" } }
		for _, jobId in ipairs(self:GetJobIds()) do
			if self:GetJobFaction(jobId) == faction then
				local series = self:GetSeries(jobId)
				for _, group in ipairs(groups) do
					if group[3] == series then table.insert(group[2], jobId) end
				end
			end
		end
		return groups
	end

	-- 계열 키(HUD 슬롯 색): war/arc/mag/thf/pir(해적 출시 시 사용)
	method string GetSeries(string jobId)
		if jobId == "bow" or jobId == "marks" then return "arc" end
		if jobId == "il" or jobId == "fp" or jobId == "bishop" then return "mag" end
		if jobId == "nl" or jobId == "shad" or jobId == "phantom" then return "thf" end
		return "war"
	end

	-- 1레벨 공격력 / 레벨업당 공격력 / 공격속도 이름 (character.md 능력치)
	method number GetBaseAttack(string jobId)
		if jobId == "paladin" then return 80 end
		-- 섀도어·신궁 약점 = 공격력(2026-09-24 사용자 "섀도어 기본 공격력 낮게 · 신궁은 기본 공격력과 크뎀을 줘야") — 50 → 30(×0.6), 스킬 비율은 ×5/3
		if jobId == "shad" or jobId == "marks" then return 30 end
		if jobId == "hero" then return 40 end
		if jobId == "bow" then return 30 end
		if jobId == "fp" or jobId == "bishop" or jobId == "nl" then return 20 end
		if jobId == "phantom" then return 100 end
		return 50
	end

	method number GetAttackPerLevel(string jobId)
		if jobId == "hero" then return 12 end
		if jobId == "marks" then return 9 end -- 15 → 9(×0.6, 2026-09-24)
		if jobId == "shad" then return 6 end -- 10 → 6(×0.6, 2026-09-24)
		if jobId == "il" then return 3 end
		if jobId == "fp" or jobId == "bishop" or jobId == "nl" then return 5 end
		if jobId == "phantom" then return 0 end
		return 10
	end

	method string GetBaseSpeed(string jobId)
		if jobId == "paladin" or jobId == "dk" or jobId == "marks" then return "느림" end
		if jobId == "bow" or jobId == "phantom" or jobId == "shad" then return "매우빠름" end
		if jobId == "nl" then return "빠름" end
		return "보통"
	end

	-- 무기 종류(.info/weapon.md, 2026-09-19): 직업마다 무기가 정해져 있고, 타격마다 최종 데미지에 무기별 최소~최대 비율을 균등 난수로 곱한다(방어율 계산 전). 케인(팬텀) 0.85~1.2(사용자 2026-09-19)
	method string GetWeaponType(string jobId)
		if jobId == "hero" then return "두손검" end
		if jobId == "paladin" then return "양손둔기" end
		if jobId == "dk" then return "창" end
		if jobId == "bow" then return "활" end
		if jobId == "marks" then return "석궁" end
		if jobId == "il" or jobId == "fp" then return "스태프" end
		if jobId == "bishop" then return "완드" end
		if jobId == "nl" then return "아대" end
		if jobId == "shad" then return "단검" end
		if jobId == "phantom" then return "케인" end
		return ""
	end

	-- 무기별 데미지 비율 {최소, 최대}
	method table GetWeaponRange(string weapon)
		if weapon == "두손검" then return { 0.8, 1.2 } end
		if weapon == "양손둔기" then return { 0.75, 1.25 } end
		if weapon == "창" then return { 0.7, 1.5 } end
		if weapon == "스태프" then return { 0.9, 1.1 } end
		if weapon == "완드" then return { 0.85, 1.05 } end
		if weapon == "아대" then return { 0.8, 1.3 } end
		if weapon == "단검" then return { 0.7, 1.2 } end
		if weapon == "활" then return { 0.75, 1.3 } end
		if weapon == "석궁" then return { 0.6, 1.35 } end
		if weapon == "케인" then return { 0.85, 1.2 } end
		return { 1.0, 1.0 }
	end

	-- 타격 1회의 무기 배율 굴림(균등 난수). 기대값 = (최소+최대)/2 — 표(balance-detail.md)는 이 기대값을 곱해 둔다
	method number RollWeapon(string jobId)
		local r = self:GetWeaponRange(self:GetWeaponType(jobId))
		return r[1] + (r[2] - r[1]) * _UtilLogic:RandomDouble()
	end

	method number WeaponMean(string jobId)
		local r = self:GetWeaponRange(self:GetWeaponType(jobId))
		return (r[1] + r[2]) / 2
	end

	-- 기본 외형 = 공식 "모험가 ○○" 세트(아바타 아이템 RUID). 없는 직업은 nil
	--   슬롯: longcoat / weapon2h 또는 weapon1h / shoes / hair / face(얼굴, 없으면 기본) / cap(모자) / faceAcc(얼굴 장식). 세트의 캐시 무기는 잔상이 두손검(swordTS/swordOL)이라
	--   무기 = 각 세트의 전용 무기(사용자 2026-09-17 최종 — 캐시 무기라 공격 모션에 두손검 계열 잔상(swordTS/swordOL)이 나오지만 의상과 색이 맞는 쪽을 택함).
	--   마법사·섀도어·나이트로드는 **한손 판**(stand1, 한손으로 드는 모션), 활·석궁·전사 무기는 두손 판. 팬텀은 세트가 없어 팬텀 오리지날티(케인).
	--   대안(잔상이 정상인 진짜 무기): 리버스 니플하임 5d0abb01… / 리버스 벨로체 6083bc6e… / 타임리스 알슈피스 164067c8… / 타임리스 엔가우 9e8fe977… / 리버스 블랙뷰티 676ca51a…
	--   / 타임리스 엔릴 티어 9886e145… / 타임리스 람피온 11f2459e… / 타임리스 킬릭 f92581fa… / 타임리스 페르소나 b5150885…
	--   성별(사용자 2026-09-17): 전사 3·나로·팬텀 = 남(롱코트 01050xxx/01054xxx, 헤어 65xxx, 기본 얼굴) / 보마·신궁·썬콜·불독·비숍·섀도어 = 여(롱코트 01051xxx, 부츠 01071xxx, 헤어 67xxx, 얼굴 = 청아한 얼굴 21259)
	method table GetCostume(string jobId)
		if jobId == "hero" then
			return { longcoat = "c92ab70d7a064aafaa34298c2e9890e3", weapon2h = "c4f9b9c993754161816092e680584ce3",
				shoes = "186a55d192d24b4da5201801422bebf7", hair = "931c0ed47c3e4df69734fe19247a7b33" }
		end
		if jobId == "paladin" then
			return { longcoat = "3db1f00384854ab6aa9e6148efa942d9", weapon2h = "ba9a04c1dc1f42049f0ec88e95052c76",
				shoes = "790ae27c0b30414eb369bda472df4799", hair = "9188a9716ae947b5a1e518bd0d1c0252" }
		end
		if jobId == "dk" then
			-- 창 = 타임리스 알슈피스(진짜 창, afterImage spear — 2026-09-18 사용자 "다크나이트만 리버스로": 세트 캐시 창 acd581b7…의 빨간 두손검 참격이 스피어 버스터와 겹쳐서. 리버스 창(로렌티우스)은 라이브러리에 없어 자매 세트 타임리스로. 대안 레볼루션 스피어 44d92464…)
			return { longcoat = "a529865cf7be417c97b7855eed344004", weapon2h = "164067c82a8347d681cf49a8be3db5df",
				shoes = "f6f89e92db4f498e9b5fb6ec7ee81dda", hair = "e8d9dda3dfd34b68b62426838e951723" }
		end
		if jobId == "bow" then
			-- 모험가 보우마스터 세트(여): 슈트(여 01051806) · 부츠 · 검은색 헤어(67060) · 깃털 모자 + 활 = 타임리스 엔가우(진짜 활, afterImage bow — 2026-09-18 사용자: 세트 캐시 활 37ad1f37…의 파란 폭발 잔상이 초당 5발 폭풍의 시와 겹쳐서 교체)
			return { longcoat = "485c62e590af4b0b943a202ec9890252", weapon2h = "9e8fe977ff9540d180f3f08dc420d087",
				shoes = "44f0f373baed42cc91d160b20d01fe7b", hair = "c97a920273e243a28a81772834cbba05", face = "9edd3b016f6b4afaa7973c7259d46c69", cap = "74aa2fe40c304ec7b91f5bf2ce1cc128" }
		end
		if jobId == "marks" then
			-- 모험가 신궁 세트(여): 슈트(여 01051810) · 부츠 · 검은색 헤어(67070) · 모자 + 세트 석궁(두손 판)
			return { longcoat = "05a8f762ba03471dbbded534436646c3", weapon2h = "2ae7ec2367cc45ecb6b49ec12ac4d05b",
				shoes = "d79e6681a08c467fa69b37ab0e9023be", hair = "d944c2c9ac264e8ca0272f35e9f13fb6", face = "9edd3b016f6b4afaa7973c7259d46c69", cap = "9defd0fd49cd45629d1c8beefc10ebd9" }
		end
		if jobId == "il" then
			-- 모험가 썬콜 세트(여): 로브(여 01051805) · 부츠(여 01071193) · 검은색 헤어(67050) · 머리띠 + 세트 스태프(한손 판)
			return { longcoat = "8a6b5acc6a02447cb25ce366945d09e7", weapon1h = "3dcc26b9213d4b1193377a5c676bffdb",
				shoes = "1a2b66f0496f4926bd9d6d7d1f77ccb4", hair = "9110ec2d96ba489cb958cad1132c0ab6", face = "9edd3b016f6b4afaa7973c7259d46c69", cap = "39f032dee08e47dc84fd6ab0019b12f9" }
		end
		if jobId == "fp" then
			-- 모험가 불독 세트(여): 로브(여 01051803) · 부츠(여 01071191) · 검은색 헤어(67030), 모자 없음 + 세트 완드(한손 판)
			return { longcoat = "c449931dbadc42d08b9386faf5c0fc62", weapon1h = "37d1f2f65ace4ff583e388243b756682",
				shoes = "baeca0b68837465bbf1dead9755313c8", hair = "47575a7d509d4f6fa8878f20c372ebef", face = "9edd3b016f6b4afaa7973c7259d46c69" }
		end
		if jobId == "bishop" then
			-- 모험가 비숍 세트(여): 로브(여 01051804) · 부츠(여 01071192) · 검은색 헤어(67040) · 모자 + 세트 완드(한손 판)
			return { longcoat = "f6ded93c726f4974972392fdeecce574", weapon1h = "ffa0f813b710492088cbd93b3d4a7db6",
				shoes = "2fecfe3a5d944e43825ca6ef73d816ab", hair = "2ae23cf95ae0413085f2534258771533", face = "9edd3b016f6b4afaa7973c7259d46c69", cap = "2d2c164b8cda45aaa0ca59cdff242e59" }
		end
		if jobId == "nl" then
			-- 모험가 나이트로드 세트: 슈트(01054091) · 부츠 · 검은색 헤어(65080) · 헤어밴드(01001160) + 세트 표창(한손 판)
			return { longcoat = "b2f43a0a2ce344d6a3eb7e5c5f288415", weapon1h = "37cdd4cecceb4315864f1e014711a8cc",
				shoes = "4539394af12f41afa9f1a6e4736717a6", hair = "2c0ae06e45744e7fa4a8e986f8249b14", cap = "ed9795ce9c2348d58423f49b9e65eabf" }
		end
		if jobId == "shad" then
			-- 모험가 섀도어 세트(여): 슈트(01054093) · 부츠 · 검은색 헤어(67100) · 마스크(얼굴 장식) + 세트 단검(한손 판)
