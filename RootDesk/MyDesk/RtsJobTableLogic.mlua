			end
			fx.hitKinds = kinds
			list[#list + 1] = { lv = 1, kind = "액티브", prism = true, name = "블레이드 토네이도 + 카르마 퓨리", desc = "검의 폭풍과 카르마 퓨리를 동시에 날려 사거리 3 안의 적 1마리를 103.7%의 데미지로 72회, 110.3%의 데미지로 45회 공격한다. 재사용 대기시간 5초.", target = false, cd = 5, ratio = 103.7, hits = 117, hitRatios = hr, targets = 1, range = 3, fx = fx }
		end
	end

	-- 능력치 쪽 변화(기본 공격 비율·타격·주기·사거리, 보스 공격시 데미지 합연산 풀)
	method void ApplyPrismStat(string id, table st, string jobId)
		-- 2026-09-24 사용자: 프리즘의 '보스 공격시 데미지 증가 +n%'(③)를 빼고 → 같은 날 '보스 최종 데미지는 없어, 스킬 데미지로': 보스 가산은 전부 ⑤ '보스 공격 시 +n%'(st.bossRatio / 스킬 k.bossRatio).
		--   값 = 직업 티어 목표(50레벨·증강 없음 보스 원딜: 1티어 히어로·나로 3만 · 썬콜 2.5만 / 2티어 4만 / 3티어 2.8만 / 비숍 개미딜 약 2천)에 맞춘 것.
		--   = damage.md ⑥ '보스 공격 시 최종 데미지 +n%'(곱): 유닛 능력치 st.finBoss(보스 최종 데미지)에 ×(1 + n%) — 스킬 하나에만 붙는 것은 스킬 bossFinal(보스에게 주는 최종 데미지)
		if id == "enrage" then
			st.hits = 3
			st.range = 3
			-- 공격 대상 수는 바꾸지 않는다(레이징 블로우 강화 전 3마리 · 40레벨부터 6마리). 보스 전용 가산은 발할라 +45%뿐(전 인레이지 보스 +242%는 아래 +422%에 합침)
			st.ratio = st.ratio + 422 -- 레이징 블로우 +422%(⑤ 모든 대상) — 2026-09-24 사용자 "프리즘 증강의 보스 +n%를 빼고 스킬 데미지로 통합 — 일반 라운드도 밀게"(보스 딜 같음) / 2026-09-24 사용자 "1티어 30장 · 2티어 8장이 권장 — 편차 줄이기": 그 장수에서 1티어 50만 · 2티어 8만(팬텀 8.8만)
		elseif id == "giant" then
			-- 거대화 = 6타(2026-09-23 사용자 "거대화 때만 6회, 데미지는 그만큼 토막"): 1타 비율 = (기본 + 29) ÷ 2 → 50레벨 (180 + 29) ÷ 2 = 104.5% × 6 = 3타 209%와 총합 같음
			st.ratio = (st.ratio + 29) / 2
			st.hits = 6
			st.range = 6
			st.ratio = st.ratio + 654 -- 1회 데미지 +654%(⑤ 모든 대상) — 2026-09-24 사용자 "프리즘 증강의 보스 +n%를 빼고 스킬 데미지로 통합 — 일반 라운드도 밀게"(보스 딜 같음) / 2026-09-24 사용자 "1티어 30장 · 2티어 8장이 권장 — 편차 줄이기": 그 장수에서 1티어 50만 · 2티어 8만(팬텀 8.8만) / 보스 공격 시 +421%(⑤ — 2026-09-24 사용자 "보스 최종 데미지는 없어, 스킬 데미지로 관리", 전 보스 최종 ×5.03) — 2티어 4만
		elseif id == "arrowrain" then
			st.ratio = 395 -- 54 + 341(2026-09-24 사용자 "프리즘 증강의 보스 +n%를 빼고 스킬 데미지로 통합 — 일반 라운드도 밀게"(보스 딜 같음))
			st.hits = 2
			st.period = 0.2
			st.range = 6
			st.bossRatio = 0 -- 폭풍의 시 강화의 보스 +143%는 폭풍의 시 것(애로우 레인엔 없음) — 2026-09-24 사용자 "1티어 30장 · 2티어 8장이 권장 — 편차 줄이기": 그 장수에서 1티어 50만 · 2티어 8만(팬텀 8.8만) / 1티어 보스 가산(⑤) (2026-09-24 티어 재설계 — .info/tier.md, 값 = tools/balance-calc.py TUNE) — 폭풍의 시 +143% 대신(애로우 레인이 기본 공격 자리)
		elseif id == "truesnipe" then
			-- 능력치 변화 없음(보스 전용 가산 없음 — 트루 스나이핑 스킬 비율 719.7%만). 프리즘 방무 +15는 2026-09-24 삭제 — 2티어 킷 방무 50으로 통일
		elseif id == "transcend" then
			-- 능력치 변화 없음(보스 전용 가산 없음 — 초월 도트 퍼니셔 구체 비율 314%만). 프리즘 방무 +15는 2026-09-24 삭제 — 2티어 킷 방무 50으로 통일
		elseif id == "divinepunish" then
			st.ratio = 49 -- 27 + 22(2026-09-24 사용자 "프리즘 증강의 보스 +n%를 빼고 스킬 데미지로 통합 — 일반 라운드도 밀게"(보스 딜 같음))
			st.hits = 1
			st.period = 0.2
			st.range = 3
			st.targets = 6 -- 2026-09-22 사용자 "몬스터 타겟 수 6으로"
			-- (보스 +22%는 비율에 합침) — 보스 공격 시 +22%(⑤ — 2026-09-24 사용자 "보스 최종 데미지는 없어, 스킬 데미지로 관리", 전 보스 최종 ×1.7) — 2026-09-24 사용자 "서브 — 개미딜이라도"(보스 약 2천) + 받는 데미지 증가(스킬 vuln)
		elseif id == "fuma" then
			st.ratio = st.ratio + 20
			st.range = 3 -- 2026-09-22 사용자 "사거리 1 추가"(쿼드러플 스로우 2 → 3). 쿨 없는 스킬은 st.range가 우선이라 여기서
			st.ratio = st.ratio + 247 -- 풍마수리검 130 → 377%(⑤ 모든 대상) — 2026-09-24 사용자 "프리즘 증강의 보스 +n%를 빼고 스킬 데미지로 통합 — 일반 라운드도 밀게"(보스 딜 같음) / 2026-09-24 사용자 "1티어 30장 · 2티어 8장이 권장 — 편차 줄이기": 그 장수에서 1티어 50만 · 2티어 8만(팬텀 8.8만) / 1티어 보스 가산(⑤) (2026-09-24 티어 재설계 — .info/tier.md, 값 = tools/balance-calc.py TUNE) — 전 보스 최종 ×4.57
			-- 방어율 무시 +15%(2026-09-23 사용자 "풍마수리검에 방무 15% 추가") — 나이트로드 액티브는 풍마수리검(쿼드러플 스로우 대체)뿐이라 능력치에 얹는다(쉐도우 파트너 ½타도 같은 표창)
			self:AddIgn(st, 70) -- 2026-09-24 1티어(자기가 강한 메인 격수) — 히어로 발할라와 같은 70
		elseif id == "dualblade" then
			-- 크확 +40·크뎀 +80(2026-09-24 사용자 "섀도어: 프리즘에 크확·크뎀 많이, 기본 공격력은 낮게") · 보스 가산 +82%는 스킬 비율에 합침(⑤ 모든 대상 — 2026-09-24 사용자 "프리즘 증강의 보스 +n%를 빼고 스킬 데미지로 통합 — 일반 라운드도 밀게"(보스 딜 같음)) (2026-09-24 티어 재설계 — .info/tier.md, 값 = tools/balance-calc.py TUNE)
			st.crit = (st.crit or 0) + 40
			st.critDmg = (st.critDmg or 0) + 80
		end
	end

end
