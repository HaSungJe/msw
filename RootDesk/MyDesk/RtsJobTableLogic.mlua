					fx = { motion = "swingO1", clip = "61840689ea7b44f09f91960734232e34", scale = 1.6, feetDx = 0, feetDy = 0, assetFacesLeft = true, sound = "acb0f70275b7422dbcc8a395cbbd9d28",
						hitDelay = 0.3, hitClip = "644458b8c91949b4b4b84ff949eba8ca", hitScale = 1.4, hitDy = 0.6 } },
				{ lv = 40, kind = "패시브", name = "대거 익스퍼트", desc = "공격력이 20%, 최종 데미지가 5% 증가한다.", target = false },
				{ lv = 50, kind = "패시브", name = "레디 투 다이", desc = "최종 데미지가 20%, 보스 공격 시 데미지가 30% 증가한다. 보스 공격 시 새비지 블로우의 데미지가 88% 증가하고, 몬스터의 방어율을 50% 무시한다.", target = false },
			}
		end
		if jobId == "phantom" then
			return {
				-- 조커 연출 3차(2026-09-20, 사용자 영상 + "스킬명 400041009, 캐릭터 애니메이션은 keydown 01eff730…"): 원작 조커 = 400041009(prepare·keydown·keydownend·screen + pre/loop/end 사운드) + 400041010(타격 3색·타격음).
				--   캐릭터: alert 자세 유지 + keydown 클립(붉은·금빛 리본이 몸을 감싸며 도는 지팡이 회전 잔상)을 loopClip으로 공격 중 계속. 카드: 사용자 지정 5종(2026-09-20 "빨강·초록·파랑·검정·노랑 5개") = 400041011/screen/6 빨강 십자(e57428fc…) · 400041012/screen/5 초록 나무(3642df1a…) · 400041014/screen/4 파랑 검(4e7909ae…) · 400041015/screen/4 검정·금 달별(6856aa12…) · 400041013/screen/5 노랑 모래시계(68eead1e…), 발마다 차례로(라운드 로빈). 포물선 높이는 대상까지 칸 거리로 1칸 1.0 / 2칸 1.1 / 3칸 1.2 / 4칸 이상 1.3(projArcByDist, 무작위 없음 — 2026-09-20 사용자; 그 전엔 1.0 → 1.4 고정). 비행 시간은 0.65·0.55초를 거쳐 다시 0.4초(사용자 "원래대로, 너무 답답하네"), 판정 0.35초 뒤. 원본이 180~204×300~328px지만 보이는 카드는 그 절반(나머지는 투명한 잔상 테두리)이라 0.55배가 이전 덱(104×176, 0.52배)과 같은 화면 크기(0.3배는 너무 작았음). 회전 없이 그대로(projSpin 제거·projNoRotate), 공격마다 2장(0.05초 간격 — 0.1초 공격이라 초당 20장), **머리 위(+1.35)에서 적에게 항상 위로 볼록한 포물선**(projArc 1.0, 높이 0.5~1.0) 0.4초 비행. 타격은 400041010 hit/0·1·2 무작위 + 타격음
				{ lv = 1, kind = "액티브", name = "조커", desc = "사거리 5 안의 적 1마리를 192.5%의 데미지로 공격한다. 공격속도와 관계없이 0.1초마다 카드를 던진다.", target = false, range = 5,
					fx = { motions = { "swingOF", "swingO1", "swingO1", "stabO1" }, motionCycle = true, motionGap = 0.45,
						loopClip = "01eff730ea0a4c3aa797fdb50a1e4492", loopScale = 0.9, loopDx = 0, loopDy = 0.55, loopAlpha = 0.9, loopOrder = 190, loopFacesLeft = true,
						projs = { "e57428fc63e34e239b0ed3c5befdaae3", "3642df1a01b043e282621a3d97ee0beb", "4e7909aecedf4dde84d841bf7a0f7fb4", "6856aa123ca94eb3ad9315fc7e3bf027", "68eead1e49fa4e21b7ab064d47833a2b" }, projCount = 2, projStagger = 0.05, projSec = 0.4, projDx = 0, projDy = 1.35, projScale = 0.55, projNoRotate = true, projArc = 1.0, projArcByDist = { 1.0, 1.1, 1.2, 1.3 }, assetFacesLeft = true,
						hitDelay = 0.35, hitClips = { "6c691c6d80724c7f966326006e210fcc", "f0f23e845b144475b9b8a7059e4821cc", "8b23673c5c2d4443b384b080eaa1dac2" }, hitScale = 1.4, hitDy = 0.6, hitSound = "e37b311a831546b99b6e512f7ba6983c" } },
				{ lv = 10, kind = "패시브", name = "조커: 날카로운 검", desc = "모든 아군 유닛의 최종 데미지가 5% 증가한다.", target = false },
				{ lv = 20, kind = "패시브", name = "문라이트", desc = "공격력이 150, 공격력이 10% 증가한다.", target = false },
				{ lv = 30, kind = "패시브", name = "프레이 오브 아리아", desc = "공격력이 150, 공격력이 10% 증가한다.", target = false },
				{ lv = 40, kind = "패시브", name = "케인 엑스퍼트", desc = "최종 데미지가 10% 증가한다.", target = false },
				{ lv = 50, kind = "패시브", name = "블스아이", desc = "크리티컬 확률이 50%, 크리티컬 데미지가 30%, 최종 데미지가 20% 증가하고 몬스터의 방어율을 60% 무시한다. 보스 공격 시 데미지가 60% 증가하고, 보스 공격 시 조커의 데미지가 143% 증가한다.", target = false },
			}
		end
		return { { lv = 1, kind = "액티브", name = "(미정)", desc = "스킬 정의는 character.md — 코드 등록 전", target = false } }
	end

	-- 대상 지정 스킬의 획득 레벨(없으면 0)
	-- ===== 액티브 스킬 잠금 설정 (2026-09-16) =====
	--   유닛의 RtsUnitComponent.SkillLocks = 스킬 목록 순서대로 한 글자씩("0"/"1"/"2"). 패시브 자리는 항상 "0".
	--   0 사용 / 1 보스전 잠금(보스 라운드에만 안 씀) / 2 잠금(안 씀) / 3 영구 잠금(프리즘 증강의 "영구적 잠금" — 강제, 클라가 풀 수 없음. 서버 RtsUnitLogic.SetPermaLock으로만).
	--   전투 루프(Phase 3)가 액티브를 고를 때 이 값을 본다(2·3은 안 씀).

	method string DefaultLocks(string jobId)
		local skills = self:GetSkills(jobId)
		local s = ""
		for i = 1, #skills do
			local m = 0
			if skills[i].kind == "액티브" and skills[i].lock ~= nil then m = skills[i].lock end
			s = s .. string.format("%d", m)
		end
		return s
	end

	method number GetLock(string locks, number i)
		local c = string.sub(locks or "", i, i)
		if c == "1" then return 1 end
		if c == "2" then return 2 end
		if c == "3" then return 3 end
		return 0
	end

	method string SetLock(string locks, number i, number mode)
		local n = math.max(#(locks or ""), i)
		local s = ""
		for k = 1, n do
			if k == i then
				s = s .. string.format("%d", mode)
			else
				s = s .. string.format("%d", self:GetLock(locks, k))
			end
		end
		return s
	end

	method string LockName(number mode)
		if mode == 1 then return "보스전 잠금" end
		if mode == 2 then return "잠금" end
		if mode == 3 then return "영구 잠금" end
		return "사용"
	end

	method number GetTargetSkillLevel(string jobId)
		local list = self:GetSkills(jobId)
		for i = 1, #list do
			if list[i].target then return list[i].lv end
		end
		return 0
	end

	-- 레벨 L의 전투 계수: pct 공격력%(합연산 결과) / flat 추가 공격력 / ratio 기본 공격 데미지%(1회 타격) / hits 타격 수 / targets 타겟 수
	--   bossAdd 보스 공격시 데미지 증가%(합연산 결과 — 킷 보스 티어(2026-09-19: 나로 0 / 불독·팬텀 10 / 히어로 15 / DK 25 / 보우·신궁·섀도어 30 / 팔라딘·썬콜·비숍 40)·증강·블스아이·프리즘, 3단계) / ign 방어율 무시% / fin 최종 데미지%(몬스터) / finBoss 최종 데미지%(보스)
	--   / ignBoss 보스 방무%(-1 = 별도 없음) / speed 공격속도 이름 / halfHits 데미지 ½인 추가 타격 수(쉐도우 파트너 — 기본 공격에만)
	--   crit 크리티컬 확률%(합연산) / critDmg 크리티컬 데미지%(합연산) — 크리 발생 시 최종 데미지에 ×(1 + critDmg)
	--   파티 버프(모든 유닛 / 주변 n타일 / 지정 유닛)는 여기 넣지 않는다 — RtsUnitBuffLogic이 얹는다(샤프아이즈·조커·프레이는 구역 전체·자신 포함, 홀리 유니티는 지정 유닛·자신 제외)
	method table GetStat(string jobId, number L)
		local s = self:GetStatRaw(jobId, L)
		if s.bossAdd == nil then s.bossAdd = 0 end
		if s.crit == nil then s.crit = self.BaseCritRate end
		if s.critDmg == nil then s.critDmg = self.BaseCritDamage end
		if s.crit > 100 then s.crit = 100 end
		return s
	end

	method table GetStatRaw(string jobId, number L)
		if jobId == "hero" then
			-- 2026-09-19 밸런스 패치: 어드콤 강화(40) = 공격력 +100%만(방무 20% 제거 → 방무는 20레벨 10%가 끝), 발할라(50) = 방무 100% + 공격력 +30%(합연산 → 230%)
			local ign = 0
			if L >= 20 then ign = 10 elseif L >= 10 then ign = 5 end
			-- 레이징 블로우 140%×2회(2026-09-19 킷 보스 티어 조정: 90 → 140, 강화 +100 → +150. 스킬 강화 증강은 1회당 비율에 더함)
			local s = { pct = 100, flat = 0, ratio = 140, hits = 2, targets = 3, ign = ign, fin = 100, finBoss = 100, ignBoss = -1, speed = "보통" }
			-- 2026-09-24 사용자 "1티어는 기본 스킬을 손봐서 증강 효율을 높이게": 어드콤 강화 공격력 +100%·발할라 +30%(합연산 200 → 230%)와 킷 보공 15%를
			--   최종 데미지(곱)로 옮긴다 — 레벨마다 기본 딜은 같고(×2.0 → ×2.3, 보스 ×1.15), 공격력%·보공이 100%·0%에서 시작해 증강 공격력%·보공이 희석되지 않는다
			if L >= 40 then
				s.fin = 200
				s.finBoss = 200
				s.ratio = 290
				s.targets = 6
				s.range = 2
			end
			if L >= 50 then
				s.ignBoss = 60 -- 2026-09-23 사용자 "발할라 방무 100 → 60%" — 보스 상대면 st.ign에 더한다(합연산, 2026-09-24): 50레벨 10 + 60 = 70
				s.fin = 230
				s.finBoss = 230
				-- 1티어 보스 가산 = damage.md ⑤ 스킬 데미지 '보스 공격 시 +n%'(st.bossRatio — 보스를 칠 때만 기본 공격 비율에 더한다) (2026-09-24 티어 재설계 — .info/tier.md, 값 = tools/balance-calc.py TUNE): 발할라 레이징 블로우 +45%(전 보스 최종 ×1.15)
				s.bossRatio = 45
			end
			return s
		end
		if jobId == "paladin" then
			-- 2026-09-19 밸런스 패치(목표 DPS 조정): 디바인 차지 200%, 디바인 블레싱(30) 최종 +50%, 디바인 차지 강화(50) 데미지 +140%(→ 340%)·사거리 2·6마리·2회, 생츄어리 200%(스킬 표)
			local s = { pct = 100, flat = 0, ratio = 120, hits = 1, targets = 4, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = "느림" }
			if L >= 30 then
				s.fin = 150
				s.finBoss = 150
			end
			if L >= 50 then
				s.ratio = 190
				s.hits = 2
				s.bossAdd = 40 -- 킷 보스 티어(2026-09-19): 팔라딘 40%
				s.targets = 6
			end
			return s
		end
		if jobId == "dk" then
			-- 2026-09-19 3차: 비홀더 강화(40, 공격속도 보통) 제거 → 스피어 버스터 강화(40) 데미지 +30%(70 → 100%). 공격속도는 끝까지 느림
			-- 2026-09-23 사용자 "다크나이트 초반에 너무 세다 — 초반 너프, 후반 약상향": 스피어 버스터 120 → 80%, 30레벨 숙련 +50%(130%) 신설, 40레벨 강화 +50% 그대로(180%, 전 170%)
			--   6타는 거대화 프리즘만(ApplyPrismStat "giant" — 2026-09-23 사용자 "거대화 때만 6회, 기존은 3회")
			local s = { pct = 100, flat = 0, ratio = 80, hits = 3, targets = 3, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = "느림" }
			--   → 같은 날 "버서크(공격력 +100%)를 30으로, 숙련을 20으로": 20~29레벨 딜 ×0.81(80% × 공격력 2배 → 130% × 1배), 30레벨부터 그대로
			if L >= 10 then s.flat = 100 end
			if L >= 20 then s.ratio = 130 end
			--   → 같은 날 "버서크 공격력 증가 50%로, 드래곤 로어에 패시브 최종 데미지 +20%": 버서크 +100 → +50%(30~ 딜 ×0.75), 50레벨 최종 ×1.2(보스 최종도 같이)
			if L >= 30 then s.pct = 150 end
			if L >= 40 then
				s.ratio = 180
				s.bossAdd = 25 -- 킷 보스 티어(2026-09-19): DK 25%
			end
			if L >= 50 then
				s.fin = 120
				s.finBoss = 120
				s.ign = 50 -- 2티어 킷 방무 50(2026-09-24 사용자 "팬텀 제외 2티어 방무 통일" — 섀도어와 같은 50, 팬텀 60) — 드래곤 로어 패시브
			end
			return s
		end
		if jobId == "bow" then
			-- 폭풍의 시 50%×1회×1마리, 공격속도와 무관하게 0.2초마다(period). 크리티컬 마스터리 +30%(L10), 보우 마스터리·액스퍼트 공격력 +5%씩(L20·L30), 강화 75%(L50). 샤프아이즈는 파티 버프(여기 안 넣음)
			--   2026-09-19 밸런스 패치: 폭풍의 시 40%, 보우 마스터리·액스퍼트 +25%씩, 강화 +15%(→ 55%)
			local s = { pct = 100, flat = 0, ratio = 70, hits = 1, targets = 1, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = "매우빠름", period = 0.2, crit = self.BaseCritRate, critDmg = self.BaseCritDamage }
			if L >= 10 then s.crit = s.crit + 30 end
			if L >= 20 then s.pct = s.pct + 25 end
			if L >= 30 then s.pct = s.pct + 25 end
			if L >= 50 then
				s.ratio = 93
				-- 1티어(2026-09-24 보우 2 → 1티어): 킷 보공 30·보스 최종 ×2.93 → 폭풍의 시 보스 공격 시 +143%(⑤ st.bossRatio) (2026-09-24 티어 재설계 — .info/tier.md, 값 = tools/balance-calc.py TUNE) — 50레벨 보스 1만
				s.bossRatio = 143
				s.ign = 70 -- 2026-09-24 사용자 "보우 1티어 — 1티어 방무 70에 맞추자"(전 50)
			end
			return s
		end
		if jobId == "marks" then
			-- 피어싱 30%×3회×6마리(느림 1.25초). 크리티컬 마스터리 +30%(L10), 크로스보우 액스퍼트 공격력 +20%(L40), 강화 50%×4회(L50). 샤프아이즈(L20)는 파티 버프
			--   2026-09-19 밸런스 패치: 피어싱 2회(3회에서), 크로스보우 액스퍼트 +70%, 강화(50) = 데미지 +50%만(3차: 사거리 4 변경·타격 수 변경 모두 삭제 → 30 + 50 = 80%)
			local s = { pct = 100, flat = 0, ratio = 183.3, hits = 2, targets = 6, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = "느림", crit = self.BaseCritRate, critDmg = self.BaseCritDamage }
			if L >= 10 then s.crit = s.crit + 30 end
			if L >= 40 then s.pct = 170 end
			if L >= 50 then
				s.ratio = 441.6 -- 183.3 + 258.3(2026-09-24 비율 ×5/3 — 기본 공격력 ×0.6과 짝)
				s.bossAdd = 30 -- 킷 보스 티어(2026-09-19): 신궁 30%
				s.ign = 50 -- 2티어 킷 방무 50(2026-09-24 사용자 "팬텀 제외 2티어 방무 통일" — 섀도어와 같은 50, 팬텀 60) — 피어싱 강화
			end
			return s
		end
		if jobId == "il" then
			-- 체인 라이트닝 100%×1회×10마리(보통). 메디테이션 +50(L10), 강화 2회(L20), 아케인 에임 공격력 +10%(L40), 인피니티 최종 +10%(L50)
			--   2026-09-19 밸런스 패치: 메디테이션 +150, 강화(20) = 사거리 3·130%(타격 수 변경 제거), 아케인 에임 +50%, 인피니티(50) = 공격력 +50%(3차; 최종 데미지 항목 삭제), 블리자드 300%·빙결 5초(스킬 표)
			--   2026-09-23 너프(사용자 "체인 라이트닝 초반 너무 사기"): 최대 10마리 → 6마리, 데미지 −20%(130% → 105%, 강화 170% → 135%)
			local s = { pct = 100, flat = 0, ratio = 105, hits = 1, targets = 6, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = "보통", crit = self.BaseCritRate, critDmg = self.BaseCritDamage }
			if L >= 10 then s.flat = 150 end
			-- 2026-09-23 사용자 "체인 라이트닝 강화(20) 데미지 더 — 30레벨 사냥 6천 초반까지": 135 → 355%(30레벨 사냥 2,325 → 약 6,100)
			if L >= 20 then
				s.ratio = 355
				s.range = 3
			end
			-- 2026-09-24 1티어 증강 효율: 아케인 에임·인피니티 공격력 +50%씩(합 150 → 200%)과 킷 보공 40%를 최종 데미지(곱)로 — 기본 딜은 같고 증강 공격력%·보공이 희석되지 않는다
			if L >= 40 then
				s.fin = 150
				s.finBoss = 150
			end
			if L >= 50 then
				s.fin = 200
				s.finBoss = 200 -- 인피니티 보스 최종 +40% 삭제 (2026-09-24 티어 재설계 — .info/tier.md, 값 = tools/balance-calc.py TUNE) — 1티어 보스 딜은 템페스트
			end
			return s
		end
		if jobId == "fp" then
			-- 기본 공격 없음 — 포이즌 리전(지속 피해 지대 dotPct%/2초 × 12초, 방무 100%, 쿨 15)·도트 퍼니셔(구체 100%, 쿨 15)만. 아래 2026-09-19 패치 값 참조
			--   ratio·hits·targets 0 = 표의 기본 DPS 0(지속 피해는 팝업 DPS에 아직 안 넣음)
			local s = { pct = 100, flat = 0, ratio = 0, hits = 0, targets = 0, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = "보통", crit = self.BaseCritRate, critDmg = self.BaseCritDamage, dotPct = 10, dotIgn = 0 }
			--   2026-09-19 밸런스 패치: 포이즌 리전 기본 15%·방무 100%, 메디테이션 +100, 강화(20) +15%(→ 30%), 아케인 에임 +50%, 인피니티 최종 +30%(3차)
			--   2026-09-23 사용자 "포이즌 리전 데미지 2배, 너무 약하네": 기본 15 → 30%, 강화(20) 30 → 60%
			s.dotPct = 50 -- 2026-09-26 사용자 "포이즌 리전 좀 많이 세게 — 50%, 강화 80%"(전 30 · 60)
			s.dotIgn = 100
			-- 일반 몬스터(보스 제외)에 틱마다 고정 데미지(RtsCombatLogic 지대 피해): 2026-09-26 사용자 "상향 — 20 + 레벨×2" → 같은 날 "레벨업 증가량 3배로" 20 + 레벨×3(전 5 + 레벨×1.5 버림 · 그 전 10 + 레벨×3 → "너무 쎄다")
			s.dotFlat = 20 + 3 * L
			if L >= 10 then s.flat = 100 end
			if L >= 20 then s.dotPct = 80 end
			if L >= 40 then s.pct = 150 end
			if L >= 50 then
				s.fin = 130
				s.finBoss = 130
				s.bossAdd = 10 -- 킷 보스 티어(2026-09-19): 불독 10%
				s.ign = 50 -- 2티어 킷 방무 50(2026-09-24 사용자 "팬텀 제외 2티어 방무 통일" — 섀도어와 같은 50, 팬텀 60) — 인피니티
			end
			return s
		end
		if jobId == "bishop" then
			-- 엔젤레이 80%×1회×1마리(보통). 메디테이션 +50(L10), 아케인 에임 +20%(L40), 인피니티 최종 +30%(L50). 프레이(L30)는 파티 버프(여기 안 넣음)
			--   2026-09-19 밸런스 패치: 엔젤레이 30%×3회, 메디테이션 +100, 아케인 에임 +50%, 인피니티 최종 +20%, 제네시스 300%(스킬 표), 프레이 = 모든 유닛 최종 +10%(RtsUnitBuffLogic)
			local s = { pct = 100, flat = 0, ratio = 38, hits = 3, targets = 1, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = "보통", crit = self.BaseCritRate, critDmg = self.BaseCritDamage }
			if L >= 10 then s.flat = 100 end
			if L >= 40 then s.pct = 150 end
			if L >= 50 then
				s.fin = 120
				s.finBoss = 120
				s.bossAdd = 40 -- 킷 보스 티어(2026-09-19): 비숍 40%
			end
			return s
		end
		if jobId == "nl" then
			-- 쿼드러플 스로우 110%×4회×1마리(빠름). 자벨린 마스터리(10) 최종 +10%, 크리티컬 마스터리(20) 크확 +30·크뎀 +25, 쉐도우 파트너(30) 표창 +4개 ½(halfHits), 자벨린 마스터리(40) 최종 +10%·+100, 레디 투 다이(50) 최종 +20%
			--   킷 보스 티어 0%·공격력% 0(2026-09-19 사용자: 나이트로드는 증강 효율 최고). 최종 데미지는 곱(damage.md ⑥)
			local s = { pct = 100, flat = 0, ratio = 110, hits = 4, targets = 1, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = "빠름", crit = self.BaseCritRate, critDmg = self.BaseCritDamage }
			if L >= 10 then s.fin = s.fin * 1.10 end
			if L >= 20 then
				s.crit = s.crit + 30
				s.critDmg = s.critDmg + 25
			end
			if L >= 30 then s.halfHits = 4 end
			if L >= 40 then
				s.fin = s.fin * 1.10
				s.flat = 100
			end
			if L >= 50 then s.fin = s.fin * 1.20 end
			s.finBoss = s.fin
			return s
		end
		if jobId == "shad" then
			-- 새비지 블로우 17.5%×8회×1마리(매우빠름). 대거 마스터리(10) 공격력 +30%, 크리티컬 마스터리(20) 크확 +30·크뎀 +20, 대거 익스퍼트(40) 공격력 +20%·최종 +5%, 레디 투 다이(50) 최종 +20%·보스 +30%(킷 티어 4)
			local s = { pct = 100, flat = 0, ratio = 29.2, hits = 8, targets = 1, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = "매우빠름", crit = self.BaseCritRate, critDmg = self.BaseCritDamage }
			if L >= 10 then s.pct = 130 end
			if L >= 20 then
				s.crit = s.crit + 30
				s.critDmg = s.critDmg + 20
			end
			if L >= 40 then
				s.pct = s.pct + 20
				s.fin = s.fin * 1.05
			end
			if L >= 50 then
				s.fin = s.fin * 1.20
				s.bossAdd = 30 -- 킷 보스 티어(2026-09-19): 섀도어 30%
				-- 레디 투 다이: 보스 공격 시 새비지 블로우 +88%(⑤ st.bossRatio — 2026-09-24 사용자 "보스 최종 데미지는 없어, 스킬 데미지로 관리", 전 보스 최종 ×3.96, 50레벨 보스 1.5만), 방무 50
				s.bossRatio = 88
				s.ign = 50
			end
			s.finBoss = s.fin
			return s
		end
		if jobId == "phantom" then
			-- 조커 192.5%×1회×1마리, 공격속도 무관 0.1초(폭풍의 시처럼 period 고정; 2026-09-20 사용자 "0.1초당 1회, 데미지 반토막" — 385%·0.2초에서 DPS 동일). 문라이트(20)·프레이 오브 아리아(30) 각 +150·+10%, 케인 엑스퍼트(40) 최종 +10%,
			--   블스아이(50) 크확 +50·크뎀 +30·방무 100·보스 +60%(킷 티어 1 +10 포함)·최종 +20%. 조커: 날카로운 검(10)은 파티 버프(RtsUnitBuffLogic joker, 자신 포함)라 여기 안 넣음. 레벨업당 공격력 0
			local s = { pct = 100, flat = 0, ratio = 192.5, hits = 1, targets = 1, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = "매우빠름", period = 0.1, crit = self.BaseCritRate, critDmg = self.BaseCritDamage }
			if L >= 20 then
				s.flat = s.flat + 150
				s.pct = s.pct + 10
			end
			if L >= 30 then
				s.flat = s.flat + 150
				s.pct = s.pct + 10
			end
			if L >= 40 then s.fin = s.fin * 1.10 end
			if L >= 50 then
				s.crit = s.crit + 50
				s.critDmg = s.critDmg + 30
				s.ign = 60 -- 2026-09-23 사용자 "블스아이 방무 100 → 60%"
				s.bossAdd = 60
				-- 블스아이: 보스 공격 시 조커 +146%(⑤ st.bossRatio — 2026-09-24 사용자 "보스 최종 데미지는 없어, 스킬 데미지로 관리", 전 보스 최종 ×1.76, 팬텀 = 2티어 1등 4.4만)
				s.bossRatio = 143 -- 2026-09-24 사용자 "1티어 30장 · 2티어 8장이 권장 — 편차 줄이기": 그 장수에서 1티어 50만 · 2티어 8만(팬텀 8.8만)
				s.fin = s.fin * 1.20
			end
			s.finBoss = s.fin
			return s
		end
		-- 나머지 직업: 스킬표 등록 전 임시 계수(기본 공격 100%·1마리·1회, 직업 공격속도만 반영)
		local s = { pct = 100, flat = 0, ratio = 100, hits = 1, targets = 1, ign = 0, fin = 100, finBoss = 100, ignBoss = -1, speed = self:GetBaseSpeed(jobId), crit = self.BaseCritRate, critDmg = self.BaseCritDamage }
		return s
	end

	-- damage.md 7단계: ① 공격력(기본 + 성장 + 추가) → ② × 공격력%(합) → ③ × 보스 데미지 증가(합, 보스만) → ④ × 크리티컬(기대값 1 + 확률 × 크뎀)
	--   → ⑤ × 스킬 비율(1회 타격) → ⑥ × 최종 데미지(곱) → ⑦ 방어(표·팝업엔 없음). 보스 DPS = 1타 × 타격 수 ÷ 주기, 몬스터 DPS = × 타겟 수
	--   버프 없는 자기 능력치만. 파티 버프(홀리 유니티·샤프아이즈·프레이·조커)는 RtsUnitBuffLogic.ApplyToStat으로 st를 바꾼 뒤 CalcStat
	method table Calc(string jobId, number L)
		return self:CalcStat(jobId, L, self:GetStat(jobId, L))
	end

	method table CalcStat(string jobId, number L, table st)
		local base = self:GetBaseAttack(jobId)
		local per = self:GetAttackPerLevel(jobId)
		local atk = base + per * (L - 1) + st.flat
		local one = atk * (st.pct / 100) * (st.ratio / 100)
		local period = self:GetPeriod(st)
		local critMul = 1 + (st.crit / 100) * (st.critDmg / 100)
		local bossMul = 1 + (st.bossAdd or 0) / 100
		-- halfHits = 데미지 ½인 추가 타격(쉐도우 파트너 표창) — 타격 수에 0.5개씩 얹는다
		local hitsEff = st.hits + (st.halfHits or 0) * 0.5
		-- 보스 최종 데미지(st.finBoss — 킷·프리즘의 '보스 공격 시 최종 데미지'까지 곱)
		-- ⑤ 보스 공격 시 +n%(st.bossRatio — 1티어, 2026-09-24): 보스 1타 비율 = 비율 + n
		local bossRatioMul = 1
		if st.bossRatio ~= nil and st.bossRatio ~= 0 and st.ratio > 0 then bossRatioMul = (st.ratio + st.bossRatio) / st.ratio end
		local boss = one * hitsEff * bossMul * bossRatioMul * (st.finBoss / 100) * critMul / period
		local mob = one * hitsEff * st.targets * (st.fin / 100) * critMul / period
		return { st = st, base = base, per = per, atk = atk, one = one, period = period, critMul = critMul, boss = boss, mob = mob }
	end

	-- ===== 프리즘 증강(2026-09-22 개발모드 선행 — 정의·수치는 .info/character.md '종류: 프리즘', 규칙은 .beaver/memory/balance.md) =====
	--   유닛의 RtsUnitComponent.Prisms(쉼표 목록 "enrage,core…")에 든 id를 직업 표 위에 얹는다. GetSkillsFor/GetStatFor = GetSkills/GetStat의 유닛판 —
	--   전투(RtsCombatLogic)·팝업(RtsUnitPopupLogic)·연출(CastFx/HitFx)·잠금(RtsUnitLogic)은 전부 이걸 쓴다. locks = 획득 시 영구 잠금(3)할 스킬 이름(RtsUnitLogic.ApplyPrism).
	--   연출 자산이 아직 없는 프리즘은 기존 스킬 연출을 그대로 쓴다(사용자가 자산을 하나씩 고르면 교체) — 인레이지만 확보(2026-09-20)
	method table GetPrisms()
		return {
			{ id = "enrage", job = "hero", name = "인레이지", desc = "[프리즘] 레이징 블로우가 인레이지로 강화된다. 레이징 블로우의 데미지가 422% 증가하고, 사거리가 3으로, 공격 횟수가 3회로 늘어난다. 증강의 효율을 높인다." },
			{ id = "holyunity", job = "paladin", name = "홀리 유니티", desc = "[프리즘] 아군 유닛 1명을 지정해 그 유닛의 최종 데미지를 40% 증가시킨다. 자신에게는 사용할 수 없다." },
			{ id = "giant", job = "dk", name = "거대화", desc = "[프리즘] 스피어 버스터가 거대해진다. 사거리가 6으로 늘고 데미지가 29% 증가하는 대신 6회로 나눠 찌른다(1회 데미지 = 절반 + 654%). 일부 증강의 효율을 높인다." },
			{ id = "arrowrain", job = "bow", name = "애로우 레인", desc = "[프리즘] 폭풍의 시 대신 애로우 레인을 사용한다. 하늘에서 화살비를 내려 사거리 6 안의 적 1마리를 395%의 데미지로 2회 공격하며, 공격속도와 관계없이 0.2초마다 발사한다. 증강의 효율을 높인다.", locks = { "폭풍의 시" } },
			{ id = "truesnipe", job = "marks", name = "트루 스나이핑", desc = "[프리즘] 스나이핑 대신 트루 스나이핑을 사용한다. 사거리 6 안의 적 1마리를 719.7%의 데미지로 10회 공격하며, 반드시 크리티컬로 적중한다. 재사용 대기시간 2초. 일부 증강의 효율을 높인다.", locks = { "스나이핑" } }, -- 피어싱 영구 잠금 뺌(2026-09-23 사용자 "트루 스나이핑 → 피어싱 영구 잠금 빼자")
			{ id = "tempest", job = "il", name = "블리자드 템페스트", desc = "[프리즘] 블리자드의 재사용 대기시간이 2초로 줄고, 사거리 제한이 없어지며 공격 대상이 최대 30마리로 늘고 데미지가 1001%가 된다. 보스는 180%의 데미지로 30회 공격한다. 방어율 무시가 70% 증가한다. 증강의 효율을 높인다." }, -- 2026-09-23 엘릭서와 통합 · 2026-09-24 사용자 "1티어가 시너지화 → 썬콜 자체 시너지 없애고 방무로 쌔게": 방어율 감소·보스 최종 −47% 삭제, 방무 15 → 70
			{ id = "transcend", job = "fp", name = "초월", desc = "[프리즘] 도트 퍼니셔가 초월한다. 구체가 60개로 늘고 구체와 폭발이 2배로 커지며, 재사용 대기시간이 3초로 줄어든다. 구체의 데미지는 314%가 된다. 일부 증강의 효율을 높인다." },
			{ id = "divinepunish", job = "bishop", name = "디바인 퍼니시먼트", desc = "[프리즘] 엔젤레이 대신 디바인 퍼니시먼트를 사용한다. 빛의 검을 내려 사거리 3 안의 적을 최대 6마리까지 49%의 데미지로 공격하며, 공격속도와 관계없이 0.2초마다 발동한다. 맞은 적은 3초 동안 받는 데미지가 20% 증가한다.", locks = { "엔젤레이" } },
			{ id = "fuma", job = "nl", name = "풍마수리검", desc = "[프리즘] 쿼드러플 스로우 대신 거대한 풍마수리검을 던진다. 사거리 3 안의 적 1마리를 377%의 데미지로 4회 공격하며, 30레벨부터는 쉐도우 파트너도 함께 던진다. 방어율 무시가 70% 증가한다. 증강의 효율을 높인다.", locks = { "쿼드러플 스로우" } },
			{ id = "dualblade", job = "shad", name = "자유전직 - 듀얼블레이더", desc = "[프리즘] 듀얼블레이더로 전직한다. 새비지 블로우와 메소 익스플로전 대신 블레이드 토네이도와 카르마 퓨리를 함께 사용한다. 크리티컬 확률이 40%, 크리티컬 데미지가 80% 증가하며, 일부 증강의 효율을 높인다.", locks = { "새비지 블로우", "메소 익스플로전" } },
			{ id = "phantom", job = "", name = "영웅 팬텀", desc = "팬텀 영입 해금. 팬텀은 증강의 효율이 높다." }, -- 2026-09-24 사용자(RtsJobTableLogic.AugMulFor)
		}
	end

	method any GetPrism(string id)
		local list = self:GetPrisms()
		for i = 1, #list do
			if list[i].id == id then return list[i] end
		end
		return nil
	end

	-- 유닛이 자기 직업 프리즘(인레이지·풍마수리검·템페스트·애로우 레인·듀얼블레이더·트루 스나이핑·거대화·초월·홀리 유니티·디바인 퍼니시먼트)을 가졌는가 — 증강 효과 배율 조건(AugMulFor)
	method boolean HasOwnPrism(any u)
		local ids = self:PrismIds(u)
		for i = 1, #ids do
			local d = self:GetPrism(ids[i])
			if d ~= nil and d.job == u.JobId then return true end
		end
		return false
	end

	-- 유닛이 프리즘 id를 가졌는가
	method boolean HasPrism(any u, string id)
		if u == nil or u.Prisms == nil or u.Prisms == "" then return false end
		for q in string.gmatch(u.Prisms, "[^,]+") do
			if q == id then return true end
		end
		return false
	end

	-- 직업 티어(2026-09-24 사용자 — .info/tier.md): 1 히어로·나이트로드·썬콜·보우마스터(보우 = 같은 날 2 → 1) /
	--   2 섀도어·팬텀·불독·신궁·다크나이트(불독·신궁·다크 = 같은 날 3 → 2, 3티어 없음) / 4 팔라딘·비숍(서포터)
	-- ===== 영입 상세(2026-09-25 사용자 "유닛 기본 외형 + 강점·약점 오각형 + 스킬 목록" — 직업 설명 문구는 같은 날 빼기로) =====

	-- 기본 공격 사거리(레벨 L): 전투와 같은 규칙(RtsCombatLogic — 획득한 쿨 없는 액티브 중 뒤의 것, 레벨 강화 st.range가 있으면 그것, 없으면 스킬 range, 그것도 없으면 2)
	method number BasicRange(string jobId, number L)
		local st = self:GetStat(jobId, L)
		local skills = self:GetSkills(jobId)
		for i = #skills, 1, -1 do
			local k = skills[i]
			if k.kind == "액티브" and k.fx ~= nil and k.cd == nil and L >= (k.lv or 1) then
				if st.range ~= nil then return st.range end
				return k.range or 2
			end
		end
		return st.range or 2
	end

	-- 오각형 5축 단계(5 매우 높음 … 1 매우 낮음, 50레벨 · 증강 없음 · 전체 직업 중 비교 — 2026-09-25 사용자):
	--   speed = 기본 공격 속도 이름 / range = 기본 공격 사거리 ÷ 전체 최댓값 → 80·60·40·20% / aug = 증강 효율(1티어 5 · 팬텀 4 · 2티어 3 · 서포터 1, '낮음'은 비움 — 화면엔 티어 말 금지)
	--   boss·hunt = tools/balance-calc.py --radar(2026-09-25: 보스 = 50레벨 + 자기 프리즘 + 마지막 보스 전 카드 43장을 3택1 최선으로 몰아준 보스 DPS, 사냥 = 50레벨·증강 없음 40마리 사냥 DPS) — 직업 수치가 바뀌면 다시 돌려 옮긴다
	method table GetRadar(string jobId)
		local fixed = {
			hero = { boss = 4, hunt = 5 },
			paladin = { boss = 1, hunt = 2 },
			dk = { boss = 1, hunt = 3 },
			bow = { boss = 5, hunt = 1 },
			marks = { boss = 2, hunt = 4 },
			il = { boss = 4, hunt = 3 },
			fp = { boss = 2, hunt = 1 },
			bishop = { boss = 1, hunt = 1 },
			nl = { boss = 5, hunt = 1 },
			shad = { boss = 2, hunt = 1 },
			phantom = { boss = 3, hunt = 2 },
		}
		local f = fixed[jobId] or { boss = 1, hunt = 1 }
		local sp = self:GetStat(jobId, 50).speed or "보통"
		local speed = 3
		if sp == "매우빠름" then speed = 5 elseif sp == "빠름" then speed = 4 elseif sp == "느림" then speed = 2 elseif sp == "매우느림" then speed = 1 end
		local maxR = 1
		local ids = self:GetJobIds()
		for i = 1, #ids do maxR = math.max(maxR, self:BasicRange(ids[i], 50)) end
		local range = self:RatioLevel(self:BasicRange(jobId, 50) / maxR)
		local aug = 3
		local tier = self:TierOf(jobId)
		if jobId == "phantom" then aug = 4 elseif tier == 1 then aug = 5 elseif tier >= 4 then aug = 1 end
		return { speed = speed, range = range, aug = aug, boss = f.boss, hunt = f.hunt }
	end

	-- 비율(0~1, 전체 최댓값 대비) → 단계: 80% 이상 5 · 60% 4 · 40% 3 · 20% 2 · 그 아래 1(tools/balance-calc.py radar_level과 같은 경계)
	method number RatioLevel(number ratio)
		if ratio >= 0.8 then return 5 end
		if ratio >= 0.6 then return 4 end
		if ratio >= 0.4 then return 3 end
		if ratio >= 0.2 then return 2 end
		return 1
	end

	method number TierOf(string jobId)
		if jobId == "hero" or jobId == "nl" or jobId == "il" or jobId == "bow" then return 1 end
		if jobId == "shad" or jobId == "phantom" or jobId == "fp" or jobId == "marks" or jobId == "dk" then return 2 end
		return 4
	end

	-- 이 유닛에 적용된 증강 개수 = 브론즈~골드·특수 코어(Augs) + 직업 프리즘(Prisms). 팬텀 영입(잠금 해제)은 유닛에 안 붙어 빠진다 — 방어구 부수기(아래 ArmorBreakFor)
	method number AugCountOf(any u)
		local n = 0
		if u == nil then return 0 end
		if u.Augs ~= nil then
			for q in string.gmatch(u.Augs, "[^,]+") do n = n + 1 end
		end
		if u.Prisms ~= nil then
			for q in string.gmatch(u.Prisms, "[^,]+") do n = n + 1 end
		end
		return n
	end

	-- 방어구 부수기(2026-09-24 사용자 "1티어의 증강은 파티원에게 주는 게 아니라 보스를 약화시키는 디버프로 — 이름 방어구 부수기"):
	--   1티어 유닛의 증강 개수 × ArmorBreakPer = 그 구역 보스 방어율 감소(%p), 최대 ArmorBreakCap개. 1티어가 여럿이면 가장 큰 1기만(중복 없음 — 서버 RtsCombatLogic.ArmorBreak · 클라 RtsMonsterInfoLogic.ArmorBreakOf가 최댓값)
	--   상한 30 = .info/tier.md 클리어 조건 5의 1티어 몫(골드 I 환산 30장). damage.md ⑧ 방어(합연산 — 가드 크러쉬처럼 뺀다)
	property number ArmorBreakCap = 30

	property number ArmorBreakPer = 1

	-- 1티어 증강 효과 최대 배율(증강 ArmorBreakCap개 = 30개일 때) — AugMulFor
	property number T1AugMulMax = 3

	method number ArmorBreakFor(any u)
		if u == nil or self:TierOf(u.JobId) ~= 1 then return 0 end
		-- 자기 직업 프리즘이 있어야 켜진다(2026-09-24 사용자 "프리즘도 없는데 왜 자꾸 뜨냐" — 증강 배율 AugMulFor와 같은 조건, 전엔 빠져 있었다)
		if not self:HasOwnPrism(u) then return 0 end
		local n = self:AugCountOf(u)
		if n > self.ArmorBreakCap then n = self.ArmorBreakCap end
		return n * self.ArmorBreakPer
	end

	-- 프리즘 증강 효율 버프(2026-09-25 사용자 "프리즘 코어의 증강 효율 증가가 버프 창에 — 증강이 얼마나 오르는지, 증강으로 오른 수치 +얼마"):
	--   프리즘 설명은 "증강의 효율을 높인다 / 일부 증강의 효율을 높인다"로만 쓰고, 실제 수치는 캐릭터 상세 '적용 중인 버프' 탭 맨 위 줄(RtsUnitPopupLogic.BuildBuffTabFor)에.
	--   증강 효과 배율(AugMulFor)이 켜진 유닛만 — 자기 직업 프리즘이 있는 1티어(증강 0개면 +0%)·2티어, 팬텀. 없으면 nil
	--   { name = 프리즘 이름(팬텀은 "영웅 팬텀"), eff = 설명 문장("크리티컬 확률·크리티컬 데미지 증강 효과가 100% 증가한다." — 2026-09-25 사용자 "버프 칸엔 이런 식으로"),
	--     gains = 배율 덕분에 더 오른 몫을 능력치마다 한 줄씩 { "공격력 +40", "크리티컬 데미지 +12%" }(빈 표 = 아직 없음 — 사용자 "증강으로 이득 본 수치 총합을 각각") }
	method any PrismAugBuff(any u)
		if u == nil then return nil end
		local m = self:AugMulFor(u)
		local keys = { "atk", "pct", "boss", "crit", "critDmg" }
		local label = { atk = "공격력", pct = "공격력%", boss = "보스 공격 시 데미지", crit = "크리티컬 확률", critDmg = "크리티컬 데미지" }
		local on = {}
		local same = true
		for i = 1, #keys do
			local x = m[keys[i]] or 1
			if x ~= 1 then on[#on + 1] = keys[i] end
			if math.abs(x - (m[keys[1]] or 1)) > 0.0001 then same = false end
		end
		local tier1 = self:TierOf(u.JobId) == 1 and self:HasOwnPrism(u)
		if #on == 0 and not tier1 then return nil end
		local name = "프리즘"
		if u.JobId == "phantom" then
			name = "영웅 팬텀"
		else
			local ids = self:PrismIds(u)
			for i = 1, #ids do
				local d = self:GetPrism(ids[i])
				if d ~= nil and d.job == u.JobId then name = d.name end
			end
		end
		local up = 0
		if #on > 0 then up = (m[on[1]] - 1) * 100 end
		local upText = string.format("%d", math.floor(up + 0.5)) .. "%"
		local eff = "모든 능력치 증강 효과가 " .. upText .. " 증가한다."
		if tier1 then
			local per = (self.T1AugMulMax - 1) * 100 / self.ArmorBreakCap
			eff = "능력치 증강 효과가 " .. upText .. " 증가한다(가진 증강 1개당 " .. string.format("%.1f", per) .. "%, " .. string.format("%d", self.ArmorBreakCap) .. "개에서 " .. string.format("%d", math.floor((self.T1AugMulMax - 1) * 100 + 0.5)) .. "%)."
		elseif #on > 0 and not same then
			local ns = {}
			for i = 1, #on do ns[#ns + 1] = label[on[i]] end
			eff = table.concat(ns, "·") .. " 증강 효과가 " .. upText .. " 증가한다."
		end
		local A = _RtsAugmentTableLogic
		local t1 = A:TotalsMul(u.Augs, m)
		local t0 = A:TotalsMul(u.Augs, nil)
		local parts = {}
		local function add(text, v, unit)
			if v >= 0.5 then parts[#parts + 1] = text .. " +" .. string.format("%d", math.floor(v + 0.5)) .. unit end
		end
		add("공격력", t1.atk - t0.atk, "")
		add("공격력", t1.pct - t0.pct, "%")
		add("보스 공격 시 데미지", t1.boss - t0.boss, "%")
		add("크리티컬 확률", t1.crit - t0.crit, "%")
		add("크리티컬 데미지", t1.critDmg - t0.critDmg, "%")
		return { name = name, eff = eff, gains = parts }
	end

	-- 증강 효과 배율 (2026-09-24 티어 재설계 — .info/tier.md, 값 = tools/balance-calc.py TUNE):
	--   1티어(히어로·나이트로드·썬콜·보우) 모든 증강 ×(1 + 2 × 증강 수 ÷ 30), 30개에서 ×3(사용자 "1장 1.1배, 2장 1.2배 … 30장 3.0배 — 1티어는 1명에게 몰아주는 게 좋구나 하게") —
	--     그 1티어가 가진 증강 수(AugCountOf, 방어구 부수기와 같은 개수·같은 상한 ArmorBreakCap)가 늘면 이미 받은 증강까지 다 같이 세진다 /
	--   2티어는 약점 증강만 ×2(사용자 "2티어에는 약점 증강만 효율 2배") — 그 직업 프리즘이 있을 때(사용자 "프리즘에 부족한 부분의 증강 효율 2배"):
	--   섀도어 공격력 · 불독 크확·크뎀 · 신궁 공격력·크뎀 · 다크 크확·크뎀. 팬텀은 밸런스형 2티어 1등 — 모든 증강 ×1.75(사용자 "팬텀은 1.75배 받자, 2티어 중 1등")
	--   브론즈~골드 증강에만(RtsAugmentTableLogic.MulOf — 특수 코어 제외)
	method table AugMulFor(any u)
		local m = { crit = 1, critDmg = 1, atk = 1, pct = 1, boss = 1 }
		if u == nil then return m end
		local all = 1
		-- 1티어 배율은 자기 직업 프리즘이 있을 때만(2026-09-24 사용자 "1티어·2티어 증강 효과는 프리즘이 붙은 경우 — 프리즘 없이 증강 효과가 늘면 안 돼")
		if self:TierOf(u.JobId) == 1 and self:HasOwnPrism(u) then
			local n = self:AugCountOf(u)
			if n > self.ArmorBreakCap then n = self.ArmorBreakCap end
			all = 1 + (self.T1AugMulMax - 1) * n / self.ArmorBreakCap
		elseif u.JobId == "phantom" then
			all = 1.75
		end
		if all ~= 1 then return { crit = all, critDmg = all, atk = all, pct = all, boss = all } end
		if u.JobId == "shad" and self:HasPrism(u, "dualblade") then m.atk = 2 end
		if u.JobId == "fp" and self:HasPrism(u, "transcend") then
			m.crit = 2
			m.critDmg = 2
		end
		if u.JobId == "marks" and self:HasPrism(u, "truesnipe") then
			m.atk = 2
			m.critDmg = 2
		end
		if u.JobId == "dk" and self:HasPrism(u, "giant") then
			m.crit = 2
			m.critDmg = 2
		end
		return m
	end

	method table PrismIds(any u)
		local out = {}
		if u == nil or u.Prisms == nil then return out end
		for q in string.gmatch(u.Prisms, "[^,]+") do out[#out + 1] = q end
		return out
	end

	method number FindSkill(table list, string name)
		for i = 1, #list do
			if list[i].name == name then return i end
		end
		return 0
	end

	method table CopyTable(table t)
		local c = {}
		for k, v in pairs(t) do c[k] = v end
		return c
	end

	-- 프리즘 id의 대체 스킬(prism = true)을 쓸 수 있는 레벨 — 그 레벨 전엔 프리즘의 영구 잠금(locks)을 걸지 않는다(RtsUnitLogic.SyncPrismLocks). 대체 스킬이 없으면 1
	--   2026-09-23 사용자 "모든 프리즘에 레벨 제한 50 제거 — 트루 스나이핑 50이라 못 쓰는 게 너무 패널티": 대체 스킬·홀리 유니티 lv 50 → 1(받는 즉시). 블리자드·도트 퍼니셔를 바꾸는 템페스트·초월은 그 스킬(30레벨)을 따르다가 2026-09-24 사용자 "프리즘 레벨 제한 다 없애야" → 이것도 1
	method number PrismLockLevel(string id, string jobId)
		local list = self:GetSkills(jobId)
		self:ApplyPrismSkills(id, list, jobId)
		local lv = 0
		for i = 1, #list do
			if list[i].prism == true and (lv == 0 or list[i].lv < lv) then lv = list[i].lv end
		end
		if lv == 0 then lv = 1 end
		return lv
	end

	-- 직업 표 + 이 유닛의 프리즘(전투·팝업·연출·잠금이 쓰는 표)
	method table GetSkillsFor(any u)
		local list = self:GetSkills(u.JobId)
		local ids = self:PrismIds(u)
		for i = 1, #ids do self:ApplyPrismSkills(ids[i], list, u.JobId) end
		return list
	end

	-- 클라: 이 직업의 스킬 연출을 프리즘 변형까지 전부 미리 올린다(유닛이 생길 때). 프리즘을 켠 뒤 첫 시전이 자산 다운로드 중이라 표식·클립이 빈 채로 나오던 문제
	--   (2026-09-22 사용자 "엘릭서+템페스트 동시에 켰는데 계속 적용 안 되다가 껐다 켜니 정상" — 서버 표는 맞았고 tile 9종×21프레임이 아직 안 내려온 것)
	@ExecSpace("ClientOnly")
	method void PreloadJobFx(string jobId)
		local base = self:GetSkills(jobId)
		for i = 1, #base do
			if base[i].fx ~= nil then _RtsSkillFxLogic:Preload(base[i].fx) end
		end
		local prisms = self:GetPrisms()
		for j = 1, #prisms do
			if prisms[j].job == jobId then
				local list = self:GetSkills(jobId)
				self:ApplyPrismSkills(prisms[j].id, list, jobId)
				for i = 1, #list do
					if list[i].fx ~= nil then _RtsSkillFxLogic:Preload(list[i].fx) end
				end
			end
		end
	end

	-- 방어율 무시 합산(2026-09-24 사용자 "합연산 + 증강 방무 삭제" — 곱연산에서 되돌림): 방무 출처(직업 킷·프리즘)를 그대로 더한다
	method void AddIgn(table st, number x)
		st.ign = (st.ign or 0) + x
	end

	method table GetStatFor(any u)
		local st = self:GetStat(u.JobId, u.Level)
		local ids = self:PrismIds(u)
		for i = 1, #ids do self:ApplyPrismStat(ids[i], st, u.JobId) end
		-- 블리자드 템페스트 방무 +70(2026-09-24 사용자 "썬콜 시너지 대신 방무로 쌔게" — 히어로·나이트로드와 같은 70, 전 +15)
		if self:HasPrism(u, "tempest") then self:AddIgn(st, 70) end
		-- 지정된 브론즈~골드·특수 코어 증강(RtsUnitComponent.Augs) — 합연산, 일격필살만 최종 곱(2026-09-23). 증강 효율(AugEff)은 2026-09-24 사용자 결정으로 삭제 — 모든 직업 수치 그대로
		-- 증강 효과 배율(AugMulFor — 1티어 증강 수에 따라 최대 ×3 · 팬텀 ×1.75 · 2티어 약점 ×2)
		if u.Augs ~= nil and u.Augs ~= "" then _RtsAugmentTableLogic:ApplyToStatMul(st, u.Augs, self:AugMulFor(u)) end
		return st
	end

	-- 프리즘으로 직업 이름이 바뀌는 경우(자유전직 → 듀얼블레이더, 2026-09-22 사용자 "듀얼블레이드 → 듀얼블레이더")
	method string GetJobNameFor(any u)
		if self:HasPrism(u, "dualblade") then return "듀얼블레이더" end
		return self:GetJobName(u.JobId)
	end

	method void ApplyPrismSkills(string id, table list, string jobId)
		if id == "enrage" then
			local i = self:FindSkill(list, "레이징 블로우")
			if i > 0 then
				local k = self:CopyTable(list[i])
				k.desc = "사거리 3 안의 적을 최대 3마리까지 562%의 데미지로 3회 공격한다. 40레벨부터는 최대 6마리까지 712%의 데미지로 공격한다. (인레이지)"
				k.range = 3
				-- 인레이지판 연출(character.md 히어로 인레이지): 1120017/effect/2 + 추출 사운드 + hit/0. 원화 인레이지 7장 전용 액션, 타격은 0.30/0.50/0.70초 유지
				k.fx = { motion = "enragedRagingBlow", motionRate = 0.58, hideWeapon = true, hideWeaponSec = 0.85, clip = "71d8513c51fc48c49609837f3d15160b", clipDelay = 0, scale = 2.0, feetDx = 0, feetDy = 0, assetFacesLeft = true, sound = "e794c1382f484195bae36f1b93c9f060",
					hitDelay = 0.3, hitGap = 0.2, hitClip = "b79cbdf6d06b487382f03d625a1fc464", hitScale = 2.0, hitDy = 0.6 }
				list[i] = k
			end
		elseif id == "holyunity" then
			list[#list + 1] = { lv = 1, kind = "패시브", name = "홀리 유니티", desc = "프리즘. 유닛 1개 지정 — 그 유닛의 최종 데미지 +40%", target = true }
		elseif id == "giant" then
			local i = self:FindSkill(list, "스피어 버스터")
			if i > 0 then
				local k = self:CopyTable(list[i])
				k.range = 6
				k.desc = "사거리 6 안의 적을 최대 3마리까지 6회 공격한다. 1회 데미지는 (스피어 버스터 데미지 + 29%) ÷ 2 + 654%이다(40레벨부터 758.5%). (거대화)"
				-- 거대화 6타 연출(2026-09-23 사용자 "찌르기 이펙트도 6번 따르르륵"): 타격 0.075초 간격, 찌르기 클립 3개를 0.075초 늦춰 한 번씩 더(0.6~0.975초), 용 날개 1.2초까지
				-- 거대화 = 창이 3배(사용자 2026-09-22): 시전 클립·추가 클립 스케일 ×3(타격 클립은 그대로). 원점이 발이라 발판 위치는 같다
				local fx = self:CopyTable(k.fx)
				fx.scale = (fx.scale or 1) * 3
				if fx.clips ~= nil then
					local cl = {}
					for c = 1, #fx.clips do
						local it = fx.clips[c]
						if type(it) == "table" then
							local t = self:CopyTable(it)
							t.scale = (t.scale or fx.scale / 3) * 3
							cl[c] = t
						else
							cl[c] = it
						end
					end
					-- 6타: 찌르기 클립(2~4번째)을 0.075초 늦춰 한 번씩 더
					for c = 2, 4 do
						local it = fx.clips[c]
						if it ~= nil and type(it) ~= "table" then cl[#cl + 1] = { it, delay = 0.075, scale = fx.scale } end
					end
					fx.clips = cl
				end
				fx.hitGap = 0.075
				fx.clipLife = 1.2 -- 날개도 6타 끝(약 1.1초)까지
				k.fx = fx
				list[i] = k
			end
		elseif id == "arrowrain" then
			-- 애로우 레인 연출(2026-09-22 사용자 "사운드는 폭풍의 시 그대로, 발사 애니메이션 등은 교체"): 원작 400031002 —
			--   공격 시작에 effect(황금 날개 활 소환 → 발사, 15프레임 0.84초, 좌우 대칭) 0~12프레임(0.72초, loopIntro) → 공격 중 같은 effect 클립의 4~12프레임(큰 활 + 화살) 루프(loopFrameA/B). repeat 클립(f7b71339…, 188px)은 작아서 미채택(사용자).
			--   화살은 손에서 쏘지 않고 대상 머리 위 4칸에서 수직 낙하(projFrom "sky", ±0.5 흩어짐, 0.2초 비행 = hitDelay). 타격 클립은 폭풍의 시 것(400031002에는 hit 클립이 없음).
			--   소리(2026-09-22 사용자 "좀 더 임팩트 있게"): 활 소환 순간 원작 400031002/use(1.9초) 1회(loopIntroSound), 발마다 시전음은 폭풍의 시 것, 타격음은 400030002/loop 46a9fd9a…를 피치 1.5로 빨리 감기(hitSoundPitch — 사용자 선택)
			local i = self:FindSkill(list, "폭풍의 시")
			local fx = nil
			if i > 0 and list[i].fx ~= nil then
				fx = self:CopyTable(list[i].fx)
				-- 루프 = effect 클립(활 소환)의 큰 활 구간 4~12프레임을 반복(2026-09-22 사용자 "첫 애니메이션만 크고 이후는 작아진다 — 처음의 큰 애니메이션이 계속 유지되어야"). 전엔 repeat 클립(188px)이라 작아 보였다
				--   인트로는 같은 클립 0~12프레임(등장 → 큰 활, 0.72초)까지만 보이고 루프로 이어진다(13~14 소멸 프레임은 안 보임)
				fx.loopClip = "586154fb11a4489a88e78f3d2a028884"
				fx.loopFrameA = 4
				fx.loopFrameB = 12
				fx.loopScale = 1.1
				fx.loopDx = 0
				fx.loopDy = 1.1
				fx.loopAlpha = 1
				fx.loopFacesLeft = nil
				fx.loopIntro = "586154fb11a4489a88e78f3d2a028884"
				fx.loopIntroScale = 1.1
				fx.loopIntroDy = 0
				fx.loopIntroLife = 0.72
				fx.loopIntroSound = "6b7b47d8bf6441918bc73fdb02a2d542"
				-- 타격음(2026-09-22 사용자 "46a9fd9a… 이 소리로. 좀 더 빨리 감으면 될 듯"): 400030002/loop 0.97초를 피치 1.5(≈0.65초)로
				fx.hitSound = "46a9fd9aeb454108857aa9642fc7b91f"
				fx.hitSoundPitch = 1.5
				fx.projFrom = "sky"
				fx.projSkyHeight = 4
				fx.projSkySpread = 0.5
				fx.projSec = 0.2
				fx.hitDelay = 0.2
			end
			list[#list + 1] = { lv = 1, kind = "액티브", prism = true, name = "애로우 레인", desc = "폭풍의 시 대신 애로우 레인을 사용한다. 하늘에서 화살비를 내려 사거리 6 안의 적 1마리를 395%의 데미지로 2회 공격하며, 공격속도와 관계없이 0.2초마다 발사한다. 증강의 효율을 높인다.", target = false, range = 6, fx = fx }
		elseif id == "truesnipe" then
			-- 트루 스나이핑 연출(2026-09-22 사용자 skillname#400031006): 원작 400031006에는 special(조준 십자선 7프레임 0.84초 — 잠금 3 → 발사 섬광 → 원 확산)과 use 소리만 있다.
			--   스나이핑 fx를 복사해 표식만 십자선(markClip, 박스 긴 쪽 × 0.45, 0.85초)으로, 시전음은 400031006/use(1.44초), 타격은 섬광 프레임(0.36초)에 맞춰 0.05초 간격 10회·타격 클립 스케일 2.0. 모션·시전 이펙트·타격 클립·타격음은 스나이핑 것
			local i = self:FindSkill(list, "스나이핑")
			local fx = nil
			if i > 0 and list[i].fx ~= nil then
				fx = self:CopyTable(list[i].fx)
				fx.markClip = "64224b19c0aa4359963ab551d5862cfd"
				fx.markFit = 0.45
				fx.markPivotDy = 0
				fx.markLife = 0.85
				fx.sound = "1fa8bbf7adfd40c4a4709c110b9033be"
				fx.hitDelay = 0.36
				fx.hitGap = 0.05
				fx.hitScale = 2.0
			end
			list[#list + 1] = { lv = 1, kind = "액티브", prism = true, name = "트루 스나이핑", desc = "스나이핑 대신 트루 스나이핑을 사용한다. 사거리 6 안의 적 1마리를 719.7%의 데미지로 10회 공격하며, 반드시 크리티컬로 적중한다. 재사용 대기시간 2초.", target = false, cd = 2, ratio = 719.7, hits = 10, targets = 1, range = 6, forceCrit = true, fx = fx }
		elseif id == "tempest" then
			-- 기본 블리자드와 같은 1.80초 모션·후딜, 2초 쿨타임. 낙하·판정 간격도 0.6배로 압축한다.
			local i = self:FindSkill(list, "블리자드")
			if i > 0 then
				local k = self:CopyTable(list[i])
				-- 프리즘 레벨 제한 없음(2026-09-24 사용자 "캐릭터들 프리즘 레벨 제한 다 없애야") — 블리자드 원래 30레벨 → 받는 즉시(1)
				k.lv = 1
				k.prism = true
				k.cd = 2 -- 구 엘릭서(2026-09-23 템페스트에 통합)
				k.ratio = 1001 -- 965 + 36(⑤ 모든 대상 — 2026-09-24 사용자 "프리즘 증강의 보스 +n%를 빼고 스킬 데미지로 통합 — 일반 라운드도 밀게"(보스 딜 같음)) / 보스 공격 시 +36%(⑤) — 2026-09-24 사용자 "1티어 30장 · 2티어 8장이 권장 — 편차 줄이기": 그 장수에서 1티어 50만 · 2티어 8만(팬텀 8.8만)
				-- 2026-09-26 사용자 "템페스트 배우면 일반 몬스터 15 → 30, 보스도 30회 — 화려해야 볼 맛 나지, 지금보다 조금 세져도 괜찮아":
				--   일반 몬스터 = 최대 30마리 각 1회(1마리당 1001% × 일반 몬스터 2배 그대로) / 보스 = 30회 × 1회 180%(⑤ 보스 공격 시 180 − 1001%p) = 시전당 5,400%.
				--   같은 날 1차 330%(시전당 9,900%) → 사용자 "보스전 40만 후반~50만 초반으로 너프 — 보스분만 빼면 됨": 50레벨 증강 27장 전부 몰아준 최고점 평균 91.3만 → 49.7만(tools/balance-calc.py 기준).
				--   대상이 전부 보스면 30회를 보스들에게 번갈아(아이온·얄다바오트 2체면 15회씩 — RtsCombatLogic). 값 = tools/balance-calc.py TUNE sun_BH·sun_BT
				k.targets = 30
				k.zoneWide = true -- 사거리 제한 없음(구역 전체가 후보 — RtsCombatLogic, 2026-09-26 사용자 "템페스트일 때만")
