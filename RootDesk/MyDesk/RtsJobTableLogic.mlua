			local acc = 0
			for h = 1, 117 do
				acc = acc + 45 / 117
				if acc >= 1 then
					acc = acc - 1
					hr[h] = 17
					kinds[h] = 2
				else
					hr[h] = 13
					kinds[h] = 1
				end
			end
			fx.hitKinds = kinds
			list[#list + 1] = { lv = 50, kind = "액티브", prism = true, name = "블레이드 토네이도 + 카르마 퓨리", desc = "검의 폭풍과 카르마 퓨리를 동시에 날려 사거리 3 안의 적 1마리를 13%의 데미지로 72회, 17%의 데미지로 45회 공격한다. 재사용 대기시간 5초 (코드는 두 스킬을 한 행 '블레이드 토네이도 + 카르마 퓨리'로 표시 — RtsJobTableLogic ApplyPrismSkills dualblade)", target = false, cd = 5, ratio = 13, hits = 117, hitRatios = hr, targets = 1, range = 3, fx = fx }
		end
	end

	-- 능력치 쪽 변화(기본 공격 비율·타격·주기·사거리, 보스 공격시 데미지 합연산 풀)
	method void ApplyPrismStat(string id, table st, string jobId)
		if id == "enrage" then
			st.hits = 3
			st.range = 3
			st.bossAdd = (st.bossAdd or 0) + 200
		elseif id == "giant" then
			st.ratio = st.ratio + 29
			st.range = 6
			st.bossAdd = (st.bossAdd or 0) + 185
		elseif id == "arrowrain" then
			st.ratio = 54
			st.hits = 2
			st.period = 0.2
			st.range = 6
			st.bossAdd = (st.bossAdd or 0) + 220
		elseif id == "truesnipe" then
			st.bossAdd = (st.bossAdd or 0) + 135
		elseif id == "transcend" then
			st.bossAdd = (st.bossAdd or 0) + 250 -- 2026-09-22 사용자 "보스 데미지 증가 250% 넣고 그만큼 스킬 데미지 빼자"(구체 비율 918 → 281, ApplyPrismSkills)
		elseif id == "divinepunish" then
			st.ratio = 27
			st.hits = 1
			st.period = 0.2
			st.range = 3
			st.targets = 6 -- 2026-09-22 사용자 "몬스터 타겟 수 6으로"
			st.bossAdd = (st.bossAdd or 0) + 1350
		elseif id == "fuma" then
			st.ratio = st.ratio + 20
			st.range = 3 -- 2026-09-22 사용자 "사거리 1 추가"(쿼드러플 스로우 2 → 3). 쿨 없는 스킬은 st.range가 우선이라 여기서
			st.bossAdd = (st.bossAdd or 0) + 360
		elseif id == "dualblade" then
			st.bossAdd = (st.bossAdd or 0) + 1150
		end
	end

end
