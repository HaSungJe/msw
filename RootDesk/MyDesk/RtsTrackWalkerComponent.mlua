-- rts-base: 트랙 위를 등속으로 도는 이동체 (2026-09-14 프로토타입 → Phase 6·7 웨이브·보스)
--   t(0=S, 1=E)를 속도/트랙 길이만큼 올리며 RtsZoneLogic.GetTrackPoint로 위치를 잡는다. 일반 몹은 E에 닿으면 S로 순간이동(Loop).
--   서버가 움직이고 위치는 동기화. 보관(보스 스테이지) 중엔 Paused로 멈춘다.
--   보스는 트랙을 걷지 않는다(2026-09-23 — RtsBossLogic.SpawnBoss가 보스 영역에 Paused로 세운다).
@Component
script RtsTrackWalkerComponent extends Component

	property number Zone = 1

	property number T = 0

	-- 속도 수치(100 = 기준 속도, RtsConfigLogic.SpeedUnitPerSec). 몹 속도는 전부 동일(로드맵)
	property number Speed = 100

	property boolean Loop = true

	property number Facing = -1

	property boolean Paused = false

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 보관(Paused) · 게임 일시정지(RtsStageLogic.Paused, 2026-09-25) 중엔 멈춤
		if self.Paused or _RtsStageLogic.Paused then return end
		local m = self.Entity.RtsMonsterComponent
		if m ~= nil and m.Dead then return end
		local len = _RtsZoneLogic:GetTrackLength()
		if len <= 0 then return end
		local before = _RtsZoneLogic:GetTrackPoint(self.Zone, self.T)
		local spd = self.Speed
		-- 빙결(블리자드) 중이면 이동속도 × RtsMonsterComponent.FreezeSlow(0.5) — 보스는 빙결이 안 걸린다(RtsMonsterComponent.Freeze)
		if m ~= nil and m:IsFrozenNow() then spd = spd * m.FreezeSlow end
		local ups = _RtsConfigLogic:SpeedToUnitsPerSec(spd)
		-- 배속(2026-09-27 — RtsStageLogic.RealSpeed, 진행 중 2배속이면 두 배로 걷는다)
		self.T = self.T + ups * delta * _RtsStageLogic:RealSpeed() / len
		if self.T >= 1 then
			if self.Loop then
				self.T = self.T - 1
				before = _RtsZoneLogic:GetTrackPoint(self.Zone, self.T)
			else
				self.T = 1
			end
		end
		local p = _RtsZoneLogic:GetTrackPoint(self.Zone, self.T)
		self.Entity.TransformComponent.WorldPosition = Vector3(p.x, p.y, 0)
		-- 몬스터 스프라이트는 기본이 왼쪽 보기 → 오른쪽으로 갈 때 뒤집는다
		local dx = p.x - before.x
		if dx > 0.0005 then
			self:SetFacing(1)
		elseif dx < -0.0005 then
			self:SetFacing(-1)
		end
	end

	@ExecSpace("ServerOnly")
	method void SetFacing(number dir)
		if self.Facing == dir then return end
		self.Facing = dir
		local sr = self.Entity.SpriteRendererComponent
		if sr ~= nil then sr.FlipX = (dir > 0) end
	end

end
