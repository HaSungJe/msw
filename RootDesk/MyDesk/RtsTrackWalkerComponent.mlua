-- rts-base: 트랙 위를 등속으로 도는 이동체 (2026-09-14 프로토타입 — 초록달팽이 시연)
--   t(0=S, 1=E)를 속도/트랙 길이만큼 올리며 RtsZoneLogic.GetTrackPoint로 위치를 잡는다. E에 닿으면 S로 순간이동(Loop).
--   Phase 3 #10(몹 스폰·순환)의 이동 부분이 이걸 그대로 쓴다. 서버가 움직이고 위치는 동기화.
@Component
script RtsTrackWalkerComponent extends Component

	property number Zone = 1

	property number T = 0

	-- 속도 수치(100 = 기준 속도, RtsConfigLogic.SpeedUnitPerSec). 몹 속도는 전부 동일(로드맵) — 값은 Phase 2 테이블로 옮긴다
	property number Speed = 100

	property boolean Loop = true

	property number Facing = -1

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		local len = _RtsZoneLogic:GetTrackLength()
		if len <= 0 then return end
		local before = _RtsZoneLogic:GetTrackPoint(self.Zone, self.T)
		local spd = self.Speed
		-- 빙결(블리자드) 중이면 이동속도 × RtsMonsterComponent.FreezeSlow(0.5) — 2026-09-20 사용자 "이동속도 감속도 구현"
		local m = self.Entity.RtsMonsterComponent
		if m ~= nil and m:IsFrozenNow() then spd = spd * m.FreezeSlow end
		self.T = self.T + _RtsConfigLogic:SpeedToUnitsPerSec(spd) * delta / len
		if self.T >= 1 then
			if self.Loop then
				self.T = self.T - 1
				before = _RtsZoneLogic:GetTrackPoint(self.Zone, self.T)
			else
				self.T = 1
			end
		end
		local p = _RtsZoneLogic:GetTrackPoint(self.Zone, self.T)
		self.Entity.TransformComponent.WorldPosition = Vector3(p.x, p.y, 0)
		-- 몬스터 스프라이트는 기본이 왼쪽 보기 → 오른쪽으로 갈 때 뒤집는다
		local dx = p.x - before.x
		if dx > 0.0005 then
			self:SetFacing(1)
		elseif dx < -0.0005 then
			self:SetFacing(-1)
		end
	end

	@ExecSpace("ServerOnly")
	method void SetFacing(number dir)
		if self.Facing == dir then return end
		self.Facing = dir
		local sr = self.Entity.SpriteRendererComponent
		if sr ~= nil then sr.FlipX = (dir > 0) end
	end

end
