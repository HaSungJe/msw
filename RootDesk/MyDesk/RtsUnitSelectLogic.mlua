-- Phase 4 #14·#17 (부분, 2026-09-15): 트랙 위 캐릭터 선택 — 마우스 오버 손 커서 / 클릭 → 캐릭터 우측 작은 메뉴(위치 이동·상세정보) / 위치 이동 모드
--   위치 이동 모드: 발판마다 틀 스프라이트(테두리+연한 채움)로 칸을 강조(빈 칸 금색, 내 유닛 자리 파랑 = 맞교환). 클릭한 발판으로 이동(서버 검증, 유닛마다 3분 쿨). ESC 취소.
--   상세정보 = RtsUnitPopupLogic(유닛 정보 팝업). 전부 클라 전용. 좌표는 1920×1080 기준.
@Logic
script RtsUnitSelectLogic extends Logic

	-- 메이플스토리 기본 손 커서(ui/basic/cursor/0). 캐릭터·발판 위에서만 보인다
	property string HandCursorRUID = "3930c5d2e85b4bff8467aada64fda7f5"

	property boolean HandShown = false

	-- 컨텍스트 메뉴(캐릭터 우측): 열려 있는 유닛 번호(0 = 닫힘)
	property number MenuNo = 0

	property Entity Menu = nil

	-- 열린 메뉴의 UI 좌표 사각형 {x0,y0,x1,y1} (중앙 원점) — 유닛 TouchEvent가 메뉴 위에서 났는지 판정용
	property table MenuRect = nil

	-- 위치 이동 모드: 이동 중인 유닛 번호(0 = 아님) + 발판 표시 엔티티들
	property number MoveNo = 0

	property table PadMarkers = {}

	-- 마커 이름 세대(직전 마커의 Destroy가 끝나기 전에 다시 켜도 이름이 겹치지 않게)
	property number MarkerGen = 0

	-- 발판 강조 틀: 업로드 스프라이트 RtsPadFrame(assets/textures/pad-frame.png, 80px = 흰 테두리 6px + 연한 채움, PPU 100).
	--   스케일 2.222 = 한 칸(80px) — 2026-09-15 실측. 2.12 = 칸 사이 살짝 틈. 색은 Color 틴트
	property string MarkerRUID = "2c03a06fb9ee495e80e3935eb033bccf"

	property number MarkerScale = 2.12

	-- 클릭 판정 상자(월드 단위, 발 기준): 아바타 스케일 2 = 폭 1.4, 높이 2.2
	property number HitHalfW = 0.7

	property number HitH = 2.2

	method boolean IsMoveMode()
		return self.MoveNo > 0
	end

	-- ===== 마우스 오버: 손 커서 =====

	@ExecSpace("ClientOnly")
	method number UnitAtScreen(Vector2 screen)
		local w = _UILogic:ScreenToWorldPosition(screen)
		for no = 1, _RtsUnitLogic:GetMaxUnits() do
			local u = _RtsUnitLogic:GetMyUnit(no)
			if u ~= nil then
				local p = u.Entity.TransformComponent.WorldPosition
				if w.x >= p.x - self.HitHalfW and w.x <= p.x + self.HitHalfW and w.y >= p.y and w.y <= p.y + self.HitH then
					return no
				end
			end
		end
		return 0
	end

	-- 화면 좌표 → 그리드 칸 (내 구역 기준). x=col, y=row
	@ExecSpace("ClientOnly")
	method Vector2 CellAtScreen(Vector2 screen)
		local w = _UILogic:ScreenToWorldPosition(screen)
		local c = _RtsConfigLogic:GetZoneCenter(_RtsUnitLogic:MyZone())
		local cell = _RtsConfigLogic:GetGridCell()
		local col = math.floor((w.x - c.x - _RtsConfigLogic:GetGridLeft()) / cell) + 1
		local row = math.floor((c.y + _RtsConfigLogic:GetGridTop() - w.y) / cell) + 1
		return Vector2(col, row)
	end

	@ExecSpace("ClientOnly")
	method void SetHand(boolean on)
		if on == self.HandShown then return end
		self.HandShown = on
		if on then
			_InputService:SetCursor(self.HandCursorRUID, Vector2(0, 0))
		else
			_InputService:ResetCursor()
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleMouseMoveEvent(MouseMoveEvent event)
		if _RtsPopupLogic:IsOpen() or _InputService:IsPointerOverUI() then
			self:SetHand(false)
			return
		end
		local screen = _InputService:GetCursorPosition()
		if self.MoveNo > 0 then
			local cell = self:CellAtScreen(screen)
			self:SetHand(_RtsZoneLogic:IsPadCell(cell.x, cell.y))
			return
		end
		self:SetHand(self:UnitAtScreen(screen) > 0)
	end

	-- ===== 클릭 → 컨텍스트 메뉴 =====

	-- RtsUnitComponent(TouchReceive)에서 호출
	@ExecSpace("ClientOnly")
	method void OnUnitClicked(number no)
		if self.MoveNo > 0 then return end
		if _RtsPopupLogic:IsOpen() then return end
		if self.MenuNo == no then
			self:CloseMenu()
			return
		end
		self:OpenMenu(no)
	end

	@ExecSpace("ClientOnly")
	method void OpenMenu(number no)
		self:CloseMenu()
		local u = _RtsUnitLogic:GetMyUnit(no)
		if u == nil then return end
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		if H.HudGroup == nil then return end
		-- 캐릭터 오른쪽 어깨 옆. 월드 → 화면 → UI(중앙 원점)
		local p = u.Entity.TransformComponent.WorldPosition
		local screen = _UILogic:WorldToScreenPosition(Vector2(p.x + 0.9, p.y + 1.2))
		local ui = _UILogic:ScreenToUIPosition(screen)
		local W = 170
		local rowH = 40
		local menuH = rowH * 2 + 14
		local menu = H:SpawnPanel("RtsUnitMenu", H.HudGroup, Vector2(0.5, 0.5), Vector2(0, 0.5), Vector2(ui.x, ui.y), Vector2(W, menuH),
			Color(0.11, 0.094, 0.075, 0.97), H:ColGold(), 1.5)
		self.Menu = menu.Parent
		self.MenuNo = no
		self.MenuRect = { x0 = ui.x - 6, y0 = ui.y - menuH / 2 - 6, x1 = ui.x + W + 6, y1 = ui.y + menuH / 2 + 6 }

		-- 1) 위치 이동 (쿨타임 중이면 남은 시간, 비활성)
		local left = u:MoveCoolLeft()
		local text = "위치 이동"
		local ink = H:ColInk()
		if left > 0 then
			text = "이동 대기 " .. _RtsUnitPopupLogic:FmtSec(left)
			ink = Color(0.6, 0.56, 0.5, 1)
		end
		local b1 = H:SpawnPanel("RtsUnitMenuMove", menu, Vector2(0, 1), Vector2(0, 1), Vector2(6, -6), Vector2(W - 12, rowH - 4),
			P:Mix(Color.white, 0.05), P:Mix(H:ColGold(), 0.35), 1.5)
		H:SpawnLabel("RtsUnitMenuMoveText", b1, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(W - 20, 30),
			text, ink, 16, TextAlignmentType.MiddleCenter, true)
		if left <= 0 then
			local c1 = H:SpawnClick("RtsUnitMenuMoveClick", b1)
			c1:ConnectEvent(ButtonClickEvent, function(event)
				local target = self.MenuNo
				self:CloseMenu()
				self:BeginMove(target)
			end)
		end

		-- 2) 상세정보
		local b2 = H:SpawnPanel("RtsUnitMenuInfo", menu, Vector2(0, 1), Vector2(0, 1), Vector2(6, -6 - rowH), Vector2(W - 12, rowH - 4),
			P:Mix(Color.white, 0.05), P:Mix(H:ColGold(), 0.35), 1.5)
		H:SpawnLabel("RtsUnitMenuInfoText", b2, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(W - 20, 30),
			"상세정보", H:ColInk(), 16, TextAlignmentType.MiddleCenter, true)
		local c2 = H:SpawnClick("RtsUnitMenuInfoClick", b2)
		c2:ConnectEvent(ButtonClickEvent, function(event)
			local target = self.MenuNo
			self:CloseMenu()
			_RtsUnitPopupLogic:OpenUnit(target)
		end)
	end

	-- 화면 좌표가 열린 메뉴 위인가 (여백 6px 포함). 유닛 클릭보다 UI가 우선이어야 하므로 RtsUnitComponent.OnTouched가 먼저 묻는다
	@ExecSpace("ClientOnly")
	method boolean IsOverMenu(Vector2 screen)
		local r = self.MenuRect
		if r == nil or self.Menu == nil then return false end
		local p = _UILogic:ScreenToUIPosition(screen)
		return p.x >= r.x0 and p.x <= r.x1 and p.y >= r.y0 and p.y <= r.y1
	end

	@ExecSpace("ClientOnly")
	method void CloseMenu()
		self.MenuNo = 0
		self.MenuRect = nil
		if self.Menu ~= nil then
			self.Menu:Destroy()
			self.Menu = nil
		end
	end

	-- ===== 위치 이동 모드 =====

	-- 발판마다 틀(테두리 + 연한 채움)을 씌워 칸을 강조. 빈 발판 금색 / 내 유닛이 선 발판 파랑(= 맞교환). 이동 중인 유닛 자리는 제외
	@ExecSpace("ClientOnly")
	method void BeginMove(number no)
		local u = _RtsUnitLogic:GetMyUnit(no)
		if u == nil or u:MoveCoolLeft() > 0 then return end
		self:CloseMenu()
		if _RtsPopupLogic:IsOpen() then _RtsPopupLogic:Close() end
		self.MoveNo = no
		local zone = _RtsUnitLogic:MyZone()
		local mapRoot = _EntityService:GetEntityByPath("/maps/RtsMap")
		self:ClearMarkers()
		self.MarkerGen = self.MarkerGen + 1
		local gen = _RtsHudLogic:Int(self.MarkerGen)
		for i = 1, _RtsZoneLogic:GetPadCount() do
			local p = _RtsZoneLogic:GetPadCell(i)
			local occupant = _RtsUnitLogic:MyUnitAt(p.x, p.y)
			if occupant ~= no then
				local at = _RtsZoneLogic:GetCellCenter(zone, p.x, p.y)
				local tint = Color(1, 0.82, 0.25, 1)
				if occupant > 0 then tint = Color(0.4, 0.62, 1, 1) end
				self:SpawnMarker("RtsPadFrame" .. gen .. "_" .. tostring(i), mapRoot, at, self.MarkerScale, 150, tint)
			end
		end
		_RtsHudLogic:ShowHint(_RtsHudLogic:Int(no) .. ". " .. _RtsJobTableLogic:GetJobName(u.JobId) .. " 위치 이동 — 발판을 클릭 (파란 발판 = 자리 맞교환) · ESC 취소")
	end

	@ExecSpace("ClientOnly")
	method void SpawnMarker(string name, Entity parent, Vector2 at, number scale, number order, Color color)
		local m = _SpawnService:SpawnByModelId("model://MapObject", name, Vector3(at.x, at.y, 0), parent)
		if m == nil then return end
		local sr = m.SpriteRendererComponent
		if sr ~= nil then
			sr.SpriteRUID = self.MarkerRUID
			sr.SortingLayer = "MapLayer0"
			sr.OrderInLayer = order
			sr.Color = color
		end
		m.TransformComponent.Scale = Vector3(scale, scale, 1)
		self.PadMarkers[#self.PadMarkers + 1] = m
	end

	@ExecSpace("ClientOnly")
	method void ClearMarkers()
		for i = 1, #self.PadMarkers do
			local m = self.PadMarkers[i]
			if m ~= nil then m:Destroy() end
		end
		self.PadMarkers = {}
	end

	@ExecSpace("ClientOnly")
	method void EndMove()
		self.MoveNo = 0
		self:ClearMarkers()
		self:SetHand(false)
		_RtsHudLogic:HideHint()
	end

	-- 화면 클릭: 이동 모드면 발판 판정 → 이동 요청. 아니면 메뉴 밖 클릭 → 메뉴 닫기
	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleScreenTouchEvent(ScreenTouchEvent event)
		if _InputService:IsPointerOverUI() then return end
		if self.MoveNo == 0 then
			-- 캐릭터 자체를 누른 경우는 TouchEvent(OnUnitClicked)가 토글하므로 여기선 빈 곳만
			if self.MenuNo > 0 and self:UnitAtScreen(event.TouchPoint) == 0 then self:CloseMenu() end
			return
		end
		local cell = self:CellAtScreen(event.TouchPoint)
		if not _RtsZoneLogic:IsPadCell(cell.x, cell.y) then return end
		local no = self.MoveNo
		log("RtsUnitSelect: move " .. _RtsHudLogic:Int(no) .. " -> (" .. _RtsHudLogic:Int(cell.x) .. "," .. _RtsHudLogic:Int(cell.y) .. ")")
		self:EndMove()
		_RtsUnitLogic:RequestMove(no, cell.x, cell.y)
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyDownEvent(KeyDownEvent event)
		if event.key ~= KeyboardKey.Escape then return end
		if self.MoveNo > 0 then
			self:EndMove()
		elseif self.MenuNo > 0 then
			self:CloseMenu()
		end
	end

end
