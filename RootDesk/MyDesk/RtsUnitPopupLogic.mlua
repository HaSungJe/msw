-- Phase 5 #19·#20 + Phase 4 #14 (부분, 2026-09-15): 유닛 정보 팝업 (아티팩트 v27 #unitModal 그대로)
--   열기: 우측 유닛 슬롯 클릭 / 캐릭터 클릭 메뉴의 상세정보. 셸(딤·패널·제목·X·ESC)은 RtsPopupLogic("unit").
--   좌: 외형(직업 기본 세트 하나 — 월드 아바타 스킨은 2026-09-25 삭제) + 능력치(RtsJobTableLogic.Calc, 파티 버프 반영 행은 ▲).
--   우: 탭 3개 — 스킬(미획득 흐림, 액티브/패시브) / 증강 n(이 유닛에 지정된 증강, Phase 6 전엔 빈 목록) / 적용 중인 버프 n(RtsUnitBuffLogic). 증강·버프는 ScrollLayoutGroup 스크롤 목록. Tab 키로 순환(CycleTab).
--   대상 지정 스킬(홀리 유니티) 행에는 셀렉트 박스(미지정 / 내 다른 유닛). 하단: [레벨업] 버튼만(2026-09-16 — 누적 투자·다음 벽·보유 메소·'(벽)' 문구는 유저에게 필요 없는 내부 정보라 삭제. 메소는 HUD 좌상단).
--   위치 이동은 여기 없음 — 캐릭터 클릭 메뉴(RtsUnitSelectLogic)에서. 대상 변경·위치 이동은 유닛마다 3분 쿨.
--   좌표는 1920×1080 기준(목업 1cqw = 19.2px). 값은 서버가 바꾸고(RtsUnitLogic) 동기화가 오면 다시 그린다.
@Logic
script RtsUnitPopupLogic extends Logic

	property number PanelW = 1360

	property number PanelH = 880

	-- 지금 보고 있는 유닛 번호(0 = 닫힘)
	property number CurNo = 0

	property Entity Body = nil

	property Entity Content = nil

	property Entity Dropdown = nil

	-- 우측 탭: skill / aug / buff (팝업을 닫아도 유지)
	property string Tab = "active"

	property Entity BondCoolText = nil

	property Entity BondBtn = nil

	property number TickId = 0

	property boolean BondLocked = false

	-- 제자리 갱신용 참조(2026-09-23 사용자 "레벨업 누를 때 창이 깜빡거림"): 능력치 값 라벨 8개 · 레벨업 버튼(안쪽·글자·비용)
	--   Render는 엔티티 100여 개를 지우고 다시 만들어(스폰이 여러 프레임에 나뉨) 깜빡이므로, 구조가 같으면 글자·색만 바꾼다
	property table StatVals = {}

	property Entity LvBtn = nil

	-- 레벨업 버튼 글자 조각(RtsUnitSelectLogic.SpawnLvRow — "LV.UP (15→16 · 350 [메소])")
	property table LvRow = nil

	-- 마지막으로 통째로 그린 구조 서명(직업·프리즘·잠금·스킨·대상·탭·획득 스킬 수·버프·증강 수·해금·대상 쿨) — 달라질 때만 Render
	property string Sig = ""

	-- 부분 다시 그리기(2026-09-25): 오른쪽 탭 막대 · 오른쪽 내용 컨테이너 · 외형 서명(이것이 바뀔 때만 통째로)
	property table TabBar = nil

	property Entity RightBox = nil

	property string LookSigNow = ""

	-- 동기화가 한꺼번에 여러 번 와도(레벨·사용 메소·메소·알림) 한 번만 갱신
	property boolean UpdatePending = false

	-- ===== 열기·닫기 =====

	method boolean IsOpen()
		return self.CurNo > 0
	end

	@ExecSpace("ClientOnly")
	method void OpenUnit(number no)
		if _RtsUnitLogic:GetMyUnit(no) == nil then return end
		if _RtsUnitSelectLogic:IsMoveMode() then _RtsUnitSelectLogic:EndMove() end
		_RtsUnitSelectLogic:EndPlace()
		_RtsUnitSelectLogic:CloseMenu()
		-- 이미 열려 있으면(같은 유닛을 다시 클릭 등) 먼저 닫는다 — Open 안의 Close가 CurNo를 지우기 때문
		if _RtsPopupLogic:IsOpen() then _RtsPopupLogic:Close() end
		self.CurNo = no
		_RtsPopupLogic:Open("unit")
	end

	-- RtsPopupLogic.Open("unit")이 body를 만든 뒤 호출
	@ExecSpace("ClientOnly")
	method void BuildBody(Entity body)
		self.Body = body
		self:Render()
		if self.TickId == 0 then
			self.TickId = _TimerService:SetTimerRepeat(function()
				self:Tick()
			end, 1)
		end
	end

	-- RtsPopupLogic.Close()가 호출
	@ExecSpace("ClientOnly")
	method void OnClosed()
		self.CurNo = 0
		self.Body = nil
		self.Content = nil
		self.Dropdown = nil
		self.BondCoolText = nil
		self.BondBtn = nil
		self.StatVals = {}
		self.LvBtn = nil
		self.LvRow = nil
		self.Sig = ""
		self.LookSigNow = ""
		self.TabBar = nil
		self.RightBox = nil
		if self.TickId ~= 0 then
			_TimerService:ClearTimer(self.TickId)
			self.TickId = 0
		end
	end

	-- 서버 값이 바뀌어 도착했을 때 (RtsUnitComponent.OnSyncProperty / RtsUnitLogic.OnChanged·메소 동기화). 0.05초 안에 온 것은 한 번으로 묶는다
	@ExecSpace("ClientOnly")
	method void OnUnitSynced(number no)
		-- 캐릭터 클릭 메뉴의 레벨업 줄(레벨·비용·메소 부족 표시)도 같이
		_RtsUnitSelectLogic:RefreshMenuLevel()
		if self.CurNo == 0 or self.Body == nil then return end
		if self.UpdatePending then return end
		self.UpdatePending = true
		_TimerService:SetTimerOnce(function()
			self.UpdatePending = false
			self:UpdateInPlace()
		end, 0.05)
	end

	-- 구조가 그대로면 제목·능력치·레벨업 버튼만 제자리에서 바꾸고, 달라졌으면 통째로 다시 그린다
	@ExecSpace("ClientOnly")
	method void UpdateInPlace()
		if self.CurNo == 0 or self.Body == nil then return end
		local u = _RtsUnitLogic:GetMyUnit(self.CurNo)
		if u == nil then
			_RtsPopupLogic:Close()
			return
		end
		if #self.StatVals == 0 or self.LvBtn == nil or self:LookSig(u) ~= self.LookSigNow then
			self:Render()
			return
		end
		-- 외형·틀은 그대로, 오른쪽(스킬·증강·버프)만 구조가 바뀌었으면 오른쪽만 다시(2026-09-25 "필요한 부분만 다시 그려")
		if self:Signature(u) ~= self.Sig then self:RenderRight(u) end
		self:ApplyTitle(u)
		local rows = self:StatRowTexts(u)
		for i = 1, #rows do
			local v = self.StatVals[i]
			if v ~= nil and isvalid(v) and v.TextComponent.Text ~= rows[i][2] then v.TextComponent.Text = rows[i][2] end
		end
		self:UpdateStatChart(u)
		self:ApplyLevelButton(u)
	end

	-- 통째로 다시 그려야 하는 구조의 서명(외형 칸 — 직업·프리즘 이름). 나머지는 오른쪽만 다시(Signature)
	method string LookSig(any u)
		return u.JobId .. "|" .. u.Prisms
	end

	-- 오른쪽 탭 내용 구조의 서명
	@ExecSpace("ClientOnly")
	method string Signature(any u)
		local skills = _RtsJobTableLogic:GetSkillsFor(u)
		local got = 0
		for i = 1, #skills do
			if u.Level >= skills[i].lv then got = got + 1 end
		end
		local B = _RtsUnitBuffLogic
		local bondLock = "0"
		if u:BondCoolLeft() > 0 then bondLock = "1" end
		return u.JobId .. "|" .. u.Prisms .. "|" .. u.SkillLocks .. "|" .. _RtsHudLogic:Int(u.BondNo) .. "|" .. self.Tab
			.. "|" .. _RtsHudLogic:Int(got) .. "|" .. B:BuffSig(u.Zone, u.No) .. "|" .. _RtsHudLogic:Int(#B:GetAugmentsFor(u.Zone, u.No))
			.. "|" .. bondLock
	end

	-- 제목: "2. 팔라딘  Lv 40 · 모험가 · 전사"
	@ExecSpace("ClientOnly")
	method void ApplyTitle(any u)
		-- 직업과 레벨은 흉상 아래에서 갱신한다.
		local P = _RtsPopupLogic
		P.Title.TextComponent.IsRichText = false
		P.Title.TextComponent.Text = "캐릭터 상세정보"
		if self._T.Identity ~= nil and isvalid(self._T.Identity) then
			self._T.Identity.TextComponent.Text = _RtsJobTableLogic:GetJobNameFor(u) .. "\n<size=18>Lv. " .. _RtsHudLogic:Int(u.Level) .. "</size>"
		end
	end

	-- 레벨업 가능 여부(최대 레벨 아님 + 메소 충분) — 버튼 모양과 클릭 판단 공용(서버도 다시 검사)
	@ExecSpace("ClientOnly")
	method boolean CanLevelUp(any u)
		if u == nil then return false end
		local T = _RtsJobTableLogic
		if u.Level >= T:GetMaxLevel() then return false end
		return _RtsUnitLogic:GetMyMeso() >= T:GetLevelCost(u.Level + 1)
	end

	-- 레벨업 버튼: "레벨업 → Lv n" + 비용, 메소 부족·최대 레벨이면 흐리게
	@ExecSpace("ClientOnly")
	method void ApplyLevelButton(any u)
		if self.LvBtn == nil or not isvalid(self.LvBtn) then return end
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		local T = _RtsJobTableLogic
		local nextLv = u.Level + 1
		local maxed = u.Level >= T:GetMaxLevel()
		local can = self:CanLevelUp(u)
		local lbg = P:Mix(H:ColGold(), 0.92)
		local lborder = H:ColGold()
		local lInk = Color(0.133, 0.114, 0.09, 1)
		if not can then
			lbg = P:Mix(lbg, 0.4)
			lborder = P:Mix(lborder, 0.4)
			lInk = Color(0.45, 0.4, 0.33, 1)
		end
		self.LvBtn.SpriteGUIRendererComponent.Color = lbg
		self.LvBtn.Parent.SpriteGUIRendererComponent.Color = lborder
		_RtsUnitSelectLogic:ApplyLvRow(self.LvRow, u, lInk)
	end

	-- ===== 그리기 =====

	method string FmtSec(number s)
		local m = math.floor(s / 60)
		local r = math.floor(s - m * 60)
		local rs = _RtsHudLogic:Int(r)
		if r < 10 then rs = "0" .. rs end
		return _RtsHudLogic:Int(m) .. ":" .. rs
	end

	method string Fmt(number n)
		return _RtsHudLogic:FormatNumber(n)
	end

	@ExecSpace("ClientOnly")
	method void Render()
		if self.Body == nil then return end
		local u = _RtsUnitLogic:GetMyUnit(self.CurNo)
		if u == nil then
			_RtsPopupLogic:Close()
			return
		end
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		local T = _RtsJobTableLogic
		-- 옛 내용은 새 내용이 그려질 때까지 잠깐 남겼다가 지운다(2026-09-24 사용자 "캐릭터 상세보기 탭으로 넘어갈 때 번쩍임" —
		--   엔진이 UI를 여러 프레임에 나눠 만들어 지우자마자 새로 만들면 잠깐 빈 창이 보였다). 새 내용이 위에 그려진다
		if self.Content ~= nil then
			local old = self.Content
			_TimerService:SetTimerOnce(function()
				if old ~= nil and isvalid(old) then old:Destroy() end
			end, 0.12)
		end
		self.Dropdown = nil
		local content = H:SpawnStretch("model://uisprite", "RtsUnitContent", self.Body, Vector2(0, 0), Vector2(1, 1), Vector2(0, 0), Vector2(0, 0))
		H:Tint(content, 0, 0, 0, 0)
		self.Content = content

		local B = _RtsUnitBuffLogic
		local buffs = B:GetBuffsFor(u.Zone, u.No)
		self:ApplyTitle(u)

		-- ----- 좌: 외형(직업 기본 세트 — 2026-09-25 사용자 "월드 아바타 없애고 기본 스킨이나 이쁘게 꾸며서 보여줘") -----
		--   가운데에 크게 + 뒤에 은은한 금빛 원광 + 아래 이름판(프리즘으로 직업명이 바뀌면 그 이름 — 2026-09-22 "듀얼블레이더라고 나와야지")
		--   2026-09-25 사용자 "모습이 너무 낮다 — '외형' 글자 빼고 캐릭터가 원 안에": 제목 줄 삭제, 캐릭터를 원 위쪽 가운데로 작게(무기까지 원 안)
		local look = H:SpawnRoundedPanel("RtsUnitLook", content, Vector2(0, 1), Vector2(0, 1), Vector2(27, -10), Vector2(190, 416),
			P:Card(), P:Mix(H:ColGold(), 0.25), 1.5)
		local glow = H:SpawnUI("model://uisprite", "RtsUnitLookGlow", look, Vector2(0, 1), Vector2(0.5, 0.5), Vector2(95, -126), Vector2(180, 180))
		if H.CircleMaskRUID ~= "" then glow.SpriteGUIRendererComponent.ImageRUID = DataRef(H.CircleMaskRUID) end
		glow.SpriteGUIRendererComponent.Color = Color(0.76, 0.75, 0.9, 0.12)
		glow.SpriteGUIRendererComponent.RaycastTarget = false
		if u.JobId == "il" then
			self:SpawnPreviewAt(look, u, Vector2(95, -126), Vector2(180, 180))
		else
			self:SpawnPreviewAt(look, u, Vector2(95, -134), Vector2(136, 170))
		end
		self._T.Identity = H:SpawnLabel("RtsUnitIdentity", look, Vector2(0.5, 0), Vector2(0.5, 0), Vector2(0, 48), Vector2(178, 74),
			"", P:Ink(), 19, TextAlignmentType.MiddleCenter, true)
		self._T.Identity.TextComponent.IsRichText = true
		self:ApplyTitle(u)

		-- 흉상 옆 실제 여섯 능력치. 숫자와 도형 모두 같은 버프 반영 값을 사용한다.
		self.StatVals = {}
		local stats = H:SpawnRoundedPanel("RtsUnitStats", content, Vector2(0, 1), Vector2(0, 1), Vector2(229, -10), Vector2(400, 416), P:Card(), P:Edge(), 1.5)
		self:BuildStatChart(stats, u)
		local rows = self:StatRowTexts(u)
		for _, index in ipairs({1, 4}) do
			local x = 27
			if index == 4 then x = 307 end
			H:SpawnLabel("RtsUnitExtraStatK", content, Vector2(0, 1), Vector2(0, 1), Vector2(x, -443), Vector2(160, 24), rows[index][1], P:Muted(), 16, TextAlignmentType.MiddleLeft, false)
			self.StatVals[index] = H:SpawnLabel("RtsUnitExtraStatV", content, Vector2(0, 1), Vector2(0, 1), Vector2(x + 160, -443), Vector2(100, 24), rows[index][2], P:Ink(), 18, TextAlignmentType.MiddleRight, true)
		end
		H:SpawnLabel("RtsStatChartScale", content, Vector2(0, 1), Vector2(0, 1), Vector2(27, -642), Vector2(602, 70), "도형 기준: 공격력 1,000 · 공격력 증가 200%\n최종 데미지 300% · 보스 데미지 200% · 크확 100% · 크뎀 200%\n기준을 넘은 수치도 숫자에는 그대로 표시됩니다", P:Muted(), 13, TextAlignmentType.UpperLeft, false)

		-- ----- 좌 아래: 증강으로 오른 수치(2026-09-24 사용자 "캐릭터 상세정보 아래에 박스 하나 더 — 증강으로 올라간 수치") -----
		--   증강 탭 합계와 같은 계산(RtsAugmentTableLogic.TotalsMul × 티어 배율 RtsJobTableLogic.AugMulFor), 2열 격자
		local at = _RtsAugmentTableLogic:TotalsMul(u.Augs, _RtsJobTableLogic:AugMulFor(u))
		local augBox = H:SpawnRoundedPanel("RtsUnitAugGain", content, Vector2(0, 1), Vector2(0, 1), Vector2(27, -486), Vector2(602, 130),
			P:Mix(H:ColGold(), 0.06), P:Mix(H:ColGold(), 0.35), 1.5)
		H:SpawnLabel("RtsUnitAugGainT", augBox, Vector2(0, 1), Vector2(0, 1), Vector2(14, -6), Vector2(534, 24),
			"증강으로 오른 수치 (" .. H:Int(at.n) .. "개)", P:AccentInk(), 16, TextAlignmentType.MiddleLeft, true)
		local gains = {}
		if at.atk > 0 then gains[#gains + 1] = "공격력 +" .. H:Int(at.atk) end
		if at.pct > 0 then gains[#gains + 1] = "공격력 +" .. H:Int(at.pct) .. "%" end
		if at.boss > 0 then gains[#gains + 1] = "보스 데미지 +" .. H:Int(at.boss) .. "%" end
		if at.crit > 0 then gains[#gains + 1] = "크리티컬 확률 +" .. H:Int(at.crit) .. "%" end
		if at.critDmg > 0 then gains[#gains + 1] = "크리티컬 데미지 +" .. H:Int(at.critDmg) .. "%" end
		if at.fin > 100.01 then gains[#gains + 1] = "최종 데미지 +" .. H:Int(at.fin - 100) .. "%" end
		if #gains == 0 then
			H:SpawnLabel("RtsUnitAugGainNone", augBox, Vector2(0, 1), Vector2(0, 1), Vector2(14, -32), Vector2(534, 24),
				"적용된 증강이 없어요", _RtsPopupLogic:Muted(), 16, TextAlignmentType.MiddleLeft, false)
		else
			for gi = 1, #gains do
				local col = (gi - 1) % 2
				local line = math.floor((gi - 1) / 2)
				local gl = H:SpawnLabel("RtsUnitAugGainV", augBox, Vector2(0, 1), Vector2(0, 1), Vector2(14 + col * 275, -36 - line * 26), Vector2(262, 24),
					gains[gi], _RtsPopupLogic:Ink(), 15, TextAlignmentType.MiddleLeft, false)
				gl.TextComponent.Overflow = OverflowType.Truncate
			end
		end

		-- ----- 우: 탭(스킬 / 증강 n / 적용 중인 버프 n) + 목록 -----
		local rx = 647
		local rw = self.PanelW - rx - 27
		local augs = B:GetAugmentsFor(u.Zone, u.No)
		local tabs = {
			{ id = "active", text = "액티브", w = 104 },
			{ id = "passive", text = "패시브", w = 104 },
			{ id = "aug", text = "증강 " .. H:Int(#augs), w = 130 },
			{ id = "buff", text = "버프 " .. H:Int(self:BuffCount(u, buffs)), w = 130 },
		}
		-- 탭은 제자리(켜짐·개수 글자만 바뀜 — RenderRight), 누르면 오른쪽 내용만 다시(2026-09-25 "필요한 부분만")
		local items = {}
		for i = 1, #tabs do items[i] = { tabs[i].id, tabs[i].text, tabs[i].w } end
		self.TabBar = P:SpawnTabBar(content, "RtsUnitTab", items, self.Tab, rx, -10, 120, 48, 8, 18, function(key)
			self.Tab = key
			self:RenderRight(_RtsUnitLogic:GetMyUnit(self.CurNo))
		end)
		local tx = self.TabBar.right
		-- 단축키 표시: 탭 오른쪽 [Tab] — Tab 키로 스킬 → 증강 → 적용 중인 버프 순환(2026-09-23 사용자, RtsUnitSelectLogic.HandleKeyDownEvent → CycleTab)
		local tkey = H:SpawnRoundedPanel("RtsUnitTabKey", content, Vector2(0, 1), Vector2(0, 1), Vector2(tx + 4, -20), Vector2(56, 26),
			Color(0.92, 0.93, 0.98, 0.9), Color(0.72, 0.74, 0.84, 0.9), 1.2)
		H:SpawnLabel("RtsUnitTabKeyText", tkey, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(54, 24),
			"Tab", Color(0.38, 0.39, 0.50, 1), 13, TextAlignmentType.MiddleCenter, true)
		self.RightBox = nil
		self:RenderRight(u)

		-- ----- 하단: 레벨업 버튼만 -----
		--   누적 투자·다음 벽까지 비용·보유 메소는 안 보인다(2026-09-16 사용자: 유저에게 필요 없는 내부 정보. 메소는 HUD 좌상단에 있음).
		--   벽 레벨(10·20·…)도 유저에겐 그냥 다음 레벨 — 비용만 보여 주고 '(벽)' 문구·붉은색 없음
		-- 레벨업 → Lv n (메소 부족·최대 레벨은 흐리게). 모양·글자는 ApplyLevelButton이 제자리에서 바꾸고, 클릭은 누를 때 가능 여부를 본다
		local lbtn = H:SpawnRoundedPanel("RtsUnitLvUp", content, Vector2(1, 0), Vector2(1, 0), Vector2(-27, 10), Vector2(340, 54), H:ColGold(), H:ColGold(), 1.5)
		self.LvBtn = lbtn
		-- 오른쪽 72 = [Space] 키캡(58, 여백 6) + 틈 8 — 전엔 14라 글자·메소 아이콘이 키캡과 겹쳤다(2026-09-25 사용자 "레벨업과 스페이스 버튼이 겹침")
		self.LvRow = _RtsUnitSelectLogic:SpawnLvRow(lbtn, 72, 16)
		self:ApplyLevelButton(u)
		local lclick = H:SpawnClick("RtsUnitLvUpClick", lbtn)
		lclick:ConnectEvent(ButtonClickEvent, function(event)
			if self:CanLevelUp(_RtsUnitLogic:GetMyUnit(self.CurNo)) then _RtsUnitLogic:LevelUpNow(self.CurNo) end
		end)
		-- 단축키 표시: 레벨업 버튼 안 오른쪽 [Space](2026-09-25 사용자 "Space가 LV.UP 우측에 — 버튼 하나로 합쳐서", 캐릭터 메뉴의 레벨업 줄과 같은 키캡 — RtsUnitSelectLogic.SpawnKeyCap)
		_RtsUnitSelectLogic:SpawnKeyCap(lbtn, "Space")
		self.Sig = self:Signature(u)
		self.LookSigNow = self:LookSig(u)
	end

	-- 능력치 8줄 { 이름, 값(리치 텍스트) } — 버프 없는 원값(s0)과 버프 반영값(s)이 다른 행은 ▲. 프리즘은 둘 다에 반영(GetStatFor)
	--   기본 공격 구성·보스 DPS·몬스터 DPS 줄은 2026-09-18 사용자 요청으로 제거(설계 수치 — 유저에게 불필요)
	--   공격속도는 등급만(보통·빠름…; n초당 1회 없음), 공격력은 총합만(구성식 없음), 공격력 %는 추가되는 %의 합(+n%) — 2026-09-18 사용자
	@ExecSpace("ClientOnly")
	method table StatRowTexts(any u)
		local H = _RtsHudLogic
		local T = _RtsJobTableLogic
		local B = _RtsUnitBuffLogic
		local s0 = T:GetStatFor(u)
		local s = T:GetStatFor(u)
		B:ApplyToStat(s, B:GetBuffsFor(u.Zone, u.No))
		local c = T:CalcStat(u.JobId, u.Level, s)
		local muted = "<color=#a3957a>"
		-- 방무는 보스 옵션(2026-09-24 사용자 "일반 몬스터 방어율 0 — 방무는 보스 옵션"): 보스 상대 총 방무(발할라 ignBoss까지 합연산) 하나만
		local ignBossTotal = s.ign
		if s.ignBoss > 0 then ignBossTotal = s.ign + s.ignBoss end
		local ignText = H:Int(ignBossTotal) .. "%"
		local up = " <color=#356c32>▲</color>"
		-- 최종 데미지는 배율(120%)이 아니라 추가분만(+20%; 기본 0%) — 2026-09-18 사용자 "이거는 +만 표시"
		local function plusPct(v)
			local d = v - 100
			if d > 0 then return "+" .. H:Int(d) .. "%" end
			return H:Int(d) .. "%"
		end
		local finText = plusPct(s.fin)
		if s.finBoss ~= s.fin then finText = finText .. " " .. muted .. "· 보스 " .. plusPct(s.finBoss) .. "</color>" end
		if s.fin ~= s0.fin or s.finBoss ~= s0.finBoss then finText = finText .. up end
		-- 보스 공격시 데미지 증가(킷 티어 + 증강 + 프리즘, 합연산) — 기본 0%라 +n%만
		local bossText = "+" .. H:Int(s.bossAdd or 0) .. "%"
		if (s.bossAdd or 0) ~= (s0.bossAdd or 0) then bossText = bossText .. up end
		-- 크리티컬은 확률/데미지 두 줄, 적용 중인 총합만(버프 포함 값 하나)
		local critText = H:Int(s.crit) .. "%"
		if s.crit ~= s0.crit then critText = critText .. up end
		local critDmgText = H:Int(s.critDmg) .. "%"
		if s.critDmg ~= s0.critDmg then critDmgText = critDmgText .. up end
		return {
			{ "공격속도", s.speed },
			{ "공격력", "<b>" .. self:Fmt(c.atk) .. "</b>" },
			{ "공격력 %", plusPct(s.pct) },
			{ "보스 방어율 무시", ignText },
			{ "최종 데미지", finText },
			{ "보스 데미지", bossText },
			{ "크리티컬 확률", critText },
			{ "크리티컬 데미지", critDmgText },
		}
	end

	-- 홀리 유니티 행의 대상 지정: "대상:" + 셀렉트 박스 + 쿨타임
	@ExecSpace("ClientOnly")
	-- 설명 글이 폭 w(px)에서 몇 줄인지(14px 글꼴: 한글 ≈ 13px, 그 외 ≈ 8px로 어림). 1~3줄
	method number DescLines(string text, number w)
		if text == nil or text == "" then return 1 end
		-- UTF-8 이어붙임 바이트(0x80~0xBF) 수로 한글(3바이트 = 이어붙임 2개) 글자 수를 어림한다
		local bytes = #text
		local _, cont = string.gsub(text, "[\128-\191]", "")
		local wide = math.floor(cont / 2)
		local narrow = bytes - cont - wide
		if narrow < 0 then narrow = 0 end
		local px = wide * 18 + narrow * 10
		local lines = math.ceil(px / math.max(60, w))
		if lines < 1 then lines = 1 end
		if lines > 12 then lines = 12 end
		return lines
	end

	method void BuildTargetRow(Entity row, any u, number rx, number sy)
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		local targetY = row.Parent.UITransformComponent.RectSize.y - 46
		H:SpawnLabel("RtsUnitTgtK", row, Vector2(0, 1), Vector2(0, 1), Vector2(70, -targetY), Vector2(50, 30),
			"대상:", _RtsPopupLogic:Muted(), 14, TextAlignmentType.MiddleLeft, false)
		self.BondLocked = u:BondCoolLeft() > 0
		local bg = P:Mix(Color.white, 0.55)
		local border = P:Mix(Color.white, 0.28)
		if self.BondLocked then border = P:Edge() end
		local btn = H:SpawnRoundedPanel("RtsUnitTgtSel", row, Vector2(0, 1), Vector2(0, 1), Vector2(118, -targetY), Vector2(250, 30), bg, border, 1.5)
		self.BondBtn = btn
		local ink = _RtsPopupLogic:Ink()
		if self.BondLocked then ink = Color(0.6, 0.56, 0.5, 1) end
		H:SpawnLabel("RtsUnitTgtCur", btn, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(10, 0), Vector2(200, 26),
			self:TargetLabel(u.BondNo), ink, 14, TextAlignmentType.MiddleLeft, false)
		H:SpawnLabel("RtsUnitTgtArrow", btn, Vector2(1, 0.5), Vector2(1, 0.5), Vector2(-8, 0), Vector2(20, 26),
			"▼", _RtsPopupLogic:Muted(), 11, TextAlignmentType.MiddleCenter, false)
		local cool = H:SpawnLabel("RtsUnitTgtCool", row, Vector2(0, 1), Vector2(0, 1), Vector2(380, -targetY), Vector2(320, 30),
			"", _RtsPopupLogic:Muted(), 13, TextAlignmentType.MiddleLeft, false)
		self.BondCoolText = cool
		self:ApplyBondCool(u)
		if not self.BondLocked then
			local click = H:SpawnClick("RtsUnitTgtClick", btn)
			-- 스크롤된 버튼의 현재 위치를 읽어 목록을 바로 아래에 띄운다.
			click:ConnectEvent(ButtonClickEvent, function(event)
				local transform = self.Content.UITransformComponent
				local bt = btn.UITransformComponent
				local point = transform:ToLocalPoint(bt.WorldPosition)
				local x = point.x + transform.Pivot.x * transform.RectSize.x - bt.Pivot.x * bt.RectSize.x
				local y = point.y - (1 - transform.Pivot.y) * transform.RectSize.y - bt.Pivot.y * bt.RectSize.y - 2
				-- 엔진 WorldPosition에는 ScrollLayout의 시각 이동이 빠져 있어 실제 행 경계로 보정한다.
				local lists = self.RightBox:GetChildComponentsByTypeName("ScrollLayoutGroupComponent", true)
				if #lists > 0 then
					local scroll = lists[1]
					local bottom = 0
					for _, t in ipairs(scroll.Entity:GetChildComponentsByTypeName("UITransformComponent", false)) do
						bottom = math.max(bottom, -t.anchoredPosition.y + t.Pivot.y * t.RectSize.y)
					end
					y = y + scroll:GetScrollNormalizedPosition().y * math.max(0, bottom - scroll.Entity.UITransformComponent.RectSize.y)
				end
				local count = #_RtsUnitLogic:ListZoneUnits(_RtsUnitLogic:MyZone())
				x = math.max(16, math.min(x, transform.RectSize.x - 266))
				y = math.max(-transform.RectSize.y + 30 * count + 20, y)
				self:ToggleDropdown(x, y)
			end)
		end
	end

	-- 스킬 탭: 획득 레벨 순으로 쌓는다. 스크롤 목록(8행 이상이면 스크롤), 설명 줄 수만큼 행이 커진다(2026-09-22)
	@ExecSpace("ClientOnly")
	method void BuildSkillTab(Entity body, any u, number rx0, number rw0, number top0)
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		local skills = _RtsJobTableLogic:GetSkillsFor(u)
		local ids = _RtsJobTableLogic:PrismIds(u)
		self.BondCoolText = nil
		self.BondBtn = nil
		self.BondLocked = false
		-- 스크롤 목록(2026-09-22 사용자 "공간 좁아서 계속 글 깨지잖아, 스크롤이라도 주던가"): 행 높이는 줄이지 않고 64 고정, 설명이 한 줄(폭 ÷ 13px)을 넘으면 줄 수만큼 20px씩 키운다. 8행 넘으면 스크롤
		local rowCount = #skills
		for i = 1, #ids do
			local pz = _RtsJobTableLogic:GetPrism(ids[i])
			if pz ~= nil and _RtsJobTableLogic:FindSkill(skills, pz.name) == 0 then rowCount = rowCount + 1 end
		end
		local list = self:SpawnScrollList(body, "RtsUnitSkillList", rx0, rw0, top0, rowCount)
		if list == nil then return end
		-- 홀리 유니티 드롭다운은 body 좌표로 자리를 잡으므로 원래 열 위치(rx0·top0)로 계산한다(스크롤된 상태에선 어긋날 수 있음). 행은 목록 안에 x 0, 폭은 스크롤바만큼 뺀다
		local content = list
		local rx = 0
		local rw = rw0 - 12
		local sy = 0
		local rh0 = 84
		for i = 1, #skills do
			local k = skills[i]
			if (self.Tab == "active" and k.kind == "액티브") or (self.Tab == "passive" and k.kind ~= "액티브") then
			local got = u.Level >= k.lv
			local isTarget = k.target and got
			local lockMode0 = _RtsJobTableLogic:GetLock(u.SkillLocks, i)
			local lockable0 = k.kind == "액티브" and (got or lockMode0 == 3)
			local descW = rw - 90

			local lines = self:DescLines(k.desc, descW)
			local rh = rh0 + (lines - 1) * 24
			if lockable0 then rh = rh + 48 end
			if isTarget then rh = rh + 52 end
			local bg = P:Card()
			local border = P:Edge()
			if not got then
				bg = P:Mix(Color.white, 0.02)
				border = P:Mix(Color.white, 0.06)
			end
			local row = H:SpawnRoundedPanel("RtsUnitSkill" .. tostring(i), content, Vector2(0, 1), Vector2(0, 1), Vector2(rx, sy), Vector2(rw, rh), bg, border, 1.5)
			local bar = H:SpawnStretch("model://uisprite", "RtsUnitSkillBar", row, Vector2(0, 0), Vector2(0, 1), Vector2(0, 0), Vector2(4, 0))
			local barColor = Color(0.541, 0.498, 0.439, 1)
			if k.kind == "액티브" then barColor = H:ColGold() end
			if not got then barColor = Color(0.4, 0.37, 0.33, 0.6) end
			bar.SpriteGUIRendererComponent.Color = barColor
			local ink = _RtsPopupLogic:Ink()
			local desc = _RtsPopupLogic:Ink()
			local mutedC = _RtsPopupLogic:Muted()
			if not got then
				ink = Color(0.55, 0.51, 0.45, 1)
				desc = Color(0.5, 0.46, 0.41, 1)
				mutedC = Color(0.45, 0.42, 0.37, 1)
			end
			local lvLbl = H:SpawnLabel("RtsUnitSkillLv", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(12, 0), Vector2(50, 40),
				"Lv\n<b><size=17>" .. H:Int(k.lv) .. "</size></b>", mutedC, 12, TextAlignmentType.MiddleCenter, false)
			lvLbl.TextComponent.IsRichText = true
			-- 프리즘이 얹은 액티브(k.prism)는 태그를 '액티브 · 프리즘'으로(2026-09-22 사용자 "왜 풍마수리검이 2칸이지" — 같은 이름의 프리즘 행은 아래에서 생략)
			local kindText = k.kind
			if k.prism then kindText = k.kind .. " · <color=#784aa1>프리즘</color>" end
			local nameText = k.name .. "  <size=11><color=#78624d>" .. kindText .. "</color></size>"
			if not got then nameText = nameText .. "  <size=12><color=#8a8072>미획득</color></size>" end
			-- 획득한 액티브는 우측에 잠금 설정 토글(사용 / 보스전 잠금 / 잠금)이 붙어 글자 폭을 그만큼 줄인다. 영구 잠금(3)은 미획득이어도 표시
			local lockMode = _RtsJobTableLogic:GetLock(u.SkillLocks, i)
			local isLockable = k.kind == "액티브" and (got or lockMode == 3)
			local textW = rw - 90

			local nameLbl = H:SpawnLabel("RtsUnitSkillName", row, Vector2(0, 1), Vector2(0, 1), Vector2(70, -8), Vector2(textW, 24),
				nameText, ink, 21, TextAlignmentType.MiddleLeft, true)
			nameLbl.TextComponent.IsRichText = true
			H:SpawnLabel("RtsUnitSkillDesc", row, Vector2(0, 1), Vector2(0, 1), Vector2(70, -42), Vector2(textW, 8 + lines * 24),
				k.desc, desc, 18, TextAlignmentType.UpperLeft, false)
			if isLockable then
				self:BuildLockToggle(row, u, i, rh)
			end
			if isTarget then
				self:BuildTargetRow(row, u, rx0, top0 + sy)
			end
			sy = sy - rh - 6
			end
		end
		-- 적용된 프리즘 증강(2026-09-22 사용자 "프리즘 스킬들은 모두 상세정보 → 스킬에서 확인"): 스킬 표 뒤에 프리즘색 행으로. 기존 스킬을 바꾸는 프리즘(템페스트·엘릭서·인레이지·거대화·초월·풍마수리검)은 표에 새 항목이 없어 여기서만 보인다
		for i = 1, #ids do
			local pz = _RtsJobTableLogic:GetPrism(ids[i])
			-- 같은 이름의 스킬 행이 이미 있으면(풍마수리검·애로우 레인·트루 스나이핑·디바인 퍼니시먼트) 프리즘 행은 생략
			if pz ~= nil and _RtsJobTableLogic:FindSkill(skills, pz.name) > 0 then pz = nil end
			if pz ~= nil and self.Tab == "passive" then
				local pc = P:GradeColor("prism")
				local plines = self:DescLines(pz.desc, rw - 90)
				local rh = rh0 + (plines - 1) * 24
				local row = H:SpawnRoundedPanel("RtsUnitPrism" .. tostring(i), content, Vector2(0, 1), Vector2(0, 1), Vector2(rx, sy), Vector2(rw, rh), P:Mix(pc, 0.08), P:Mix(pc, 0.45), 1.5)
				local bar = H:SpawnStretch("model://uisprite", "RtsUnitPrismBar", row, Vector2(0, 0), Vector2(0, 1), Vector2(0, 0), Vector2(4, 0))
				bar.SpriteGUIRendererComponent.Color = pc
				local lvLbl = H:SpawnLabel("RtsUnitPrismLv", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(12, 0), Vector2(50, 40),
					"Lv\n<b><size=17>1</size></b>", _RtsPopupLogic:Muted(), 12, TextAlignmentType.MiddleCenter, false) -- 프리즘은 레벨 제한 없음(2026-09-24 사용자 — 전엔 50으로 적혀 있었다)
				lvLbl.TextComponent.IsRichText = true
				local nameLbl = H:SpawnLabel("RtsUnitPrismName", row, Vector2(0, 1), Vector2(0, 1), Vector2(70, -8), Vector2(rw - 90, 24),
					pz.name .. "  <size=11><color=#784aa1>프리즘</color></size>", _RtsPopupLogic:Ink(), 17, TextAlignmentType.MiddleLeft, true)
				nameLbl.TextComponent.IsRichText = true
				H:SpawnLabel("RtsUnitPrismDesc", row, Vector2(0, 1), Vector2(0, 1), Vector2(70, -42), Vector2(rw - 90, 8 + plines * 24),
					pz.desc, _RtsPopupLogic:Ink(), 18, TextAlignmentType.UpperLeft, false)
				sy = sy - rh - 6
			end
		end
		if sy == 0 then self:SpawnEmptyRow(list, rw, "표시할 스킬이 없어요") end
	end

	-- 액티브 스킬 잠금 설정(2026-09-16): 행 우측 상단에 3분할 토글 [사용 | 보스전 잠금 | 잠금]. 선택 = 초록/주황/빨강, 나머지는 흐림. 클릭 즉시 서버 요청(쿨타임 없음)
	--   영구 잠금(3, 프리즘 증강)은 토글 대신 프리즘색 알약 "영구 잠금" 하나 — 클릭 없음(풀 수 없음)
	--   대상 지정 행(높이 100)도 토글은 위 64px 안에 둔다
	@ExecSpace("ClientOnly")
	method void BuildLockToggle(Entity row, any u, number idx, number rh)
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		local cur = _RtsJobTableLogic:GetLock(u.SkillLocks, idx)
		if cur == 3 then
			local pc = P:GradeColor("prism")
			local pill = H:SpawnRoundedPanel("RtsUnitLock" .. H:Int(idx) .. "_3", row, Vector2(0, 0), Vector2(0, 0), Vector2(70, 12), Vector2(150, 36), P:Mix(pc, 0.22), pc, 1.5)
			H:SpawnLabel("RtsUnitLockText", pill, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(146, 32),
				"영구 잠금", _RtsPopupLogic:Ink(), 16, TextAlignmentType.MiddleCenter, true)   -- 이모지(🔒)는 게임 폰트에 없어 안 그려진다(실측)
			return
		end
		local opts = { { m = 0, w = 104, c = Color(0.624, 0.827, 0.604, 1) }, { m = 1, w = 154, c = Color(0.91, 0.635, 0.416, 1) }, { m = 2, w = 104, c = Color(0.86, 0.47, 0.44, 1) } }
		local total = 0
		for i = 1, #opts do total = total + opts[i].w end
		total = total + 4 * (#opts - 1)
		local x = 70
		for i = 1, #opts do
			local o = opts[i]
			local on = (o.m == cur)
			local bg = P:Card()
			local border = P:Edge()
			local ink = Color(0.6, 0.56, 0.5, 1)
			if on then
				bg = P:Mix(o.c, 0.22)
				border = o.c
				ink = _RtsPopupLogic:Ink()
			end
			local btn = H:SpawnRoundedPanel("RtsUnitLock" .. H:Int(idx) .. "_" .. H:Int(o.m), row, Vector2(0, 0), Vector2(0, 0), Vector2(x, 12), Vector2(o.w, 36), bg, border, 1.5)
			H:SpawnLabel("RtsUnitLockText", btn, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(o.w - 8, 32),
				_RtsJobTableLogic:LockName(o.m), ink, 16, TextAlignmentType.MiddleCenter, on)
			if not on then
				local mode = o.m
				local click = H:SpawnClick("RtsUnitLockClick", btn)
				click:ConnectEvent(ButtonClickEvent, function(event)
					_RtsUnitLogic:RequestSkillLock(self.CurNo, idx, mode)
				end)
			end
			x = x + o.w + 4
		end
	end

	-- 스크롤 목록 컨테이너(세로 레이아웃, 자식 행을 위에서부터 쌓고 넘치면 스크롤). 하단 66px는 레벨업 버튼 자리
	--   rows = 64px 행 수(간격 6). 다 들어가면 스크롤 자체를 끈다 — AutoHide는 내용이 짧아도 핸들이 그대로 보이고, Hide는 트랙이 흰 띠로 남음(2026-09-16 실측)
	@ExecSpace("ClientOnly")
	method Entity SpawnScrollList(Entity content, string name, number rx, number rw, number top, number rows)
		local H = _RtsHudLogic
		local list = H:SpawnStretch("model://uisprite", name, content, Vector2(0, 0), Vector2(0, 1), Vector2(rx, 66), Vector2(rx + rw, top))
		if list == nil then return nil end
		H:Tint(list, 1, 1, 1, 0)
		local viewH = (self.PanelH - 70) - 66 + top
		-- rows = 행 수(70px 기준). 스킬 탭처럼 행 높이가 다르면 넉넉히 스크롤을 켠다(행이 7개 이상이면)
		local fits = rows * 70 - 6 <= viewH
		local sg = list:AddComponent("ScrollLayoutGroupComponent")
		if sg ~= nil then
			sg.Type = LayoutGroupType.Vertical
			sg.ChildAlignment = ChildAlignmentType.UpperLeft
			sg.Spacing = 10
			sg.UseScroll = true
			-- 스크롤바 프로퍼티 이름은 d.mlua(Visible·Thickness…)와 달리 런타임엔 ScrollBar* (2026-09-16 실측: "cannot set Visible")
			sg.ScrollBarVisible = ScrollBarVisibility.AlwaysShow
			sg.ScrollBarThickness = 8
			sg.ScrollBarHandleColor = H:ColGold()
			sg.ScrollBarBackgroundColor = Color(0.42, 0.32, 0.22, 0.1)
		end
		return list
	end

	-- 빈 목록 안내(목록의 유일한 행)
	@ExecSpace("ClientOnly")
	method void SpawnEmptyRow(Entity list, number rw, string text)
		local H = _RtsHudLogic
		local row = H:SpawnUI("model://uisprite", "RtsUnitEmptyRow", list, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(rw - 12, 200))
		H:Tint(row, 1, 1, 1, 0)
		H:SpawnLabel("RtsUnitEmptyText", row, Vector2(0.5, 0.5), Vector2(0.5, 0.5), Vector2(0, 0), Vector2(rw - 40, 60),
			text, _RtsPopupLogic:Muted(), 15, TextAlignmentType.MiddleCenter, false)
	end

	-- 증강 탭(2026-09-24): 맨 위에 증강 합계(공격력·공격력%·보스·크리 확률·크리 데미지·최종) + 방어구 부수기(켜졌을 때만), 그 아래 지정된 증강 목록
	@ExecSpace("ClientOnly")
	method void BuildAugTabFor(Entity content, any u, number rx, number rw, number top, table augs)
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		-- 증강 효과 배율까지 곱한 합계(1티어 ×3 · 2티어 약점 ×2 — RtsJobTableLogic.AugMulFor, 2026-09-24)
		local t = _RtsAugmentTableLogic:TotalsMul(u.Augs, _RtsJobTableLogic:AugMulFor(u))
		local box = H:SpawnRoundedPanel("RtsUnitAugSum", content, Vector2(0, 1), Vector2(0, 1), Vector2(rx, top), Vector2(rw - 12, 88),
			P:Mix(H:ColGold(), 0.08), P:Mix(H:ColGold(), 0.4), 1.5)
		local parts = {}
		if t.atk > 0 then parts[#parts + 1] = "공격력 +" .. H:Int(t.atk) end
		if t.pct > 0 then parts[#parts + 1] = "공격력 +" .. H:Int(t.pct) .. "%" end
		if t.boss > 0 then parts[#parts + 1] = "보스 공격 시 데미지 +" .. H:Int(t.boss) .. "%" end
		if t.crit > 0 then parts[#parts + 1] = "크리티컬 확률 +" .. H:Int(t.crit) .. "%" end
		if t.critDmg > 0 then parts[#parts + 1] = "크리티컬 데미지 +" .. H:Int(t.critDmg) .. "%" end
		if t.fin > 100.01 then parts[#parts + 1] = "최종 데미지 +" .. H:Int(t.fin - 100) .. "%" end
		local line1 = "증강 " .. H:Int(t.n) .. "개 합계"
		local line2 = "아직 없어요"
		if #parts > 0 then line2 = table.concat(parts, "  ·  ") end
		-- 셋째 줄 = 방어구 부수기가 켜졌을 때만 그 수치(자기 직업 프리즘이 있는 1티어 — RtsJobTableLogic.ArmorBreakFor).
		--   티어·서포터 같은 분류는 화면에 쓰지 않는다(2026-09-24 사용자 "1티어/2티어는 개발 관점에서 나눈 거지 유저는 몰라야 해") — 셋째 줄이 없으면 상자를 줄인다
		local JT = _RtsJobTableLogic
		local line3 = ""
		if JT:ArmorBreakFor(u) > 0 then
			local n = JT:AugCountOf(u)
			if n > JT.ArmorBreakCap then n = JT.ArmorBreakCap end
			line3 = "방어구 부수기: 보스 방어율 −" .. H:Int(JT:ArmorBreakFor(u)) .. "%p (증강 " .. H:Int(n) .. "/" .. H:Int(JT.ArmorBreakCap) .. "개)"
		end
		local boxH = 88
		if line3 == "" then boxH = 62 end
		box.Parent.UITransformComponent.RectSize = Vector2(rw - 12, boxH)
		H:SpawnLabel("RtsUnitAugSumT", box, Vector2(0, 1), Vector2(0, 1), Vector2(14, -6), Vector2(rw - 40, 22), line1, P:AccentInk(), 16, TextAlignmentType.MiddleLeft, true)
		H:SpawnLabel("RtsUnitAugSumV", box, Vector2(0, 1), Vector2(0, 1), Vector2(14, -30), Vector2(rw - 40, 24), line2, _RtsPopupLogic:Ink(), 15, TextAlignmentType.MiddleLeft, true)
		if line3 ~= "" then
			H:SpawnLabel("RtsUnitAugSumE", box, Vector2(0, 1), Vector2(0, 1), Vector2(14, -58), Vector2(rw - 40, 22), line3, _RtsPopupLogic:Muted(), 13, TextAlignmentType.MiddleLeft, false)
		end
		self:BuildAugTab(content, rx, rw, top - boxH - 8, augs)
	end

	-- 증강 탭 목록: 이 유닛에 지정된 증강(등급 배지 · 이름 · 효과)
	@ExecSpace("ClientOnly")
	method void BuildAugTab(Entity content, number rx, number rw, number top, table augs)
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		-- 설명 줄 수만큼 행 높이(2026-09-24 사용자 "풍마수리검 효과가 기니까 텍스트 깨짐" — 전엔 64px 고정이라 긴 프리즘 설명이 다음 행으로 넘쳤다).
		--   머리표("[나이트로드 전용] [프리즘]")는 배지와 겹치니 뗀다. 스크롤 판단도 실제 높이 합으로
		local descs = {}
		local heights = {}
		local total = 0
		for i = 1, #augs do
			local d = P:StripTags(augs[i].d or "")
			local lines = self:DescLines(d, rw - 120)
			if string.len(d) > 150 then lines = math.max(lines, math.ceil(string.len(d) / 2.6 / 44)) end
			if lines > 6 then lines = 6 end
			descs[i] = d
			heights[i] = math.max(100, 54 + lines * 22)
			total = total + heights[i] + 6
		end
		local list = self:SpawnScrollList(content, "RtsUnitAugList", rx, rw, top, math.max(#augs, math.ceil(total / 70)))
		if list == nil then return end
		if #augs == 0 then
			self:SpawnEmptyRow(list, rw, "적용 중인 증강이 없어요.")
			return
		end
		for i = 1, #augs do
			local a = augs[i]
			local rh = heights[i]
			local row = H:SpawnRoundedPanel("RtsUnitAug" .. tostring(i), list, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(rw - 12, rh),
				P:Card(), P:Edge(), 1.5)
			local band = H:SpawnStretch("model://uisprite", "RtsUnitAugBand", row, Vector2(0, 0), Vector2(0, 1), Vector2(0, 0), Vector2(4, 0))
			band.SpriteGUIRendererComponent.Color = P:GradeColor(a.g)
			local definition = _RtsAugmentTableLogic:GetDef(a.id)
			if definition ~= nil then P:SpawnAugIcon(row, definition, Vector2(14, -14), 64) end
			H:SpawnLabel("RtsUnitAugT", row, Vector2(0, 1), Vector2(0, 1), Vector2(96, -12), Vector2(rw - 124, 26),
				a.t, _RtsPopupLogic:Ink(), 17, TextAlignmentType.MiddleLeft, true)
			H:SpawnLabel("RtsUnitAugD", row, Vector2(0, 1), Vector2(0, 1), Vector2(96, -46), Vector2(rw - 124, rh - 54),
				descs[i], _RtsPopupLogic:Ink(), 14, TextAlignmentType.UpperLeft, false)
		end
	end

	-- 탭 글자 '적용 중인 버프 n' = 파티 버프 수 + 프리즘 증강 효율 버프(있으면 1)
	@ExecSpace("ClientOnly")
	method number BuffCount(any u, table buffs)
		local n = #buffs
		if _RtsJobTableLogic:PrismAugBuff(u) ~= nil then n = n + 1 end
		return n
	end

	-- 적용 중인 버프 탭: 맨 위 = 프리즘 증강 효율(있으면 — 2026-09-25 사용자 "프리즘 버프가 버프 칸에, 증강이 얼마나 오르고 증강으로 오른 수치 +얼마"),
	--   그 아래 파티 버프(아이콘 · 이름 + 범위 · 효과, 출처 유닛은 안 씀)
	@ExecSpace("ClientOnly")
	method void BuildBuffTabFor(Entity content, any u, number rx, number rw, number top, table buffs)
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		local B = _RtsUnitBuffLogic
		local pb = _RtsJobTableLogic:PrismAugBuff(u)
		-- 프리즘 줄 높이: 이름 34 + 설명 24 + 머리 22 + 수치 2열 격자(줄마다 20) + 아래 10
		local pbH = 0
		if pb ~= nil then
			local gl = math.max(1, math.ceil(#pb.gains / 2))
			pbH = 34 + 24 + 22 + gl * 20 + 10
		end
		local rows = #buffs
		if pb ~= nil then rows = rows + math.ceil(pbH / 64) + 1 end
		local list = self:SpawnScrollList(content, "RtsUnitBuffList", rx, rw, top, rows)
		if list == nil then return end
		if pb ~= nil then
			local row = H:SpawnRoundedPanel("RtsUnitBuffPrism", list, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(rw - 12, pbH),
				P:Mix(P:GradeColor("prism"), 0.1), P:Mix(P:GradeColor("prism"), 0.45), 1.5)
			local band = H:SpawnStretch("model://uisprite", "RtsUnitBuffPrismBand", row, Vector2(0, 0), Vector2(0, 1), Vector2(0, 0), Vector2(4, 0))
			band.SpriteGUIRendererComponent.Color = P:GradeColor("prism")
			P:SpawnBadge("RtsUnitBuffPrismBadge", row, Vector2(14, -20), "prism")
			local nm = H:SpawnLabel("RtsUnitBuffPrismName", row, Vector2(0, 1), Vector2(0, 1), Vector2(96, -12), Vector2(rw - 124, 26),
				pb.name .. "  <size=11><color=#78624d>프리즘 · 이 유닛</color></size>", _RtsPopupLogic:Ink(), 17, TextAlignmentType.MiddleLeft, true)
			nm.TextComponent.IsRichText = true
			-- 설명(2026-09-25 사용자 "크리티컬 확률·크리티컬 데미지 증강 효과가 100% 증가한다. 이런 식으로")
			local ef = H:SpawnLabel("RtsUnitBuffPrismEff", row, Vector2(0, 1), Vector2(0, 1), Vector2(92, -34), Vector2(rw - 120, 22),
				pb.eff, Color(0.23, 0.43, 0.21, 1), 16, TextAlignmentType.MiddleLeft, true)
			ef.TextComponent.Overflow = OverflowType.Truncate
			-- 증강 효과가 늘어 더 받은 수치 — 능력치마다 따로(2열 격자, 사용자 "증강으로 이득 본 수치 총합을 각각")
			H:SpawnLabel("RtsUnitBuffPrismHead", row, Vector2(0, 1), Vector2(0, 1), Vector2(92, -58), Vector2(rw - 120, 20),
				"증강 효과 증가로 더 받은 수치", P:AccentInk(), 15, TextAlignmentType.MiddleLeft, true)
			if #pb.gains == 0 then
				H:SpawnLabel("RtsUnitBuffPrismGain0", row, Vector2(0, 1), Vector2(0, 1), Vector2(92, -80), Vector2(rw - 120, 20),
					"아직 없어요(증강이 붙으면 늘어나요)", _RtsPopupLogic:Muted(), 13, TextAlignmentType.MiddleLeft, false)
			end
			local colW = math.floor((rw - 120) / 2)
			for gi = 1, #pb.gains do
				local col = (gi - 1) % 2
				local line = math.floor((gi - 1) / 2)
				local g = H:SpawnLabel("RtsUnitBuffPrismGain", row, Vector2(0, 1), Vector2(0, 1), Vector2(92 + col * colW, -80 - line * 20), Vector2(colW - 6, 20),
					pb.gains[gi], _RtsPopupLogic:Ink(), 13, TextAlignmentType.MiddleLeft, false)
				g.TextComponent.Overflow = OverflowType.Truncate
			end
		end
		if #buffs == 0 and pb == nil then
			self:SpawnEmptyRow(list, rw, "적용 중인 버프가 없어요.")
			return
		end
		for i = 1, #buffs do
			local b = buffs[i]
			local row = H:SpawnRoundedPanel("RtsUnitBuff" .. tostring(i), list, Vector2(0, 1), Vector2(0, 1), Vector2(0, 0), Vector2(rw - 12, 64),
				P:Card(), P:Edge(), 1.5)
			local ic = nil
			if b.def.icon ~= nil and b.def.icon ~= "" then
				ic = H:SpawnUI("model://uisprite", "RtsUnitBuffIcon", row, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(14, 0), Vector2(40, 40))
			end
			if ic ~= nil and ic.SpriteGUIRendererComponent ~= nil then
				ic.SpriteGUIRendererComponent.ImageRUID = DataRef(b.def.icon)
				ic.SpriteGUIRendererComponent.Color = Color.white
			end
			local name = H:SpawnLabel("RtsUnitBuffName", row, Vector2(0, 1), Vector2(0, 1), Vector2(70, -8), Vector2(rw - 100, 24),
				b.def.name .. "  <size=11><color=#78624d>" .. B:ScopeText(b.def) .. "</color></size>", _RtsPopupLogic:Ink(), 17, TextAlignmentType.MiddleLeft, true)
			name.TextComponent.IsRichText = true
			H:SpawnLabel("RtsUnitBuffEff", row, Vector2(0, 1), Vector2(0, 1), Vector2(70, -34), Vector2(rw - 100, 22),
				B:EffectText(b.def), Color(0.23, 0.43, 0.21, 1), 16, TextAlignmentType.MiddleLeft, false)
		end
	end

	method string TargetLabel(number no)
		if no <= 0 then return "미지정" end
		local o = _RtsUnitLogic:GetMyUnit(no)
		if o == nil then return "미지정" end
		return _RtsHudLogic:Int(o.No) .. ". " .. _RtsJobTableLogic:GetJobNameFor(o) .. " Lv" .. _RtsHudLogic:Int(o.Level)
	end

	@ExecSpace("ClientOnly")
	method void ToggleDropdown(number x, number y)
		if self.Dropdown ~= nil then
			self.Dropdown:Destroy()
			self.Dropdown = nil
			return
		end
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		local u = _RtsUnitLogic:GetMyUnit(self.CurNo)
		if u == nil then return end
		local options = { { no = 0, text = "미지정" } }
		local nos = _RtsUnitLogic:ListZoneUnits(_RtsUnitLogic:MyZone())
		for i0 = 1, #nos do
			local no = nos[i0]
			if no ~= self.CurNo then
				local o = _RtsUnitLogic:GetMyUnit(no)
				if o ~= nil then options[#options + 1] = { no = no, text = self:TargetLabel(no) } end
			end
		end
		local rowH = 30
		local list = H:SpawnRoundedPanel("RtsUnitTgtList", self.Content, Vector2(0, 1), Vector2(0, 1), Vector2(x, y), Vector2(250, rowH * #options + 4),
			P:Card(), H:ColGold(), 1.5)
		self.Dropdown = list.Parent
		for i = 1, #options do
			local o = options[i]
			local on = (o.no == u.BondNo)
			local bg = P:Card()
			if on then bg = P:Mix(H:ColGold(), 0.2) end
			local item = H:SpawnUI("model://uisprite", "RtsUnitTgtItem" .. tostring(i), list, Vector2(0, 1), Vector2(0, 1), Vector2(2, -2 - (i - 1) * rowH), Vector2(246, rowH))
			item.SpriteGUIRendererComponent.Color = bg
			H:SpawnLabel("RtsUnitTgtItemText", item, Vector2(0, 0.5), Vector2(0, 0.5), Vector2(10, 0), Vector2(230, 26),
				o.text, _RtsPopupLogic:Ink(), 14, TextAlignmentType.MiddleLeft, false)
			local pick = o.no
			local click = H:SpawnClick("RtsUnitTgtItemClick", item)
			click:ConnectEvent(ButtonClickEvent, function(event)
				if self.Dropdown ~= nil then
					self.Dropdown:Destroy()
					self.Dropdown = nil
				end
				if pick ~= u.BondNo then _RtsUnitLogic:RequestBond(self.CurNo, pick) end
			end)
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyBondCool(any u)
		if self.BondCoolText == nil or self.BondCoolText.TextComponent == nil then return end
		local left = u:BondCoolLeft()
		if left > 0 then
			self.BondCoolText.TextComponent.Text = "재지정까지 " .. self:FmtSec(left)
			self.BondCoolText.TextComponent.FontColor = Color(0.91, 0.635, 0.416, 1)
		else
			self.BondCoolText.TextComponent.Text = "변경 가능 · 쿨타임 3분"
			self.BondCoolText.TextComponent.FontColor = Color(0.624, 0.827, 0.604, 1)
		end
	end

	-- Tab 키 = 우측 탭 순환: 스킬 → 증강 → 적용 중인 버프 → 스킬(2026-09-23 사용자). RtsUnitSelectLogic.HandleKeyDownEvent가 부른다 — 오른쪽만 다시
	@ExecSpace("ClientOnly")
	method void CycleTab()
		if self.CurNo == 0 or self.Body == nil then return end
		if self.Tab == "active" then
			self.Tab = "passive"
		elseif self.Tab == "passive" then
			self.Tab = "aug"
		elseif self.Tab == "aug" then
			self.Tab = "buff"
		else
			self.Tab = "active"
		end
		self:RenderRight(_RtsUnitLogic:GetMyUnit(self.CurNo))
	end

	-- 오른쪽(탭 내용)만 다시: 탭 켜짐·개수 글자는 제자리, 목록은 컨테이너째 교체(옛 것은 0.12초 뒤 지움). 외형·능력치·레벨업 버튼은 그대로
	@ExecSpace("ClientOnly")
	method void RenderRight(any u)
		if u == nil or self.Content == nil or not isvalid(self.Content) then return end
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		local B = _RtsUnitBuffLogic
		local buffs = B:GetBuffsFor(u.Zone, u.No)
		local augs = B:GetAugmentsFor(u.Zone, u.No)
		if self.TabBar ~= nil then
			P:SetTabText(self.TabBar.tabs["aug"], "증강 " .. H:Int(#augs))
			P:SetTabText(self.TabBar.tabs["buff"], "버프 " .. H:Int(self:BuffCount(u, buffs)))
			P:BarSelect(self.TabBar, self.Tab)
		end
		if self.Dropdown ~= nil and isvalid(self.Dropdown) then self.Dropdown:Destroy() end
		self.Dropdown = nil
		local old = self.RightBox
		local scrollPos = nil
		if self._T.RightTab == self.Tab and isvalid(old) then
			local lists = old:GetChildComponentsByTypeName("ScrollLayoutGroupComponent", true)
			if #lists > 0 then scrollPos = lists[1]:GetScrollNormalizedPosition() end
		end
		self._T.RightTab = self.Tab
		local box = P:SpawnBox(self.Content, "RtsUnitRight")
		self.RightBox = box
		local rx = 647
		local rw = self.PanelW - rx - 27
		local top = -74
		if self.Tab == "aug" then
			self:BuildAugTabFor(box, u, rx, rw, top, augs)
		elseif self.Tab == "buff" then
			self:BuildBuffTabFor(box, u, rx, rw, top, buffs)
		else
			self:BuildSkillTab(box, u, rx, rw, top)
		end
		if scrollPos ~= nil then
			_TimerService:SetTimerOnce(function()
				if not isvalid(box) then return end
				local lists = box:GetChildComponentsByTypeName("ScrollLayoutGroupComponent", true)
				if #lists > 0 then lists[1]:SetScrollNormalizedPosition(UITransformAxis.Vertical, scrollPos.y) end
			end, 0.2)
		end
		P:SwapContent(old, box)
		self.Sig = self:Signature(u)
	end

	-- 1초마다: 쿨타임 글자 갱신, 쿨이 끝나는 순간 전체 다시 그림(버튼 활성)
	@ExecSpace("ClientOnly")
	method void Tick()
		if self.CurNo == 0 or self.Body == nil then return end
		local u = _RtsUnitLogic:GetMyUnit(self.CurNo)
		if u == nil then return end
		if self.BondLocked and u:BondCoolLeft() <= 0 then
			self:RenderRight(u)
			return
		end
		self:ApplyBondCool(u)
	end

	-- 외형 미리보기: UI 아바타(UIEmpty + CostumeManager + AvatarGUIRenderer). 모델이 없으면 조용히 건너뛴다
	@ExecSpace("ClientOnly")
	method void SpawnPreview(Entity parent, any u)
		self:SpawnPreviewAt(parent, u, Vector2(92, -128), Vector2(120, 190))
	end

	-- 위치(부모 왼쪽 위 기준 가운데)·크기를 받는 판(2026-09-25 영입 상세 팝업 — RtsPopupLogic.BuildRecruitInfo가 { JobId } 표로 부른다). 직업 기본 세트만
	@ExecSpace("ClientOnly")
	method void SpawnPreviewAt(Entity parent, any u, Vector2 pos, Vector2 size)
		local H = _RtsHudLogic
		local e = _SpawnService:SpawnByModelId("model://uiempty", "RtsUnitPreview", Vector3.zero, parent)
		if e == nil then
			H:SpawnLabel("RtsUnitPreviewText", parent, Vector2(0, 1), Vector2(0, 1), Vector2(pos.x - size.x / 2, pos.y + size.y / 2), size,
				_RtsJobTableLogic:GetJobName(u.JobId), _RtsPopupLogic:Muted(), 14, TextAlignmentType.MiddleCenter, false)
			return
		end
		local t = e.UITransformComponent
		t.AnchorsMin = Vector2(0, 1)
		t.AnchorsMax = Vector2(0, 1)
		t.Pivot = Vector2(0.5, 0.5)
		t.anchoredPosition = pos
		t.RectSize = size
		if u.JobId == "il" then
			local sprite = e:AddComponent("SpriteGUIRendererComponent")
			sprite.ImageRUID = _RtsJobTableLogic:GetMagePortraitRUID()
			sprite.PreserveSprite = PreserveSpriteType.AspectOnly
			sprite.RaycastTarget = false
			return
		end
		local cm = e:AddComponent("CostumeManagerComponent")
		local ar = e:AddComponent("AvatarGUIRendererComponent")
		if cm == nil or ar == nil then return end
		ar.PreserveAvatar = PreserveSpriteType.AspectOnly
		local set = _RtsJobTableLogic:GetCostume(u.JobId)
		if set == nil then return end
		cm.UseCustomEquipOnly = true
		cm.CustomLongcoatEquip = set.longcoat
		cm.CustomTwoHandedWeaponEquip = set.weapon2h or ""
		cm.CustomOneHandedWeaponEquip = set.weapon1h or ""
		cm.CustomShoesEquip = set.shoes
		cm.CustomHairEquip = set.hair
		cm.CustomCapEquip = set.cap or ""
		cm.CustomFaceAccessoryEquip = set.faceAcc or ""
		cm.CustomFaceEquip = set.face or ""
	end

	@ExecSpace("ClientOnly")
	method void SetChartLine(Entity line, Vector2 a, Vector2 b, number thick)
		-- 기존 선의 위치와 길이만 갱신한다.
		local dx = b.x - a.x
		local dy = b.y - a.y
		local t = line.UITransformComponent
		t.Pivot = Vector2(0, 0.5)
		t.anchoredPosition = a
		t.RectSize = Vector2(math.max(0.01, math.sqrt(dx * dx + dy * dy)), thick)
		t.ZRotation = math.deg(_RtsPopupLogic:Atan2(dy, dx))
	end

	@ExecSpace("ClientOnly")
	method void BuildStatChart(Entity parent, any u)
		-- 육각 격자·아이콘·값 라벨을 한 번 만들고 능력치가 바뀌면 재사용한다.
		local H = _RtsHudLogic
		local P = _RtsPopupLogic
		local c = Vector2(200, -204)
		local radius = 85
		local ends = {}
		local function line(name, color)
			local e = H:SpawnUI("model://uisprite", name, parent, Vector2(0, 1), Vector2(0, 0.5), c, Vector2(1, 1))
			e.SpriteGUIRendererComponent.Color = color
			e.SpriteGUIRendererComponent.RaycastTarget = false
			return e
		end
		for i = 1, 6 do
			local a = math.rad((i - 1) * 60)
			ends[i] = Vector2(c.x + math.sin(a) * radius, c.y + math.cos(a) * radius)
		end
		for level = 1, 4 do
			for i = 1, 6 do
				local v = ends[i]
				local w = ends[i % 6 + 1]
				local scale = level / 4
				self:SetChartLine(line("RtsStatGrid", Color(0.64, 0.64, 0.76, 0.30)), c + (v - c) * scale, c + (w - c) * scale, 1)
			end
		end
		for i = 1, 6 do self:SetChartLine(line("RtsStatAxis", Color(0.64, 0.64, 0.76, 0.23)), c, ends[i], 1) end
		self._T.ChartLines = {}
		self._T.ChartDots = {}
		self._T.ChartFill = {}
		for i = 1, 12 do
			local e = line("RtsStatFill", Color(0.66, 0.60, 0.86, 0.20))
			e.SpriteGUIRendererComponent.ImageRUID = DataRef(P.RightTriRUID)
			self._T.ChartFill[i] = e
		end
		for i = 1, 6 do
			self._T.ChartLines[i] = line("RtsStatValueEdge", Color(0.52, 0.46, 0.70, 0.95))
			local dot = line("RtsStatValueDot", Color(0.45, 0.40, 0.63, 1))
			dot.SpriteGUIRendererComponent.ImageRUID = DataRef(H.CircleMaskRUID)
			dot.UITransformComponent.Pivot = Vector2(0.5, 0.5)
			dot.UITransformComponent.RectSize = Vector2(6, 6)
			self._T.ChartDots[i] = dot
		end
		local keys = {"atk", "pct", "fin", "boss", "crit", "critDmg"}
		local names = {"공격력", "공격력%", "최종 데미지%", "보스 공격 시 데미지%", "크리티컬 확률", "크리티컬 데미지"}
		local indices = {2, 3, 5, 6, 7, 8}
		local spots = {Vector2(200, -14), Vector2(334, -96), Vector2(334, -244), Vector2(200, -321), Vector2(66, -244), Vector2(66, -96)}
		local rows = self:StatRowTexts(u)
		for i = 1, 6 do
			local pos = spots[i]
			H:SpawnStatIcon(parent, keys[i], Vector2(pos.x - 14, pos.y), 28)
			H:SpawnLabel("RtsStatName", parent, Vector2(0, 1), Vector2(0.5, 1), Vector2(pos.x, pos.y - 29), Vector2(124, 32), names[i], P:Muted(), 13, TextAlignmentType.MiddleCenter, false)
			local value = H:SpawnLabel("RtsStatValue", parent, Vector2(0, 1), Vector2(0.5, 1), Vector2(pos.x, pos.y - 59), Vector2(122, 24), rows[indices[i]][2], P:Ink(), 19, TextAlignmentType.MiddleCenter, true)
			value.TextComponent.IsRichText = true
			self.StatVals[indices[i]] = value
		end
		self:UpdateStatChart(u)
	end

	@ExecSpace("ClientOnly")
	method void UpdateStatChart(any u)
		-- 각 축의 고정 표시 척도는 직업·레벨에 따라 바뀌지 않는다. 게임 수치는 제한하지 않는다.
		if self._T.ChartLines == nil then return end
		local T = _RtsJobTableLogic
		local s = T:GetStatFor(u)
		_RtsUnitBuffLogic:ApplyToStat(s, _RtsUnitBuffLogic:GetBuffsFor(u.Zone, u.No))
		local calc = T:CalcStat(u.JobId, u.Level, s)
		local values = {calc.atk, s.pct - 100, s.fin - 100, s.bossAdd or 0, s.crit, s.critDmg}
		local limits = {1000, 200, 300, 200, 100, 200}
		local c = Vector2(200, -204)
		local points = {}
		for i = 1, 6 do
			local angle = math.rad((i - 1) * 60)
			local radius = 85 * math.max(0, math.min(1, values[i] / limits[i]))
			points[i] = Vector2(c.x + math.sin(angle) * radius, c.y + math.cos(angle) * radius)
		end
		local function right(e, f, m, v)
			local dx, dy = m.x - f.x, m.y - f.y
			local vx, vy = v.x - f.x, v.y - f.y
			if dx * vy - dy * vx < 0 then dx, dy, vx, vy = vx, vy, dx, dy end
			local t = e.UITransformComponent
			t.Pivot = Vector2(0, 0)
			t.anchoredPosition = f
			t.RectSize = Vector2(math.max(0.01, math.sqrt(dx * dx + dy * dy)), math.max(0.01, math.sqrt(vx * vx + vy * vy)))
			t.ZRotation = math.deg(_RtsPopupLogic:Atan2(dy, dx))
		end
		for i = 1, 6 do
			local a, b = points[i], points[i % 6 + 1]
			self:SetChartLine(self._T.ChartLines[i], a, b, 2.5)
			self._T.ChartDots[i].UITransformComponent.anchoredPosition = a
			local ps = {c, a, b}
			local best, length = 1, -1
			for j = 1, 3 do
				local v, w = ps[j], ps[j % 3 + 1]
				local d = (v.x - w.x) ^ 2 + (v.y - w.y) ^ 2
				if d > length then best, length = j, d end
			end
			local x, y, o = ps[best], ps[best % 3 + 1], ps[(best + 1) % 3 + 1]
			local amount = ((o.x - x.x) * (y.x - x.x) + (o.y - x.y) * (y.y - x.y)) / math.max(0.01, length)
			local foot = Vector2(x.x + (y.x - x.x) * amount, x.y + (y.y - x.y) * amount)
			right(self._T.ChartFill[i * 2 - 1], foot, x, o)
			right(self._T.ChartFill[i * 2], foot, y, o)
		end
	end

end
